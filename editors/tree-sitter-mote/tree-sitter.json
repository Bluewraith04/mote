{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "mote",
      "camelcase": "Mote",
      "scope": "source.mote",
      "path": ".",
      "file-types": ["mote"],
      "highlights": "../zed/languages/mote/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "description": "Tree-sitter grammar for the Mote language",
    "links": {
      "repository": "https://github.com/Bluewraith04/mote"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
