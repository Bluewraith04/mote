/// A YAML config read into a derived type, bundled with its files into a.tar.gz and a.zip, and restored.
import std.data.yaml as yaml
import std.data.json as json
import std.data.compress as compress
import std.data.archive as archive
import std.sys.fs as fs

@derive(Json)
class Site {
    title: String
    pages: List<String>
    draft: Bool
}

let CONFIG = "# site settings
title: Notes
pages: [index, about]
draft: false
"

fn main() {
    fs.create_dir_all("site/pages").unwrap()
    fs.write_text("site/site.yaml", CONFIG).unwrap()
    fs.write_text("site/pages/index.txt", "welcome").unwrap()
    fs.write_text("site/pages/about.txt", "about this site").unwrap()

    let entries = archive.read_dir("site").unwrap()
    fs.write_bytes("site.tar.gz", compress.gzip(archive.pack_tar(entries).unwrap())).unwrap()
    fs.write_bytes("site.zip", archive.pack_zip(entries).unwrap()).unwrap()

    let from_tar = archive.unpack_tar(compress.gunzip(fs.read_bytes("site.tar.gz").unwrap()).unwrap()).unwrap()
    archive.extract(from_tar, "restored/tar").unwrap()
    archive.extract(archive.unpack_zip(fs.read_bytes("site.zip").unwrap()).unwrap(), "restored/zip").unwrap()

    for dir in ["restored/tar", "restored/zip"] {
        let site = Site.from_json(yaml.parse(fs.read_text(dir + "/site.yaml").unwrap()).unwrap()).unwrap()
        println("${site.title}: ${site.pages.len()} pages, draft ${site.draft}")
        for page in site.pages {
            let body = fs.read_text(dir + "/pages/" + page + ".txt").unwrap()
            println("  ${page}: ${body}")
        }
    }
    println(entries.len())
    print(yaml.to_text(Site.from_json(yaml.parse(CONFIG).unwrap()).unwrap().to_json()).unwrap())
}
