/// std.sys.env: program arguments and environment variables.
/// The environment is read-only. A missing variable is `None`.

import std.prelude

pub fn args() -> List<String> {
    return __env_args()
}

/// The value of environment variable `name`, or `None` if it is unset. Not called `var`, which is a keyword.
pub fn get_var(name: String) -> Option<String> {
    let v = __env_var_raw(name)
    if v == null {
        return None
    }
    return Some(v)
}

pub fn vars() -> Map<String, String> {
    return __env_vars()
}

/// Ends the process now with `code` (low 8 bits), after flushing stdout and stderr.
pub fn exit(code: Int) { __process_exit(code) }
