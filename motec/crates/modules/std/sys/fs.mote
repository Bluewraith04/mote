/// std.sys.fs — file handles. Explicit import, not in the prelude.
///
/// A `File` holds only the platform's handle id. `close()` (or `with`) closes it at a chosen point;
/// a `File` nothing holds any more is closed by the collector.
/// Every operation is OS-fallible; each native answers the `Result` itself.

import std.prelude

pub class File {
    id: Int

    /// Up to `max` bytes; empty at end of file.
    pub fn read(self, max: Int) -> Result<Bytes, Error> {
        return __fs_read(self.id, max)
    }

    /// The next line without its ending; `Ok(None)` at end of file.
    pub fn read_line(self) -> Result<Option<String>, Error> {
        let line = __fs_read_line(self.id)?
        if line == null {
            return Ok(None)
        }
        return Ok(Some(line))
    }

    /// Each remaining line as `Ok(line)`; a read failure is one `Err`, then the end. Does not close.
    pub fn lines(self) -> Stream<Result<String, Error>> {
        while true {
            match self.read_line() {
                Ok(got) => {
                    match got {
                        Some(line) => { yield Ok(line) }
                        None => { return }
                    }
                }
                Err(e) => {
                    yield Err(e)
                    return
                }
            }
        }
    }

    /// Everything from the current position to end of file.
    pub fn read_to_end(self) -> Result<Bytes, Error> {
        let out = Bytes()
        while true {
            match self.read(4096) {
                Ok(chunk) => {
                    let c: Bytes = chunk
                    if c.len() == 0 {
                        return Ok(out)
                    }
                    out.extend(c)
                }
                Err(e) => { return Err(e) }
            }
        }
        return Ok(out)
    }

    pub fn write(self, b: Bytes) -> Result<Null, Error> {
        return __fs_write(self.id, b)
    }

    pub fn write_text(self, s: String) -> Result<Null, Error> {
        return __fs_write_text(self.id, s)
    }

    /// Moves to `offset` bytes from the start; answers the new position.
    pub fn seek(self, offset: Int) -> Result<Int, Error> {
        return __fs_seek(self.id, offset, 0)
    }

    /// Moves `offset` bytes from the current position.
    pub fn seek_by(self, offset: Int) -> Result<Int, Error> {
        return __fs_seek(self.id, offset, 1)
    }

    /// Moves to `offset` bytes from the end (usually negative).
    pub fn seek_end(self, offset: Int) -> Result<Int, Error> {
        return __fs_seek(self.id, offset, 2)
    }

    pub fn close(self) -> Result<Null, Error> {
        return __fs_close(self.id)
    }
}

fn owned(id: Int) -> File {
    let f = File { id: id }
    __release_on_collect(f, 1)
    return f
}

fn opened(id: Result<Int, Error>) -> Result<File, Error> {
    match id {
        Ok(n) => { return Ok(owned(n)) }
        Err(e) => { return Err(e) }
    }
}

/// Opens an existing file for reading.
pub fn open(path: String) -> Result<File, Error> {
    return opened(__fs_open(path, 0))
}

/// Creates the file, or truncates it, for writing.
pub fn create(path: String) -> Result<File, Error> {
    return opened(__fs_open(path, 1))
}

/// Opens for writing at the end, creating the file if absent.
pub fn append(path: String) -> Result<File, Error> {
    return opened(__fs_open(path, 2))
}

/// What `stat` reports; `kind` is 0 file, 1 directory, 2 other; `modified` is Unix milliseconds.
pub class Stat {
    pub kind: Int
    pub size: Int
    pub modified: Int

    pub fn is_file(self) -> Bool { return self.kind == 0 }
    pub fn is_dir(self) -> Bool { return self.kind == 1 }
}

/// Entry names of a directory, sorted, without `.` and `..`.
pub fn list_dir(path: String) -> Result<List<String>, Error> {
    return __fs_list_dir(path)
}

pub fn create_dir(path: String) -> Result<Null, Error> {
    return __fs_create_dir(path, 0)
}

/// Creates the directory and its parents; an existing directory is not an error.
pub fn create_dir_all(path: String) -> Result<Null, Error> {
    return __fs_create_dir(path, 1)
}

pub fn remove_file(path: String) -> Result<Null, Error> {
    return __fs_remove_file(path)
}

/// Removes an empty directory.
pub fn remove_dir(path: String) -> Result<Null, Error> {
    return __fs_remove_dir(path, 0)
}

/// Removes a directory and everything in it.
pub fn remove_dir_all(path: String) -> Result<Null, Error> {
    return __fs_remove_dir(path, 1)
}

/// Moves a file or directory; replaces a file at `dst`.
pub fn rename(src: String, dst: String) -> Result<Null, Error> {
    return __fs_rename(src, dst)
}

/// Size, kind and modified time; follows symlinks.
pub fn stat(path: String) -> Result<Stat, Error> {
    let parts = __fs_stat(path)?
    return Ok(Stat { kind: parts.get(0), size: parts.get(1), modified: parts.get(2) })
}

pub fn exists(path: String) -> Bool {
    return __fs_stat(path).is_ok()
}

@stable
pub fn read_text(path: String) -> Result<String, Error> {
    with f = open(path)? {
        let b = f.read_to_end()?
        match b.decode() {
            Some(s) => { return Ok(s) }
            None => { return Err(Error.new(ErrorKind.InvalidData, "read_text: invalid UTF-8: " + path)) }
        }
    }
    return Err(Error.new(ErrorKind.Other, "unreachable"))
}

@stable
pub fn write_text(path: String, s: String) -> Result<Null, Error> {
    with f = create(path)? {
        f.write_text(s)?
        return Ok(null)
    }
    return Err(Error.new(ErrorKind.Other, "unreachable"))
}

@stable
pub fn read_bytes(path: String) -> Result<Bytes, Error> {
    with f = open(path)? {
        return f.read_to_end()
    }
    return Err(Error.new(ErrorKind.Other, "unreachable"))
}

@stable
pub fn write_bytes(path: String, b: Bytes) -> Result<Null, Error> {
    with f = create(path)? {
        f.write(b)?
        return Ok(null)
    }
    return Err(Error.new(ErrorKind.Other, "unreachable"))
}
