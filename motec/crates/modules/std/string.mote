/// std.string: eager helpers on top of the built-in `String` methods (`slice`, `find`, `replace`, `split`, `trim`, `to_upper`, `to_lower`, `repeat`, `contains`, `starts_with`, `ends_with`, `bytes`). Reached as `import std.string as str`.

import std.prelude

/// Join `parts` with `sep` between each.
pub fn join(parts: List<String>, sep: String) -> String {
    var out = ""
    var first = true
    for p in parts {
        if first {
            out = out + p
            first = false
        } else {
            out = out + sep + p
        }
    }
    return out
}

/// Split into lines on `\n`. A trailing newline yields a trailing empty piece,
/// matching `split`.
pub fn lines(s: String) -> List<String> {
    return s.split("\n")
}

/// True when `s` is empty or entirely ASCII whitespace.
pub fn is_blank(s: String) -> Bool {
    return s.trim().is_empty()
}

/// `s` with `pad` prepended until it is at least `width` bytes long.
pub fn pad_start(s: String, width: Int, pad: String) -> String {
    var out = s
    while out.len() < width {
        out = pad + out
    }
    return out
}

/// The `Int` written in `s`: optional `-` and digits only; overflow, spaces or `+` are an `Err`.
pub fn parse_int(s: String) -> Result<Int, Error> {
    return __str_parse_int(s)
}

/// The finite `Float` written in `s`: digits, optional `-`, fraction and exponent; `inf`, `nan`, spaces or `+` are an `Err`.
pub fn parse_float(s: String) -> Result<Float, Error> {
    return __str_parse_float(s)
}
