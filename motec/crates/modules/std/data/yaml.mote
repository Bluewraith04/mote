
import std.prelude
import std.data.json as json
import { Json } from std.data.json

/// The one document in `text` (an empty text is `Null`); more than one is an `Err`.
pub fn parse(text: String) -> Result<Json, Error> {
    let as_json = __yaml_parse(text, false)?
    return json.parse(as_json)
}

/// Every document in `text`, in order.
pub fn parse_all(text: String) -> Result<List<Json>, Error> {
    let as_json = __yaml_parse(text, true)?
    let docs = json.parse(as_json)?
    match docs {
        Json.Array(items) => { return Ok(items) }
        _ => { return Err(Error.new(ErrorKind.InvalidData, "expected a list of documents")) }
    }
}

/// `j` as a YAML document.
pub fn to_text(j: Json) -> Result<String, Error> {
    let as_json = json.to_text(j)?
    return __yaml_render(as_json)
}
