/// std.data.archive — tar and zip over the Rust `tar` and `zip` crates. Explicit import, not in the prelude.
///
/// An archive is read or written whole as `Bytes`, as a list of `Entry`. A directory is an entry whose name ends in `/`.
/// Names must stay inside the archive's own directory: no leading `/`, no `\`, no `..`. Unpacking stops with an `Err` past 1 GiB.

import std.prelude
import std.sys.fs as fs

/// A file (its `data`) or a directory (a name ending in `/`, empty `data`) in an archive.
pub class Entry {
    pub name: String
    pub data: Bytes

    pub fn is_dir(self) -> Bool { return self.name.ends_with("/") }
}

/// A file entry.
pub fn file(name: String, data: Bytes) -> Entry {
    return Entry { name: name, data: data }
}

/// A directory entry; the trailing `/` is added.
pub fn dir(name: String) -> Entry {
    return Entry { name: name + "/", data: Bytes() }
}

fn names(entries: List<Entry>) -> List<String> {
    var out: List<String> = []
    for e in entries { out.push(e.name) }
    return out
}

fn datas(entries: List<Entry>) -> List<Bytes> {
    var out: List<Bytes> = []
    for e in entries { out.push(e.data) }
    return out
}

fn entries_of(flat: List<__Any>) -> List<Entry> {
    var out: List<Entry> = []
    var i = 0
    while i < flat.len() {
        out.push(Entry { name: flat.get(i), data: flat.get(i + 1) })
        i = i + 2
    }
    return out
}

/// A tar archive of `entries`; times are zero, so the same entries give the same bytes.
pub fn pack_tar(entries: List<Entry>) -> Result<Bytes, Error> {
    return __tar_pack(names(entries), datas(entries))
}

/// The files and directories of a tar archive; links and devices are skipped.
pub fn unpack_tar(b: Bytes) -> Result<List<Entry>, Error> {
    let flat = __tar_unpack(b)?
    return Ok(entries_of(flat))
}

/// A zip archive of `entries`, deflated at level 6.
pub fn pack_zip(entries: List<Entry>) -> Result<Bytes, Error> {
    return __zip_pack(names(entries), datas(entries), 6)
}

/// The files and directories of a zip archive.
pub fn unpack_zip(b: Bytes) -> Result<List<Entry>, Error> {
    let flat = __zip_unpack(b)?
    return Ok(entries_of(flat))
}

fn bad_name(name: String) -> Bool {
    if name.len() == 0 || name.starts_with("/") || name.contains("\\") { return true }
    for part in name.split("/") {
        if part == ".." { return true }
    }
    return false
}

fn collect(root: String, prefix: String, var out: List<Entry>) -> Result<Null, Error> {
    for name in fs.list_dir(root + "/" + prefix)? {
        let rel = prefix + name
        let info = fs.stat(root + "/" + rel)?
        if info.is_dir() {
            out.push(dir(rel))
            collect(root, rel + "/", out)?
        } else {
            out.push(file(rel, fs.read_bytes(root + "/" + rel)?))
        }
    }
    return Ok(null)
}

/// Every file and directory under `path` as entries named relative to it, in sorted order, directories before their contents.
pub fn read_dir(path: String) -> Result<List<Entry>, Error> {
    var out: List<Entry> = []
    collect(path, "", out)?
    return Ok(out)
}

/// Writes `entries` under `dir_path`, creating it and any directories; an unsafe name is an `Err` and nothing after it is written.
pub fn extract(entries: List<Entry>, dir_path: String) -> Result<Null, Error> {
    for e in entries {
        if bad_name(e.name) { return Err(Error.new(ErrorKind.InvalidData, "unsafe entry name ${e.name}")) }
    }
    fs.create_dir_all(dir_path)?
    for e in entries {
        let target = dir_path + "/" + e.name
        if e.is_dir() {
            fs.create_dir_all(target)?
        } else {
            let slash = target.rfind("/")
            match slash {
                Some(at) => { fs.create_dir_all(target.slice(0, at))? }
                None => {}
            }
            fs.write_bytes(target, e.data)?
        }
    }
    return Ok(null)
}
