/// std.data.compress — gzip, zlib and raw deflate over the Rust `flate2` crate. Explicit import, not in the prelude.
///
/// Each `*_level` form takes 0 (store) to 9 (smallest); a level outside that range is clamped. Decompressing stops with an `Err` past 1 GiB.

import std.prelude

/// gzip at level 6.
pub fn gzip(b: Bytes) -> Bytes {
    return __compress(b, 0, 6)
}

pub fn gzip_level(b: Bytes, level: Int) -> Bytes {
    return __compress(b, 0, level)
}

/// The bytes inside gzip data.
pub fn gunzip(b: Bytes) -> Result<Bytes, Error> {
    return __decompress(b, 0)
}

/// zlib at level 6.
pub fn zlib(b: Bytes) -> Bytes {
    return __compress(b, 1, 6)
}

pub fn zlib_level(b: Bytes, level: Int) -> Bytes {
    return __compress(b, 1, level)
}

/// The bytes inside zlib data.
pub fn unzlib(b: Bytes) -> Result<Bytes, Error> {
    return __decompress(b, 1)
}

/// Raw deflate (no header) at level 6.
pub fn deflate(b: Bytes) -> Bytes {
    return __compress(b, 2, 6)
}

pub fn deflate_level(b: Bytes, level: Int) -> Bytes {
    return __compress(b, 2, level)
}

/// The bytes inside raw deflate data.
pub fn inflate(b: Bytes) -> Result<Bytes, Error> {
    return __decompress(b, 2)
}
