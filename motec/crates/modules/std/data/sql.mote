/// std.data.sql — SQLite databases over the rusqlite crate. Explicit import, not in the prelude.
///
/// A `Database` holds only the platform's id; one connection serves every task, a call at a time. A call runs on the
/// offload pool while its task waits. `close()` closes it at a chosen point; one nothing holds any more is closed by
/// the collector. A value is a `Cell` (an Int, Float, String or Bytes) or `None` for SQL NULL.

import std.prelude
import { to_float } from std.math

/// A non-null SQL value.
pub type Cell = Int | Float | String | Bytes

/// What an `execute` did: the rows it changed and the row id of the last insert on the connection.
pub class Changes {
    pub changed: Int
    pub last_id: Int
}

/// One result row, its cells in column order.
pub class Row {
    names: List<String>
    cells: List<Cell?>

    /// The columns' names.
    pub fn columns(self) -> List<String> { return self.names }

    /// The cell in column `i`, counting from 0.
    pub fn at(self, i: Int) -> Result<Cell?, Error> {
        if i < 0 || i >= self.cells.len() {
            return Err(Error.new(ErrorKind.NotFound, "no column ${i}"))
        }
        return Ok(self.cells.get(i))
    }

    /// The cell in the column called `name`.
    pub fn get(self, name: String) -> Result<Cell?, Error> {
        var i = 0
        while i < self.names.len() {
            if self.names.get(i) == name { return Ok(self.cells.get(i)) }
            i = i + 1
        }
        return Err(Error.new(ErrorKind.NotFound, "no column ${name}"))
    }

    /// Whether the cell in `name` is NULL.
    pub fn is_null(self, name: String) -> Result<Bool, Error> {
        match self.get(name)? {
            Some(v) => { return Ok(false) }
            None => { return Ok(true) }
        }
    }

    /// The cell in `name` as an Int; an `Err` for NULL or another type.
    pub fn int(self, name: String) -> Result<Int, Error> {
        match self.get(name)? {
            Some(v) => {
                match v {
                    n: Int => { return Ok(n) }
                    other => { return Err(wrong(name, "an Int")) }
                }
            }
            None => { return Err(wrong(name, "an Int")) }
        }
    }

    /// The cell in `name` as a Float (an Int converts); an `Err` for NULL or another type.
    pub fn float(self, name: String) -> Result<Float, Error> {
        match self.get(name)? {
            Some(v) => {
                match v {
                    f: Float => { return Ok(f) }
                    n: Int => { return Ok(to_float(n)) }
                    other => { return Err(wrong(name, "a Float")) }
                }
            }
            None => { return Err(wrong(name, "a Float")) }
        }
    }

    /// The cell in `name` as a String; an `Err` for NULL or another type.
    pub fn text(self, name: String) -> Result<String, Error> {
        match self.get(name)? {
            Some(v) => {
                match v {
                    s: String => { return Ok(s) }
                    other => { return Err(wrong(name, "a String")) }
                }
            }
            None => { return Err(wrong(name, "a String")) }
        }
    }

    /// The cell in `name` as Bytes; an `Err` for NULL or another type.
    pub fn bytes(self, name: String) -> Result<Bytes, Error> {
        match self.get(name)? {
            Some(v) => {
                match v {
                    b: Bytes => { return Ok(b) }
                    other => { return Err(wrong(name, "Bytes")) }
                }
            }
            None => { return Err(wrong(name, "Bytes")) }
        }
    }
}

fn wrong(name: String, want: String) -> Error {
    return Error.new(ErrorKind.InvalidData, "column ${name} is not ${want}")
}

fn changes(db: Int, tx: Int, sql: String, params: List<Cell?>) -> Result<Changes, Error> {
    let r = __sql_run(db, tx, sql, params, 0)?
    return Ok(Changes { changed: r.get(0), last_id: r.get(1) })
}

fn rows(db: Int, tx: Int, sql: String, params: List<Cell?>) -> Result<List<Row>, Error> {
    var names: List<String> = []
    var out: List<Row> = []
    var count = 0
    var i = 0
    var at = 0
    let r = __sql_run(db, tx, sql, params, 1)?
    count = r.get(2)
    while i < count {
        names.push(r.get(3 + i))
        i = i + 1
    }
    at = 3 + count
    while at < r.len() {
        var cells: List<Cell?> = []
        var j = 0
        while j < count {
            cells.push(r.get(at + j))
            j = j + 1
        }
        out.push(Row { names: names, cells: cells })
        at = at + count
    }
    return Ok(out)
}

fn statement(db: Int, tx: Int, sql: String) -> Result<Statement, Error> {
    let none: List<Cell?> = []
    var names: List<String> = []
    var count = 0
    var i = 0
    let r = __sql_run(db, tx, sql, none, 2)?
    count = r.get(2)
    while i < count {
        names.push(r.get(3 + i))
        i = i + 1
    }
    return Ok(Statement { db: db, tx: tx, sql: sql, count: r.get(0), names: names })
}

/// A statement checked once and run many times; the connection keeps its prepared form.
pub class Statement {
    db: Int
    tx: Int
    sql: String
    count: Int
    names: List<String>

    /// How many `?` parameters it takes.
    pub fn param_count(self) -> Int { return self.count }

    /// The names of the columns it answers; none for a statement that returns no rows.
    pub fn columns(self) -> List<String> { return self.names }

    pub fn execute(self, params: List<Cell?> = []) -> Result<Changes, Error> {
        return changes(self.db, self.tx, self.sql, params)
    }

    pub fn query(self, params: List<Cell?> = []) -> Result<List<Row>, Error> {
        return rows(self.db, self.tx, self.sql, params)
    }
}

/// An open transaction: its statements run as one unit, and no other task's call runs on the database until it
/// ends. Dropped or closed without `commit()`, it rolls back, so `with t = db.begin()! {... t.commit()! }` is safe.
pub class Transaction {
    id: Int
    db: Int

    pub fn execute(self, sql: String, params: List<Cell?> = []) -> Result<Changes, Error> {
        return changes(self.db, self.id, sql, params)
    }

    pub fn query(self, sql: String, params: List<Cell?> = []) -> Result<List<Row>, Error> {
        return rows(self.db, self.id, sql, params)
    }

    pub fn prepare(self, sql: String) -> Result<Statement, Error> {
        return statement(self.db, self.id, sql)
    }

    /// Makes the changes permanent and ends the transaction.
    pub fn commit(self) -> Result<Null, Error> {
        return __sql_end(self.id, 1)
    }

    /// Undoes the changes and ends the transaction.
    pub fn rollback(self) -> Result<Null, Error> {
        return __sql_end(self.id, 0)
    }

    /// Rolls back if the transaction is still open; nothing after a commit.
    pub fn close(self) -> Result<Null, Error> {
        return __sql_end(self.id, 0)
    }
}

/// A SQLite database.
pub class Database {
    id: Int

    /// Runs a statement that returns no rows; `?` in `sql` takes `params` in order.
    pub fn execute(self, sql: String, params: List<Cell?> = []) -> Result<Changes, Error> {
        return changes(self.id, 0, sql, params)
    }

    /// Runs a statement and answers every row it returns.
    pub fn query(self, sql: String, params: List<Cell?> = []) -> Result<List<Row>, Error> {
        return rows(self.id, 0, sql, params)
    }

    /// Checks `sql` now and answers a statement to run again.
    pub fn prepare(self, sql: String) -> Result<Statement, Error> {
        return statement(self.id, 0, sql)
    }

    /// Starts a transaction, waiting while another task's is open (30 s at most).
    pub fn begin(self) -> Result<Transaction, Error> {
        let token = __sql_begin(self.id)?
        let t = Transaction { id: token, db: self.id }
        __release_on_collect(t, 6)
        return Ok(t)
    }

    pub fn close(self) -> Result<Null, Error> {
        return __sql_close(self.id)
    }
}

/// Opens the database file at `path`, creating it if it is missing. Foreign keys are enforced.
pub fn open(path: String) -> Result<Database, Error> {
    let id = __sql_open(path)?
    let db = Database { id: id }
    __release_on_collect(db, 5)
    return Ok(db)
}

/// A new database in memory, private to this handle and gone when it closes.
pub fn memory() -> Result<Database, Error> {
    return open(":memory:")
}
