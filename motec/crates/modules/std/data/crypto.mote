/// std.data.crypto — hashes, HMAC, secure random bytes and password hashing over the RustCrypto crates.
/// Explicit import, not in the prelude. Data is `Bytes`; `to_hex` makes the usual text form.

import std.prelude

/// The SHA-256 hash of `data` (32 bytes).
pub fn sha256(data: Bytes) -> Bytes { return __crypto_hash(0, data) }

/// The SHA-384 hash of `data` (48 bytes).
pub fn sha384(data: Bytes) -> Bytes { return __crypto_hash(1, data) }

/// The SHA-512 hash of `data` (64 bytes).
pub fn sha512(data: Bytes) -> Bytes { return __crypto_hash(2, data) }

/// HMAC-SHA-256 of `data` under `key` (32 bytes); a key of any length works.
pub fn hmac_sha256(key: Bytes, data: Bytes) -> Bytes { return __crypto_hmac(0, key, data) }

/// HMAC-SHA-384 of `data` under `key` (48 bytes).
pub fn hmac_sha384(key: Bytes, data: Bytes) -> Bytes { return __crypto_hmac(1, key, data) }

/// HMAC-SHA-512 of `data` under `key` (64 bytes).
pub fn hmac_sha512(key: Bytes, data: Bytes) -> Bytes { return __crypto_hmac(2, key, data) }

/// Whether the bytes match, taking the same time wherever they differ; use it for tags and tokens, not `==`.
pub fn constant_time_eq(a: Bytes, b: Bytes) -> Bool { return __crypto_equal(a, b) }

/// `n` bytes (0 to 64 MiB) from the operating system's secure source, unlike `std.random`.
pub fn random_bytes(n: Int) -> Result<Bytes, Error> { return __crypto_random(n) }

/// Lowercase hexadecimal text of `data`.
pub fn to_hex(data: Bytes) -> String { return __hex_encode(data) }

/// The bytes of hexadecimal text in either case; an odd length or another character is an `Err`.
pub fn from_hex(text: String) -> Result<Bytes, Error> { return __hex_decode(text) }

/// An Argon2id hash of `password` as text (`$argon2id$v=19$m=19456,t=2,p=1$salt$hash`) with a fresh random salt; it takes tens of milliseconds.
pub fn hash_password(password: String) -> Result<String, Error> { return __password_hash(password) }

/// Whether `password` made `hash`; an `Err` when `hash` is not a password hash.
pub fn verify_password(password: String, hash: String) -> Result<Bool, Error> { return __password_verify(password, hash) }
