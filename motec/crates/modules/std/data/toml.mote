/// std.data.toml — TOML read into and written from `Json`, over the Rust `toml` crate. Explicit import, not in the prelude.
///
/// `parse(text)` answers a `Json` `Object`; dates and times stay text. `to_text(j)` prints an `Object` as a document.

import std.prelude
import std.data.json as json
import { Json } from std.data.json

/// Parses a TOML document into a `Json` `Object`; an `Err` names the line and column.
pub fn parse(text: String) -> Result<Json, Error> {
    let as_json = __toml_parse(text)?
    return json.parse(as_json)
}

/// Prints a `Json` `Object` as a TOML document; anything else, or a `Null` anywhere, is an `Err`.
pub fn to_text(j: Json) -> Result<String, Error> {
    let as_json = json.to_text(j)?
    return __toml_render(as_json)
}
