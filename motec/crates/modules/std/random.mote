/// std.random: a seedable generator. Explicit import.
/// `Rng` owns its SplitMix64 state, so a seeded `Rng` is deterministic. `random()` draws from a fresh entropy seed. Not cryptographically secure.

import std.prelude

pub class Rng {
    var state: Int

    pub fn seeded(seed: Int) -> Rng { return Rng { state: seed } }
    pub fn from_entropy() -> Rng { return Rng { state: __random_entropy() } }

    /// Non-negative 63-bit integer.
    pub fn next_bits(var self) -> Int {
        self.state = __random_advance(self.state)
        return __random_bits(self.state)
    }

    /// Uniform in [lo, hi). Returns lo if the range is empty.
    pub fn next_int(var self, lo: Int, hi: Int) -> Int {
        if hi <= lo { return lo }
        return lo + self.next_bits() % (hi - lo)
    }

    /// Uniform in [0, 1).
    pub fn next_float(var self) -> Float {
        self.state = __random_advance(self.state)
        return __random_unit(self.state)
    }

    pub fn bool(var self) -> Bool { return self.next_bits() % 2 == 1 }

    pub fn choice<T>(var self, items: List<T>) -> Option<T> {
        if items.len() == 0 { return None }
        return Some(items.get(self.next_int(0, items.len())))
    }

    /// Fisher–Yates, in place.
    pub fn shuffle<T>(var self, var items: List<T>) {
        var i = items.len() - 1
        while i > 0 {
            let j = self.next_int(0, i + 1)
            let tmp = items.get(i)
            items.set(i, items.get(j))
            items.set(j, tmp)
            i = i - 1
        }
    }
}

/// A single draw in [0, 1), entropy-seeded.
pub fn random() -> Float { return __random_unit(__random_advance(__random_entropy())) }
