/// pane.element — the `Element` tree a view builds, and the modifiers that restyle it.

import std.sys.gui as gui
import .theme

/// What an element does to the window itself: `Move` drags it, `Resize(edge)` resizes from an edge (see `gui.Edge`, counted from 0), the rest act on a click.
pub enum Action {
    Nothing
    Move
    Minimize
    Maximize
    Close
    Resize(Int)
}

/// One piece of a view: its kind and role, text, style edits, children and the handlers that change the state `S`.
pub class Element<S> {
    pub var kind: gui.Kind
    pub var role: theme.Role
    pub var text: String
    pub var edits: List<(gui.Style) -> gui.Style>
    pub var fill: Int
    pub var id: String
    pub var png: Bytes
    pub var act: Action
    pub var kids: List<Element<S>>
    pub var click: List<(var S) -> Null>
    pub var change: List<(var S, String) -> Null>
    pub var submit: List<(var S) -> Null>

    fn copy(self) -> Element<S> {
        return Element { kind: self.kind, role: self.role, text: self.text, edits: self.edits, fill: self.fill, id: self.id, png: self.png, act: self.act, kids: self.kids, click: self.click, change: self.change, submit: self.submit }
    }

    /// Runs `f` on the state when the element is clicked.
    pub fn on_click(self, f: (var S) -> Null) -> Element<S> {
        var e = self.copy()
        e.click = [f]
        return e
    }

    /// Runs `f` with the state and the new text when an input's text changes.
    pub fn on_change(self, f: (var S, String) -> Null) -> Element<S> {
        var e = self.copy()
        e.change = [f]
        return e
    }

    /// Runs `f` on the state when Enter is pressed in an input.
    pub fn on_submit(self, f: (var S) -> Null) -> Element<S> {
        var e = self.copy()
        e.submit = [f]
        return e
    }

    /// Names the element among its siblings, so a redraw keeps its node, focus and scroll when the list reorders.
    pub fn key(self, id: String) -> Element<S> {
        var e = self.copy()
        e.id = id
        return e
    }

    /// Makes pressing or clicking the element act on the window, as the title bar of `pane.chrome` does.
    pub fn action(self, a: Action) -> Element<S> {
        var e = self.copy()
        e.act = a
        return e
    }

    /// Shows a PNG in an image element.
    pub fn source(self, png: Bytes) -> Element<S> {
        var e = self.copy()
        e.png = png
        return e
    }

    /// Changes the look with any `std.sys.gui` style method: `el.style(|s| s.opacity(0.5))`.
    pub fn style(self, f: (gui.Style) -> gui.Style) -> Element<S> {
        var e = self.copy()
        var edits: List<(gui.Style) -> gui.Style> = []
        for x in self.edits { edits.push(x) }
        edits.push(f)
        e.edits = edits
        return e
    }

    /// The same padding on every side, in pixels.
    pub fn pad(self, px: Float) -> Element<S> { return self.style(|s| s.padding(px)) }

    /// The space between children, in pixels.
    pub fn gap(self, px: Float) -> Element<S> { return self.style(|s| s.gap(px)) }

    /// The same margin on every side, in pixels.
    pub fn margin(self, px: Float) -> Element<S> { return self.style(|s| s.margin(px)) }

    /// The background, as `0xRRGGBBAA`; a pressable element's hover and pressed colors follow it.
    pub fn bg(self, color: Int) -> Element<S> {
        if self.is_pressable() {
            var e = self.copy()
            e.fill = color
            return e
        }
        return self.style(|s| s.background(color))
    }

    /// The text color, as `0xRRGGBBAA`.
    pub fn color(self, color: Int) -> Element<S> { return self.style(|s| s.color(color)) }

    /// The font size, in pixels.
    pub fn size(self, px: Float) -> Element<S> { return self.style(|s| s.font_size(px)) }

    pub fn bold(self) -> Element<S> { return self.style(|s| s.font_weight(700)) }

    pub fn radius(self, px: Float) -> Element<S> { return self.style(|s| s.radius(px)) }

    /// A width in pixels.
    pub fn width(self, px: Float) -> Element<S> { return self.style(|s| s.width(gui.Size.Px(px))) }

    /// A height in pixels.
    pub fn height(self, px: Float) -> Element<S> { return self.style(|s| s.height(gui.Size.Px(px))) }

    /// Takes the free space left in the parent, shared with other growing siblings.
    pub fn grow(self) -> Element<S> { return self.style(|s| s.grow(1.0)) }

    /// Centers the children, buttons included, or the text of a button.
    pub fn center(self) -> Element<S> {
        var e = self.style(|s| s.align_items(gui.Align.Center).justify(gui.Align.Center).text_align(gui.TextAlign.Center))
        var kids: List<Element<S>> = []
        for k in self.kids {
            if k.kind == gui.Kind.Button { kids.push(k.style(|s| s.align_self(gui.Align.Center))) } else { kids.push(k) }
        }
        e.kids = kids
        return e
    }

    fn is_pressable(self) -> Bool {
        match self.role {
            theme.Role.Button => { return true }
            theme.Role.Chosen => { return true }
            theme.Role.Item => { return true }
            theme.Role.Caption => { return true }
            theme.Role.CaptionClose => { return true }
            theme.Role.Dot(_) => { return true }
            _ => { return false }
        }
    }
}

/// An element of `kind` and `role` with no handlers; the components of pane build theirs with it.
pub fn element<S>(kind: gui.Kind, role: theme.Role, text: String, kids: List<Element<S>>) -> Element<S> {
    return Element { kind: kind, role: role, text: text, edits: [], fill: -1, id: "", png: Bytes(0), act: Action.Nothing, kids: kids, click: [], change: [], submit: [] }
}
