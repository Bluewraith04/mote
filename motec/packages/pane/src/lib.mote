/// pane — describe a window as a function of your state; the handlers change the state and the window follows.
///
/// A view builds an `Element` tree with `vstack`, `hstack`, `box`, `scroll`, `text`, `h1` to `h6`, `button` and `input`.
/// Modifiers (`pad`, `bg`, `on_click`, ...) answer a changed copy. `run` opens a window and calls the view again after every event,
/// then updates only the nodes that differ. Built on `std.sys.gui`, whose `Window` stays available through `mount`.
/// The core lives in `element`, `controls`, `layout`, `theme` and `app`; larger components are modules imported by name, as in `import pane.nav`.

pub import { Element } from .element
pub import { text, h1, h2, h3, h4, h5, h6, button, input } from .controls
pub import { vstack, hstack, box, scroll } from .layout
pub import { Theme } from .theme
pub import { Chrome } from .chrome
pub import { App, mount, mount_themed, mount_chrome, run, run_themed, run_chrome } from .app
