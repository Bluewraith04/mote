/// pane.layout — stacks, boxes and scrolling lists.

import std.sys.gui as gui
import .element
import .theme

/// Children one under the other.
pub fn vstack<S>(kids: List<element.Element<S>>) -> element.Element<S> {
    return element.element(gui.Kind.Box, theme.Role.Plain, "", kids).style(|s| s.direction(gui.Direction.Column).gap(8.0))
}

/// Children side by side, centered across.
pub fn hstack<S>(kids: List<element.Element<S>>) -> element.Element<S> {
    return element.element(gui.Kind.Box, theme.Role.Plain, "", kids).style(|s| s.direction(gui.Direction.Row).gap(8.0).align_items(gui.Align.Center))
}

/// A plain box that lays its children out in a row; restyle it with the modifiers.
pub fn box<S>(kids: List<element.Element<S>>) -> element.Element<S> {
    return element.element(gui.Kind.Box, theme.Role.Plain, "", kids)
}

/// Children one under the other that scroll when they do not fit; give it a `height`.
pub fn scroll<S>(kids: List<element.Element<S>>) -> element.Element<S> {
    return element.element(gui.Kind.Scroll, theme.Role.Plain, "", kids).style(|s| s.direction(gui.Direction.Column).gap(4.0))
}
