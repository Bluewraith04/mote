/// pane.pages — a bar of page numbers with previous and next.

import std.sys.gui as gui
import { min, max } from std.math
import .element
import .theme

fn step<S>(label: String, to: Int, live: Bool, on_pick: (var S, Int) -> Null) -> element.Element<S> {
    let b: element.Element<S> = element.element(gui.Kind.Button, theme.Role.Item, label, [])
    if live { return b.on_click(|var s| { on_pick(s, to) }) }
    return b.style(|s| s.opacity(0.4))
}

/// Pages `1` to `count` with `current` (counted from 0) highlighted, at most five around it, and `<` `>` either side; clicking page `i` runs `on_pick(state, i)`.
pub fn pages<S>(count: Int, current: Int, on_pick: (var S, Int) -> Null) -> element.Element<S> {
    var kids: List<element.Element<S>> = [step("<", current - 1, current > 0, on_pick)]
    let first = max(0, min(current - 2, count - 5))
    let last = min(count, first + 5)
    var i = first
    while i < last {
        let at = i
        var role = theme.Role.Item
        if at == current { role = theme.Role.Chosen }
        kids.push(element.element(gui.Kind.Button, role, "${at + 1}", []).on_click(|var s| { on_pick(s, at) }))
        i = i + 1
    }
    kids.push(step(">", current + 1, current < count - 1, on_pick))
    return element.element(gui.Kind.Box, theme.Role.Plain, "", kids).style(|s| s.direction(gui.Direction.Row).gap(4.0).align_items(gui.Align.Center))
}
