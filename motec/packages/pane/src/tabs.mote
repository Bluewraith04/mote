/// pane.tabs — a row of choices with one selected.

import std.sys.gui as gui
import .element
import .theme

/// One button per label side by side, the one at `selected` highlighted; clicking tab `i` runs `on_pick(state, i)`.
pub fn tabs<S>(labels: List<String>, selected: Int, on_pick: (var S, Int) -> Null) -> element.Element<S> {
    var kids: List<element.Element<S>> = []
    var i = 0
    while i < labels.len() {
        let at = i
        var role = theme.Role.Item
        if at == selected { role = theme.Role.Chosen }
        kids.push(element.element(gui.Kind.Button, role, labels.get(at), []).on_click(|var s| { on_pick(s, at) }))
        i = i + 1
    }
    return element.element(gui.Kind.Box, theme.Role.Plain, "", kids).style(|s| s.direction(gui.Direction.Row).gap(4.0))
}
