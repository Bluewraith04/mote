/// pane.shared — a view over a `Shared` cell that other tasks update.

import std.sys.gui as gui
import .element
import .theme
import .app

/// An app over `cell`: each draw shows the cell's current version and each handler is an update of it.
/// A task that updates the cell calls `win.post(n)` afterwards, which redraws the window.
pub fn mount_shared<S>(win: gui.Window, var cell: Shared<S>, view: (S) -> element.Element<S>) -> Result<app.App<S>, Error> {
    return mount_shared_themed(win, cell, view, theme.light())
}

/// As `mount_shared`, in the theme `th`.
pub fn mount_shared_themed<S>(win: gui.Window, var cell: Shared<S>, view: (S) -> element.Element<S>, th: theme.Theme) -> Result<app.App<S>, Error> {
    let own = cell.get().clone()
    return app.mount_source(win, own, view, th, || { return cell.get() }, |h| { cell.update(|v| { h(v) }) })
}
