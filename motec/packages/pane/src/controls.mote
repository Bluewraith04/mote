/// pane.controls — text, headings, buttons and inputs, styled by the window's theme.

import std.sys.gui as gui
import .element
import .theme

fn heading<S>(label: String, px: Float) -> element.Element<S> {
    return element.element(gui.Kind.Text, theme.Role.Heading(px), label, [])
}

/// A line of text.
pub fn text<S>(label: String) -> element.Element<S> {
    return element.element(gui.Kind.Text, theme.Role.Text, label, [])
}

pub fn h1<S>(label: String) -> element.Element<S> { return heading(label, 28.0) }

pub fn h2<S>(label: String) -> element.Element<S> { return heading(label, 24.0) }

pub fn h3<S>(label: String) -> element.Element<S> { return heading(label, 20.0) }

pub fn h4<S>(label: String) -> element.Element<S> { return heading(label, 18.0) }

pub fn h5<S>(label: String) -> element.Element<S> { return heading(label, 16.0) }

pub fn h6<S>(label: String) -> element.Element<S> { return heading(label, 14.0) }

/// A button; add `on_click` to say what it does.
pub fn button<S>(label: String) -> element.Element<S> {
    return element.element(gui.Kind.Button, theme.Role.Button, label, [])
}

/// A one-line text field showing `value`; add `on_change` to store what the user types.
pub fn input<S>(value: String) -> element.Element<S> {
    return element.element(gui.Kind.Input, theme.Role.Input, value, [])
}
