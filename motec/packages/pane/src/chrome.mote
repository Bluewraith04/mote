/// pane.chrome — the window's title bar, drawn by pane in place of the system frame, in three presets.

import std.sys.gui as gui
import .element
import .theme

/// Which frame a window has.
pub enum Frame {
    System
    Flat
    Windows
    Mac
}

/// The frame of a window: the system's own, or a title bar pane draws with the theme's colors.
pub class Chrome {
    pub var frame: Frame

    /// Whether pane draws the frame, which is when the system frame is turned off.
    pub fn drawn(self) -> Bool { return self.frame != Frame.System }
}

/// The frame the system draws; the default.
pub fn system() -> Chrome { return Chrome { frame: Frame.System } }

/// A slim bar with the title at the left and small rounded minimize, maximize and close buttons at the right.
pub fn flat() -> Chrome { return Chrome { frame: Frame.Flat } }

/// A bar with the title at the left and full-height minimize, maximize and close buttons at the right; close turns red under the pointer.
pub fn windows() -> Chrome { return Chrome { frame: Frame.Windows } }

/// A bar with three round close, minimize and maximize dots at the left and the title in the middle.
pub fn mac() -> Chrome { return Chrome { frame: Frame.Mac } }

fn caption<S>(label: String, role: theme.Role, act: element.Action) -> element.Element<S> {
    return element.element(gui.Kind.Button, role, label, []).action(act)
}

fn small<S>(label: String, act: element.Action) -> element.Element<S> {
    return caption(label, theme.Role.Caption, act).style(|s| s.width(gui.Size.Px(34.0)).height(gui.Size.Px(26.0)).radius(6.0).margin_sides(0.0, 4.0, 0.0, 0.0))
}

fn dot<S>(color: Int, act: element.Action) -> element.Element<S> {
    return element.element(gui.Kind.Button, theme.Role.Dot(color), "", []).action(act)
}

fn title_text<S>(title: String) -> element.Element<S> {
    return element.element(gui.Kind.Text, theme.Role.Text, title, []).size(14.0).bold()
}

fn bar<S>(ch: Chrome, title: String) -> element.Element<S> {
    var kids: List<element.Element<S>> = []
    match ch.frame {
        Frame.Mac => {
            kids.push(dot(0xff5f57ff, element.Action.Close).style(|s| s.margin_sides(0.0, 0.0, 0.0, 14.0)))
            kids.push(dot(0xfebc2eff, element.Action.Minimize).style(|s| s.margin_sides(0.0, 0.0, 0.0, 8.0)))
            kids.push(dot(0x28c840ff, element.Action.Maximize).style(|s| s.margin_sides(0.0, 0.0, 0.0, 8.0)))
            kids.push(title_text(title).grow().style(|s| s.text_align(gui.TextAlign.Center).margin_sides(0.0, 67.0, 0.0, 0.0)))
        }
        Frame.Flat => {
            kids.push(title_text(title).grow().style(|s| s.margin_sides(0.0, 0.0, 0.0, 14.0)))
            kids.push(small("\u{2013}", element.Action.Minimize))
            kids.push(small("\u{25a1}", element.Action.Maximize))
            kids.push(small("\u{00d7}", element.Action.Close))
        }
        _ => {
            kids.push(title_text(title).grow().style(|s| s.margin_sides(0.0, 0.0, 0.0, 14.0)))
            kids.push(caption("\u{2013}", theme.Role.Caption, element.Action.Minimize))
            kids.push(caption("\u{25a1}", theme.Role.Caption, element.Action.Maximize))
            kids.push(caption("\u{00d7}", theme.Role.CaptionClose, element.Action.Close))
        }
    }
    return element.element(gui.Kind.Box, theme.Role.Bar, "", kids).action(element.Action.Move)
}

/// An invisible strip on an edge or corner of the window that resizes it when pressed; `edge` counts as `gui.Edge`.
fn grip<S>(edge: Int, top: gui.Size, right: gui.Size, bottom: gui.Size, left: gui.Size, w: gui.Size, h: gui.Size) -> element.Element<S> {
    return element.element(gui.Kind.Box, theme.Role.Plain, "", []).action(element.Action.Resize(edge)).style(|s| s.position(gui.Position.Absolute).inset(top, right, bottom, left).width(w).height(h))
}

fn grips<S>() -> List<element.Element<S>> {
    let zero = gui.Size.Px(0.0)
    let auto = gui.Size.Auto
    let inner = gui.Size.Px(10.0)
    let thin = gui.Size.Px(5.0)
    return [
        grip(0, zero, inner, auto, inner, auto, thin),
        grip(1, auto, inner, zero, inner, auto, thin),
        grip(2, inner, zero, inner, auto, thin, auto),
        grip(3, inner, auto, inner, zero, thin, auto),
        grip(4, zero, zero, auto, auto, inner, inner),
        grip(5, zero, auto, auto, zero, inner, inner),
        grip(6, auto, zero, zero, auto, inner, inner),
        grip(7, auto, auto, zero, zero, inner, inner),
    ]
}

/// What the window's root holds for `content`: just the content for the system frame, else the bar, the content padded under it, and the edge grips.
pub fn frame<S>(ch: Chrome, title: String, content: element.Element<S>) -> List<element.Element<S>> {
    if !ch.drawn() { return [content] }
    let body: element.Element<S> = element.element(gui.Kind.Box, theme.Role.Plain, "", [content]).style(|s| s.direction(gui.Direction.Column).padding(16.0).grow(1.0))
    var out: List<element.Element<S>> = [bar(ch, title), body]
    for g in grips() { out.push(g) }
    return out
}
