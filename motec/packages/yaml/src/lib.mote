/// yaml — YAML read into and written from `Json`, over a Rust library the package carries.

import std.data.json as json
import { Json } from std.data.json
import { open_package, bind } from std.dev.libtools

fn text_of(b: Bytes) -> String {
    match b.decode() {
        Some(s) => { return s }
        None => { return "" }
    }
}

fn fail(out: Bytes, n: Int) -> Error {
    var shown = 0 - n
    if shown > out.len() { shown = out.len() }
    return Error.new(ErrorKind.InvalidData, text_of(out.slice(0, shown)))
}

/// Parses `text`; `all` asks for a list of every document.
fn read(text: String, all: Int) -> Result<String, Error> {
    let lib = open_package("yaml", "mote_yaml")?
    let f = bind<(Bytes, Int, Bytes, Int, Int) -> Int>(lib, "mote_yaml_parse")?
    let bytes = text.bytes()
    var out = Bytes(bytes.len() * 3 + 256)
    var n = f(bytes, bytes.len(), out, out.len(), all)
    if n > out.len() {
        out = Bytes(n)
        n = f(bytes, bytes.len(), out, out.len(), all)
    }
    if n < 0 { return Err(fail(out, n)) }
    return Ok(text_of(out.slice(0, n)))
}

fn write(as_json: String) -> Result<String, Error> {
    let lib = open_package("yaml", "mote_yaml")?
    let f = bind<(Bytes, Int, Bytes, Int) -> Int>(lib, "mote_yaml_render")?
    let bytes = as_json.bytes()
    var out = Bytes(bytes.len() * 2 + 256)
    var n = f(bytes, bytes.len(), out, out.len())
    if n > out.len() {
        out = Bytes(n)
        n = f(bytes, bytes.len(), out, out.len())
    }
    if n < 0 { return Err(fail(out, n)) }
    return Ok(text_of(out.slice(0, n)))
}

/// The one document in `text` (an empty text is `Null`); more than one is an `Err`.
pub fn parse(text: String) -> Result<Json, Error> {
    let as_json = read(text, 0)?
    return json.parse(as_json)
}

/// Every document in `text`, in order.
pub fn parse_all(text: String) -> Result<List<Json>, Error> {
    let as_json = read(text, 1)?
    let docs = json.parse(as_json)?
    match docs {
        Json.Array(items) => { return Ok(items) }
        _ => { return Err(Error.new(ErrorKind.InvalidData, "expected a list of documents")) }
    }
}

/// `j` as a YAML document.
pub fn to_text(j: Json) -> Result<String, Error> {
    let as_json = json.to_text(j)?
    return write(as_json)
}
