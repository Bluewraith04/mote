/// compress — gzip, zlib and raw deflate over a Rust library the package carries.
///
/// Each `*_level` form takes 0 (store) to 9 (smallest); a level outside that range is clamped. Decompressing stops with an `Err` past 1 GiB.
/// The compressing functions fault when the library cannot be opened: the package needs `native = true` in `mote.toml`.

import { open_package, bind } from std.dev.libtools

fn text_of(b: Bytes) -> String {
    match b.decode() {
        Some(s) => { return s }
        None => { return "" }
    }
}

fn fail(out: Bytes, n: Int) -> Error {
    var shown = 0 - n
    if shown > out.len() { shown = out.len() }
    return Error.new(ErrorKind.InvalidData, text_of(out.slice(0, shown)))
}

fn pack(b: Bytes, mode: Int, level: Int) -> Result<Bytes, Error> {
    let lib = open_package("compress", "mote_compress")?
    let f = bind<(Bytes, Int, Bytes, Int, Int, Int) -> Int>(lib, "mote_compress")?
    var out = Bytes(b.len() + b.len() / 8 + 256)
    var n = f(b, b.len(), out, out.len(), mode, level)
    if n > out.len() {
        out = Bytes(n)
        n = f(b, b.len(), out, out.len(), mode, level)
    }
    if n < 0 { return Err(fail(out, n)) }
    return Ok(out.slice(0, n))
}

fn unpack(b: Bytes, mode: Int) -> Result<Bytes, Error> {
    let lib = open_package("compress", "mote_compress")?
    let f = bind<(Bytes, Int, Bytes, Int, Int) -> Int>(lib, "mote_decompress")?
    var out = Bytes(b.len() * 4 + 256)
    var n = f(b, b.len(), out, out.len(), mode)
    if n > out.len() {
        out = Bytes(n)
        n = f(b, b.len(), out, out.len(), mode)
    }
    if n < 0 { return Err(fail(out, n)) }
    return Ok(out.slice(0, n))
}

/// gzip at level 6.
pub fn gzip(b: Bytes) -> Bytes {
    return pack(b, 0, 6).unwrap()
}

pub fn gzip_level(b: Bytes, level: Int) -> Bytes {
    return pack(b, 0, level).unwrap()
}

/// The bytes inside gzip data.
pub fn gunzip(b: Bytes) -> Result<Bytes, Error> {
    return unpack(b, 0)
}

/// zlib at level 6.
pub fn zlib(b: Bytes) -> Bytes {
    return pack(b, 1, 6).unwrap()
}

pub fn zlib_level(b: Bytes, level: Int) -> Bytes {
    return pack(b, 1, level).unwrap()
}

/// The bytes inside zlib data.
pub fn unzlib(b: Bytes) -> Result<Bytes, Error> {
    return unpack(b, 1)
}

/// Raw deflate (no header) at level 6.
pub fn deflate(b: Bytes) -> Bytes {
    return pack(b, 2, 6).unwrap()
}

pub fn deflate_level(b: Bytes, level: Int) -> Bytes {
    return pack(b, 2, level).unwrap()
}

/// The bytes inside raw deflate data.
pub fn inflate(b: Bytes) -> Result<Bytes, Error> {
    return unpack(b, 2)
}
