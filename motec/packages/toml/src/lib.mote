/// toml — TOML read into and written from `Json`, over a Rust library the package carries.

import std.data.json as json
import { Json } from std.data.json
import { open_package, bind } from std.dev.libtools

fn text_of(b: Bytes) -> String {
    match b.decode() {
        Some(s) => { return s }
        None => { return "" }
    }
}

/// Calls the library function `name` on `input`, calling again with a larger buffer when the answer did not fit.
fn run(name: String, input: String) -> Result<String, Error> {
    let lib = open_package("toml", "mote_toml")?
    let f = bind<(Bytes, Int, Bytes, Int) -> Int>(lib, name)?
    let bytes = input.bytes()
    var out = Bytes(bytes.len() * 2 + 256)
    var n = f(bytes, bytes.len(), out, out.len())
    if n > out.len() {
        out = Bytes(n)
        n = f(bytes, bytes.len(), out, out.len())
    }
    if n < 0 {
        var shown = 0 - n
        if shown > out.len() { shown = out.len() }
        return Err(Error.new(ErrorKind.InvalidData, text_of(out.slice(0, shown))))
    }
    return Ok(text_of(out.slice(0, n)))
}

/// Parses a TOML document into a `Json` `Object`; an `Err` names the line and column.
pub fn parse(text: String) -> Result<Json, Error> {
    let as_json = run("mote_toml_parse", text)?
    return json.parse(as_json)
}

/// Prints a `Json` `Object` as a TOML document; anything else, or a `Null` anywhere, is an `Err`.
pub fn to_text(j: Json) -> Result<String, Error> {
    let as_json = json.to_text(j)?
    return run("mote_toml_render", as_json)
}
