/// http — an HTTP client over a Rust library the package carries (the `ureq` crate).
///
/// HTTPS, redirects and gzip are handled underneath. Any status is an answer (`Ok(Response)`); only a failure to
/// get one (DNS, refused, timeout, too many redirects, a body past the limit) is an `Err`.

import std.data.json as jsonlib
import std.string as strings
import { Json } from std.data.json
import { open_package, bind, bind_blocking } from std.dev.libtools

/// A finished exchange.
pub class Response {
    pub status: Int
    pub url: String
    pub body: Bytes
    headers: List<String>

    /// Whether the status is 200 to 299.
    pub fn ok(self) -> Bool { return self.status >= 200 && self.status < 300 }

    /// The first header called `name` (any case), if there is one.
    pub fn header(self, name: String) -> Option<String> {
        let want = name.to_lower()
        var i = 0
        while i < self.headers.len() {
            let have: String = self.headers.get(i)
            if have == want {
                let value: String = self.headers.get(i + 1)
                return Some(value)
            }
            i = i + 2
        }
        return None
    }

    /// Every header by lowercase name; a repeated header's values are joined with `, `.
    pub fn header_map(self) -> Map<String, String> {
        var out: Map<String, String> = Map()
        var i = 0
        while i < self.headers.len() {
            let name: String = self.headers.get(i)
            let value: String = self.headers.get(i + 1)
            if out.contains_key(name) {
                let before: String = out[name]
                out[name] = before + ", " + value
            } else {
                out[name] = value
            }
            i = i + 2
        }
        return out
    }

    /// The body as text; an `Err` if it is not UTF-8.
    pub fn text(self) -> Result<String, Error> {
        match self.body.decode() {
            Some(t) => { return Ok(t) }
            None => { return Err(Error.new(ErrorKind.InvalidData, "the response body is not UTF-8")) }
        }
    }

    /// The body parsed as JSON.
    pub fn json(self) -> Result<Json, Error> {
        let t = self.text()?
        return jsonlib.parse(t)
    }

    /// This response when the status is 2xx, else an `Err` naming the status.
    pub fn error_for_status(self) -> Result<Response, Error> {
        if self.ok() { return Ok(self) }
        var kind = ErrorKind.Other
        if self.status == 404 { kind = ErrorKind.NotFound }
        if self.status == 401 || self.status == 403 { kind = ErrorKind.PermissionDenied }
        return Err(Error.new(kind, "HTTP ${self.status} for ${self.url}"))
    }
}

fn text_of(b: Bytes) -> String {
    match b.decode() {
        Some(s) => { return s }
        None => { return "" }
    }
}

fn kind_of(name: String) -> ErrorKind {
    if name == "NotFound" { return ErrorKind.NotFound }
    if name == "PermissionDenied" { return ErrorKind.PermissionDenied }
    if name == "InvalidData" { return ErrorKind.InvalidData }
    if name == "TimedOut" { return ErrorKind.TimedOut }
    return ErrorKind.Other
}

/// The library's `<kind> <message>` answer as an `Err`.
fn fail(out: Bytes, n: Int) -> Error {
    var shown = 0 - n
    if shown > out.len() { shown = out.len() }
    let text = text_of(out.slice(0, shown))
    match text.find(" ") {
        Some(at) => { return Error.new(kind_of(text.slice(0, at)), text.slice(at + 1, text.len())) }
        None => { return Error.new(ErrorKind.Other, text) }
    }
}

/// A reader over the library's answer.
class Cursor {
    b: Bytes
    var at: Int

    /// An Int ending at a space or newline, which it passes.
    fn number(var self) -> Int {
        var n = 0
        while self.b[self.at] != 10 && self.b[self.at] != 32 {
            n = n * 10 + (self.b[self.at] - 48)
            self.at = self.at + 1
        }
        self.at = self.at + 1
        return n
    }

    /// The text of a `<len>\n<bytes>` frame.
    fn text(var self) -> String {
        let n = self.number()
        let out = text_of(self.b.slice(self.at, self.at + n))
        self.at = self.at + n
        return out
    }

    fn rest(self) -> Bytes { return self.b.slice(self.at, self.b.len()) }
}

fn frame(var out: Bytes, data: Bytes) {
    out.extend((data.len().to_string() + "\n").bytes())
    out.extend(data)
}

fn with_header(items: List<String>, name: String, value: String) -> List<String> {
    let lower = name.to_lower()
    var out: List<String> = []
    var i = 0
    while i < items.len() {
        let have: String = items.get(i)
        if have.to_lower() != lower {
            out.push(have)
            let kept: String = items.get(i + 1)
            out.push(kept)
        }
        i = i + 2
    }
    out.push(lower)
    out.push(value)
    return out
}

/// A request being built; each method answers a changed copy, and `send()` makes the call.
pub class Request {
    method: String
    url: String
    headers: List<String>
    payload: Bytes
    seconds: Int
    redirects: Int
    limit: Int
    failure: String

    fn changed(self, headers: List<String>, payload: Bytes, failure: String) -> Request {
        return Request {
            method: self.method, url: self.url, headers: headers, payload: payload,
            seconds: self.seconds, redirects: self.redirects, limit: self.limit, failure: failure,
        }
    }

    /// Sets a header, replacing one of the same name.
    pub fn header(self, name: String, value: String) -> Request {
        return self.changed(with_header(self.headers, name, value), self.payload, self.failure)
    }

    /// The body as given bytes.
    pub fn body(self, data: Bytes) -> Request {
        return self.changed(self.headers, data, self.failure)
    }

    /// The body as UTF-8 text, with a text content type unless one is set.
    pub fn text(self, content: String) -> Request {
        return self.changed(with_header(self.headers, "content-type", "text/plain; charset=utf-8"), content.bytes(), self.failure)
    }

    /// The body as JSON text, with a JSON content type. A value with no JSON text (`NaN`) makes `send()` an `Err`.
    pub fn json(self, value: Json) -> Request {
        match jsonlib.to_text(value) {
            Ok(t) => { return self.changed(with_header(self.headers, "content-type", "application/json"), t.bytes(), self.failure) }
            Err(e) => { return self.changed(self.headers, self.payload, e.message) }
        }
    }

    /// The body as a form (`a=1&b=2`, percent-encoded).
    pub fn form(self, fields: Map<String, String>) -> Request {
        let encoded = query(fields)
        return self.changed(with_header(self.headers, "content-type", "application/x-www-form-urlencoded"), encoded.bytes(), self.failure)
    }

    /// Gives up after `seconds` in total (30 by default).
    pub fn timeout(self, seconds: Int) -> Request {
        return Request {
            method: self.method, url: self.url, headers: self.headers, payload: self.payload,
            seconds: seconds, redirects: self.redirects, limit: self.limit, failure: self.failure,
        }
    }

    /// Follows at most `n` redirects (10 by default); more is an `Err`, and 0 answers the redirect itself.
    pub fn max_redirects(self, n: Int) -> Request {
        return Request {
            method: self.method, url: self.url, headers: self.headers, payload: self.payload,
            seconds: self.seconds, redirects: n, limit: self.limit, failure: self.failure,
        }
    }

    /// Reads at most `bytes` of response body (64 MiB by default); more is an `Err`.
    pub fn max_body(self, bytes: Int) -> Request {
        return Request {
            method: self.method, url: self.url, headers: self.headers, payload: self.payload,
            seconds: self.seconds, redirects: self.redirects, limit: bytes, failure: self.failure,
        }
    }

    /// Makes the call and waits for the answer.
    pub fn send(self) -> Result<Response, Error> {
        if self.failure != "" { return Err(Error.new(ErrorKind.InvalidData, self.failure)) }
        var input = Bytes()
        var headers: List<String> = []
        input.extend((self.seconds * 1000).to_string().bytes())
        input.extend((" " + self.redirects.to_string() + " " + self.limit.to_string() + " " + (self.headers.len() / 2).to_string() + "\n").bytes())
        frame(input, self.method.bytes())
        frame(input, self.url.bytes())
        for h in self.headers { frame(input, h.bytes()) }
        frame(input, self.payload)
        let lib = open_package("http", "mote_http")?
        let send = bind_blocking<(Bytes, Int, Bytes, Int) -> Int>(lib, "mote_http_request")?
        let take = bind<(Int, Bytes, Int) -> Int>(lib, "mote_http_take")?
        let small = Bytes(4096)
        let n = send(input, input.len(), small, small.len())
        if n < 0 { return Err(fail(small, n)) }
        let head = Cursor { b: small.slice(0, n), at: 0 }
        let ticket = head.number()
        let size = head.number()
        let out = Bytes(size)
        let m = take(ticket, out, size)
        if m < 0 { return Err(fail(out, m)) }
        let c = Cursor { b: out, at: 0 }
        let status = c.number()
        let count = c.number()
        var i = 0
        while i < count * 2 {
            headers.push(c.text())
            i = i + 1
        }
        return Ok(Response { status: status, url: self.url, body: c.rest(), headers: headers })
    }
}

/// A request for `method` (`"GET"`, `"PUT"`,...) and `url`.
pub fn request(method: String, url: String) -> Request {
    let none: List<String> = []
    return Request { method: method.to_upper(), url: url, headers: none, payload: Bytes(), seconds: 30, redirects: 10, limit: 67108864, failure: "" }
}

fn hex(n: Int) -> String {
    return "0123456789ABCDEF".slice(n, n + 1)
}

/// `s` percent-encoded for a form: letters, digits and `*-._` stay, a space is `+`, any other byte is `%XX`.
fn encode(s: String) -> String {
    var out = ""
    let data = s.bytes()
    var i = 0
    while i < data.len() {
        let b = data[i]
        let plain = (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 42 || b == 45 || b == 46 || b == 95
        if plain {
            out = out + s.slice(i, i + 1)
        } else if b == 32 {
            out = out + "+"
        } else {
            out = out + "%" + hex(b / 16) + hex(b % 16)
        }
        i = i + 1
    }
    return out
}

/// `a=1&b=2` with names and values percent-encoded (a space is `+`), in the map's order: a query string or form body.
pub fn query(params: Map<String, String>) -> String {
    var parts: List<String> = []
    for k in params.keys() {
        parts.push(encode(k) + "=" + encode(params[k]))
    }
    return strings.join(parts, "&")
}

pub fn get(url: String) -> Result<Response, Error> { return request("GET", url).send() }

pub fn head(url: String) -> Result<Response, Error> { return request("HEAD", url).send() }

pub fn delete(url: String) -> Result<Response, Error> { return request("DELETE", url).send() }

pub fn post(url: String, body: Bytes) -> Result<Response, Error> { return request("POST", url).body(body).send() }

pub fn put(url: String, body: Bytes) -> Result<Response, Error> { return request("PUT", url).body(body).send() }

pub fn patch(url: String, body: Bytes) -> Result<Response, Error> { return request("PATCH", url).body(body).send() }

/// POST `value` as JSON.
pub fn post_json(url: String, value: Json) -> Result<Response, Error> { return request("POST", url).json(value).send() }

/// POST `fields` as a form.
pub fn post_form(url: String, fields: Map<String, String>) -> Result<Response, Error> { return request("POST", url).form(fields).send() }
