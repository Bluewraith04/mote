// describe: kinds, names, fields, variants, methods, attributes and docs of the types a program writes.
import { assert, assert_eq } from std.test
import { describe, Kind, Shape } from std.meta

/// A point on the plane.
struct Point {
    pub var x: Int
    y: Int = 0
}

class Counter {
    var count: Int

    pub fn bump(var self) { self.count += 1 }
    fn peek(self) -> Int { return self.count }
}

enum Shapely {
    /// Nothing.
    Empty
    Circle(Float)
    Rect { width: Float, height: Float }
}

enum Level {
    Low = 1
    High = 5
}

struct Pair<A, B> {
    first: A
    second: B
}

class Node {
    var value: Int
    var next: Node?
}

fn name_of<T>() -> String {
    return describe<T>().name()
}

test "the built in types have their kind and name" {
    assert(describe<Int>().kind() == Kind.Int, "Int")
    assert_eq(describe<Int>().name(), "Int")
    assert(describe<String>().kind() == Kind.String, "String")
    assert(describe<Bool>().kind() == Kind.Bool, "Bool")
    assert(describe<Float>().kind() == Kind.Float, "Float")
    assert(describe<List<Int>>().kind() == Kind.List, "List")
    assert_eq(describe<List<Int>>().name(), "List<Int>")
    assert(describe<Int?>().kind() == Kind.Optional, "Optional")
    assert(describe<(Int, String)>().kind() == Kind.Tuple, "Tuple")
    assert(describe<Int | String>().kind() == Kind.Union, "Union")
}

test "a container names the types it holds" {
    let args = describe<List<String>>().args()
    assert_eq(args.len(), 1)
    assert_eq(args[0].name(), "String")
    let tuple = describe<(Int, Bool)>().args()
    assert_eq(tuple.len(), 2)
    assert(tuple[1].kind() == Kind.Bool, "second member")
    let optional = describe<Int?>().args()
    assert(optional[0].kind() == Kind.Int, "inner")
}

test "a struct lists its fields in order" {
    let point = describe<Point>()
    assert(point.kind() == Kind.Struct, "Struct")
    assert_eq(point.short_name(), "Point")
    let fields = point.fields()
    assert_eq(fields.len(), 2)
    assert_eq(fields[0].name, "x")
    assert(fields[0].ty.kind() == Kind.Int, "x is Int")
    assert(fields[0].is_var, "x is var")
    assert(fields[0].is_pub, "x is pub")
    assert(!fields[0].has_default, "x has no default")
    assert_eq(fields[1].name, "y")
    assert(!fields[1].is_var, "y is not var")
    assert(!fields[1].is_pub, "y is not pub")
    assert(fields[1].has_default, "y has a default")
}

test "a class is a class" {
    let counter = describe<Counter>()
    assert(counter.kind() == Kind.Class, "Class")
    assert_eq(counter.fields().len(), 1)
}

test "methods carry their name, visibility and receiver" {
    let methods = describe<Counter>().methods()
    assert_eq(methods.len(), 2)
    assert_eq(methods[0].name, "bump")
    assert(methods[0].is_pub, "bump is pub")
    assert(methods[0].has_self, "bump has self")
    assert(methods[0].writes_self, "bump writes self")
    assert_eq(methods[1].name, "peek")
    assert(!methods[1].is_pub, "peek is private")
    assert(!methods[1].writes_self, "peek reads self")
}

test "an enum lists its variants with their shape" {
    let variants = describe<Shapely>().variants()
    assert(describe<Shapely>().kind() == Kind.Enum, "Enum")
    assert_eq(variants.len(), 3)
    assert_eq(variants[0].name, "Empty")
    assert(variants[0].shape == Shape.Unit, "Empty is unit")
    assert_eq(variants[0].doc, "Nothing.")
    assert(variants[1].shape == Shape.Tuple, "Circle is a tuple")
    assert_eq(variants[1].fields.len(), 1)
    assert(variants[1].fields[0].ty.kind() == Kind.Float, "Circle holds a Float")
    assert(variants[2].shape == Shape.Named, "Rect is named")
    assert_eq(variants[2].fields[1].name, "height")
}

test "a variant with a value reports it" {
    let variants = describe<Level>().variants()
    assert_eq(variants[0].discriminant!, 1)
    assert_eq(variants[1].discriminant!, 5)
    assert(describe<Shapely>().variants()[0].discriminant == null, "no value")
}

test "a doc is the lines written before the type" {
    assert_eq(describe<Point>().doc(), "A point on the plane.")
    assert_eq(describe<Counter>().doc(), "")
}

test "attributes name what was written" {
    let attributes = describe<List<Int>>().attributes()
    assert_eq(attributes.len(), 1)
    assert_eq(attributes[0].name, "lang")
    assert_eq(attributes[0].args[0].value, "list")
    assert_eq(describe<Point>().attributes().len(), 0)
}

test "a generic type is described at the arguments it is used with" {
    let pair = describe<Pair<Int, String>>()
    assert_eq(pair.short_name(), "Pair")
    assert(pair.name().ends_with("Pair<Int, String>"), "the name holds the arguments")
    let generics = pair.generics()
    assert_eq(generics.len(), 2)
    assert_eq(generics[0], "A")
    assert_eq(generics[1], "B")
    assert(pair.args()[1].kind() == Kind.String, "second argument")
    assert(pair.fields()[1].ty.kind() == Kind.String, "second field")
}

test "a generic function describes the type it was called with" {
    assert_eq(name_of<Int>(), "Int")
    assert_eq(name_of<List<String>>(), "List<String>")
    assert(name_of<Point>().ends_with("Point"), "a struct is named by its path")
}

test "a type that holds itself is described once" {
    let node = describe<Node>()
    let next = node.fields()[1].ty
    assert(next.kind() == Kind.Optional, "next is optional")
    assert_eq(next.args()[0].short_name(), "Node")
    assert(next.args()[0].fields().len() == 2, "the inner Node has the same fields")
}

test "a type lists no traits it does not declare" {
    assert_eq(describe<Point>().traits().len(), 0)
}
