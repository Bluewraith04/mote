// String methods and std.string.
import { assert, assert_eq } from std.test
import { join, lines, is_blank, pad_start, parse_int, parse_float } from std.string

test "length counts bytes" {
    assert_eq("".len(), 0)
    assert_eq("abc".len(), 3)
    assert_eq("é".len(), 2)
    assert("".is_empty(), "empty")
    assert(!"a".is_empty(), "not empty")
}

test "concat and plus join text" {
    assert_eq("ab".concat("cd"), "abcd")
    assert_eq("ab" + "cd", "abcd")
    let n = 7
    assert_eq("n=${n}", "n=7")
}

test "slice takes a byte range" {
    assert_eq("hello".slice(1, 3), "el")
    assert_eq("hello".slice(0, 5), "hello")
    assert_eq("hello".slice(2, 2), "")
}

test "case and trim" {
    assert_eq("Hello".to_upper(), "HELLO")
    assert_eq("Hello".to_lower(), "hello")
    assert_eq("  a b \n".trim(), "a b")
}

test "repeat and replace" {
    assert_eq("ab".repeat(3), "ababab")
    assert_eq("ab".repeat(0), "")
    assert_eq("a-b-c".replace("-", "+"), "a+b+c")
    assert_eq("abc".replace("x", "y"), "abc")
}

test "find, contains, starts_with and ends_with" {
    assert_eq("hello".find("l")!, 2)
    assert_eq("hello".rfind("l")!, 3)
    assert("hello".find("z") == null, "no z")
    assert("hello".contains("ell"), "contains")
    assert(!"hello".contains("xyz"), "does not contain")
    assert("hello".starts_with("he"), "starts")
    assert(!"hello".starts_with("lo"), "does not start")
    assert("hello".ends_with("lo"), "ends")
    assert(!"hello".ends_with("he"), "does not end")
    assert("hello".ends_with(""), "ends with nothing")
}

test "split cuts at every separator" {
    assert("a,b,c".split(",") == ["a", "b", "c"], "three parts")
    assert("abc".split(",") == ["abc"], "no separator")
    assert("a,,b".split(",") == ["a", "", "b"], "an empty part")
    assert("".split(",") == [""], "empty text")
}

test "comparison is by bytes" {
    assert("apple" < "banana", "less")
    assert("b" > "a", "greater")
    assert_eq("a".compare("b"), -1)
    assert_eq("b".compare("b"), 0)
    assert_eq("c".compare("b"), 1)
    assert("a" == "a", "equal")
}

test "bytes gives the UTF-8 bytes" {
    let bytes = "aé".bytes()
    assert_eq(bytes.len(), 3)
    assert_eq(bytes[0] as Int, 97)
    assert_eq(bytes[1] as Int, 195)
}

test "join puts the separator between parts" {
    assert_eq(join(["a", "b", "c"], ", "), "a, b, c")
    assert_eq(join([], ", "), "")
    assert_eq(join(["only"], ", "), "only")
}

test "lines splits on newlines and drops carriage returns" {
    assert(lines("a\nb\r\nc") == ["a", "b", "c"], "three lines")
    assert(lines("one") == ["one"], "one line")
}

test "is_blank and pad_start" {
    assert(is_blank("  \n"), "blank")
    assert(!is_blank(" x "), "not blank")
    assert_eq(pad_start("7", 3, "0"), "007")
    assert_eq(pad_start("1234", 3, "0"), "1234")
}

test "parse_int and parse_float read numbers" {
    assert_eq(parse_int("42").unwrap(), 42)
    assert_eq(parse_int("-7").unwrap(), -7)
    assert(parse_int("4x").is_err(), "not an integer")
    assert(parse_int("").is_err(), "empty")
    assert_eq(parse_float("2.5").unwrap(), 2.5)
    assert(parse_float("abc").is_err(), "not a number")
}

test "a parse error says what was wrong" {
    match parse_int("zz") {
        Ok(_) => assert(false, "parsed")
        Err(e) => assert_eq(e.message, "not an integer: zz")
    }
}
