// Assertions for test blocks; a failure is a fault.
import { fault } from std.option
import std.traits as traits

pub fn assert(condition: Bool, message: String = "assertion failed") {
    if !condition { fault<Null>(message) }
}

pub fn fail(message: String) {
    fault<Null>(message)
}

pub fn assert_eq<T: traits.Eq + traits.Display>(left: T, right: T) {
    if !(left == right) { fault<Null>("assert_eq failed: ${left} != ${right}") }
}

pub fn assert_ne<T: traits.Eq + traits.Display>(left: T, right: T) {
    if left == right { fault<Null>("assert_ne failed: ${left} == ${right}") }
}
