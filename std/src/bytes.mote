// A growable buffer of bytes.

pub class Bytes {
    var items: List<UInt8>

    pub fn new() -> Bytes { return Bytes { items: [] } }
    pub fn from_array(bytes: [UInt8]) -> Bytes { return Bytes { items: bytes.to_list() } }
    pub fn from_string(text: String) -> Bytes { return Bytes { items: text.bytes().to_list() } }
    pub fn len(self) -> Int { return self.items.len() }
    pub fn is_empty(self) -> Bool { return self.items.is_empty() }
    pub fn get(self, index: Int) -> UInt8 { return self.items.get(index) }
    pub fn set(var self, index: Int, value: UInt8) { self.items.set(index, value) }
    pub fn push(var self, value: UInt8) { self.items.push(value) }
    pub fn pop(var self) -> UInt8? { return self.items.pop() }
    pub fn extend(var self, bytes: [UInt8]) {
        var i = 0
        while i < bytes.len() {
            self.items.push(bytes.get(i))
            i += 1
        }
    }
    pub fn append(var self, other: Bytes) { self.extend(other.to_array()) }
    pub fn clear(var self) { self.items.clear() }
    pub fn slice(self, start: Int, end: Int) -> Bytes { return Bytes { items: self.items.slice(start, end) } }
    pub fn clone(self) -> Bytes { return Bytes { items: self.items.clone() } }
    pub fn to_array(self) -> [UInt8] { return self.items.to_array() }
    pub fn to_string(self) -> String? { return String.from_bytes(self.to_array()) }
}
