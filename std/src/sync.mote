// Channels, Mutex and Once; the handle calls are intrinsics, the rest is Mote.
import { Stream } from std.collections

@intrinsic("channel_new")
native fn channel_new<T>(buffer: Int) -> (Sender<T>, Receiver<T>)
@intrinsic("sender_send")
native fn sender_send<T>(tx: Sender<T>, value: T)
@intrinsic("sender_try_send")
native fn sender_try_send<T>(tx: Sender<T>, value: T) -> Bool
@intrinsic("sender_close")
native fn sender_close<T>(tx: Sender<T>)
@intrinsic("sender_clone")
native fn sender_clone<T>(tx: Sender<T>) -> Sender<T>
@intrinsic("receiver_recv")
native fn receiver_recv<T>(rx: Receiver<T>) -> T?
@intrinsic("receiver_recv_timeout")
native fn receiver_recv_timeout<T>(rx: Receiver<T>, ms: Int) -> T?
@intrinsic("receiver_try_recv")
native fn receiver_try_recv<T>(rx: Receiver<T>) -> T?
@intrinsic("receiver_is_closed")
native fn receiver_is_closed<T>(rx: Receiver<T>) -> Bool
@intrinsic("receiver_close")
native fn receiver_close<T>(rx: Receiver<T>)
@intrinsic("receiver_clone")
native fn receiver_clone<T>(rx: Receiver<T>) -> Receiver<T>

pub struct Channel<T> {
    pub fn new(buffer: Int) -> (Sender<T>, Receiver<T>) { return channel_new(buffer) }
}

@lang("sender")
pub class Sender<T> {
    pub fn send(self, value: T) { sender_send(self, value) }
    pub fn try_send(self, value: T) -> Bool { return sender_try_send(self, value) }
    pub fn close(self) { sender_close(self) }
    pub fn clone(self) -> Sender<T> { return sender_clone(self) }
}

@lang("receiver")
pub class Receiver<T> {
    pub fn recv(self) -> T? { return receiver_recv(self) }
    pub fn recv_timeout(self, ms: Int) -> T? { return receiver_recv_timeout(self, ms) }
    pub fn try_recv(self) -> T? { return receiver_try_recv(self) }
    pub fn is_closed(self) -> Bool { return receiver_is_closed(self) }
    pub fn close(self) { receiver_close(self) }
    pub fn clone(self) -> Receiver<T> { return receiver_clone(self) }
    pub fn stream(self) -> Stream<T> {
        while true {
            let item = receiver_recv(self)
            if item == null { return }
            yield item
        }
    }
}

@intrinsic("deep_clone")
native fn deep_copy<T>(value: T) -> T
@intrinsic("mutex_new")
native fn mutex_new<T>(value: T) -> Mutex<T>
@intrinsic("mutex_take")
native fn mutex_take<T>(lock: Mutex<T>) -> T
@intrinsic("mutex_put")
native fn mutex_put<T>(lock: Mutex<T>, value: T)
@intrinsic("once_new")
native fn once_new<T>() -> Once<T>
@intrinsic("once_begin")
native fn once_begin<T>(cell: Once<T>) -> Bool
@intrinsic("once_finish")
native fn once_finish<T>(cell: Once<T>, value: T)
@intrinsic("once_value")
native fn once_value<T>(cell: Once<T>) -> T

@lang("mutex")
pub class Mutex<T> {
    pub fn new(value: T) -> Mutex<T> { return mutex_new(deep_copy(value)) }
    pub fn lock<R>(self, work: Send (var T) -> R) -> R {
        var value = mutex_take(self)
        let result = work(value)
        mutex_put(self, value)
        return deep_copy(result)
    }
    pub fn get(self) -> T {
        let value = mutex_take(self)
        let copy = deep_copy(value)
        mutex_put(self, value)
        return copy
    }
    pub fn set(self, value: T) {
        let owned = deep_copy(value)
        mutex_take(self)
        mutex_put(self, owned)
    }
}

@lang("once")
pub class Once<T> {
    pub fn new() -> Once<T> { return once_new() }
    pub fn get_or_init(self, init: Send () -> T) -> T {
        if once_begin(self) { once_finish(self, init()) }
        return once_value(self)
    }
}

pub fn merge<T>(rxs: List<Receiver<T>>) -> Receiver<T> {
    let (tx, out) = Channel<T>(0)
    for rx in rxs {
        let mine = tx.clone()
        spawn {
            for item in rx { mine.send(item) }
        }
    }
    tx.close()
    return out
}

pub fn broadcast<T>(rx: Receiver<T>, n: Int) -> List<Receiver<T>> {
    var outs: List<Receiver<T>> = []
    var source = rx
    var i = 0
    while i < n {
        let (next_tx, next_rx) = Channel<T>(0)
        let (out_tx, out_rx) = Channel<T>(0)
        let input = source
        spawn {
            for item in input {
                out_tx.send(item)
                next_tx.send(item)
            }
        }
        outs.push(out_rx)
        source = next_rx
        i += 1
    }
    let rest = source
    spawn {
        for item in rest {}
    }
    return outs
}
