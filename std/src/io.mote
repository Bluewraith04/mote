// Printing, standard input, the program's arguments and its end.

@intrinsic("print")
pub native fn print<T>(value: T)

@intrinsic("println")
pub native fn println<T>(value: T)

@intrinsic("eprint")
pub native fn eprint<T>(value: T)

@intrinsic("eprintln")
pub native fn eprintln<T>(value: T)

@intrinsic("typeof")
pub native fn typeof<T>(value: T) -> String

@intrinsic("sys_read_line")
native fn read_line_of() -> String?
@intrinsic("sys_args")
native fn args_of() -> List<String>
@intrinsic("sys_exit")
native fn exit_of(code: Int)

pub fn read_line() -> String? { return read_line_of() }
pub fn args() -> [String] { return args_of().to_array() }
pub fn exit(code: Int) { exit_of(code) }
