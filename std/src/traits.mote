// The traits the language knows; Display, Debug and Clone have default methods that read the type through std.meta.
import { debug_text, duplicate, show } from std.meta

@lang("display")
pub trait Display {
    fn to_string(self) -> String {
        return show(self)
    }
}

@lang("debug")
pub trait Debug {
    fn debug(self) -> String {
        return debug_text(self)
    }
}

@lang("eq")
pub trait Eq {
    fn eq(self, other: Self) -> Bool
}

@lang("ord")
pub trait Ord {
    fn compare(self, other: Self) -> Int
}

@lang("clone")
pub trait Clone {
    fn clone(self) -> Self {
        return duplicate(self)
    }
}

@lang("closeable")
pub trait Closeable {
    fn close(self) -> Result<Null, Error>
}

// A type that can key a Map or Set: nothing in it is a Float or a collection that can change. The compiler checks it; a type does not list it.
@lang("key")
pub trait Key {
}
