// The floating-point types.
import std.numeric as n

@intrinsic("float_is_nan")
native fn is_nan_of<T>(x: T) -> Bool
@intrinsic("float_is_infinite")
native fn is_infinite_of<T>(x: T) -> Bool

@lang("float")
pub struct Float {
    pub fn eq(self, other: Float) -> Bool { return self == other }
    pub fn compare(self, other: Float) -> Int {
        if self < other { return -1 }
        if self > other { return 1 }
        return 0
    }
    pub fn clone(self) -> Float { return self }
    pub fn debug(self) -> String { return n.to_string(self) }
    pub fn abs(self) -> Float {
        if self < 0.0 { return -self }
        return self
    }
    pub fn min(self, other: Float) -> Float {
        if other < self { return other }
        return self
    }
    pub fn max(self, other: Float) -> Float {
        if other > self { return other }
        return self
    }
    pub fn to_string(self) -> String { return n.to_string(self) }
    pub fn is_nan(self) -> Bool { return is_nan_of(self) }
    pub fn is_infinite(self) -> Bool { return is_infinite_of(self) }
    pub fn from(x: Int) -> Float { return x as Float }
    pub fn from(x: Float32) -> Float { return x as Float }
}

@lang("float32")
pub struct Float32 {
    pub fn eq(self, other: Float32) -> Bool { return self == other }
    pub fn compare(self, other: Float32) -> Int {
        if self < other { return -1 }
        if self > other { return 1 }
        return 0
    }
    pub fn clone(self) -> Float32 { return self }
    pub fn debug(self) -> String { return n.to_string(self) }
    pub fn abs(self) -> Float32 {
        if self < 0.0 { return -self }
        return self
    }
    pub fn min(self, other: Float32) -> Float32 {
        if other < self { return other }
        return self
    }
    pub fn max(self, other: Float32) -> Float32 {
        if other > self { return other }
        return self
    }
    pub fn to_string(self) -> String { return n.to_string(self) }
    pub fn is_nan(self) -> Bool { return is_nan_of(self) }
    pub fn is_infinite(self) -> Bool { return is_infinite_of(self) }
    pub fn from(x: Int) -> Float32 { return x as Float32 }
    pub fn from(x: Float) -> Float32 { return x as Float32 }
}
