// Atomic integers and flags; every operation is sequentially consistent.
import { Bool as Flag } from std.numbers

@intrinsic("atomic_int_new")
native fn atomic_int_new(value: Int) -> Int64
@intrinsic("atomic_int_load")
native fn atomic_int_load(cell: Int64) -> Int
@intrinsic("atomic_int_store")
native fn atomic_int_store(cell: Int64, value: Int)
@intrinsic("atomic_int_swap")
native fn atomic_int_swap(cell: Int64, value: Int) -> Int
@intrinsic("atomic_int_compare_exchange")
native fn atomic_int_compare_exchange(cell: Int64, expected: Int, value: Int) -> Flag
@intrinsic("atomic_int_fetch_add")
native fn atomic_int_fetch_add(cell: Int64, by: Int) -> Int
@intrinsic("atomic_int_fetch_sub")
native fn atomic_int_fetch_sub(cell: Int64, by: Int) -> Int
@intrinsic("atomic_bool_new")
native fn atomic_bool_new(value: Flag) -> Bool
@intrinsic("atomic_bool_load")
native fn atomic_bool_load(cell: Bool) -> Flag
@intrinsic("atomic_bool_store")
native fn atomic_bool_store(cell: Bool, value: Flag)
@intrinsic("atomic_bool_swap")
native fn atomic_bool_swap(cell: Bool, value: Flag) -> Flag
@intrinsic("atomic_bool_compare_exchange")
native fn atomic_bool_compare_exchange(cell: Bool, expected: Flag, value: Flag) -> Flag

@lang("atomic_int")
pub class Int64 {
    pub fn new(value: Int) -> Int64 { return atomic_int_new(value) }
    pub fn load(self) -> Int { return atomic_int_load(self) }
    pub fn store(self, value: Int) { atomic_int_store(self, value) }
    pub fn swap(self, value: Int) -> Int { return atomic_int_swap(self, value) }
    pub fn compare_exchange(self, expected: Int, value: Int) -> Flag { return atomic_int_compare_exchange(self, expected, value) }
    pub fn fetch_add(self, by: Int) -> Int { return atomic_int_fetch_add(self, by) }
    pub fn fetch_sub(self, by: Int) -> Int { return atomic_int_fetch_sub(self, by) }
}

@lang("atomic_bool")
pub class Bool {
    pub fn new(value: Flag) -> Bool { return atomic_bool_new(value) }
    pub fn load(self) -> Flag { return atomic_bool_load(self) }
    pub fn store(self, value: Flag) { atomic_bool_store(self, value) }
    pub fn swap(self, value: Flag) -> Flag { return atomic_bool_swap(self, value) }
    pub fn compare_exchange(self, expected: Flag, value: Flag) -> Flag { return atomic_bool_compare_exchange(self, expected, value) }
}
