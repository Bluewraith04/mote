// The operations every number type shares; each is generic so the compiler picks the width.

@intrinsic("num_to_string")
pub native fn to_string<T>(n: T) -> String

@intrinsic("num_wrapping_add")
pub native fn wrapping_add<T>(a: T, b: T) -> T
@intrinsic("num_wrapping_sub")
pub native fn wrapping_sub<T>(a: T, b: T) -> T
@intrinsic("num_wrapping_mul")
pub native fn wrapping_mul<T>(a: T, b: T) -> T
@intrinsic("num_wrapping_neg")
pub native fn wrapping_neg<T>(a: T) -> T
@intrinsic("num_wrapping_shl")
pub native fn wrapping_shl<T>(a: T, n: Int) -> T
@intrinsic("num_wrapping_shr")
pub native fn wrapping_shr<T>(a: T, n: Int) -> T

@intrinsic("num_checked_add")
pub native fn checked_add<T>(a: T, b: T) -> T?
@intrinsic("num_checked_sub")
pub native fn checked_sub<T>(a: T, b: T) -> T?
@intrinsic("num_checked_mul")
pub native fn checked_mul<T>(a: T, b: T) -> T?
@intrinsic("num_checked_neg")
pub native fn checked_neg<T>(a: T) -> T?
@intrinsic("num_checked_shl")
pub native fn checked_shl<T>(a: T, n: Int) -> T?
@intrinsic("num_checked_shr")
pub native fn checked_shr<T>(a: T, n: Int) -> T?

@intrinsic("num_saturating_add")
pub native fn saturating_add<T>(a: T, b: T) -> T
@intrinsic("num_saturating_sub")
pub native fn saturating_sub<T>(a: T, b: T) -> T
@intrinsic("num_saturating_mul")
pub native fn saturating_mul<T>(a: T, b: T) -> T
@intrinsic("num_saturating_neg")
pub native fn saturating_neg<T>(a: T) -> T
@intrinsic("num_saturating_shl")
pub native fn saturating_shl<T>(a: T, n: Int) -> T
@intrinsic("num_saturating_shr")
pub native fn saturating_shr<T>(a: T, n: Int) -> T

@intrinsic("num_overflowing_add")
pub native fn overflowing_add<T>(a: T, b: T) -> (T, Bool)
@intrinsic("num_overflowing_sub")
pub native fn overflowing_sub<T>(a: T, b: T) -> (T, Bool)
@intrinsic("num_overflowing_mul")
pub native fn overflowing_mul<T>(a: T, b: T) -> (T, Bool)
@intrinsic("num_overflowing_neg")
pub native fn overflowing_neg<T>(a: T) -> (T, Bool)
@intrinsic("num_overflowing_shl")
pub native fn overflowing_shl<T>(a: T, n: Int) -> (T, Bool)
@intrinsic("num_overflowing_shr")
pub native fn overflowing_shr<T>(a: T, n: Int) -> (T, Bool)

@intrinsic("float_to_int")
pub native fn float_to_int(x: Float) -> Int
