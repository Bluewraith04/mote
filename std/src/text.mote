// The String type; lengths and offsets count UTF-8 bytes.

@intrinsic("string_len")
native fn len_of(s: String) -> Int
@intrinsic("string_concat")
native fn concat_of(a: String, b: String) -> String
@intrinsic("string_replace")
native fn replace_of(s: String, target: String, replacement: String) -> String
@intrinsic("string_slice")
native fn slice_of(s: String, start: Int, end: Int) -> String
@intrinsic("string_to_upper")
native fn to_upper_of(s: String) -> String
@intrinsic("string_to_lower")
native fn to_lower_of(s: String) -> String
@intrinsic("string_trim")
native fn trim_of(s: String) -> String
@intrinsic("string_repeat")
native fn repeat_of(s: String, count: Int) -> String
@intrinsic("string_find")
native fn find_of(s: String, needle: String) -> Int?
@intrinsic("string_rfind")
native fn rfind_of(s: String, needle: String) -> Int?
@intrinsic("string_split")
native fn split_of(s: String, separator: String) -> List<String>
@intrinsic("string_bytes")
native fn bytes_of(s: String) -> [UInt8]
@intrinsic("string_from_bytes")
native fn from_bytes_of(bytes: [UInt8]) -> String?

@lang("string")
pub struct String {
    pub fn eq(self, other: String) -> Bool { return self == other }
    pub fn compare(self, other: String) -> Int {
        if self < other { return -1 }
        if self > other { return 1 }
        return 0
    }
    pub fn clone(self) -> String { return self }
    pub fn debug(self) -> String { return self }
    pub fn len(self) -> Int { return len_of(self) }
    pub fn is_empty(self) -> Bool { return len_of(self) == 0 }
    pub fn concat(self, other: String) -> String { return concat_of(self, other) }
    pub fn replace(self, target: String, replacement: String) -> String { return replace_of(self, target, replacement) }
    pub fn slice(self, start: Int, end: Int) -> String { return slice_of(self, start, end) }
    pub fn to_upper(self) -> String { return to_upper_of(self) }
    pub fn to_lower(self) -> String { return to_lower_of(self) }
    pub fn trim(self) -> String { return trim_of(self) }
    pub fn repeat(self, count: Int) -> String { return repeat_of(self, count) }
    pub fn contains(self, needle: String) -> Bool { return find_of(self, needle) != null }
    pub fn starts_with(self, prefix: String) -> Bool { return find_of(self, prefix) == 0 }
    pub fn ends_with(self, suffix: String) -> Bool {
        let at = rfind_of(self, suffix)
        if at == null { return false }
        return at + len_of(suffix) == len_of(self)
    }
    pub fn split(self, separator: String) -> List<String> { return split_of(self, separator) }
    pub fn find(self, needle: String) -> Int? { return find_of(self, needle) }
    pub fn rfind(self, needle: String) -> Int? { return rfind_of(self, needle) }
    pub fn bytes(self) -> [UInt8] { return bytes_of(self) }
    pub fn to_string(self) -> String { return self }
    pub fn from_bytes(bytes: [UInt8]) -> String? { return from_bytes_of(bytes) }
    pub fn from(x: Int) -> String { return x.to_string() }
    pub fn from(x: Float) -> String { return x.to_string() }
    pub fn from(x: Bool) -> String { return x.to_string() }
}
