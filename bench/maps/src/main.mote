import { Map } from std.collections

fn main() {
    var table: Map<Int, Int> = Map.new()
    var i = 0
    while i < 1000000 {
        table.set(i * 7, i)
        i += 1
    }
    var sum = 0
    i = 0
    while i < 2000000 {
        sum += table.get_or(i, 0)
        i += 1
    }
    println(sum)
    println(table.len())
}
