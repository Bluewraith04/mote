import { Task, sleep } from std.task

fn main() {
    var tasks: List<Task<Int>> = List.new()
    var i = 0
    while i < 10000 {
        tasks.push(spawn {
            sleep(6000)
            return 1
        })
        i += 1
    }
    var total = 0
    for task in tasks {
        total += task.await().unwrap()
    }
    println(total)
}
