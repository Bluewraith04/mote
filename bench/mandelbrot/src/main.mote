fn escapes(cr: Float, ci: Float) -> Bool {
    var zr = 0.0
    var zi = 0.0
    var n = 0
    while n < 200 {
        let next = zr * zr - zi * zi + cr
        zi = 2.0 * zr * zi + ci
        zr = next
        if zr * zr + zi * zi > 4.0 {
            return true
        }
        n += 1
    }
    return false
}

fn main() {
    let size = 1200
    var inside = 0
    var y = 0
    while y < size {
        var x = 0
        while x < size {
            let cr = (x as Float) * 3.0 / (size as Float) - 2.0
            let ci = (y as Float) * 2.0 / (size as Float) - 1.0
            if !escapes(cr, ci) {
                inside += 1
            }
            x += 1
        }
        y += 1
    }
    println(inside)
}
