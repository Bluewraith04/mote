import { assert, assert_eq } from std.test
import { current_dir, env, get, get_or, has, remove, set, set_current_dir, vars } from env

test "a variable is set, read and removed" {
    assert(get("MOTE_ENV_TEST_A") == null, "unset")
    assert(!has("MOTE_ENV_TEST_A"), "not has")
    set("MOTE_ENV_TEST_A", "value one")!
    assert_eq(get("MOTE_ENV_TEST_A")!, "value one")
    assert(has("MOTE_ENV_TEST_A"), "has")
    set("MOTE_ENV_TEST_A", "two")!
    assert_eq(get("MOTE_ENV_TEST_A")!, "two")
    remove("MOTE_ENV_TEST_A")!
    assert(get("MOTE_ENV_TEST_A") == null, "removed")
    remove("MOTE_ENV_TEST_A")!
}

test "an empty value is set and a fallback covers an unset name" {
    set("MOTE_ENV_TEST_B", "")!
    assert(has("MOTE_ENV_TEST_B"), "set")
    assert_eq(get("MOTE_ENV_TEST_B")!, "")
    assert_eq(get_or("MOTE_ENV_TEST_B", "x"), "")
    assert_eq(get_or("MOTE_ENV_TEST_NOPE", "x"), "x")
    remove("MOTE_ENV_TEST_B")!
}

test "a long value is read whole" {
    var long = "abcdefghij"
    for _ in 0..10 {
        long = long + long
    }
    set("MOTE_ENV_TEST_C", long)!
    assert_eq(get("MOTE_ENV_TEST_C")!.len(), 10240)
    remove("MOTE_ENV_TEST_C")!
}

test "a bad name is an error" {
    assert(set("", "x").is_err(), "empty")
    assert(set("A=B", "x").is_err(), "equals")
    assert(remove("A=B").is_err(), "remove")
}

test "the variables list holds one that was set" {
    set("MOTE_ENV_TEST_D", "d=1")!
    var found = ""
    for (name, value) in vars() {
        if name == "MOTE_ENV_TEST_D" {
            found = value
        }
    }
    assert_eq(found, "d=1")
    remove("MOTE_ENV_TEST_D")!
}

test "the working directory is read and changed" {
    let before = current_dir()!
    let is_win = get("OS") == "Windows_NT"
    assert(before.starts_with("/") || (is_win && before.len() >= 3 && before.slice(1, 3) == ":\\"), "absolute")
    let target = if is_win { get("TEMP") ?? get("TMP") ?? "C:\\Windows\\Temp" } else { "/tmp" }
    set_current_dir(target)!
    let now = current_dir()!
    if is_win {
        assert(now.len() >= 3 && now.slice(1, 3) == ":\\", "changed on windows")
    } else {
        assert_eq(now, "/tmp")
    }
    assert(set_current_dir(target + "/mote-env-nothing-here").is_err(), "missing")
    set_current_dir(before)!
    assert_eq(current_dir()!, before)
}

test "env() supports bracket indexing" {
    assert(env()["MOTE_ENV_TEST_IDX"] == null, "unset via []")
    set("MOTE_ENV_TEST_IDX", "indexed")!
    assert_eq(env()["MOTE_ENV_TEST_IDX"]!, "indexed")
    remove("MOTE_ENV_TEST_IDX")!
}
