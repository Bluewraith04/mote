// The functions of the external library `compress`.

extern "compress" {
    pub fn compress_encoder_new(format: Int, level: Int) -> Int
    pub fn compress_decoder_new(format: Int, limit: Int) -> Int
    pub fn compress_push(handle: Int, data: [UInt8], error: [UInt8]) -> Int
    pub fn compress_finish(handle: Int, error: [UInt8]) -> Int
    pub fn compress_pending(handle: Int) -> Int
    pub fn compress_take(handle: Int, out: [UInt8]) -> Int
    pub fn compress_free(handle: Int) -> Int
}
