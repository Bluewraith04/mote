import { assert, assert_eq } from std.test
import { Date, DateTime, TimeOfDay, days_in_month, is_leap_year } from date

test "leap years follow the Gregorian rule" {
    assert(is_leap_year(2024), "2024")
    assert(!is_leap_year(2100), "2100")
    assert(is_leap_year(2000), "2000")
    assert(!is_leap_year(2023), "2023")
}

test "a month has its days" {
    assert_eq(days_in_month(2024, 2), 29)
    assert_eq(days_in_month(2023, 2), 28)
    assert_eq(days_in_month(2023, 4), 30)
    assert_eq(days_in_month(2023, 12), 31)
}

test "a date that does not exist is null" {
    assert(Date.new(2023, 2, 29) == null, "feb 29")
    assert(Date.new(2023, 13, 1) == null, "month 13")
    assert(Date.new(2023, 0, 1) == null, "month 0")
    assert(Date.new(2023, 4, 31) == null, "apr 31")
    assert(Date.new(2024, 2, 29) != null, "leap day")
}

test "a date counts its days from 1970-01-01" {
    assert_eq(Date.new(1970, 1, 1)!.days(), 0)
    assert_eq(Date.new(1970, 1, 2)!.days(), 1)
    assert_eq(Date.new(1969, 12, 31)!.days(), -1)
    assert_eq(Date.new(2000, 3, 1)!.days(), 11017)
    assert_eq(Date.new(2026, 10, 30)!.days(), 20756)
}

test "days turn back into the same date" {
    for days in [-800000, -719528, -1, 0, 1, 59, 60, 365, 11016, 20756, 2932896] {
        let date = Date.from_days(days)
        assert_eq(date.days(), days)
        assert_eq(Date.new(date.year(), date.month(), date.day())!, date)
    }
}

test "adding days crosses months and years" {
    let start = Date.new(2023, 12, 31)!
    assert_eq(start.add_days(1).to_string(), "2024-01-01")
    assert_eq(Date.new(2024, 2, 28)!.add_days(1).to_string(), "2024-02-29")
    assert_eq(Date.new(2023, 2, 28)!.add_days(1).to_string(), "2023-03-01")
    assert_eq(start.add_days(-365).to_string(), "2022-12-31")
}

test "days since is the distance between two dates" {
    let a = Date.new(2024, 3, 1)!
    let b = Date.new(2024, 2, 1)!
    assert_eq(a.days_since(b), 29)
    assert_eq(b.days_since(a), -29)
}

test "the weekday of a date" {
    assert_eq(Date.new(1970, 1, 1)!.weekday().to_string(), "Thursday")
    assert_eq(Date.new(2000, 1, 1)!.weekday().to_string(), "Saturday")
    assert_eq(Date.new(2026, 10, 30)!.weekday().number(), 5)
    assert_eq(Date.new(1969, 12, 28)!.weekday().number(), 7)
}

test "dates compare and are equal by day" {
    let a = Date.new(2024, 1, 31)!
    let b = Date.new(2024, 2, 1)!
    assert(a.compare(b) < 0, "before")
    assert(b.compare(a) > 0, "after")
    assert(a == Date.new(2024, 1, 31)!, "equal")
}

test "a date prints as ISO 8601" {
    assert_eq(Date.new(2026, 1, 5)!.to_string(), "2026-01-05")
    assert_eq(Date.new(987, 12, 1)!.to_string(), "0987-12-01")
}

test "a date parses from ISO 8601" {
    assert_eq(Date.parse("2026-10-30")!.days(), 20756)
    assert_eq(Date.parse("0987-12-01")!.year(), 987)
}

test "a bad date text is an error" {
    assert(Date.parse("2026-1-30").is_err(), "short month")
    assert(Date.parse("2026-02-30").is_err(), "no such day")
    assert(Date.parse("2026/02/03").is_err(), "separator")
    assert(Date.parse("20x6-02-03").is_err(), "letters")
    assert(Date.parse("").is_err(), "empty")
}

test "a time of day is checked, counted and printed" {
    assert(TimeOfDay.new(24, 0, 0) == null, "hour 24")
    assert(TimeOfDay.new(0, 60, 0) == null, "minute 60")
    let t = TimeOfDay.new(13, 5, 9)!
    assert_eq(t.seconds(), 47109)
    assert_eq(t.to_string(), "13:05:09")
    assert_eq(TimeOfDay.from_seconds(47109), t)
    assert_eq(TimeOfDay.from_seconds(-1).to_string(), "23:59:59")
    assert_eq(TimeOfDay.from_seconds(86400).to_string(), "00:00:00")
}

test "a time of day parses" {
    assert_eq(TimeOfDay.parse("07:30:00")!.seconds(), 27000)
    assert(TimeOfDay.parse("7:30:00").is_err(), "short hour")
    assert(TimeOfDay.parse("25:00:00").is_err(), "hour 25")
}

test "a moment counts seconds from the epoch" {
    let moment = DateTime.new(Date.new(2026, 10, 30)!, TimeOfDay.new(12, 30, 15)!)
    assert_eq(moment.seconds(), 20756 * 86400 + 45015)
    assert_eq(DateTime.from_seconds(moment.seconds()), moment)
    assert_eq(DateTime.from_seconds(-1).to_string(), "1969-12-31T23:59:59")
    assert_eq(DateTime.from_seconds(0).to_string(), "1970-01-01T00:00:00")
}

test "a moment adds seconds across a day" {
    let moment = DateTime.parse("2023-12-31T23:59:30")!
    assert_eq(moment.add_seconds(45).to_string(), "2024-01-01T00:00:15")
    assert_eq(moment.add_seconds(-86400).to_string(), "2023-12-30T23:59:30")
    assert_eq(moment.date().to_string(), "2023-12-31")
    assert_eq(moment.time().second(), 30)
}

test "a moment parses and compares" {
    let a = DateTime.parse("2024-02-29T10:00:00")!
    let b = DateTime.parse("2024-02-29T10:00:01")!
    assert(a.compare(b) < 0, "before")
    assert(DateTime.parse("2024-02-29 10:00:00").is_err(), "no T")
    assert(DateTime.parse("2024-02-30T10:00:00").is_err(), "bad date")
    assert(DateTime.parse("2024-02-29T10:00").is_err(), "no seconds")
}

test "date and datetime support + - and relational operators" {
    let d1 = Date.new(2024, 2, 28)!
    let d2 = d1 + 2
    assert_eq(d2.to_string(), "2024-03-01")
    assert_eq((2 + d1).to_string(), "2024-03-01")
    assert_eq(d2 - d1, 2)
    assert(d1 < d2 && d2 > d1 && d1 <= d2 && d2 >= d1, "date Ord operators")

    let dt1 = DateTime.parse("2023-12-31T23:59:30")!
    let dt2 = dt1 + 45
    assert_eq(dt2.to_string(), "2024-01-01T00:00:15")
    assert_eq((45 + dt1).to_string(), "2024-01-01T00:00:15")
    assert_eq(dt2 - dt1, 45)
    assert(dt1 < dt2 && dt2 >= dt1, "datetime Ord operators")

    let t1 = TimeOfDay.new(9, 0, 0)!
    let t2 = TimeOfDay.new(17, 30, 0)!
    assert(t1 < t2 && t2 > t1, "time Ord operators")
}
