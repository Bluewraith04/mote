// A day of the proleptic Gregorian calendar.
import { Display, Eq, Ord } from std.traits
import { pad_start, parse_int } from std.string
import { all_digits, bad, civil_to_days, days_to_civil, digits, modulo, two } from ._support
import Weekday from .weekday

pub fn is_leap_year(year: Int) -> Bool {
    return year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
}

pub fn days_in_month(year: Int, month: Int) -> Int {
    if month == 2 {
        if is_leap_year(year) { return 29 }
        return 28
    }
    if month == 4 || month == 6 || month == 9 || month == 11 { return 30 }
    return 31
}


pub struct Date: (Eq, Ord, Display) {
    y: Int
    m: Int
    d: Int

    /// The date, or `null` when the month or the day does not exist in that year.
    pub fn new(year: Int, month: Int, day: Int) -> Date? {
        if month < 1 || month > 12 || day < 1 || day > days_in_month(year, month) { return null }
        return Date { y: year, m: month, d: day }
    }

    /// The date `days` after 1970-01-01, which is day 0.
    pub fn from_days(days: Int) -> Date {
        let (y, m, d) = days_to_civil(days)
        return Date { y: y, m: m, d: d }
    }

    /// `YYYY-MM-DD`.
    pub fn parse(text: String) -> Result<Date, Error> {
        let parts = text.split("-")
        if parts.len() != 3 { return Err(bad("a date", text)) }
        let year = digits(parts.get(0), 4, "a year")?
        let month = digits(parts.get(1), 2, "a month")?
        let day = digits(parts.get(2), 2, "a day")?
        let made = Date.new(year, month, day)
        if made == null { return Err(bad("a date", text)) }
        return Ok(made)
    }

    pub fn year(self) -> Int { return self.y }
    pub fn month(self) -> Int { return self.m }
    pub fn day(self) -> Int { return self.d }
    pub fn days(self) -> Int { return civil_to_days(self.y, self.m, self.d) }
    pub fn add_days(self, count: Int) -> Date { return Date.from_days(self.days() + count) }
    pub fn days_since(self, earlier: Date) -> Int { return self.days() - earlier.days() }
    pub fn __add__(self, days: Int) -> Date { return self.add_days(days) }
    pub fn __radd__(self, days: Int) -> Date { return self.add_days(days) }
    pub fn __sub__(self, other: Date) -> Int { return self.days_since(other) }

    pub fn weekday(self) -> Weekday {
        return match modulo(self.days() + 3, 7) {
            0 => Weekday.Monday
            1 => Weekday.Tuesday
            2 => Weekday.Wednesday
            3 => Weekday.Thursday
            4 => Weekday.Friday
            5 => Weekday.Saturday
            _ => Weekday.Sunday
        }
    }

    pub fn eq(self, other: Date) -> Bool { return self.days() == other.days() }
    pub fn compare(self, other: Date) -> Int { return self.days() - other.days() }

    pub fn to_string(self) -> String {
        return "${pad_start(self.y.to_string(), 4, "0")}-${two(self.m)}-${two(self.d)}"
    }
}

