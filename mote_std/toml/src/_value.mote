// The value tree and its tagged JSON form, which the external library reads and writes.
import Json from json
import { parse_float, parse_int } from std.string
import { call, invalid } from ._call
import toml_print from ._lib

pub enum Toml {
    Table(List<(String, Toml)>)
    Array(List<Toml>)
    Text(String)
    Integer(Int)
    Real(Float)
    Boolean(Bool)
    Datetime(String)

    pub fn as_bool(self) -> Bool? {
        return match self {
            Boolean(value) => value
            _ => null
        }
    }

    pub fn as_int(self) -> Int? {
        return match self {
            Integer(value) => value
            _ => null
        }
    }

    /// The number as a `Float`, from either kind of number.
    pub fn as_float(self) -> Float? {
        return match self {
            Integer(value) => value as Float
            Real(value) => value
            _ => null
        }
    }

    pub fn as_text(self) -> String? {
        return match self {
            Text(value) => value
            _ => null
        }
    }

    /// The text of a date or time, such as `1979-05-27T07:32:00Z`.
    pub fn as_datetime(self) -> String? {
        return match self {
            Datetime(value) => value
            _ => null
        }
    }

    /// Element `index` of an array.
    pub fn at(self, index: Int) -> Toml? {
        return match self {
            Array(items) => if index >= 0 && index < items.len() { items.get(index) } else { null }
            _ => null
        }
    }

    /// The value of the key of a table.
    pub fn get(self, key: String) -> Toml? {
        return match self {
            Table(members) => member(members, key)
            _ => null
        }
    }

    /// Element `key` when an `Int` index, or member `key` when a `String` key.
    pub fn __getitem__(self, key: String | Int) -> Toml? {
        if key is String { return self.get(key) }
        return self.at(key)
    }

    /// The JSON tree a TOML value reads as: a table is an object and a date-time is text.
    pub fn to_json(self) -> Json {
        return match self {
            Table(members) => json_table(members)
            Array(items) => json_array(items)
            Text(text) => Json.Text(text)
            Integer(number) => Json.Integer(number)
            Real(number) => Json.Real(number)
            Boolean(flag) => Json.Boolean(flag)
            Datetime(text) => Json.Text(text)
        }
    }

    /// The `T` this TOML value decodes into, via JSON; a date-time is read as text.
    pub fn decode<T>(self) -> Result<T, Error> { return self.to_json().decode<T>() }

    /// The text of a table, an `Err` for a value that is not a table.
    pub fn to_text(self) -> Result<String, Error> { return print(self, 0) }

    /// The text of a table with an array of several items on lines of their own.
    pub fn pretty(self) -> Result<String, Error> { return print(self, 1) }
}

fn json_table(members: List<(String, Toml)>) -> Json {
    var out: List<(String, Json)> = []
    for (name, inner) in members {
        out.push((name, inner.to_json()))
    }
    return Json.Object(out)
}

fn json_array(items: List<Toml>) -> Json {
    var out: List<Json> = []
    for inner in items {
        out.push(inner.to_json())
    }
    return Json.Array(out)
}

fn member(members: List<(String, Toml)>, key: String) -> Toml? {
    for (name, value) in members {
        if name == key { return value }
    }
    return null
}

fn float_of(text: String) -> Result<Float, Error> {
    if text == "nan" { return Ok(0.0 / 0.0) }
    if text == "inf" { return Ok(1.0 / 0.0) }
    if text == "-inf" { return Ok(-1.0 / 0.0) }
    return parse_float(text)
}

fn float_text(value: Float) -> String {
    if value != value { return "nan" }
    if value - value != 0.0 { return if value > 0.0 { "inf" } else { "-inf" } }
    return value.to_string()
}

// The payload of a tagged value as text.
fn payload_text(payload: Json) -> Result<String, Error> {
    let text = payload.as_text()
    if text == null { return Err(invalid("toml: the library gave a payload that is not text")) }
    return Ok(text)
}

pub fn from_tagged(json: Json) -> Result<Toml, Error> {
    let tag = json.at(0)
    let payload = json.at(1)
    if tag == null || payload == null || tag.as_text() == null { return Err(invalid("toml: the library gave a value with no tag")) }
    let kind = tag.as_text()
    if kind == "s" { return Ok(Toml.Text(payload_text(payload)?)) }
    if kind == "i" { return Ok(Toml.Integer(parse_int(payload_text(payload)?)?)) }
    if kind == "f" { return Ok(Toml.Real(float_of(payload_text(payload)?)?)) }
    if kind == "d" { return Ok(Toml.Datetime(payload_text(payload)?)) }
    if kind == "b" {
        let flag = payload.as_bool()
        if flag == null { return Err(invalid("toml: the library gave a boolean that is not one")) }
        return Ok(Toml.Boolean(flag))
    }
    if kind == "a" {
        var items: List<Toml> = []
        var index = 0
        while true {
            let item = payload.at(index)
            if item == null { break }
            items.push(from_tagged(item)?)
            index = index + 1
        }
        return Ok(Toml.Array(items))
    }
    return match payload {
        Json.Object(members) => table_of(members)
        _ => Err(invalid("toml: the library gave a table with no members"))
    }
}

fn table_of(members: List<(String, Json)>) -> Result<Toml, Error> {
    var out: List<(String, Toml)> = []
    for (name, value) in members {
        out.push((name, from_tagged(value)?))
    }
    return Ok(Toml.Table(out))
}

fn tagged(kind: String, payload: Json) -> Json { return Json.Array([Json.Text(kind), payload]) }

fn tagged_table(members: List<(String, Toml)>) -> Json {
    var out: List<(String, Json)> = []
    for (name, inner) in members {
        out.push((name, to_tagged(inner)))
    }
    return tagged("t", Json.Object(out))
}

fn tagged_array(items: List<Toml>) -> Json {
    var out: List<Json> = []
    for inner in items {
        out.push(to_tagged(inner))
    }
    return tagged("a", Json.Array(out))
}

fn to_tagged(value: Toml) -> Json {
    return match value {
        Toml.Table(members) => tagged_table(members)
        Toml.Array(items) => tagged_array(items)
        Toml.Text(text) => tagged("s", Json.Text(text))
        Toml.Integer(number) => tagged("i", Json.Text(number.to_string()))
        Toml.Real(number) => tagged("f", Json.Text(float_text(number)))
        Toml.Boolean(flag) => tagged("b", Json.Boolean(flag))
        Toml.Datetime(text) => tagged("d", Json.Text(text))
    }
}

fn print(value: Toml, pretty: Int) -> Result<String, Error> {
    let json = to_tagged(value).to_string().bytes()
    return call(|buffer: [UInt8]| toml_print(json, pretty, buffer))
}
