// Measuring views and sharing the room of a row or column.
import { Length, Shape, Slot, View } from .view
import text_width from .text

struct Measure {
    width: Int
    height: Int
}

fn measure(view: View) -> Measure {
    if view.shape == Shape.Text {
        var width = 0
        var height = 0
        for line in view.label.split("\n") {
            width = max(width, text_width(line))
            height += 1
        }
        return Measure { width: width, height: height }
    }
    if view.shape == Shape.Column || view.shape == Shape.Row {
        var width = 0
        var height = 0
        for slot in view.children {
            let inner = measure(slot.view)
            var wide = inner.width
            var tall = inner.height
            if view.shape == Shape.Column {
                tall = match slot.length {
                    Fixed(cells) => cells
                    _ => inner.height
                }
                width = max(width, wide)
                height += tall
            } else {
                wide = match slot.length {
                    Fixed(cells) => cells
                    _ => inner.width
                }
                width += wide
                height = max(height, tall)
            }
        }
        return Measure { width: width, height: height }
    }
    if view.shape == Shape.Border || view.shape == Shape.Pad {
        let inner = measure(view.inner!)
        return Measure { width: inner.width + 2 * view.amount, height: inner.height + 2 * view.amount }
    }
    return Measure { width: 0, height: 0 }
}

pub fn max(a: Int, b: Int) -> Int { return if a > b { a } else { b } }
pub fn min(a: Int, b: Int) -> Int { return if a < b { a } else { b } }

// The cells each slot takes along an axis of `total` cells: fixed and fitted slots first, in order, then the rest shared by weight.
pub fn lengths(slots: List<Slot>, total: Int, column: Bool) -> List<Int> {
    var given: List<Int> = []
    var left = total
    var weights = 0
    for slot in slots {
        let wanted = match slot.length {
            Fixed(cells) => cells
            Fit => if column { measure(slot.view).height } else { measure(slot.view).width }
            Flex(weight) => 0
        }
        let taken = min(max(wanted, 0), left)
        given.push(taken)
        left -= taken
        weights += match slot.length {
            Flex(weight) => max(weight, 0)
            _ => 0
        }
    }
    if weights == 0 { return given }
    var handed = 0
    for at in 0..slots.len() {
        let weight = match slots[at].length {
            Flex(weight) => max(weight, 0)
            _ => 0
        }
        if weight == 0 { continue }
        let share = left * weight / weights
        given.set(at, share)
        handed += share
    }
    var extra = left - handed
    for at in 0..slots.len() {
        if extra == 0 { break }
        let weight = match slots[at].length {
            Flex(weight) => max(weight, 0)
            _ => 0
        }
        if weight == 0 { continue }
        given.set(at, given.get(at) + 1)
        extra -= 1
    }
    return given
}
