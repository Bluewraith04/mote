// The cells of a screen and the text that updates a terminal to show them.
import { clear_screen, move_to, reset_style } from term
import Style from term
import { glyphs, width_of } from ._glyphs

/// One cell of the screen: a glyph (empty for the second half of a wide glyph) and its style.
pub struct Cell {
    pub glyph: String
    pub style: Style
}

/// The cells of a screen.
pub class Grid {
    pub rows: Int
    pub cols: Int
    var cells: List<Cell>

    /// A grid of blank cells.
    pub fn blank(rows: Int, cols: Int) -> Grid {
        var cells: List<Cell> = []
        for _ in 0..rows * cols {
            cells.push(Cell { glyph: " ", style: Style {} })
        }
        return Grid { rows: rows, cols: cols, cells: cells }
    }

    pub fn cell(self, row: Int, col: Int) -> Cell { return self.cells.get(row * self.cols + col) }

    pub fn __getitem__(self, pos: (Int, Int)) -> Cell { return self.cell(pos.0, pos.1) }

    pub fn put(var self, row: Int, col: Int, glyph: String, style: Style) {
        self.cells.set(row * self.cols + col, Cell { glyph: glyph, style: style })
    }

    pub fn __setitem__(var self, pos: (Int, Int), cell: Cell) {
        self.cells.set(pos.0 * self.cols + pos.1, cell)
    }

    // Writes the text inside the rectangle; what does not fit is cut, and a wide glyph that would be cut is left out.
    pub fn draw(var self, text: String, style: Style, top: Int, left: Int, height: Int, width: Int) {
        var row = top
        for line in text.split("\n") {
            if row >= top + height { break }
            var col = left
            for glyph in glyphs(line) {
                let cells = width_of(glyph)
                if cells == 0 { continue }
                if col + cells > left + width { break }
                self.put(row, col, glyph, style)
                if cells == 2 { self.put(row, col + 1, "", style) }
                col += cells
            }
            row += 1
        }
    }

    /// The text of each row, without the styles.
    pub fn lines(self) -> List<String> {
        var found: List<String> = []
        for row in 0..self.rows {
            var line = ""
            for col in 0..self.cols {
                line = line + self.cell(row, col).glyph
            }
            found.push(line)
        }
        return found
    }

    /// The text that makes a terminal showing `before` show this grid: all of it when there is no `before` or it has another size, else only the runs of cells that differ.
    pub fn diff(self, before: Grid?) -> String {
        var out = ""
        var all = before == null
        if before != null && (before.rows != self.rows || before.cols != self.cols) { all = true }
        if all { out = clear_screen() }
        let blank = Style {}
        var shown: Style? = null
        var cursor_row = -1
        var cursor_col = -1
        for row in 0..self.rows {
            for col in 0..self.cols {
                let now = self.cell(row, col)
                if now.glyph == "" { continue }
                if !all && before != null {
                    let was = before.cell(row, col)
                    if was.glyph == now.glyph && was.style == now.style { continue }
                } else if all && now.glyph == " " && now.style == blank {
                    continue
                }
                if cursor_row != row || cursor_col != col {
                    out = out + move_to(row, col)
                }
                if shown == null || shown! != now.style {
                    out = out + now.style.codes()
                    shown = now.style
                }
                out = out + now.glyph
                cursor_row = row
                cursor_col = col + width_of(now.glyph)
            }
        }
        if shown != null { out = out + reset_style() }
        return out
    }
}
