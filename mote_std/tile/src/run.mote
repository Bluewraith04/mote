// The loop that draws a view of the state and feeds keys, the mouse and ticks to an update.
import Instant from std.time
import { KeyEvent, MouseEvent, Size as TermSize, Terminal, disable_mouse, enable_mouse, enter_alternate_screen, hide_cursor, leave_alternate_screen, reset_style, show_cursor } from term
import Grid from .grid
import render from .render
import View from .view
import { max, min } from ._layout

/// What reaches the program: a key, the mouse, a tick of the timer, or the terminal changing size.
pub enum Input {
    Key(KeyEvent)
    Mouse(MouseEvent)
    Tick
    Resize(Int, Int)
}

/// What the program does next, with the state it keeps.
pub enum Next<S> {
    Continue(S)
    Quit(S)
}

/// How a program runs: the milliseconds between ticks (0 for none), whether the mouse is reported, and the size to use when the terminal does not say.
pub struct Options {
    pub tick_ms: Int = 0
    pub mouse: Bool = false
    pub rows: Int = 24
    pub cols: Int = 80
}

fn screen_size(terminal: Terminal, options: Options) -> TermSize {
    return match terminal.size() {
        Ok(found) => if found.rows > 0 && found.cols > 0 { found } else { TermSize { rows: options.rows, cols: options.cols } }
        Err(_) => TermSize { rows: options.rows, cols: options.cols }
    }
}

fn loop_over<S>(var terminal: Terminal, initial: S, view: (S) -> View, update: (S, Input) -> Next<S>, options: Options) -> Result<S, Error> {
    var state = initial
    var shown: Grid? = null
    var size = screen_size(terminal, options)
    var last_tick = Instant.now()
    while true {
        let now_size = screen_size(terminal, options)
        if now_size.rows != size.rows || now_size.cols != size.cols {
            size = now_size
            let next = update(state, Input.Resize(size.rows, size.cols))
            match next {
                Continue(kept) => { state = kept }
                Quit(kept) => { return Ok(kept) }
            }
        }
        let grid = render(view(state), size.rows, size.cols)
        terminal.write(grid.diff(shown))?
        shown = grid
        var wait = 50
        if options.tick_ms > 0 {
            let due = options.tick_ms - last_tick.elapsed().as_millis()
            wait = min(max(due, 0), 50)
        }
        let event = terminal.read_event(wait)?
        var input: Input? = null
        if event != null {
            input = match event {
                Key(key) => Input.Key(key)
                Mouse(mouse) => Input.Mouse(mouse)
            }
        } else if options.tick_ms > 0 && last_tick.elapsed().as_millis() >= options.tick_ms {
            last_tick = Instant.now()
            input = Input.Tick
        }
        if input != null {
            match update(state, input!) {
                Continue(kept) => { state = kept }
                Quit(kept) => { return Ok(kept) }
            }
        }
    }
    return Ok(state)
}

/// Runs a program on the terminal until `update` quits: it draws `view(state)`, reads a key, the mouse or a tick, and gives the state and the input to `update`. The terminal is raw, on the alternate screen, with the cursor hidden, and is put back as it was when the program ends or fails.
pub fn run<S>(var terminal: Terminal, initial: S, view: (S) -> View, update: (S, Input) -> Next<S>, options: Options) -> Result<S, Error> {
    terminal.raw()?
    var start = enter_alternate_screen() + hide_cursor()
    if options.mouse { start = start + enable_mouse() }
    terminal.write(start)?
    let done = loop_over(terminal, initial, view, update, options)
    var finish = reset_style()
    if options.mouse { finish = finish + disable_mouse() }
    finish = finish + show_cursor() + leave_alternate_screen()
    let wrote = terminal.write(finish)
    let closed = terminal.close()
    wrote?
    closed?
    return done
}
