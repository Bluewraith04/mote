import { assert, assert_eq } from std.test
import Json from json
import { dump, load, parse, parse_all, to_text, to_text_all } from yaml

class Job {
    name: String
    retries: Int
    env: List<String>
    next: String?
}

struct Pair {
    dims: [Int; 2]
}

fn error_of(text: String) -> String {
    return match parse(text) {
        Ok(_) => "ok"
        Err(error) => error.to_string()
    }
}

test "scalars are typed by their form" {
    let doc = parse("a: 1\nb: -2.5\nc: true\nd: null\ne: ~\nf: text\ng: \"quoted\"\nh: '7'\ni: 0x1F\nj: 1e3\nk:\n")!
    assert_eq(doc.get("a")!.as_int()!, 1)
    assert_eq(doc.get("b")!.as_float()!, -2.5)
    assert_eq(doc.get("c")!.as_bool()!, true)
    assert(doc.get("d")!.is_null(), "null")
    assert(doc.get("e")!.is_null(), "tilde")
    assert_eq(doc.get("f")!.as_text()!, "text")
    assert_eq(doc.get("g")!.as_text()!, "quoted")
    assert_eq(doc.get("h")!.as_text()!, "7")
    assert_eq(doc.get("i")!.as_int()!, 31)
    assert_eq(doc.get("j")!.as_float()!, 1000.0)
    assert(doc.get("k")!.is_null(), "empty value")
}

test "sequences and mappings nest in block and flow style" {
    let doc = parse("list:\n  - 1\n  - two\n  - [3, 4]\nmap:\n  x: 1\n  y: {z: [a, b]}\n")!
    assert_eq(doc.get("list")!.at(1)!.as_text()!, "two")
    assert_eq(doc.get("list")!.at(2)!.at(1)!.as_int()!, 4)
    assert_eq(doc.get("map")!.get("y")!.get("z")!.at(0)!.as_text()!, "a")
    assert(doc.get("list")!.at(3) == null, "three items")
}

test "block scalars keep or fold their lines" {
    let doc = parse("lit: |\n  one\n  two\nfold: >\n  one\n  two\n\n  three\nstrip: |-\n  x\n")!
    assert_eq(doc.get("lit")!.as_text()!, "one\ntwo\n")
    assert_eq(doc.get("fold")!.as_text()!, "one two\nthree\n")
    assert_eq(doc.get("strip")!.as_text()!, "x")
}

test "comments are dropped and members keep their order" {
    let text = "# top\nzebra: 1 # trailing\nalpha: 2\nmid: 3\n"
    let doc = parse(text)!
    assert_eq(to_text(doc)!, "zebra: 1\nalpha: 2\nmid: 3\n")
}

test "anchors, aliases and merge keys are expanded" {
    let doc = parse("base: &b\n  host: h\n  port: 1\nuse: *b\nmore:\n  <<: *b\n  port: 2\nlist: &l [1, 2]\ncopy: *l\n")!
    assert_eq(doc.get("use")!.get("host")!.as_text()!, "h")
    assert_eq(doc.get("more")!.get("host")!.as_text()!, "h")
    assert_eq(doc.get("more")!.get("port")!.as_int()!, 2)
    assert_eq(doc.get("copy")!.at(1)!.as_int()!, 2)
}

test "tags are dropped and scalar keys become text" {
    let doc = parse("a: !!str 123\nb: !custom value\n1: one\ntrue: yes\n")!
    assert_eq(doc.get("a")!.as_text()!, "123")
    assert_eq(doc.get("b")!.as_text()!, "value")
    assert_eq(doc.get("1")!.as_text()!, "one")
    assert_eq(doc.get("true")!.as_text()!, "yes")
    assert(error_of("? [1, 2]\n: value\n").contains("key"), "a key that is not a scalar")
}

test "floats that are not finite are read as text" {
    let doc = parse("a: .inf\nb: -.inf\nc: .nan\n")!
    assert_eq(doc.get("a")!.as_text()!, ".inf")
    assert_eq(doc.get("b")!.as_text()!, "-.inf")
    assert_eq(doc.get("c")!.as_text()!, ".nan")
}

test "a stream has several documents and a text with none is null" {
    let all = parse_all("a: 1\n---\nb: 2\n---\n- 3\n")!
    assert_eq(all.len(), 3)
    assert_eq(all.get(1).get("b")!.as_int()!, 2)
    assert_eq(all.get(2).at(0)!.as_int()!, 3)
    assert(parse("a: 1\n---\nb: 2\n").is_err(), "two documents for parse")
    assert(parse("")!.is_null(), "empty text")
    assert_eq(parse_all("")!.len(), 0)
    assert_eq(to_text_all(all)!, "---\na: 1\n---\nb: 2\n---\n- 3\n")
}

test "a mistake names its line and column" {
    assert(error_of("a: 1\nb: [1, 2\n").contains("line"), "unclosed flow")
    assert(error_of("a: 1\n  b: 2\n").contains("line 2"), "bad indent")
    assert(error_of("a: &x 1\nb: *y\n").contains("line"), "unknown alias")
    assert_eq(error_of("a: 1\n"), "ok")
}

test "a value is written as text and read back equal" {
    let text = "name: demo\ncount: 3\nratio: 0.25\non: true\nnone: null\nlist:\n- 1\n- two\n- nested:\n  - a\n  - b\nmap:\n  k: v\n"
    let doc = parse(text)!
    let again = parse(to_text(doc)!)!
    assert_eq(to_text(again)!, to_text(doc)!)
    assert_eq(again.get("list")!.at(2)!.get("nested")!.at(1)!.as_text()!, "b")
    assert_eq(again.get("ratio")!.as_float()!, 0.25)
    assert(again.get("none")!.is_null(), "null")
}

test "text that reads as another type is written quoted" {
    let doc = Json.Object([("a", Json.Text("true")), ("b", Json.Text("123")), ("c", Json.Text("")), ("d", Json.Text("x: y")), ("e", Json.Text("line one\nline two\n")), ("f", Json.Text("null")), ("g", Json.Text("# not a comment"))])
    let again = parse(to_text(doc)!)!
    for key in ["a", "b", "c", "d", "e", "f", "g"] {
        assert_eq(again.get(key)!.as_text()!, doc.get(key)!.as_text()!)
    }
}

test "a record is loaded from text and dumped to it" {
    let job = load<Job>("name: build\nretries: 3\nenv:\n  - A=1\n  - B=2\n")!
    assert_eq(job.name, "build")
    assert_eq(job.retries, 3)
    assert_eq(job.env.len(), 2)
    assert(job.next == null, "an optional field left out")
    let text = dump(job)!
    let again = load<Job>(text)!
    assert_eq(again.env.get(1), "B=2")
    assert(load<Job>("name: x\n").is_err(), "missing fields")
}

test "a long document passes the native boundary whole" {
    var text = ""
    for n in 0..3000 {
        text = text + "key" + n.to_string() + ": value " + n.to_string() + "\n"
    }
    let doc = parse(text)!
    assert_eq(doc.get("key2999")!.as_text()!, "value 2999")
    assert_eq(parse(to_text(doc)!)!.get("key1500")!.as_text()!, "value 1500")
}

test "indexing, method decode and fixed arrays work on YAML" {
    let doc = parse("list:\n  - 1\n  - two\n  - [3, 4]\nname: build\nretries: 1\nenv: [A]\n")!
    assert_eq(doc["list"]![2]![1]!.as_int()!, 4)
    let job = doc.decode<Job>()!
    assert_eq(job.name, "build")
    assert_eq(job.retries, 1)
    let pair = Pair { dims: [5, 6] }
    let round = load<Pair>(dump(pair)!)!
    assert_eq(round.dims[0], 5)
    assert_eq(round.dims[1], 6)
}
