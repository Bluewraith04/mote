import { assert, assert_eq } from std.test
import sleep from std.task
import { TcpListener, TcpStream, UdpSocket } from net.socket

fn text_of(bytes: [UInt8]) -> String {
    return String.from_bytes(bytes)!
}

test "a stream carries bytes both ways" {
    let listener = TcpListener.bind("127.0.0.1", 0)!
    let port = listener.port()!
    assert(port > 0, "a port was picked")
    let server = spawn {
        let stream = listener.accept()!
        let got = stream.read(64)!
        stream.write_string("echo:" + text_of(got))!
        stream.close()!
        return text_of(got)
    }
    let client = TcpStream.connect("127.0.0.1", port)!
    client.write_string("hello")!
    assert_eq(text_of(client.read_all()!), "echo:hello")
    assert_eq(server.await()!, "hello")
    assert(client.peer_addr()!.ends_with(":${port}"), "peer")
    assert(client.local_addr()!.starts_with("127.0.0.1:"), "local")
    client.close()!
    listener.close()!
}

test "the end of the stream reads as nothing" {
    let listener = TcpListener.bind("127.0.0.1", 0)!
    let port = listener.port()!
    let server = spawn {
        let stream = listener.accept()!
        stream.close()!
        return 0
    }
    let client = TcpStream.connect("127.0.0.1", port)!
    assert_eq(client.read(10)!.len(), 0)
    server.await()!
    client.close()!
    listener.close()!
}

test "a large transfer arrives whole while the other side reads" {
    let listener = TcpListener.bind("127.0.0.1", 0)!
    let port = listener.port()!
    let server = spawn {
        let stream = listener.accept()!
        let all = stream.read_all()!
        stream.write_string("${all.len()}")!
        stream.close()!
        return all.len()
    }
    let client = TcpStream.connect("127.0.0.1", port)!
    let block: [UInt8] = [7; 100000]
    for _ in 0..5 {
        client.write(block)!
    }
    client.shutdown_write()!
    assert_eq(text_of(client.read_all()!), "500000")
    assert_eq(server.await()!, 500000)
    client.close()!
    listener.close()!
}

test "a read that waits too long is a timeout" {
    let listener = TcpListener.bind("127.0.0.1", 0)!
    let port = listener.port()!
    let client = TcpStream.connect("127.0.0.1", port)!
    let held = listener.accept()!
    client.set_timeout(40)
    let result = client.read(1)
    assert(result.is_err(), "timed out")
    let kind = match result {
        Ok(_) => ErrorKind.Other
        Err(error) => error.kind
    }
    assert(kind == ErrorKind.TimedOut, "kind")
    held.close()!
    client.close()!
    listener.close()!
}

test "accept can time out" {
    let listener = TcpListener.bind("127.0.0.1", 0)!
    listener.set_timeout(30)
    assert(listener.accept().is_err(), "nobody came")
    listener.close()!
}

test "a connection to a port nobody listens on is refused" {
    let listener = TcpListener.bind("127.0.0.1", 0)!
    let port = listener.port()!
    listener.close()!
    let result = TcpStream.connect("127.0.0.1", port)
    assert(result.is_err(), "refused")
    let message = match result {
        Ok(_) => ""
        Err(error) => error.message
    }
    assert_eq(message, "127.0.0.1:${port}: connection refused")
}

test "a name that does not resolve is NotFound" {
    let result = TcpStream.connect("no-such-host.invalid", 80)
    let kind = match result {
        Ok(_) => ErrorKind.Other
        Err(error) => error.kind
    }
    assert(kind == ErrorKind.NotFound, "kind")
}

test "an address in use is AlreadyExists" {
    let first = TcpListener.bind("127.0.0.1", 0)!
    let port = first.port()!
    let second = TcpListener.bind("127.0.0.1", port)
    let kind = match second {
        Ok(_) => ErrorKind.Other
        Err(error) => error.kind
    }
    assert(kind == ErrorKind.AlreadyExists, "kind")
    first.close()!
}

test "localhost is tried address by address" {
    let listener = TcpListener.bind("127.0.0.1", 0)!
    let port = listener.port()!
    let server = spawn {
        let stream = listener.accept()!
        stream.close()!
        return 0
    }
    let client = TcpStream.connect_within("localhost", port, 2000)!
    server.await()!
    client.close()!
    listener.close()!
}

test "many tasks use many streams at once" {
    let listener = TcpListener.bind("127.0.0.1", 0)!
    let port = listener.port()!
    let server = spawn {
        for _ in 0..4 {
            let stream = listener.accept()!
            let got = stream.read(16)!
            stream.write_string(text_of(got) + "!")!
            stream.close()!
        }
        return 0
    }
    var answers = ""
    for n in 0..4 {
        let client = TcpStream.connect("127.0.0.1", port)!
        client.write_string("c${n}")!
        answers = answers + text_of(client.read_all()!) + " "
        client.close()!
    }
    server.await()!
    assert_eq(answers, "c0! c1! c2! c3! ")
    listener.close()!
}

test "more tasks waiting on sockets than there are workers still let the rest run" {
    let listener = TcpListener.bind("127.0.0.1", 0)!
    let port = listener.port()!
    var waiting: List<Task<Int>> = []
    for _ in 0..24 {
        waiting.push(spawn {
            let stream = listener.accept()!
            let got = stream.read(16)!
            stream.write(got)!
            stream.close()!
            return got.len()
        })
    }
    var total = 0
    for n in 0..24 {
        let client = TcpStream.connect("127.0.0.1", port)!
        client.write_string("x${n}")!
        total += client.read_all()!.len()
        client.close()!
    }
    var counted = 0
    for task in waiting {
        counted += task.await()!
    }
    assert_eq(total, counted)
    assert(total > 0, "something was echoed")
    listener.close()!
}

test "datagrams go between sockets with their sender" {
    let a = UdpSocket.bind("127.0.0.1", 0)!
    let b = UdpSocket.bind("127.0.0.1", 0)!
    let port_b = b.port()!
    assert_eq(a.send_to("127.0.0.1", port_b, "ping".bytes())!, 4)
    let buffer: [UInt8] = [0; 32]
    let got = b.recv_from(buffer)!
    assert_eq(got.size, 4)
    assert_eq(text_of(buffer.slice(0, got.size).to_array()), "ping")
    assert_eq(got.sender, "127.0.0.1:${a.port()!}")
    b.set_timeout(30)
    assert(b.recv_from(buffer).is_err(), "nothing more")
    a.close()!
    b.close()!
}

test "closing twice is an error" {
    let listener = TcpListener.bind("127.0.0.1", 0)!
    listener.close()!
    assert(listener.close().is_err(), "twice")
}
