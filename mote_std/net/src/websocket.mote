// WebSocket frames (RFC 6455) over a wire; the handshake is in `net.http`.
import system_bytes from random
import Reader from ._wire

let MAX_MESSAGE = 16777216

/// A message: text, or bytes.
pub enum Message {
    Text(String)
    Binary([UInt8])
}

/// One end of a WebSocket, used by one task at a time. A message that is not complete or well formed closes the socket with an `Err`.
pub class WebSocket {
    var reader: Reader
    client: Bool
    var closing: Bool

    /// A socket over a wire whose handshake is done; `client` is true on the connecting side, which masks what it sends.
    pub fn new(reader: Reader, client: Bool) -> WebSocket { return WebSocket { reader: reader, client: client, closing: false } }

    /// Limits each read and write to `ms` milliseconds; a negative time waits for ever.
    pub fn set_timeout(self, ms: Int) { self.reader.wire.set_timeout(ms) }

    fn send_frame(var self, opcode: Int, payload: [UInt8]) -> Result<Null, Error> {
        var frame: List<UInt8> = []
        frame.push((128 + opcode) as UInt8)
        let mask = if self.client { 128 } else { 0 }
        let size = payload.len()
        if size < 126 {
            frame.push((mask + size) as UInt8)
        } else if size < 65536 {
            frame.push((mask + 126) as UInt8)
            frame.push((size / 256) as UInt8)
            frame.push((size % 256) as UInt8)
        } else {
            frame.push((mask + 127) as UInt8)
            for k in 0..8 {
                frame.push(((size >> ((7 - k) * 8)) & 255) as UInt8)
            }
        }
        if self.client {
            let key = system_bytes(4)?
            for k in 0..4 {
                frame.push(key[k])
            }
            for k in 0..size {
                frame.push(((payload[k] as Int) ^ (key[k % 4] as Int)) as UInt8)
            }
        } else {
            for k in 0..size {
                frame.push(payload[k])
            }
        }
        return self.reader.wire.write(frame.to_array())
    }

    /// Sends a text message.
    pub fn send_text(var self, text: String) -> Result<Null, Error> { return self.send_frame(1, text.bytes()) }

    /// Sends a binary message.
    pub fn send_binary(var self, bytes: [UInt8]) -> Result<Null, Error> { return self.send_frame(2, bytes) }

    /// Sends a ping with up to 125 bytes; the peer answers with a pong that `recv` skips.
    pub fn ping(var self, bytes: [UInt8]) -> Result<Null, Error> { return self.send_frame(9, bytes) }

    /// Sends the close frame with a code (1000 is normal) and a reason, and closes the stream.
    pub fn close(var self, code: Int, reason: String) -> Result<Null, Error> {
        var payload: List<UInt8> = [(code / 256) as UInt8, (code % 256) as UInt8]
        for byte in reason.bytes() {
            payload.push(byte)
        }
        var sent: Result<Null, Error> = Ok(null)
        if !self.closing {
            self.closing = true
            sent = self.send_frame(8, payload.to_array())
        }
        self.reader.wire.close()
        return sent
    }

    fn fail(var self, code: Int, text: String) -> Error {
        self.close(code, text)
        return Error.new(ErrorKind.InvalidData, "websocket: ${text}")
    }

    /// The next message, or null once the peer has closed; pings are answered and pongs skipped.
    pub fn recv(var self) -> Result<Message?, Error> {
        var data: List<UInt8> = []
        var text = false
        var started = false
        while true {
            let head = self.reader.take(2)?
            let first = head[0] as Int
            let second = head[1] as Int
            let fin = first >= 128
            let opcode = first % 16
            let masked = second >= 128
            var size = second % 128
            if first % 128 >= 16 { return Err(self.fail(1002, "reserved bits")) }
            if masked == self.client { return Err(self.fail(1002, "bad masking")) }
            if size == 126 {
                let more = self.reader.take(2)?
                size = (more[0] as Int) * 256 + (more[1] as Int)
            } else if size == 127 {
                let more = self.reader.take(8)?
                size = 0
                for k in 0..8 {
                    size = size * 256 + (more[k] as Int)
                    if size > MAX_MESSAGE { return Err(self.fail(1009, "message too large")) }
                }
            }
            if size > MAX_MESSAGE || data.len() + size > MAX_MESSAGE { return Err(self.fail(1009, "message too large")) }
            var key: [UInt8] = [0; 4]
            if masked { key = self.reader.take(4)? }
            var payload = self.reader.take(size)?
            if masked {
                for k in 0..size {
                    payload[k] = ((payload[k] as Int) ^ (key[k % 4] as Int)) as UInt8
                }
            }
            if opcode >= 8 {
                if !fin || size > 125 { return Err(self.fail(1002, "bad control frame")) }
                if opcode == 8 {
                    if !self.closing {
                        self.closing = true
                        self.send_frame(8, payload)
                    }
                    self.reader.wire.close()
                    return Ok(null)
                }
                if opcode == 9 { self.send_frame(10, payload)? }
                continue
            }
            if opcode == 0 {
                if !started { return Err(self.fail(1002, "unexpected continuation")) }
            } else if opcode == 1 || opcode == 2 {
                if started { return Err(self.fail(1002, "message inside a message")) }
                started = true
                text = opcode == 1
            } else {
                return Err(self.fail(1002, "unknown opcode"))
            }
            for byte in payload {
                data.push(byte)
            }
            if fin { break }
        }
        if text {
            let message = String.from_bytes(data.to_array())
            if message == null { return Err(self.fail(1007, "text is not UTF-8")) }
            return Ok(Message.Text(message))
        }
        return Ok(Message.Binary(data.to_array()))
    }
}
