// TLS 1.2 and 1.3 over a TcpStream: the Rust library turns bytes into records and back, this moves them over the socket.
import Closeable from std.traits
import TcpStream from .socket
import { tls_client, tls_server, tls_incoming, tls_outgoing, tls_wants_read, tls_wants_write, tls_handshaking, tls_plain_read, tls_plain_write, tls_send_close, tls_message, tls_free } from ._lib

fn fault(session: Int) -> Error {
    let buffer: [UInt8] = [0; 512]
    let count = tls_message(session, buffer)
    let text = String.from_bytes(buffer.slice(0, if count > 0 { count } else { 0 }))
    return Error.new(ErrorKind.InvalidData, "tls: ${if text == null { "failed" } else { text }}")
}

/// The accepting side's certificate chain and private key, both PEM text.
pub class TlsAcceptor {
    chain: String
    key: String

    /// Checks the chain and the key and keeps them for `accept`.
    pub fn new(chain: String, key: String) -> Result<TlsAcceptor, Error> {
        let session = tls_server(chain.bytes(), key.bytes())
        if session < 0 { return Err(Error.new(ErrorKind.InvalidData, "tls: the certificate or key is not usable")) }
        tls_free(session)
        return Ok(TlsAcceptor { chain: chain, key: key })
    }

    /// Runs the server handshake over a connected stream.
    pub fn accept(self, tcp: TcpStream) -> Result<TlsStream, Error> {
        let session = tls_server(self.chain.bytes(), self.key.bytes())
        if session < 0 { return Err(Error.new(ErrorKind.InvalidData, "tls: the certificate or key is not usable")) }
        return TlsStream.start(session, tcp)
    }
}

/// An encrypted stream used by one task at a time. A time limit set with `set_timeout` applies to the handshake, each read and each write; closing twice is an error.
pub class TlsStream: (Closeable) {
    session: AtomicInt
    tcp: TcpStream

    /// Connects and shakes hands, trusting the bundled public roots.
    pub fn connect(host: String, port: Int) -> Result<TlsStream, Error> { return TlsStream.connect_trusting(host, port, "") }

    /// Connects trusting the bundled public roots and the PEM certificates in `roots`.
    pub fn connect_trusting(host: String, port: Int, roots: String) -> Result<TlsStream, Error> {
        let tcp = TcpStream.connect(host, port)?
        return TlsStream.client(tcp, host, roots)
    }

    /// Runs the client handshake over a connected stream, checking the certificate against `host`; closes the stream if it fails.
    pub fn client(tcp: TcpStream, host: String, roots: String) -> Result<TlsStream, Error> {
        let session = tls_client(host, roots.bytes())
        if session < 0 {
            tcp.close()
            return Err(Error.new(ErrorKind.InvalidData, "tls: ${host} or the roots are not usable"))
        }
        return TlsStream.start(session, tcp)
    }

    fn start(session: Int, tcp: TcpStream) -> Result<TlsStream, Error> {
        let stream = TlsStream { session: AtomicInt(session), tcp: tcp }
        match stream.handshake(session) {
            Ok(_) => return Ok(stream)
            Err(error) => {
                stream.release()
                return Err(error)
            }
        }
    }

    fn release(self) {
        let session = self.session.swap(0)
        if session != 0 { tls_free(session) }
        self.tcp.close()
    }

    fn flush(self, session: Int) -> Result<Null, Error> {
        let buffer: [UInt8] = [0; 16384]
        while true {
            let count = tls_outgoing(session, buffer)
            if count < 0 { return Err(fault(session)) }
            if count == 0 { break }
            self.tcp.write(buffer.slice(0, count).to_array())?
        }
        return Ok(null)
    }

    fn feed(self, session: Int, data: [UInt8]) -> Result<Null, Error> {
        if tls_incoming(session, data) < 0 {
            let reason = fault(session)
            self.flush(session)
            return Err(reason)
        }
        return Ok(null)
    }

    fn handshake(self, session: Int) -> Result<Null, Error> {
        let buffer: [UInt8] = [0; 16384]
        while tls_handshaking(session) == 1 {
            self.flush(session)?
            if tls_wants_read(session) == 0 { break }
            let count = self.tcp.read_into(buffer)?
            if count == 0 { return Err(Error.new(ErrorKind.InvalidData, "tls: the peer closed during the handshake")) }
            self.feed(session, buffer.slice(0, count).to_array())?
        }
        if tls_handshaking(session) == 1 { return Err(Error.new(ErrorKind.InvalidData, "tls: the handshake stopped")) }
        return self.flush(session)
    }

    /// Limits the handshake, each read and each write to `ms` milliseconds; a negative time waits for ever.
    pub fn set_timeout(self, ms: Int) { self.tcp.set_timeout(ms) }

    /// Reads up to `buffer.len()` bytes into the start of `buffer` as soon as some arrive: the count, and 0 at the end of the stream, which includes a peer that closed without a close notice.
    pub fn read_into(self, buffer: [UInt8]) -> Result<Int, Error> {
        let session = self.session.load()
        if session == 0 { return Err(Error.new(ErrorKind.Other, "closed")) }
        let scratch: [UInt8] = [0; 16384]
        while true {
            let got = tls_plain_read(session, buffer)
            if got > 0 { return Ok(got) }
            if got == -2 { return Ok(0) }
            if got < 0 { return Err(fault(session)) }
            self.flush(session)?
            let count = self.tcp.read_into(scratch)?
            if count == 0 { return Ok(0) }
            self.feed(session, scratch.slice(0, count).to_array())?
        }
        return Ok(0)
    }

    /// Up to `count` bytes as soon as some arrive; none at the end of the stream.
    pub fn read(self, count: Int) -> Result<[UInt8], Error> {
        let buffer: [UInt8] = [0; count]
        let got = self.read_into(buffer)?
        return Ok(buffer.slice(0, got).to_array())
    }

    /// Every byte until the peer closes its side.
    pub fn read_all(self) -> Result<[UInt8], Error> {
        var all: List<UInt8> = []
        let buffer: [UInt8] = [0; 16384]
        while true {
            let got = self.read_into(buffer)?
            if got == 0 { break }
            for at in 0..got {
                all.push(buffer[at])
            }
        }
        return Ok(all.to_array())
    }

    /// Writes all of `bytes`.
    pub fn write(self, bytes: [UInt8]) -> Result<Null, Error> {
        let session = self.session.load()
        if session == 0 { return Err(Error.new(ErrorKind.Other, "closed")) }
        var at = 0
        while at < bytes.len() {
            let taken = tls_plain_write(session, bytes.slice(at, bytes.len()).to_array())
            if taken < 0 { return Err(fault(session)) }
            at = at + taken
            self.flush(session)?
        }
        return Ok(null)
    }

    /// Writes the text.
    pub fn write_string(self, text: String) -> Result<Null, Error> { return self.write(text.bytes()) }

    /// The address and port of the other end.
    pub fn peer_addr(self) -> Result<String, Error> { return self.tcp.peer_addr() }

    /// The address and port of this end.
    pub fn local_addr(self) -> Result<String, Error> { return self.tcp.local_addr() }

    /// Sends the close notice and closes the socket.
    pub fn close(self) -> Result<Null, Error> {
        let session = self.session.swap(0)
        if session == 0 { return Err(Error.new(ErrorKind.Other, "already closed")) }
        tls_send_close(session)
        self.flush(session)
        tls_free(session)
        self.tcp.shutdown_write()
        return self.tcp.close()
    }
}
