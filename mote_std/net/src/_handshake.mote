// The answer to a WebSocket handshake key (RFC 6455), which needs SHA-1.
import encode from base64

let GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"

fn rotate(value: Int, by: Int) -> Int {
    return ((value << by) | (value >> (32 - by))) & 4294967295
}

fn sha1(message: [UInt8]) -> [UInt8] {
    var padded: List<UInt8> = message.to_list()
    padded.push(128)
    while padded.len() % 64 != 56 {
        padded.push(0)
    }
    let bits = message.len() * 8
    for k in 0..8 {
        padded.push(((bits >> ((7 - k) * 8)) & 255) as UInt8)
    }
    var a0 = 1732584193
    var b0 = 4023233417
    var c0 = 2562383102
    var d0 = 271733878
    var e0 = 3285377520
    var block = 0
    while block < padded.len() {
        var w: [Int; 80] = [0; 80]
        for t in 0..16 {
            let at = block + t * 4
            w[t] = ((padded.get(at) as Int) << 24) | ((padded.get(at + 1) as Int) << 16) | ((padded.get(at + 2) as Int) << 8) | (padded.get(at + 3) as Int)
        }
        for t in 16..80 {
            w[t] = rotate(w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16], 1)
        }
        var a = a0
        var b = b0
        var c = c0
        var d = d0
        var e = e0
        for t in 0..80 {
            var f = 0
            var k = 0
            if t < 20 {
                f = (b & c) | ((b ^ 4294967295) & d)
                k = 1518500249
            } else if t < 40 {
                f = b ^ c ^ d
                k = 1859775393
            } else if t < 60 {
                f = (b & c) | (b & d) | (c & d)
                k = 2400959708
            } else {
                f = b ^ c ^ d
                k = 3395469782
            }
            let next = (rotate(a, 5) + f + e + k + w[t]) & 4294967295
            e = d
            d = c
            c = rotate(b, 30)
            b = a
            a = next
        }
        a0 = (a0 + a) & 4294967295
        b0 = (b0 + b) & 4294967295
        c0 = (c0 + c) & 4294967295
        d0 = (d0 + d) & 4294967295
        e0 = (e0 + e) & 4294967295
        block += 64
    }
    var out: List<UInt8> = []
    let state: [Int; 5] = [a0, b0, c0, d0, e0]
    for word in state {
        for k in 0..4 {
            out.push(((word >> ((3 - k) * 8)) & 255) as UInt8)
        }
    }
    return out.to_array()
}

/// The `Sec-WebSocket-Accept` answer to a `Sec-WebSocket-Key`.
pub fn accept_key(key: String) -> String {
    return encode(sha1((key + GUID).bytes()))
}
