// Reading the head and body of a message, which the server and the client share.
import parse_int from std.string
import Reader from .._wire
import Headers from .message
import { MAX_HEADERS, MAX_LINE, hex_value, invalid } from ._basic

pub fn failure_text(result: Result<Null, Error>) -> String {
    return match result {
        Ok(_) => ""
        Err(error) => error.message
    }
}

pub fn read_headers(var reader: Reader) -> Result<Headers, Error> {
    var out: List<(String, String)> = []
    var count = 0
    while true {
        let line = reader.line(MAX_LINE)?
        if line == null { return Err(invalid("the stream ended inside the headers")) }
        if line.is_empty() { break }
        count += 1
        if count > MAX_HEADERS { return Err(Error.new(ErrorKind.Unsupported, "too many headers")) }
        let colon = line.find(":")
        if colon == null { return Err(invalid("a header has no colon")) }
        out.push((line.slice(0, colon).trim().to_string().to_lower(), line.slice(colon + 1, line.len()).trim().to_string()))
    }
    return Ok(Headers.from(out.to_array()))
}

pub fn parse_hex(text: String) -> Int {
    var value = 0
    for byte in text.trim().bytes() {
        let digit = hex_value(byte as Int)
        if digit < 0 { return -1 }
        value = value * 16 + digit
        if value > 4294967296 { return -1 }
    }
    return if text.trim().is_empty() { -1 } else { value }
}

pub fn read_chunked(var reader: Reader, limit: Int) -> Result<[UInt8], Error> {
    var body: List<UInt8> = []
    while true {
        let line = reader.line(MAX_LINE)?
        if line == null { return Err(invalid("the stream ended inside a body")) }
        let semicolon = line.find(";")
        let size = parse_hex(if semicolon == null { line } else { line.slice(0, semicolon).to_string() })
        if size < 0 { return Err(invalid("a chunk size is not hex")) }
        if size == 0 { break }
        if body.len() + size > limit { return Err(Error.new(ErrorKind.Unsupported, "body too large")) }
        let data = reader.take(size)?
        for byte in data {
            body.push(byte)
        }
        let end = reader.line(MAX_LINE)?
        if end == null || !end.is_empty() { return Err(invalid("a chunk does not end with a line break")) }
    }
    while true {
        let trailer = reader.line(MAX_LINE)?
        if trailer == null || trailer.is_empty() { break }
    }
    return Ok(body.to_array())
}

pub fn read_body(var reader: Reader, headers: Headers, limit: Int) -> Result<[UInt8], Error> {
    let encoding = headers["transfer-encoding"]
    if encoding != null && encoding.to_lower().contains("chunked") { return read_chunked(reader, limit) }
    let length = headers["content-length"]
    if length == null { return Ok([]) }
    let size = match parse_int(length.trim()) {
        Ok(number) => number
        Err(_) => -1
    }
    if size < 0 { return Err(invalid("content-length is not a size")) }
    if size > limit { return Err(Error.new(ErrorKind.Unsupported, "body too large")) }
    return reader.take(size)
}

