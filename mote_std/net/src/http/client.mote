// The client: requests, redirects and the WebSocket handshake.
import encode from base64
import parse_int from std.string
import system_bytes from random
import { Reader, Wire } from .._wire
import TcpStream from ..socket
import TlsStream from ..tls
import WebSocket from ..websocket
import accept_key from .._handshake
import { Request, Response } from .message
import reason from ._text
import { MAX_LINE, invalid } from ._basic
import { failure_text, read_body, read_headers } from ._parse
import { Url, parse_url } from .url

fn host_header(url: Url) -> String {
    let name = if url.host.contains(":") { "[${url.host}]" } else { url.host }
    let default = if url.secure { 443 } else { 80 }
    return if url.port == default { name } else { "${name}:${url.port}" }
}

fn origin(url: Url) -> String { return "${if url.secure { "https" } else { "http" }}://${host_header(url)}" }

/// How the client behaves; `Options()` is 30 seconds, no redirects followed, the bundled roots only, and bodies up to 64 MiB.
pub struct Options {
    /// The time for connecting and for each read and write.
    pub timeout_ms: Int = 30000
    /// How many redirects are followed.
    pub max_redirects: Int = 0
    /// Extra trusted PEM certificates.
    pub roots: String = ""
    /// The largest body read.
    pub max_body: Int = 67108864
}

fn open_wire(url: Url, options: Options) -> Result<Wire, Error> {
    let tcp = TcpStream.connect_within(url.host, url.port, options.timeout_ms)?
    tcp.set_timeout(options.timeout_ms)
    if !url.secure { return Ok(Wire.Plain(tcp)) }
    let secure = TlsStream.client(tcp, url.host, options.roots)?
    return Ok(Wire.Secure(secure))
}

fn read_response(var reader: Reader, method: String, limit: Int) -> Result<Response, Error> {
    while true {
        let line = reader.line(MAX_LINE)?
        if line == null { return Err(invalid("the server closed without answering")) }
        let parts = line.split(" ")
        if parts.len() < 2 || !parts.get(0).starts_with("HTTP/1.") { return Err(invalid("not a status line")) }
        let status = match parse_int(parts.get(1)) {
            Ok(number) => number
            Err(_) => -1
        }
        if status < 100 || status > 599 { return Err(invalid("not a status line")) }
        let headers = read_headers(reader)?
        if status == 100 { continue }
        var body: [UInt8] = []
        if method != "HEAD" && status >= 200 && status != 204 && status != 304 {
            let encoding = headers["transfer-encoding"]
            if (encoding != null && encoding.to_lower().contains("chunked")) || headers["content-length"] != null {
                body = read_body(reader, headers, limit)?
            } else {
                body = reader.rest(limit)?
            }
        }
        return Ok(Response { status: status, headers: headers, body: body, upgrade: false })
    }
    return Err(invalid("unreachable"))
}

fn request_bytes(method: String, url: Url, headers: [(String, String)], body: [UInt8]) -> [UInt8] {
    var text = "${method} ${url.target} HTTP/1.1\r\nhost: ${host_header(url)}\r\nconnection: close\r\n"
    var sent: List<String> = []
    for (name, value) in headers {
        text = text + name + ": " + value + "\r\n"
        sent.push(name.to_lower())
    }
    if !sent.contains("user-agent") { text = text + "user-agent: mote\r\n" }
    if !sent.contains("accept") { text = text + "accept: */*\r\n" }
    if body.len() > 0 || method == "POST" || method == "PUT" || method == "PATCH" { text = text + "content-length: ${body.len()}\r\n" }
    text = text + "\r\n"
    var out = text.bytes().to_list()
    for byte in body {
        out.push(byte)
    }
    return out.to_array()
}

fn once(method: String, address: String, headers: [(String, String)], body: [UInt8], options: Options) -> Result<Response, Error> {
    let url = parse_url(address)?
    let wire = open_wire(url, options)?
    var reader = Reader.new(wire)
    let sent = wire.write(request_bytes(method, url, headers, body))
    if sent.is_err() {
        wire.close()
        return Err(Error.new(ErrorKind.Other, "${address}: ${failure_text(sent)}"))
    }
    let got = read_response(reader, method, options.max_body)
    wire.close()
    return got
}

fn resolve(base: String, location: String) -> Result<String, Error> {
    if location.starts_with("http://") || location.starts_with("https://") { return Ok(location) }
    let url = parse_url(base)?
    if location.starts_with("/") { return Ok(origin(url) + location) }
    var path = url.target
    let mark = path.find("?")
    if mark != null { path = path.slice(0, mark).to_string() }
    let slash = path.rfind("/")
    let directory = if slash == null { "/" } else { path.slice(0, slash + 1).to_string() }
    return Ok(origin(url) + directory + location)
}

/// Sends a request and reads the whole response; `headers` are `(name, value)` pairs. Redirects are followed up to `options.max_redirects`, a 303 (and a 301 or 302 after a POST) as a GET without a body.
pub fn send(method: String, address: String, headers: [(String, String)] = [], body: [UInt8] = [], options: Options = Options()) -> Result<Response, Error> {
    var current = address
    var verb = method
    var payload = body
    var left = options.max_redirects
    while true {
        let response = once(verb, current, headers, payload, options)?
        let location = response.header("location")
        if left > 0 && location != null && (response.status == 301 || response.status == 302 || response.status == 303 || response.status == 307 || response.status == 308) {
            current = resolve(current, location)?
            left -= 1
            if response.status == 303 || ((response.status == 301 || response.status == 302) && verb == "POST") {
                verb = "GET"
                payload = []
            }
            continue
        }
        return Ok(response)
    }
    return Err(invalid("unreachable"))
}

/// A GET.
pub fn get(address: String, options: Options = Options()) -> Result<Response, Error> { return send("GET", address, options=options) }

/// A POST of bytes with a content type.
pub fn post(address: String, body: [UInt8], content_type: String, options: Options = Options()) -> Result<Response, Error> {
    return send("POST", address, [("content-type", content_type)], body, options)
}

/// Connects to a `ws://` or `wss://` address and shakes hands; the socket then waits for ever.
pub fn connect_websocket(address: String, options: Options = Options()) -> Result<WebSocket, Error> {
    let url = parse_url(address)?
    let wire = open_wire(url, options)?
    var reader = Reader.new(wire)
    let key = encode(system_bytes(16)?)
    let asked = "GET ${url.target} HTTP/1.1\r\nhost: ${host_header(url)}\r\nupgrade: websocket\r\nconnection: Upgrade\r\nsec-websocket-key: ${key}\r\nsec-websocket-version: 13\r\n\r\n"
    let result = websocket_handshake(wire, reader, asked, key)
    if result.is_err() {
        wire.close()
        return Err(Error.new(ErrorKind.InvalidData, "${address}: ${failure_text(result)}"))
    }
    wire.set_timeout(-1)
    return Ok(WebSocket.new(reader, true))
}

fn websocket_handshake(wire: Wire, var reader: Reader, asked: String, key: String) -> Result<Null, Error> {
    wire.write(asked.bytes())?
    let line = reader.line(MAX_LINE)?
    if line == null || !line.contains(" 101") { return Err(invalid("the server did not switch protocols")) }
    let headers = read_headers(reader)?
    if headers["sec-websocket-accept"] != accept_key(key) { return Err(invalid("the accept key is wrong")) }
    return Ok(null)
}
