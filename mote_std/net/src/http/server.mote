// A server that answers requests over plain or TLS streams.
import parse_int from std.string
import { Reader, Wire } from .._wire
import { TcpListener, TcpStream } from ..socket
import { TlsAcceptor, TlsStream } from ..tls
import WebSocket from ..websocket
import accept_key from .._handshake
import { Request, Response } from .message
import { reason, segments_of } from ._text
import { MAX_LINE, invalid } from ._basic
import { failure_text, read_body, read_headers } from ._parse

// The next request, or null when the peer closed before sending one.
fn read_request(var reader: Reader, peer: String, limit: Int) -> Result<Request?, Error> {
    var line = reader.line(MAX_LINE)?
    while line != null && line!.is_empty() {
        line = reader.line(MAX_LINE)?
    }
    if line == null { return Ok(null) }
    let first = line!
    let parts = first.split(" ")
    if parts.len() != 3 || !parts.get(2).starts_with("HTTP/1.") { return Err(invalid("not a request line")) }
    let method = parts.get(0)
    let target = parts.get(1)
    if method.is_empty() || target.is_empty() { return Err(invalid("not a request line")) }
    let headers = read_headers(reader)?
    let expects = headers["expect"]
    if expects != null && expects.to_lower() == "100-continue" {
        reader.wire.write("HTTP/1.1 100 Continue\r\n\r\n".bytes())?
    }
    let body = read_body(reader, headers, limit)?
    let mark = target.find("?")
    let path = if mark == null { target } else { target.slice(0, mark).to_string() }
    let query = if mark == null { "" } else { target.slice(mark + 1, target.len()).to_string() }
    return Ok(Request { method: method, target: target, path: path, query: query, version: parts.get(2), headers: headers, body: body, peer: peer })
}

fn head_of(response: Response, keep_alive: Bool) -> [UInt8] {
    var text = "HTTP/1.1 ${response.status} ${reason(response.status)}\r\n"
    for (name, value) in response.headers.pairs() {
        if name != "content-length" && name != "connection" && name != "transfer-encoding" {
            text = text + name + ": " + value + "\r\n"
        }
    }
    text = text + "content-length: ${response.body.len()}\r\nconnection: ${if keep_alive { "keep-alive" } else { "close" }}\r\n\r\n"
    return text.bytes()
}

fn write_response(wire: Wire, response: Response, keep_alive: Bool, head_only: Bool) -> Result<Null, Error> {
    wire.write(head_of(response, keep_alive))?
    if !head_only && response.body.len() > 0 { wire.write(response.body)? }
    return Ok(null)
}

fn wants_keep_alive(request: Request) -> Bool {
    let connection = request.header("connection")
    let token = if connection == null { "" } else { connection.to_lower() }
    if request.version == "HTTP/1.0" { return token.contains("keep-alive") }
    return !token.contains("close")
}

/// A server that answers each request with `handler` and runs every connection in a task of its own.
pub class Server {
    handler: Send (Request) -> Response
    sockets: (Send (Request, var WebSocket) -> Null)?
    acceptor: TlsAcceptor?
    running: AtomicInt
    timeout_ms: Int
    max_body: Int

    /// A server answering each request with `handler`; the timeout is 30 s and the largest body 8 MiB.
    pub fn new(handler: Send (Request) -> Response) -> Server {
        return Server { handler: handler, sockets: null, acceptor: null, running: AtomicInt(1), timeout_ms: 30000, max_body: 8388608 }
    }

    /// A server sharing `state` across connections through a `Mutex<S>`, with an optional WebSocket handler.
    pub fn with_state<S>(
        state: S,
        handler: Send (Mutex<S>, Request) -> Response,
        sockets: (Send (Mutex<S>, Request, var WebSocket) -> Null)? = null
    ) -> Server {
        let shared = Mutex.new(state)
        var server = Server.new(|request: Request| handler(shared, request))
        if sockets != null {
            server = server.with_sockets(|request: Request, var socket: WebSocket| sockets(shared, request, socket))
        }
        return server
    }

    /// The server with a handler for connections that a response of `Response.upgrade_to_websocket()` turned into WebSockets.
    pub fn with_sockets(self, sockets: Send (Request, var WebSocket) -> Null) -> Server {
        return Server { handler: self.handler, sockets: sockets, acceptor: self.acceptor, running: self.running, timeout_ms: self.timeout_ms, max_body: self.max_body }
    }

    /// The server speaking TLS on every connection it accepts.
    pub fn with_tls(self, acceptor: TlsAcceptor) -> Server {
        return Server { handler: self.handler, sockets: self.sockets, acceptor: acceptor, running: self.running, timeout_ms: self.timeout_ms, max_body: self.max_body }
    }

    /// The server with a time limit for each read and write of a connection, and a largest request body.
    pub fn with_limits(self, timeout_ms: Int, max_body: Int) -> Server {
        return Server { handler: self.handler, sockets: self.sockets, acceptor: self.acceptor, running: self.running, timeout_ms: timeout_ms, max_body: max_body }
    }

    /// Accepts connections until `stop`, each served in its own task.
    pub fn serve(self, listener: TcpListener) -> Result<Null, Error> {
        listener.set_timeout(100)
        while self.running.load() == 1 {
            match listener.accept() {
                Ok(tcp) => {
                    spawn {
                        self.connection(tcp)
                        return 0
                    }
                }
                Err(error) => {
                    if error.kind != ErrorKind.TimedOut { return Err(error) }
                }
            }
        }
        return Ok(null)
    }

    /// Makes `serve` return once its listener next times out; connections in progress finish their request.
    pub fn stop(self) { self.running.store(0) }

    fn connection(self, tcp: TcpStream) {
        tcp.set_timeout(self.timeout_ms)
        var wire = Wire.Plain(tcp)
        let acceptor = self.acceptor
        if acceptor != null {
            match acceptor.accept(tcp) {
                Ok(secure) => wire = Wire.Secure(secure)
                Err(_) => return
            }
        }
        var reader = Reader.new(wire)
        while self.running.load() == 1 {
            match self.exchange(reader) {
                Ok(again) => {
                    if !again { break }
                }
                Err(_) => break
            }
        }
        wire.close()
    }

    fn reject(self, wire: Wire, error: Error) -> Result<Bool, Error> {
        var status = 0
        if error.kind == ErrorKind.InvalidData { status = 400 }
        if error.kind == ErrorKind.Unsupported { status = if error.message.starts_with("body") { 413 } else { 431 } }
        if status > 0 { write_response(wire, Response.text(status, error.message), false, false) }
        return Ok(false)
    }

    // One request and its response; whether the connection stays open.
    fn exchange(self, var reader: Reader) -> Result<Bool, Error> {
        let wire = reader.wire
        var found: Request? = null
        match read_request(reader, wire.peer_addr(), self.max_body) {
            Ok(request) => {
                found = request
            }
            Err(error) => {
                return self.reject(wire, error)
            }
        }
        if found == null { return Ok(false) }
        let request = found!
        let handler = self.handler
        let head_only = request.method == "HEAD"
        let asked = if head_only { Request { method: "GET", target: request.target, path: request.path, query: request.query, version: request.version, headers: request.headers, body: request.body, peer: request.peer } } else { request }
        let response = handler(asked)
        if response.upgrade { return self.upgrade(reader, request) }
        let keep = wants_keep_alive(request) && response.header("connection") != "close"
        write_response(wire, response, keep, head_only)?
        return Ok(keep)
    }

    fn upgrade(self, var reader: Reader, request: Request) -> Result<Bool, Error> {
        let wire = reader.wire
        let sockets = self.sockets
        let key = request.header("sec-websocket-key")
        let wanted = request.header("upgrade")
        if sockets == null || key == null || wanted == null || !wanted.to_lower().contains("websocket") || request.header("sec-websocket-version") != "13" {
            write_response(wire, Response.text(400, "not a WebSocket request"), false, false)?
            return Ok(false)
        }
        wire.set_timeout(-1)
        wire.write("HTTP/1.1 101 Switching Protocols\r\nupgrade: websocket\r\nconnection: Upgrade\r\nsec-websocket-accept: ${accept_key(key)}\r\n\r\n".bytes())?
        var socket = WebSocket.new(reader, false)
        sockets(request, socket)
        return Ok(false)
    }
}

