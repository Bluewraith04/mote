// How serious a record is.
import { Display, Eq, Ord } from std.traits

pub enum Level: (Eq, Ord, Display) {
    Debug
    Info
    Warn
    Error

    /// 0 for Debug to 3 for Error.
    pub fn number(self) -> Int {
        return match self {
            Debug => 0
            Info => 1
            Warn => 2
            Error => 3
        }
    }

    pub fn eq(self, other: Level) -> Bool { return self.number() == other.number() }
    pub fn compare(self, other: Level) -> Int { return self.number() - other.number() }

    pub fn to_string(self) -> String {
        return match self {
            Debug => "DEBUG"
            Info => "INFO"
            Warn => "WARN"
            Error => "ERROR"
        }
    }
}

