// Reading JSON text.
import { parse_float, parse_int } from std.string
import Json from .value

fn is_space(b: UInt8) -> Bool { return b == 32 || b == 10 || b == 13 || b == 9 }
fn is_digit(b: Int) -> Bool { return b >= 48 && b <= 57 }

// The value of a hex digit, or -1.
fn hex_value(b: UInt8) -> Int {
    let code = b as Int
    if code >= 48 && code <= 57 { return code - 48 }
    if code >= 97 && code <= 102 { return code - 87 }
    if code >= 65 && code <= 70 { return code - 55 }
    return -1
}

// The UTF-8 bytes of a code point.
fn utf8(code: Int, var out: List<UInt8>) {
    if code < 128 {
        out.push(code as UInt8)
    } else if code < 2048 {
        out.push((192 + code / 64) as UInt8)
        out.push((128 + code % 64) as UInt8)
    } else if code < 65536 {
        out.push((224 + code / 4096) as UInt8)
        out.push((128 + code / 64 % 64) as UInt8)
        out.push((128 + code % 64) as UInt8)
    } else {
        out.push((240 + code / 262144) as UInt8)
        out.push((128 + code / 4096 % 64) as UInt8)
        out.push((128 + code / 64 % 64) as UInt8)
        out.push((128 + code % 64) as UInt8)
    }
}

class Reader {
    source: String
    bytes: [UInt8]
    var at: Int

    fn fail(self, what: String) -> Error {
        return Error.new(ErrorKind.InvalidData, "${what} at ${self.at}")
    }

    // The byte at the position, or -1 at the end.
    fn peek(self) -> Int {
        if self.at >= self.bytes.len() { return -1 }
        return self.bytes.get(self.at) as Int
    }

    fn skip(var self) {
        while self.at < self.bytes.len() && is_space(self.bytes.get(self.at)) {
            self.at += 1
        }
    }

    fn expect(var self, code: Int, what: String) -> Result<Null, Error> {
        if self.peek() != code { return Err(self.fail(what)) }
        self.at += 1
        return Ok(null)
    }

    fn word(var self, text: String, result: Json) -> Result<Json, Error> {
        let end = self.at + text.len()
        if end > self.bytes.len() || self.source.slice(self.at, end) != text {
            return Err(self.fail("unexpected character"))
        }
        self.at = end
        return Ok(result)
    }

    fn value(var self, depth: Int) -> Result<Json, Error> {
        if depth > 256 { return Err(self.fail("nested too deeply")) }
        self.skip()
        let code = self.peek()
        if code == 123 { return self.object(depth) }
        if code == 91 { return self.array(depth) }
        if code == 34 { return Ok(Json.Text(self.string()?)) }
        if code == 116 { return self.word("true", Json.Boolean(true)) }
        if code == 102 { return self.word("false", Json.Boolean(false)) }
        if code == 110 { return self.word("null", Json.Null) }
        if code == 45 || is_digit(code) { return self.number() }
        if code == -1 { return Err(self.fail("unexpected end")) }
        return Err(self.fail("unexpected character"))
    }

    fn array(var self, depth: Int) -> Result<Json, Error> {
        self.at += 1
        var items: List<Json> = []
        self.skip()
        if self.peek() == 93 {
            self.at += 1
            return Ok(Json.Array(items))
        }
        while true {
            items.push(self.value(depth + 1)?)
            self.skip()
            if self.peek() == 44 {
                self.at += 1
            } else {
                self.expect(93, "expected , or ]")?
                return Ok(Json.Array(items))
            }
        }
        return Ok(Json.Array(items))
    }

    fn object(var self, depth: Int) -> Result<Json, Error> {
        self.at += 1
        var members: List<(String, Json)> = []
        self.skip()
        if self.peek() == 125 {
            self.at += 1
            return Ok(Json.Object(members))
        }
        while true {
            self.skip()
            if self.peek() != 34 { return Err(self.fail("expected a member name")) }
            let name = self.string()?
            self.skip()
            self.expect(58, "expected :")?
            members.push((name, self.value(depth + 1)?))
            self.skip()
            if self.peek() == 44 {
                self.at += 1
            } else {
                self.expect(125, "expected , or }")?
                return Ok(Json.Object(members))
            }
        }
        return Ok(Json.Object(members))
    }

    fn unit(var self) -> Result<Int, Error> {
        var code = 0
        var count = 0
        while count < 4 {
            if self.at >= self.bytes.len() { return Err(self.fail("unexpected end")) }
            let digit = hex_value(self.bytes.get(self.at))
            if digit < 0 { return Err(self.fail("expected a hex digit")) }
            code = code * 16 + digit
            self.at += 1
            count += 1
        }
        return Ok(code)
    }

    fn string(var self) -> Result<String, Error> {
        self.at += 1
        var out: List<UInt8> = []
        while true {
            if self.at >= self.bytes.len() { return Err(self.fail("unterminated string")) }
            let b = self.bytes.get(self.at)
            self.at += 1
            if b == 34 {
                let made = String.from_bytes(out.to_array())
                if made == null { return Err(self.fail("text is not UTF-8")) }
                return Ok(made)
            }
            if b < 32 { return Err(self.fail("control character in a string")) }
            if b != 92 {
                out.push(b)
                continue
            }
            if self.at >= self.bytes.len() { return Err(self.fail("unterminated string")) }
            let escape = self.bytes.get(self.at) as Int
            self.at += 1
            if escape == 34 {
                out.push(34)
            } else if escape == 92 {
                out.push(92)
            } else if escape == 47 {
                out.push(47)
            } else if escape == 98 {
                out.push(8)
            } else if escape == 102 {
                out.push(12)
            } else if escape == 110 {
                out.push(10)
            } else if escape == 114 {
                out.push(13)
            } else if escape == 116 {
                out.push(9)
            } else if escape == 117 {
                var code = self.unit()?
                if code >= 55296 && code <= 56319 {
                    if self.peek() != 92 { return Err(self.fail("lone surrogate")) }
                    self.at += 1
                    self.expect(117, "lone surrogate")?
                    let low = self.unit()?
                    if low < 56320 || low > 57343 { return Err(self.fail("lone surrogate")) }
                    code = 65536 + (code - 55296) * 1024 + (low - 56320)
                } else if code >= 56320 && code <= 57343 {
                    return Err(self.fail("lone surrogate"))
                }
                utf8(code, out)
            } else {
                return Err(self.fail("bad escape"))
            }
        }
        return Ok("")
    }

    fn digits(var self) -> Int {
        var count = 0
        while is_digit(self.peek()) {
            self.at += 1
            count += 1
        }
        return count
    }

    fn number(var self) -> Result<Json, Error> {
        let start = self.at
        var real = false
        if self.peek() == 45 { self.at += 1 }
        if self.peek() == 48 {
            self.at += 1
        } else if self.digits() == 0 {
            return Err(self.fail("expected a digit"))
        }
        if self.peek() == 46 {
            real = true
            self.at += 1
            if self.digits() == 0 { return Err(self.fail("expected a digit")) }
        }
        if self.peek() == 101 || self.peek() == 69 {
            real = true
            self.at += 1
            if self.peek() == 43 || self.peek() == 45 { self.at += 1 }
            if self.digits() == 0 { return Err(self.fail("expected a digit")) }
        }
        let text = self.source.slice(start, self.at)
        if !real {
            let whole = parse_int(text)
            if whole.is_ok() { return Ok(Json.Integer(whole?)) }
        }
        return Ok(Json.Real(parse_float(text)?))
    }
}

/// The value the text holds; an `Err` names the place of the first mistake.
pub fn parse(text: String) -> Result<Json, Error> {
    var reader = Reader { source: text, bytes: text.bytes(), at: 0 }
    let value = reader.value(0)?
    reader.skip()
    if reader.at != reader.bytes.len() { return Err(reader.fail("unexpected character")) }
    return Ok(value)
}

