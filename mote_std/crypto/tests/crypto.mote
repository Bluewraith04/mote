import { assert, assert_eq } from std.test
import { Algorithm, Digest, Hasher, equal, from_hex, hash, hash_text, hkdf, hmac, to_hex } from crypto

test "sha-256 gives the published digests" {
    assert_eq(hash_text(Algorithm.Sha256, "").to_hex(), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    assert_eq(hash_text(Algorithm.Sha256, "abc").to_hex(), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    assert_eq(hash_text(Algorithm.Sha256, "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq").to_hex(), "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")
}

test "sha-384 and sha-512 give the published digests" {
    assert_eq(hash_text(Algorithm.Sha384, "abc").to_hex(), "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7")
    assert_eq(hash_text(Algorithm.Sha512, "abc").to_hex(), "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")
}

test "a digest is as long as its algorithm says" {
    assert_eq(hash_text(Algorithm.Sha256, "x").len(), Algorithm.Sha256.size())
    assert_eq(hash_text(Algorithm.Sha384, "x").len(), 48)
    assert_eq(hash_text(Algorithm.Sha512, "x").len(), 64)
}

test "a hasher fed in pieces gives the digest of the whole" {
    let hasher = Hasher.new(Algorithm.Sha256)
    hasher.update_text("a")
    hasher.update("bc".bytes())
    assert_eq(hasher.finish().to_hex(), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    assert(hasher.close().is_err(), "finished")
}

test "a hasher closed unfinished is freed once" {
    let hasher = Hasher.new(Algorithm.Sha512)
    hasher.update_text("never finished")
    assert(hasher.close().is_ok(), "closed")
    assert(hasher.close().is_err(), "twice")
}

test "a long input hashes the same in one piece and in many" {
    let hasher = Hasher.new(Algorithm.Sha256)
    let piece: [UInt8] = [97; 1000]
    for _ in 0..1000 {
        hasher.update(piece)
    }
    assert_eq(hasher.finish().to_hex(), "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0")
}

test "hmac gives the rfc 4231 tags" {
    let key = "Jefe".bytes()
    let data = "what do ya want for nothing?".bytes()
    assert_eq(hmac(Algorithm.Sha256, key, data).to_hex(), "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
    assert_eq(hmac(Algorithm.Sha384, key, data).to_hex(), "af45d2e376484031617f78d2b58a6b1b9c7ef464f5a01b47e42ec3736322445e8e2240ca5e69e2c78b3239ecfab21649")
    assert_eq(hmac(Algorithm.Sha512, key, data).to_hex(), "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737")
}

test "hmac takes a key longer than the block" {
    let key: [UInt8] = [170; 131]
    let data = "Test Using Larger Than Block-Size Key - Hash Key First".bytes()
    assert_eq(hmac(Algorithm.Sha256, key, data).to_hex(), "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54")
}

test "digest compares in constant time and formats as hex" {
    let a: Digest = hash_text(Algorithm.Sha256, "abc")
    let b: Digest = hash(Algorithm.Sha256, "abc".bytes())
    let c: Digest = hash_text(Algorithm.Sha256, "abd")
    let d: Digest = hash_text(Algorithm.Sha384, "abc")
    assert(a == b, "equal digests")
    assert(a != c, "different bytes")
    assert(a != d, "different algorithms")
    assert_eq("${a}", a.to_hex())
    assert_eq(a.bytes().len(), 32)
}

test "hkdf gives the rfc 5869 keys" {
    let secret: [UInt8] = [11; 22]
    let salt = from_hex("000102030405060708090a0b0c")!
    let info = from_hex("f0f1f2f3f4f5f6f7f8f9")!
    assert_eq(to_hex(hkdf(Algorithm.Sha256, secret, salt, info, 42)!), "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865")
    let empty: [UInt8] = []
    assert_eq(to_hex(hkdf(Algorithm.Sha256, secret, empty, empty, 42)!), "8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8")
}

test "hkdf refuses a length above 255 digests" {
    let secret: [UInt8] = [1; 8]
    let empty: [UInt8] = []
    assert(hkdf(Algorithm.Sha256, secret, empty, empty, 8161).is_err(), "too long")
    assert_eq(hkdf(Algorithm.Sha256, secret, empty, empty, 8160)!.len(), 8160)
    assert_eq(hkdf(Algorithm.Sha512, secret, empty, empty, 0)!.len(), 0)
}

test "equal compares whole byte strings" {
    assert(equal("abc".bytes(), "abc".bytes()), "same")
    assert(!equal("abc".bytes(), "abd".bytes()), "last differs")
    assert(!equal("abc".bytes(), "ab".bytes()), "length differs")
    let empty: [UInt8] = []
    assert(equal(empty, empty), "empty")
}

test "hex round trips in either case" {
    let bytes = from_hex("00FFa5")!
    assert_eq(bytes.len(), 3)
    assert_eq(to_hex(bytes), "00ffa5")
    assert(from_hex("abc").is_err(), "odd")
    assert(from_hex("zz").is_err(), "digit")
}
