// A key or the mouse.
import Display from std.traits
import KeyEvent from .key
import MouseEvent from .mouse

/// A key or the mouse.
pub enum Event: (Display) {
    Key(KeyEvent)
    Mouse(MouseEvent)

    pub fn to_string(self) -> String {
        return match self {
            Key(event) => event.to_string()
            Mouse(event) => event.to_string()
        }
    }
}
