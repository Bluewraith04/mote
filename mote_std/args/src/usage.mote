// The usage text of a record.
import Kind from std.reflect
import join from std.string
import Flag from .flag
import { ScalarKind, Spec, specs_of } from ._spec

fn placeholder(spec: Spec) -> String {
    match spec.scalar {
        ScalarKind.Int => return "INT"
        ScalarKind.Float => return "NUMBER"
        ScalarKind.Enum => return join(spec.enum_names, "|")
        _ => return "TEXT"
    }
}

// A name and its help in two columns; a name with no help is not padded.
fn row(name: String, help: String, width: Int) -> String {
    if help == "" { return name }
    return name + " ".repeat(width - name.len()) + "  " + help
}

/// The usage text of `T`: the synopsis, the doc of the type, the positional arguments and the options with their help and defaults.
pub fn usage<T>(program: String, flags: List<Flag> = []) -> Result<String, Error> {
    const info = @type_info(T)
    if info.kind != Kind.Struct && info.kind != Kind.Class {
        return Err(Error.new(ErrorKind.InvalidData, "args: ${info.name} is not a struct or class"))
    }
    let specs = specs_of<T>(flags)?
    var synopsis = "Usage: ${program} [OPTIONS]"
    var left: List<String> = []
    var right: List<String> = []
    var positional_left: List<String> = []
    var positional_right: List<String> = []
    for spec in specs {
        var note = spec.help
        if spec.default_text != null && !spec.is_switch {
            note = (if note == "" { "" } else { note + " " }) + "[default: ${spec.default_text!}]"
        }
        if spec.positional {
            let name = spec.long.to_upper()
            let optional = spec.is_optional || spec.is_list || spec.default_text != null
            let shown = (if optional { "[" } else { "<" }) + name + (if spec.is_list { "..." } else { "" }) + (if optional { "]" } else { ">" })
            synopsis = synopsis + " " + shown
            positional_left.push("  " + shown)
            positional_right.push(note)
        } else {
            let short = if spec.short_name == "" { "    " } else { "-${spec.short_name}, " }
            let value = if spec.is_switch { "" } else { " <" + placeholder(spec) + ">" }
            left.push("  " + short + "--" + spec.long + value)
            right.push(note)
        }
    }
    left.push("  -h, --help")
    right.push("Show this help")
    var width = 0
    for each in left { if each.len() > width { width = each.len() } }
    for each in positional_left { if each.len() > width { width = each.len() } }
    var lines: List<String> = [synopsis]
    if info.doc != "" {
        lines.push("")
        lines.push(info.doc)
    }
    if positional_left.len() > 0 {
        lines.push("")
        lines.push("Arguments:")
        for at in 0..positional_left.len() {
            lines.push(row(positional_left[at], positional_right[at], width))
        }
    }
    lines.push("")
    lines.push("Options:")
    for at in 0..left.len() {
        lines.push(row(left[at], right[at], width))
    }
    return Ok(join(lines, "\n") + "\n")
}
