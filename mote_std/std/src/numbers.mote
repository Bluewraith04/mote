// Methods and trait conformances for Bool and Int.
import std.numeric as n
import { Clone, Debug, Display, Eq, Ord } from std.traits

extend Bool: (Display, Debug, Eq, Clone) {
    pub fn eq(self, other: Bool) -> Bool { return self == other }
    pub fn clone(self) -> Bool { return self }
    pub fn debug(self) -> String { return self.to_string() }
    pub fn to_string(self) -> String {
        if self { return "true" }
        return "false"
    }
}

extend Int: (Display, Debug, Eq, Ord, Clone) {
    pub fn eq(self, other: Int) -> Bool { return self == other }
    pub fn compare(self, other: Int) -> Int {
        if self < other { return -1 }
        if self > other { return 1 }
        return 0
    }
    pub fn clone(self) -> Int { return self }
    pub fn debug(self) -> String { return n.to_string(self) }
    pub fn abs(self) -> Int {
        if self < 0 { return -self }
        return self
    }
    pub fn min(self, other: Int) -> Int {
        if other < self { return other }
        return self
    }
    pub fn max(self, other: Int) -> Int {
        if other > self { return other }
        return self
    }
    pub fn to_string(self) -> String { return n.to_string(self) }
    pub fn from(x: Float) -> Int { return x as Int }
    pub fn from(x: Bool) -> Int { return x as Int }

    pub fn wrapping_add(self, other: Int) -> Int { return n.wrapping_add(self, other) }
    pub fn wrapping_sub(self, other: Int) -> Int { return n.wrapping_sub(self, other) }
    pub fn wrapping_mul(self, other: Int) -> Int { return n.wrapping_mul(self, other) }
    pub fn wrapping_neg(self) -> Int { return n.wrapping_neg(self) }
    pub fn wrapping_shl(self, bits: Int) -> Int { return n.wrapping_shl(self, bits) }
    pub fn wrapping_shr(self, bits: Int) -> Int { return n.wrapping_shr(self, bits) }

    pub fn checked_add(self, other: Int) -> Int? { return n.checked_add(self, other) }
    pub fn checked_sub(self, other: Int) -> Int? { return n.checked_sub(self, other) }
    pub fn checked_mul(self, other: Int) -> Int? { return n.checked_mul(self, other) }
    pub fn checked_neg(self) -> Int? { return n.checked_neg(self) }
    pub fn checked_shl(self, bits: Int) -> Int? { return n.checked_shl(self, bits) }
    pub fn checked_shr(self, bits: Int) -> Int? { return n.checked_shr(self, bits) }

    pub fn saturating_add(self, other: Int) -> Int { return n.saturating_add(self, other) }
    pub fn saturating_sub(self, other: Int) -> Int { return n.saturating_sub(self, other) }
    pub fn saturating_mul(self, other: Int) -> Int { return n.saturating_mul(self, other) }
    pub fn saturating_neg(self) -> Int { return n.saturating_neg(self) }
    pub fn saturating_shl(self, bits: Int) -> Int { return n.saturating_shl(self, bits) }
    pub fn saturating_shr(self, bits: Int) -> Int { return n.saturating_shr(self, bits) }

    pub fn overflowing_add(self, other: Int) -> (Int, Bool) { return n.overflowing_add(self, other) }
    pub fn overflowing_sub(self, other: Int) -> (Int, Bool) { return n.overflowing_sub(self, other) }
    pub fn overflowing_mul(self, other: Int) -> (Int, Bool) { return n.overflowing_mul(self, other) }
    pub fn overflowing_neg(self) -> (Int, Bool) { return n.overflowing_neg(self) }
    pub fn overflowing_shl(self, bits: Int) -> (Int, Bool) { return n.overflowing_shl(self, bits) }
    pub fn overflowing_shr(self, bits: Int) -> (Int, Bool) { return n.overflowing_shr(self, bits) }
}
