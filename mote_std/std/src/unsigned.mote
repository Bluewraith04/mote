// Methods and trait conformances for sized unsigned integers.
import std.numeric as n
import { Clone, Debug, Display, Eq, Ord } from std.traits

extend UInt8: (Display, Debug, Eq, Ord, Clone) {
    pub fn eq(self, other: UInt8) -> Bool { return self == other }
    pub fn compare(self, other: UInt8) -> Int {
        if self < other { return -1 }
        if self > other { return 1 }
        return 0
    }
    pub fn clone(self) -> UInt8 { return self }
    pub fn debug(self) -> String { return n.to_string(self) }
    pub fn min(self, other: UInt8) -> UInt8 {
        if other < self { return other }
        return self
    }
    pub fn max(self, other: UInt8) -> UInt8 {
        if other > self { return other }
        return self
    }
    pub fn to_string(self) -> String { return n.to_string(self) }

    pub fn wrapping_add(self, other: UInt8) -> UInt8 { return n.wrapping_add(self, other) }
    pub fn wrapping_sub(self, other: UInt8) -> UInt8 { return n.wrapping_sub(self, other) }
    pub fn wrapping_mul(self, other: UInt8) -> UInt8 { return n.wrapping_mul(self, other) }
    pub fn wrapping_neg(self) -> UInt8 { return n.wrapping_neg(self) }
    pub fn wrapping_shl(self, bits: Int) -> UInt8 { return n.wrapping_shl(self, bits) }
    pub fn wrapping_shr(self, bits: Int) -> UInt8 { return n.wrapping_shr(self, bits) }

    pub fn checked_add(self, other: UInt8) -> UInt8? { return n.checked_add(self, other) }
    pub fn checked_sub(self, other: UInt8) -> UInt8? { return n.checked_sub(self, other) }
    pub fn checked_mul(self, other: UInt8) -> UInt8? { return n.checked_mul(self, other) }
    pub fn checked_neg(self) -> UInt8? { return n.checked_neg(self) }
    pub fn checked_shl(self, bits: Int) -> UInt8? { return n.checked_shl(self, bits) }
    pub fn checked_shr(self, bits: Int) -> UInt8? { return n.checked_shr(self, bits) }

    pub fn saturating_add(self, other: UInt8) -> UInt8 { return n.saturating_add(self, other) }
    pub fn saturating_sub(self, other: UInt8) -> UInt8 { return n.saturating_sub(self, other) }
    pub fn saturating_mul(self, other: UInt8) -> UInt8 { return n.saturating_mul(self, other) }
    pub fn saturating_neg(self) -> UInt8 { return n.saturating_neg(self) }
    pub fn saturating_shl(self, bits: Int) -> UInt8 { return n.saturating_shl(self, bits) }
    pub fn saturating_shr(self, bits: Int) -> UInt8 { return n.saturating_shr(self, bits) }

    pub fn overflowing_add(self, other: UInt8) -> (UInt8, Bool) { return n.overflowing_add(self, other) }
    pub fn overflowing_sub(self, other: UInt8) -> (UInt8, Bool) { return n.overflowing_sub(self, other) }
    pub fn overflowing_mul(self, other: UInt8) -> (UInt8, Bool) { return n.overflowing_mul(self, other) }
    pub fn overflowing_neg(self) -> (UInt8, Bool) { return n.overflowing_neg(self) }
    pub fn overflowing_shl(self, bits: Int) -> (UInt8, Bool) { return n.overflowing_shl(self, bits) }
    pub fn overflowing_shr(self, bits: Int) -> (UInt8, Bool) { return n.overflowing_shr(self, bits) }
}

