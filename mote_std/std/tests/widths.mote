test "Int has every method" {
    let a = -7
    let b = 3
    assert(a.eq(a) && !a.eq(b), "eq")
    assert_eq(a.clone().debug(), "-7")
    assert_eq("${word(a.checked_add(b))} ${word(a.checked_sub(b))} ${word(a.checked_mul(b))} ${word(a.checked_neg())} ${word(a.checked_shl(1))} ${word(a.checked_shr(1))}", "-4 -10 -21 7 -14 -4")
    assert_eq("${a.overflowing_add(b)} ${a.overflowing_sub(b)} ${a.overflowing_mul(b)} ${a.overflowing_neg()} ${a.overflowing_shl(1)} ${a.overflowing_shr(1)}", "(-4, false) (-10, false) (-21, false) (7, false) (-14, false) (-4, false)")
}

test "UInt8 has every method" {
    let a: UInt8 = 5
    let b: UInt8 = 2
    assert(a.eq(a) && !a.eq(b), "eq")
    assert_eq(a.compare(b), 1)
    assert_eq(a.clone().debug(), "5")
    assert_eq("${a.min(b)} ${a.max(b)} ${a.to_string()}", "2 5 5")
    assert_eq("${a.wrapping_add(b)} ${a.wrapping_sub(b)} ${a.wrapping_mul(b)} ${a.wrapping_neg()} ${a.wrapping_shl(1)} ${a.wrapping_shr(1)}", "7 3 10 251 10 2")
    assert_eq("${word(a.checked_add(b))} ${word(a.checked_sub(b))} ${word(a.checked_mul(b))} ${word(a.checked_neg())} ${word(a.checked_shl(1))} ${word(a.checked_shr(1))}", "7 3 10 null 10 2")
    assert_eq("${a.saturating_add(b)} ${a.saturating_sub(b)} ${a.saturating_mul(b)} ${a.saturating_neg()} ${a.saturating_shl(1)} ${a.saturating_shr(1)}", "7 3 10 0 10 2")
    assert_eq("${a.overflowing_add(b)} ${a.overflowing_sub(b)} ${a.overflowing_mul(b)} ${a.overflowing_neg()} ${a.overflowing_shl(1)} ${a.overflowing_shr(1)}", "(7, false) (3, false) (10, false) (251, true) (10, false) (2, false)")
}

