test "UInt64 has every method" {
    let a: UInt64 = 5
    let b: UInt64 = 2
    assert(a.eq(a) && !a.eq(b), "eq")
    assert_eq(a.compare(b), 1)
    assert_eq(a.clone().debug(), "5")
    assert_eq("${a.min(b)} ${a.max(b)} ${a.to_string()}", "2 5 5")
    assert_eq("${a.wrapping_add(b)} ${a.wrapping_sub(b)} ${a.wrapping_mul(b)} ${a.wrapping_neg()} ${a.wrapping_shl(1)} ${a.wrapping_shr(1)}", "7 3 10 18446744073709551611 10 2")
    assert_eq("${word(a.checked_add(b))} ${word(a.checked_sub(b))} ${word(a.checked_mul(b))} ${word(a.checked_neg())} ${word(a.checked_shl(1))} ${word(a.checked_shr(1))}", "7 3 10 null 10 2")
    assert_eq("${a.saturating_add(b)} ${a.saturating_sub(b)} ${a.saturating_mul(b)} ${a.saturating_neg()} ${a.saturating_shl(1)} ${a.saturating_shr(1)}", "7 3 10 0 10 2")
    assert_eq("${a.overflowing_add(b)} ${a.overflowing_sub(b)} ${a.overflowing_mul(b)} ${a.overflowing_neg()} ${a.overflowing_shl(1)} ${a.overflowing_shr(1)}", "(7, false) (3, false) (10, false) (18446744073709551611, true) (10, false) (2, false)")
}

test "Float, Float32, Bool and String have eq, clone and debug" {
    let x: Float = 1.5
    assert(x.eq(1.5) && !x.eq(2.0), "Float eq")
    assert_eq(x.clone().debug(), "1.5")
    let y: Float32 = -1.5
    assert(y.eq(y) && !y.eq(2.0), "Float32 eq")
    assert_eq(y.compare(2.0), -1)
    assert_eq(y.clone().debug(), "-1.5")
    assert_eq("${y.abs()} ${y.min(2.0)}", "1.5 -1.5")
    assert(!y.is_infinite(), "finite")
    assert(true.eq(true) && !true.eq(false), "Bool eq")
    assert_eq(true.clone().debug(), "true")
    assert("a".eq("a") && !"a".eq("b"), "String eq")
    assert_eq("a".clone().debug(), "a")
}
