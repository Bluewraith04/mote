// Every method of the sized integers, Float32, Bool and String, called by name.
import { assert, assert_eq } from std.test
import Display from std.traits

fn word<T: Display>(value: T?) -> String {
    if let Some(v) = value {
        return v.to_string()
    }
    return "null"
}

test "Int8 has every method" {
    let a: Int8 = -7
    let b: Int8 = 3
    assert(a.eq(a) && !a.eq(b), "eq")
    assert_eq(a.compare(b), -1)
    assert_eq(a.clone().debug(), "-7")
    assert_eq("${a.abs()} ${a.min(b)} ${a.max(b)} ${a.to_string()}", "7 -7 3 -7")
    assert_eq("${a.wrapping_add(b)} ${a.wrapping_sub(b)} ${a.wrapping_mul(b)} ${a.wrapping_neg()} ${a.wrapping_shl(1)} ${a.wrapping_shr(1)}", "-4 -10 -21 7 -14 -4")
    assert_eq("${word(a.checked_add(b))} ${word(a.checked_sub(b))} ${word(a.checked_mul(b))} ${word(a.checked_neg())} ${word(a.checked_shl(1))} ${word(a.checked_shr(1))}", "-4 -10 -21 7 -14 -4")
    assert_eq("${a.saturating_add(b)} ${a.saturating_sub(b)} ${a.saturating_mul(b)} ${a.saturating_neg()} ${a.saturating_shl(1)} ${a.saturating_shr(1)}", "-4 -10 -21 7 -14 -4")
    assert_eq("${a.overflowing_add(b)} ${a.overflowing_sub(b)} ${a.overflowing_mul(b)} ${a.overflowing_neg()} ${a.overflowing_shl(1)} ${a.overflowing_shr(1)}", "(-4, false) (-10, false) (-21, false) (7, false) (-14, false) (-4, false)")
}

