// List, arrays, Map and Set.
import { assert, assert_eq } from std.test
import { set_from, union, intersection, difference, map_from, merge, map_values, filter_keys } from std.collections

test "a list grows and shrinks" {
    var xs: List<Int> = []
    assert(xs.is_empty(), "starts empty")
    xs.push(1)
    xs.push(2)
    xs.push(3)
    assert_eq(xs.len(), 3)
    assert_eq(xs.pop()!, 3)
    assert_eq(xs.len(), 2)
    xs.clear()
    assert(xs.pop() == null, "pop on empty")
}

test "first, last and get_or" {
    let xs = [10, 20, 30]
    assert_eq(xs.first()!, 10)
    assert_eq(xs.last()!, 30)
    assert_eq(xs.get(1), 20)
    assert_eq(xs.get_or(5, -1), -1)
    assert_eq(xs.get_or(-1, -1), -1)
    let none: List<Int> = []
    assert(none.first() == null, "no first")
    assert(none.last() == null, "no last")
}

test "set and index write an element" {
    var xs = [1, 2, 3]
    xs.set(0, 9)
    xs[1] = 8
    assert(xs == [9, 8, 3], "both writes")
}

test "contains and slice" {
    let xs = [1, 2, 3, 4]
    assert(xs.contains(3), "contains")
    assert(!xs.contains(9), "does not contain")
    assert(xs.slice(1, 3) == [2, 3], "slice")
    assert(xs[1..3] == [2, 3], "slice syntax")
    assert(xs[..2] == [1, 2], "open start")
}

test "set_slice replaces a range" {
    var xs = [1, 2, 3, 4]
    xs.set_slice(1, 3, [7, 8])
    assert(xs == [1, 7, 8, 4], "replaced")
}

test "clone is shallow and deep_clone copies everything" {
    var inner = [1]
    var outer = [inner]
    let shallow = outer.clone()
    let deep = outer.deep_clone()
    inner.push(2)
    assert_eq(shallow[0].len(), 2)
    assert_eq(deep[0].len(), 1)
    outer.push([5])
    assert_eq(shallow.len(), 1)
}

test "an index out of range is a fault in a task" {
    let h = spawn {
        let xs = [1]
        return xs[3]
    }
    assert(h.await().is_err(), "the task faults")
}

test "a list streams its elements" {
    var total = 0
    for x in [1, 2, 3].stream() { total += x }
    assert_eq(total, 6)
    assert([4, 5].stream().collect() == [4, 5], "collect")
}

test "an array has a fixed length" {
    var a = [0; 3]
    a[1] = 5
    assert_eq(a.len(), 3)
    assert_eq(a.get(1), 5)
    assert(a.contains(5), "contains")
    assert_eq(a.get_or(9, -1), -1)
    let part = a.slice(1, 3)
    assert_eq(part.len(), 2)
    let copy = a.clone()
    a[0] = 7
    assert_eq(copy[0], 0)
}

test "a map keeps insertion order" {
    var m: Map<String, Int> = {}
    m.set("b", 2)
    m.set("a", 1)
    m.set("c", 3)
    assert(m.keys() == ["b", "a", "c"], "keys")
    assert(m.values() == [2, 1, 3], "values")
    m.set("b", 20)
    assert(m.keys() == ["b", "a", "c"], "an update keeps the place")
    assert_eq(m.get("b"), 20)
}

test "a map looks up, removes and clears" {
    var m = {"a": 1, "b": 2}
    assert_eq(m.len(), 2)
    assert(m.contains_key("a"), "has a")
    assert(!m.contains_key("z"), "no z")
    assert_eq(m.get_or("z", -1), -1)
    assert_eq(m["a"], 1)
    m.remove("a")
    assert(!m.contains_key("a"), "removed")
    m.clear()
    assert(m.is_empty(), "cleared")
}

test "map items are pairs" {
    let m = {"x": 1, "y": 2}
    var text = ""
    for (key, value) in m.items() { text = text + key + value.to_string() }
    assert_eq(text, "x1y2")
}

test "a map compares by value and clones" {
    let a = {"k": 1}
    var b = a.clone()
    assert(a == b, "equal")
    b.set("k", 2)
    assert(a != b, "changed")
    assert_eq(a.get("k"), 1)
}

test "map helpers" {
    let m = map_from([("a", 1), ("b", 2)])
    assert_eq(m.get("b"), 2)
    let both = merge(m, {"b": 20, "c": 30})
    assert(both.keys() == ["a", "b", "c"], "merged keys")
    assert_eq(both.get("b"), 20)
    let doubled = map_values(m, |v| v * 2)
    assert_eq(doubled.get("b"), 4)
    let only_a = filter_keys(m, |k| k == "a")
    assert_eq(only_a.len(), 1)
}

test "a set holds each value once" {
    var s: Set<Int> = Set<Int>()
    s.add(1)
    s.add(2)
    s.add(1)
    assert_eq(s.len(), 2)
    assert(s.contains(2), "has 2")
    assert(s == set_from([1, 2]), "equal set")
    assert(s != set_from([1]), "different set")
    s.remove(2)
    assert(!s.contains(2), "removed")
    assert(s.items() == [1], "items")
    s.clear()
    assert(s.is_empty(), "cleared")
}

test "set operations" {
    let a = set_from([1, 2, 3])
    let b = set_from([3, 4])
    assert(union(a, b).items() == [1, 2, 3, 4], "union")
    assert(intersection(a, b).items() == [3], "intersection")
    assert(difference(a, b).items() == [1, 2], "difference")
    assert(set_from([1, 1, 2]).len() == 2, "duplicates")
}

test "a range holds its ends" {
    let r = 2..5
    assert_eq(r.start, 2)
    assert_eq(r.end, 5)
    assert(!r.inclusive, "exclusive")
    assert((2..=5).inclusive, "inclusive")
}

test "a range iterates" {
    var total = 0
    for i in 1..4 { total += i }
    for i in 1..=4 { total += i }
    assert_eq(total, 16)
}

test "a deep clone of a set is a set of its own" {
    var s: Set<Int> = Set<Int>()
    s.add(1)
    s.add(2)
    var copy = s.deep_clone()
    copy.add(3)
    assert_eq(s.len(), 2)
    assert_eq(copy.len(), 3)
    assert(copy.contains(1) && !s.contains(3), "contents")
}
