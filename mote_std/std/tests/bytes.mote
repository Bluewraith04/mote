// Conversions between arrays and lists, and the byte buffer.
import { assert, assert_eq } from std.test
import Bytes from std.bytes

test "a list becomes an array and back" {
    let xs = [3, 1, 2]
    let array = xs.to_array()
    assert_eq(array.len(), 3)
    assert_eq(array.get(0), 3)
    assert_eq(array.get(2), 2)
    let again = array.to_list()
    assert_eq(again.len(), 3)
    assert_eq(again.get(1), 1)
}

test "an empty list and an empty array convert" {
    let none: List<Int> = []
    assert_eq(none.to_array().len(), 0)
    let nothing: [Int] = []
    assert(nothing.to_list().is_empty(), "empty")
}

test "a converted array is a copy" {
    var xs = [1, 2, 3]
    let array = xs.to_array()
    xs.set(0, 9)
    assert_eq(array.get(0), 1)
}

test "a string is made from valid bytes only" {
    assert_eq(String.from_bytes("hi".bytes())!, "hi")
    let bad: [UInt8] = [255, 254]
    assert(String.from_bytes(bad) == null, "not UTF-8")
}

test "bytes grow and read back" {
    var b = Bytes.new()
    assert(b.is_empty(), "starts empty")
    b.push(104)
    b.push(105)
    assert_eq(b.len(), 2)
    assert_eq(b.get(0), 104)
    assert_eq(b[0], 104)
    b.set(1, 110)
    b[1] = 111
    assert_eq(b.to_string()!, "ho")
    assert_eq(b.pop()!, 111)
    assert_eq(b.len(), 1)
    b.clear()
    assert(b.is_empty(), "cleared")
}

test "bytes compare by value" {
    let a = Bytes.from_string("ok")
    var b = Bytes.from_string("ok")
    assert(a == b, "equal contents")
    b[0] = 79
    assert(a != b, "different contents")
}

test "bytes are made from an array or a string and extended" {
    var b = Bytes.from_string("ab")
    b.extend("cd".bytes())
    b.append(Bytes.from_array("ef".bytes()))
    assert_eq(b.to_string()!, "abcdef")
    assert_eq(b.slice(1, 3).to_string()!, "bc")
    assert_eq(b.to_array().len(), 6)
}

test "a clone of bytes is a copy" {
    var a = Bytes.from_string("x")
    let b = a.clone()
    a.push(121)
    assert_eq(a.len(), 2)
    assert_eq(b.len(), 1)
}

test "bytes that are not text give none" {
    var b = Bytes.new()
    b.push(255)
    assert(b.to_string() == null, "not UTF-8")
}
