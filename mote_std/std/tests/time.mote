// Durations, instants on the scheduler clock, and sleeping for a duration.
import { assert, assert_eq } from std.test
import { Duration, Instant, sleep } from std.time

test "a duration is made in each unit and read back" {
    assert_eq(Duration.from_secs(2).as_millis(), 2000)
    assert_eq(Duration.from_millis(3).as_micros(), 3000)
    assert_eq(Duration.from_micros(4).as_nanos(), 4000)
    assert_eq(Duration.from_nanos(5000000000).as_secs(), 5)
}

test "durations add, subtract and multiply" {
    let a = Duration.from_millis(1500)
    let b = Duration.from_millis(500)
    assert_eq(a.add(b).as_millis(), 2000)
    assert_eq((a + b).as_millis(), 2000)
    assert_eq(a.sub(b).as_millis(), 1000)
    assert_eq((a - b).as_millis(), 1000)
    assert_eq((b - a).as_nanos(), 0)
    assert_eq(b.mul(3).as_millis(), 1500)
    assert_eq((b * 3).as_millis(), 1500)
    assert_eq((3 * b).as_millis(), 1500)
    assert_eq((a / 3).as_millis(), 500)
}

test "durations compare and show their unit" {
    let short = Duration.from_millis(1)
    let long = Duration.from_secs(1)
    assert(short < long, "short")
    assert(short <= long, "short le")
    assert(long > short, "long")
    assert(long >= short, "long ge")
    assert_eq(short.compare(Duration.from_micros(1000)), 0)
    assert(short == Duration.from_micros(1000), "equal")
    assert(short <= Duration.from_micros(1000), "equal le")
    assert_eq(long.to_string(), "1s")
    assert_eq(short.to_string(), "1ms")
    assert_eq(Duration.from_micros(7).to_string(), "7us")
    assert_eq(Duration.from_nanos(9).to_string(), "9ns")
}

test "an instant moves by a duration and measures the span" {
    let start = Instant.now()
    let later = start + Duration.from_secs(1)
    let earlier = Duration.from_secs(1) + start
    assert(later == earlier, "commutative add")
    assert_eq(later.since(start).as_millis(), 1000)
    assert(start.add(Duration.from_secs(1)) == later, "add matches +")
    assert_eq((later - start).as_millis(), 1000)
    assert_eq((start - later).as_nanos(), 0)
    assert(start < later, "order")
    assert(later >= start, "order ge")
}

test "a sleep moves the clock by at least its duration" {
    let start = Instant.now()
    sleep(Duration.from_millis(30))
    assert(start.elapsed().as_millis() >= 30, "slept")
    sleep(Duration.from_nanos(1))
    assert(start.elapsed().as_millis() >= 31, "rounded up")
}
