// Reading and writing the bytes of an archive.
import { Format as Packing, compress, decompress } from compress
import { Entry, EntryKind, Format } from .entry
import { failed, field, format_code, kind_code, kind_of, text_of } from ._codes
import { archive_count, archive_free, archive_info, archive_read, archive_writer_add, archive_writer_finish, archive_writer_free, archive_writer_new, archive_writer_take } from ._lib

/// The entries of an archive in order. `limit` bounds the bytes of contents (of the unpacked tar for `TarGz`), -1 for none; an `Err` for a bad archive or one over the limit.
pub fn read(format: Format, bytes: [UInt8], limit: Int = -1) -> Result<List<Entry>, Error> {
    var source = bytes
    if format == Format.TarGz { source = decompress(Packing.Gzip, bytes, limit)? }
    var error: [UInt8] = [0; 256]
    let handle = archive_read(format_code(format), source, limit, error)
    if handle < 0 { return Err(failed(handle, error)) }
    var entries: List<Entry> = []
    for index in 0..archive_count(handle) {
        var info: [Int] = [0; 6]
        archive_info(handle, index, info)
        entries.push(Entry {
            path: text_of(field(handle, index, 0, info[3])),
            kind: kind_of(info[0]),
            mode: info[1],
            mtime: info[2],
            target: text_of(field(handle, index, 1, info[4])),
            data: field(handle, index, 2, info[5])
        })
    }
    archive_free(handle)
    return Ok(entries)
}

/// The bytes of an archive holding the entries in order. An `Err` for a link in a zip other than a symbolic one, or a path that is not valid.
pub fn write(format: Format, entries: List<Entry>) -> Result<[UInt8], Error> {
    let handle = archive_writer_new(format_code(format))
    var error: [UInt8] = [0; 256]
    for entry in entries {
        let code = archive_writer_add(handle, kind_code(entry.kind), entry.mode, entry.mtime, entry.path.bytes(), entry.target.bytes(), entry.data, error)
        if code < 0 {
            archive_writer_free(handle)
            return Err(failed(code, error))
        }
    }
    let size = archive_writer_finish(handle, error)
    if size < 0 {
        archive_writer_free(handle)
        return Err(failed(size, error))
    }
    var out: [UInt8] = [0; size]
    archive_writer_take(handle, out)
    archive_writer_free(handle)
    if format == Format.TarGz { return compress(Packing.Gzip, out) }
    return Ok(out)
}
