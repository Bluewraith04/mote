// The system source of random bytes.
import random_fill from ._lib

/// `count` bytes from the system's source, which is meant for keys and seeds.
pub fn system_bytes(count: Int) -> Result<[UInt8], Error> {
    let buffer: [UInt8] = [0; count]
    if count > 0 && random_fill(buffer) < 0 { return Err(Error.new(ErrorKind.Other, "the system source of random bytes failed")) }
    return Ok(buffer)
}

/// A random integer from the system's source.
pub fn system_int() -> Result<Int, Error> {
    let bytes = system_bytes(8)?
    var bits: UInt64 = 0
    for at in 0..8 {
        bits = (bits << 8) | (bytes[at] as UInt64)
    }
    return Ok(bits as Int)
}
