// The functions of the external library `process`.

extern "process" {
    pub fn process_spawn(program: String, argv: [UInt8], envp: [UInt8], env_inherit: Int, cwd: String, modes: Int, fds: [UInt8]) -> Int

    @blocking
    pub fn process_wait(pid: Int) -> Int

    pub fn process_try_wait(pid: Int) -> Int
    pub fn process_kill(pid: Int, number: Int) -> Int

    @blocking
    pub fn process_read(fd: Int, buffer: [UInt8], count: Int) -> Int

    @blocking
    pub fn process_write(fd: Int, bytes: [UInt8], count: Int) -> Int

    pub fn process_close(fd: Int) -> Int
}
