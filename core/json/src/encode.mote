// The JSON of a Mote value.
import { Dyn, Field, Kind, Shape, Type, build_dyn, describe, downcast } from std.meta
import { Json } from .value

fn cannot(ty: String) -> Error {
    return Error.new(ErrorKind.InvalidData, "${ty} cannot be encoded as JSON")
}

// An integer of any width the encoding knows, or null.
fn integer_of(d: Dyn) -> Int? {
    let plain = downcast<Int>(d)
    if plain != null { return plain }
    let a = downcast<Int8>(d)
    if a != null { return a as Int }
    let b = downcast<Int16>(d)
    if b != null { return b as Int }
    let c = downcast<Int32>(d)
    if c != null { return c as Int }
    let e = downcast<UInt8>(d)
    if e != null { return e as Int }
    let f = downcast<UInt16>(d)
    if f != null { return f as Int }
    let g = downcast<UInt32>(d)
    if g != null { return g as Int }
    return null
}

fn parts_of(d: Dyn, depth: Int) -> Result<List<Json>, Error> {
    var out: List<Json> = []
    for at in 0..d.len() {
        out.push(encode_dyn(d.get(at), depth + 1)?)
    }
    return Ok(out)
}

fn encode_fields(names: List<String>, d: Dyn, depth: Int) -> Result<Json, Error> {
    var members: List<(String, Json)> = []
    for at in 0..names.len() {
        members.push((names[at], encode_dyn(d.get(at), depth + 1)?))
    }
    return Ok(Json.Object(members))
}

fn encode_dyn(d: Dyn, depth: Int) -> Result<Json, Error> {
    let ty = d.ty()
    let kind = ty.kind()
    if depth > 256 { return Err(Error.new(ErrorKind.InvalidData, "a value nested too deeply to encode as JSON")) }
    if kind == Kind.Null { return Ok(Json.Null) }
    if kind == Kind.Bool { return Ok(Json.Boolean(downcast<Bool>(d)!)) }
    if kind == Kind.Int {
        let number = integer_of(d)
        if number == null { return Err(cannot(ty.name())) }
        return Ok(Json.Integer(number))
    }
    if kind == Kind.Float {
        var number = 0.0
        let wide = downcast<Float>(d)
        if wide != null {
            number = wide
        } else {
            let narrow = downcast<Float32>(d)
            if narrow == null { return Err(cannot(ty.name())) }
            number = narrow as Float
        }
        if number != number || number - number != 0.0 { return Err(Error.new(ErrorKind.InvalidData, "a Float that is not finite cannot be encoded as JSON")) }
        return Ok(Json.Real(number))
    }
    if kind == Kind.String { return Ok(Json.Text(downcast<String>(d)!)) }
    if kind == Kind.Tuple || kind == Kind.List || kind == Kind.Array || kind == Kind.Set { return Ok(Json.Array(parts_of(d, depth)?)) }
    if kind == Kind.Map {
        if ty.args()[0].kind() != Kind.String { return Err(cannot(ty.name())) }
        var members: List<(String, Json)> = []
        for at in 0..d.len() / 2 {
            members.push((downcast<String>(d.get(at * 2))!, encode_dyn(d.get(at * 2 + 1), depth + 1)?))
        }
        return Ok(Json.Object(members))
    }
    if kind == Kind.Optional {
        if d.len() == 0 { return Ok(Json.Null) }
        return encode_dyn(d.get(0), depth + 1)
    }
    if kind == Kind.Struct || kind == Kind.Class {
        var names: List<String> = []
        for field in ty.fields() {
            names.push(field.name)
        }
        return encode_fields(names, d, depth)
    }
    if kind == Kind.Enum {
        let variant = ty.variants()[d.tag()]
        if variant.shape == Shape.Unit { return Ok(Json.Text(variant.name)) }
        var inner = Json.Null
        if variant.shape == Shape.Named {
            var names: List<String> = []
            for field in variant.fields {
                names.push(field.name)
            }
            inner = encode_fields(names, d, depth)?
        } else if d.len() == 1 {
            inner = encode_dyn(d.get(0), depth + 1)?
        } else {
            inner = Json.Array(parts_of(d, depth)?)
        }
        return Ok(Json.Object([(variant.name, inner)]))
    }
    return Err(cannot(ty.name()))
}

/// The JSON of a value: a struct or class is an object of its fields, a tuple, list, array or set an array, a map with `String` keys an object, an optional its value or null, a unit variant its name, and any other variant an object with its name as the one key. A map with other keys, a union, function or handle is an `Err`.
pub fn encode<T>(value: T) -> Result<Json, Error> {
    return encode_dyn(Dyn.of(value), 0)
}

/// `to_json()` on any type that lists it.
pub trait ToJson {
    fn to_json(self) -> Result<Json, Error> { return encode(self) }
}

