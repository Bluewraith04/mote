// The functions of the native library `crypto`.

@link("crypto")
pub native fn crypto_hasher_new(algorithm: Int) -> Int

@link("crypto")
pub native fn crypto_hasher_update(handle: Int, data: [UInt8]) -> Int

@link("crypto")
pub native fn crypto_hasher_finish(handle: Int, out: [UInt8]) -> Int

@link("crypto")
pub native fn crypto_hasher_free(handle: Int) -> Int

@link("crypto")
pub native fn crypto_hmac(algorithm: Int, key: [UInt8], data: [UInt8], out: [UInt8]) -> Int

@link("crypto")
pub native fn crypto_hkdf(algorithm: Int, salt: [UInt8], secret: [UInt8], info: [UInt8], length: Int, out: [UInt8]) -> Int

@link("crypto")
pub native fn crypto_equal(a: [UInt8], b: [UInt8]) -> Int

