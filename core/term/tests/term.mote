import { assert, assert_eq } from std.test
import { join } from std.string
import { Color, Pty, Terminal, bg, bold, clear_line, clear_screen, decode_input, disable_mouse, enable_mouse, enter_alternate_screen, fg, hide_cursor, leave_alternate_screen, move_to, paint, reset_style, show_cursor, Style } from term

let ESC = "\u{1b}"

// Every event in the text as one line, `?` for bytes that mean nothing and `...` for a sequence that stops short.
fn events(text: String) -> String {
    var bytes = text.bytes()
    var words: List<String> = []
    while bytes.len() > 0 {
        let (event, used) = decode_input(bytes)
        if used == 0 {
            words.push("...")
            break
        }
        words.push(if event == null { "?" } else { event.to_string() })
        bytes = bytes.slice(used, bytes.len())
    }
    return join(words, " ")
}

test "plain keys decode" {
    assert_eq(events("ab"), "a b")
    assert_eq(events("A"), "A")
    assert_eq(events("\r"), "Enter")
    assert_eq(events("\t"), "Tab")
    assert_eq(events("\u{7f}"), "Backspace")
    assert_eq(events("é€😀"), "é € 😀")
}

test "control keys decode as the letter with Ctrl" {
    assert_eq(events("\u{1}\u{3}\u{1a}"), "Ctrl+a Ctrl+c Ctrl+z")
    assert_eq(events("\u{0}"), "Ctrl+ ")
    assert_eq(events("\u{1c}"), "Ctrl+\\")
}

test "arrow and editing keys decode" {
    assert_eq(events("${ESC}[A${ESC}[B${ESC}[C${ESC}[D"), "Up Down Right Left")
    assert_eq(events("${ESC}[H${ESC}[F${ESC}[2~${ESC}[3~${ESC}[5~${ESC}[6~"), "Home End Insert Delete PageUp PageDown")
    assert_eq(events("${ESC}OA${ESC}OH${ESC}OF"), "Up Home End")
    assert_eq(events("${ESC}[1~${ESC}[4~"), "Home End")
    assert_eq(events("${ESC}[Z"), "Shift+BackTab")
}

test "function keys decode" {
    assert_eq(events("${ESC}OP${ESC}OQ${ESC}OR${ESC}OS"), "F1 F2 F3 F4")
    assert_eq(events("${ESC}[11~${ESC}[15~${ESC}[17~${ESC}[21~${ESC}[23~${ESC}[24~"), "F1 F5 F6 F10 F11 F12")
    assert_eq(events("${ESC}[1;2P"), "Shift+F1")
}

test "modifiers decode from the parameter and from an escape before the key" {
    assert_eq(events("${ESC}[1;2A"), "Shift+Up")
    assert_eq(events("${ESC}[1;3A"), "Alt+Up")
    assert_eq(events("${ESC}[1;5C"), "Ctrl+Right")
    assert_eq(events("${ESC}[1;8D"), "Ctrl+Alt+Shift+Left")
    assert_eq(events("${ESC}[3;5~"), "Ctrl+Delete")
    assert_eq(events("${ESC}x"), "Alt+x")
    assert_eq(events("${ESC}${ESC}[A"), "Alt+Up")
    assert_eq(events("${ESC}\r"), "Alt+Enter")
}

test "mouse reports decode with the cell counted from the top left" {
    assert_eq(events("${ESC}[<0;10;5M"), "Press(0) at 4,9")
    assert_eq(events("${ESC}[<0;10;5m"), "Release(0) at 4,9")
    assert_eq(events("${ESC}[<2;1;1M"), "Press(2) at 0,0")
    assert_eq(events("${ESC}[<32;3;4M"), "Drag(0) at 3,2")
    assert_eq(events("${ESC}[<35;3;4M"), "Move(0) at 3,2")
    assert_eq(events("${ESC}[<64;7;8M${ESC}[<65;7;8M"), "ScrollUp(0) at 7,6 ScrollDown(0) at 7,6")
}

test "a sequence that stops short asks for more and one that means nothing is dropped" {
    assert_eq(events("${ESC}"), "...")
    assert_eq(events("${ESC}["), "...")
    assert_eq(events("${ESC}[1;"), "...")
    assert_eq(events("a${ESC}[1"), "a ...")
    assert_eq(events("${ESC}[99y"), "?")
    assert_eq(events("${ESC}[99~a"), "? a")
}

test "escape output is the sequences terminals know" {
    assert_eq(clear_screen(), "${ESC}[2J${ESC}[H")
    assert_eq(clear_line(), "${ESC}[2K")
    assert_eq(move_to(0, 0), "${ESC}[1;1H")
    assert_eq(move_to(4, 9), "${ESC}[5;10H")
    assert_eq(hide_cursor() + show_cursor(), "${ESC}[?25l${ESC}[?25h")
    assert_eq(enter_alternate_screen() + leave_alternate_screen(), "${ESC}[?1049h${ESC}[?1049l")
    assert_eq(enable_mouse(), "${ESC}[?1000h${ESC}[?1002h${ESC}[?1006h")
    assert_eq(disable_mouse(), "${ESC}[?1006l${ESC}[?1002l${ESC}[?1000l")
    assert_eq(bold() + reset_style(), "${ESC}[1m${ESC}[0m")
}

test "colours name the foreground and background codes" {
    assert_eq(fg(Color.Red), "${ESC}[31m")
    assert_eq(fg(Color.Default), "${ESC}[39m")
    assert_eq(bg(Color.Blue), "${ESC}[44m")
    assert_eq(fg(Color.Indexed(200)), "${ESC}[38;5;200m")
    assert_eq(bg(Color.Rgb(1, 2, 3)), "${ESC}[48;2;1;2;3m")
}

test "a styled span is the text between the codes that set the style and the reset" {
    assert_eq(paint("ok").to_string(), "${ESC}[0m${ESC}[39m${ESC}[49mok${ESC}[0m")
    assert_eq("${paint("hot").fg(Color.Red).bold()}", "${ESC}[0m${ESC}[31m${ESC}[49m${ESC}[1mhot${ESC}[0m")
    assert_eq(paint("x").bg(Color.Blue).italic().underline().look.codes(), "${ESC}[0m${ESC}[39m${ESC}[44m${ESC}[3m${ESC}[4m")
}

test "styles compare by how they look" {
    assert(Style {}.same(Style { fg: Color.Default }), "same")
    assert(!Style {}.same(Style { dim: true }), "differs")
}

test "a terminal writes the sequences for the screen, the cursor and the mouse" {
    let pty = Pty.open()!
    let terminal = pty.terminal()
    terminal.alternate_screen(true)!
    terminal.clear()!
    terminal.goto(1, 2)!
    terminal.cursor(false)!
    terminal.mouse(true)!
    terminal.print(paint("hi").bold())!
    terminal.mouse(false)!
    terminal.cursor(true)!
    terminal.alternate_screen(false)!
    var seen = ""
    while true {
        let more = pty.read(200)!
        if more == "" { break }
        seen = seen + more
    }
    let want = enter_alternate_screen() + clear_screen() + move_to(1, 2) + hide_cursor() + enable_mouse() + paint("hi").bold().to_string() + disable_mouse() + show_cursor() + leave_alternate_screen()
    assert_eq(seen, want)
    pty.close()!
}

test "a pseudo-terminal is a terminal with a size" {
    let pty = Pty.open()!
    let terminal = pty.terminal()
    assert(terminal.is_tty(), "tty")
    pty.resize(24, 80)!
    let size = terminal.size()!
    assert_eq(size.rows, 24)
    assert_eq(size.cols, 80)
    pty.close()!
    pty.close()!
}

test "raw mode delivers keys as they are typed" {
    let pty = Pty.open()!
    var terminal = pty.terminal()
    terminal.raw()!
    pty.send("a")!
    pty.send("${ESC}[A")!
    pty.send("${ESC}[<0;2;3M")!
    assert_eq(terminal.read_event(1000)!!.to_string(), "a")
    assert_eq(terminal.read_event(1000)!!.to_string(), "Up")
    assert_eq(terminal.read_event(1000)!!.to_string(), "Press(0) at 2,1")
    assert(terminal.read_event(20)! == null, "timeout")
    terminal.close()!
    pty.close()!
}

test "a lone escape is told from the start of a sequence by waiting" {
    let pty = Pty.open()!
    var terminal = pty.terminal()
    terminal.raw()!
    pty.send(ESC)!
    assert_eq(terminal.read_event(1000)!!.to_string(), "Escape")
    pty.send("${ESC}[")!
    pty.send("B")!
    assert_eq(terminal.read_event(1000)!!.to_string(), "Down")
    terminal.close()!
    pty.close()!
}

test "a key typed before raw mode is held for a line and released by raw mode" {
    let pty = Pty.open()!
    var terminal = pty.terminal()
    pty.send("x")!
    assert(terminal.read_event(100)! == null, "held by line editing")
    terminal.raw()!
    pty.send("y")!
    assert_eq(terminal.read_event(1000)!!.to_string(), "x")
    assert_eq(terminal.read_event(1000)!!.to_string(), "y")
    terminal.close()!
    pty.close()!
}

test "output written to the terminal reaches the other end untouched in raw mode" {
    let pty = Pty.open()!
    let terminal = pty.terminal()
    terminal.raw()!
    terminal.write("one\ntwo")!
    assert_eq(pty.read(1000)!, "one\ntwo")
    terminal.close()!
    terminal.write("a\nb")!
    assert_eq(pty.read(1000)!, "a\r\nb")
    pty.close()!
}

test "a descriptor that is no terminal is told so" {
    let terminal = Terminal.on(-1, -1)
    assert(!terminal.is_tty(), "tty")
    assert(terminal.size().is_err(), "size")
    assert(terminal.raw().is_err(), "raw")
    assert(terminal.close().is_ok(), "close")
}
