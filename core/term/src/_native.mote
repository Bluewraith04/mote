// The functions of the native library `term`.

@link("term")
pub native fn term_is_tty(fd: Int) -> Int

@link("term")
pub native fn term_size(fd: Int, out: [Int]) -> Int

@link("term")
pub native fn term_set_size(fd: Int, rows: Int, cols: Int) -> Int

@link("term")
pub native fn term_raw(fd: Int, saved: [UInt8]) -> Int

@link("term")
pub native fn term_restore(fd: Int, saved: [UInt8]) -> Int

@blocking
@link("term")
pub native fn term_read(fd: Int, buffer: [UInt8], timeout_ms: Int) -> Int

@blocking
@link("term")
pub native fn term_write(fd: Int, buffer: [UInt8], count: Int) -> Int

@link("term")
pub native fn term_close(fd: Int) -> Int

@link("term")
pub native fn term_pty(out: [Int]) -> Int
