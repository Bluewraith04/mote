import ..src.lib as compress

fn same(a: Bytes, b: Bytes) -> Bool {
    if a.len() != b.len() { return false }
    var i = 0
    while i < a.len() {
        if a.get(i) != b.get(i) { return false }
        i = i + 1
    }
    return true
}

fn text(n: Int) -> Bytes {
    var b = Bytes()
    var i = 0
    while i < n {
        b.push(97 + i % 7)
        i = i + 1
    }
    return b
}

test "each format round trips and shrinks repeating data" {
    let data = text(5000)
    let g = compress.gzip(data)
    let z = compress.zlib(data)
    let d = compress.deflate(data)
    assert(same(compress.gunzip(g).unwrap(), data))
    assert(same(compress.unzlib(z).unwrap(), data))
    assert(same(compress.inflate(d).unwrap(), data))
    assert(g.len() < 200 && z.len() < 200 && d.len() < 200)
    assert(g.get(0) == 31 && g.get(1) == 139)
    assert(z.get(0) == 120)
    assert_eq(compress.gunzip(compress.gzip(Bytes())).unwrap().len(), 0)
}

test "levels trade size for effort and clamp" {
    let data = text(20000)
    let stored = compress.gzip_level(data, 0)
    let best = compress.gzip_level(data, 9)
    assert(stored.len() > data.len())
    assert(best.len() < stored.len())
    assert(same(compress.gunzip(stored).unwrap(), data))
    assert(same(compress.gunzip(compress.gzip_level(data, 99)).unwrap(), data))
    assert(same(compress.gunzip(compress.gzip_level(data, -5)).unwrap(), data))
}

test "bad data is an error" {
    let junk = "not compressed".bytes()
    assert(compress.gunzip(junk).is_err())
    assert(compress.unzlib(junk).is_err())
    assert(compress.inflate(junk).is_err())
    assert(compress.gunzip(compress.zlib(junk)).is_err())
    let g = compress.gzip(text(1000))
    assert(compress.gunzip(g.slice(0, g.len() - 6)).is_err())
}
