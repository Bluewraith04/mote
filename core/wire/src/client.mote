/// Makes HTTP calls and returns their responses.

import std.json as jsonlib
import std.string as strings
import { Json, JsonCodec } from std.json
import { open_package, bind, bind_blocking } from std.libtools
import .answers

/// A finished exchange.
pub class Response {
    pub status: Int
    pub url: String
    pub body: Bytes
    headers: List<String>

    /// An answer from its parts; `headers` is a flat list of lowercase names and values.
    pub fn of(status: Int, url: String, headers: List<String>, body: Bytes) -> Response {
        return Response { status: status, url: url, body: body, headers: headers }
    }

    /// Whether the status is 200 to 299.
    pub fn ok(self) -> Bool { return self.status >= 200 && self.status < 300 }

    /// The first header called `name` (any case), if there is one.
    pub fn header(self, name: String) -> Option<String> {
        let want = name.to_lower()
        var i = 0
        while i < self.headers.len() {
            let have: String = self.headers.get(i)
            if have == want {
                let value: String = self.headers.get(i + 1)
                return Some(value)
            }
            i = i + 2
        }
        return None
    }

    /// The body as text; an `Err` if it is not UTF-8.
    pub fn text(self) -> Result<String, Error> {
        match self.body.decode() {
            Some(t) => { return Ok(t) }
            None => { return Err(Error.new(ErrorKind.InvalidData, "the response body is not UTF-8")) }
        }
    }

    /// The body parsed as JSON.
    pub fn json(self) -> Result<Json, Error> {
        let t = self.text()?
        return jsonlib.parse(t)
    }

    /// This response when the status is 2xx, else an `Err` naming the status.
    pub fn error_for_status(self) -> Result<Response, Error> {
        if self.ok() { return Ok(self) }
        var kind = ErrorKind.Other
        if self.status == 404 { kind = ErrorKind.NotFound }
        if self.status == 401 || self.status == 403 { kind = ErrorKind.PermissionDenied }
        return Err(Error.new(kind, "HTTP ${self.status} for ${self.url}"))
    }
}

/// A reader over the library's answer.
class Cursor {
    b: Bytes
    var at: Int

    /// An Int ending at a space or newline, which it passes.
    fn number(var self) -> Int {
        var n = 0
        while self.b[self.at] != 10 && self.b[self.at] != 32 {
            n = n * 10 + (self.b[self.at] - 48)
            self.at = self.at + 1
        }
        self.at = self.at + 1
        return n
    }

    /// The text of a `<len>\n<bytes>` frame.
    fn text(var self) -> String {
        let n = self.number()
        let out = answers.text_of(self.b.slice(self.at, self.at + n))
        self.at = self.at + n
        return out
    }

    fn rest(self) -> Bytes { return self.b.slice(self.at, self.b.len()) }
}

fn frame(var out: Bytes, data: Bytes) {
    out.extend((data.len().to_string() + "\n").bytes())
    out.extend(data)
}

/// Sets a header in a flat list of names and values.
fn with_header(items: List<String>, name: String, value: String) -> List<String> {
    let lower = name.to_lower()
    var out: List<String> = []
    var i = 0
    while i < items.len() {
        let have: String = items.get(i)
        if have.to_lower() != lower {
            out.push(have)
            let kept: String = items.get(i + 1)
            out.push(kept)
        }
        i = i + 2
    }
    out.push(lower)
    out.push(value)
    return out
}

/// A request being built.
pub class ClientRequest {
    pub method: String
    pub url: String
    pub headers: List<String>
    pub payload: Bytes
    seconds: Int
    redirects: Int
    limit: Int
    pub failure: String

    fn changed(self, headers: List<String>, payload: Bytes, failure: String) -> ClientRequest {
        return ClientRequest {
            method: self.method, url: self.url, headers: headers, payload: payload,
            seconds: self.seconds, redirects: self.redirects, limit: self.limit, failure: failure,
        }
    }

    fn tuned(self, seconds: Int, redirects: Int, limit: Int) -> ClientRequest {
        return ClientRequest {
            method: self.method, url: self.url, headers: self.headers, payload: self.payload,
            seconds: seconds, redirects: redirects, limit: limit, failure: self.failure,
        }
    }

    /// Aims at another `method` and `url`, keeping the headers, body and settings.
    pub fn to(self, method: String, url: String) -> ClientRequest {
        return ClientRequest {
            method: method.to_upper(), url: url, headers: self.headers, payload: self.payload,
            seconds: self.seconds, redirects: self.redirects, limit: self.limit, failure: self.failure,
        }
    }

    /// Sets a header, replacing one of the same name.
    pub fn header(self, name: String, value: String) -> ClientRequest {
        return self.changed(with_header(self.headers, name, value), self.payload, self.failure)
    }

    /// The body as given bytes.
    pub fn body(self, data: Bytes) -> ClientRequest {
        return self.changed(self.headers, data, self.failure)
    }

    /// The body as UTF-8 text, with a text content type unless one is set.
    pub fn text(self, content: String) -> ClientRequest {
        return self.changed(with_header(self.headers, "content-type", "text/plain; charset=utf-8"), content.bytes(), self.failure)
    }

    /// Sets the body as JSON text.
    pub fn json(self, value: Json) -> ClientRequest {
        match jsonlib.to_text(value) {
            Ok(t) => { return self.changed(with_header(self.headers, "content-type", "application/json"), t.bytes(), self.failure) }
            Err(e) => { return self.changed(self.headers, self.payload, e.message) }
        }
    }

    /// The body as a form (`a=1&b=2`, percent-encoded).
    pub fn form(self, fields: Map<String, String>) -> ClientRequest {
        let encoded = query(fields)
        return self.changed(with_header(self.headers, "content-type", "application/x-www-form-urlencoded"), encoded.bytes(), self.failure)
    }

    /// Gives up after `seconds` in total (30 by default).
    pub fn timeout(self, seconds: Int) -> ClientRequest {
        return self.tuned(seconds, self.redirects, self.limit)
    }

    /// Follows at most `n` redirects.
    pub fn max_redirects(self, n: Int) -> ClientRequest {
        return self.tuned(self.seconds, n, self.limit)
    }

    /// Reads at most `bytes` of response body (64 MiB by default); more is an `Err`.
    pub fn max_body(self, bytes: Int) -> ClientRequest {
        return self.tuned(self.seconds, self.redirects, bytes)
    }

    /// Makes the call and waits for the whole answer.
    pub fn send(self) -> Result<Response, Error> {
        if self.failure != "" { return Err(Error.new(ErrorKind.InvalidData, self.failure)) }
        var input = Bytes()
        var headers: List<String> = []
        input.extend((self.seconds * 1000).to_string().bytes())
        input.extend((" " + self.redirects.to_string() + " " + self.limit.to_string() + " " + (self.headers.len() / 2).to_string() + "\n").bytes())
        frame(input, self.method.bytes())
        frame(input, self.url.bytes())
        for h in self.headers { frame(input, h.bytes()) }
        frame(input, self.payload)
        let lib = open_package("wire", "mote_http")?
        let call = bind_blocking<(Bytes, Int, Bytes, Int) -> Int>(lib, "mote_http_request")?
        let take = bind<(Int, Bytes, Int) -> Int>(lib, "mote_http_take")?
        let small = Bytes(4096)
        let n = call(input, input.len(), small, small.len())
        if n < 0 { return Err(answers.fail(small, n)) }
        let head = Cursor { b: small.slice(0, n), at: 0 }
        let ticket = head.number()
        let size = head.number()
        let out = Bytes(size)
        let m = take(ticket, out, size)
        if m < 0 { return Err(answers.fail(out, m)) }
        let c = Cursor { b: out, at: 0 }
        let status = c.number()
        let count = c.number()
        var i = 0
        while i < count * 2 {
            headers.push(c.text())
            i = i + 1
        }
        return Ok(Response { status: status, url: self.url, body: c.rest(), headers: headers })
    }
}

/// A request for `method` (`"GET"`, `"PUT"`,...) and `url`.
pub fn request(method: String, url: String) -> ClientRequest {
    let none: List<String> = []
    return ClientRequest {
        method: method.to_upper(), url: url, headers: none, payload: Bytes(), seconds: 30, redirects: 10, limit: 67108864, failure: "",
    }
}

fn hex(n: Int) -> String {
    return "0123456789ABCDEF".slice(n, n + 1)
}

/// Percent-encodes a string for a form.
fn encode(s: String) -> String {
    var out = ""
    let data = s.bytes()
    var i = 0
    while i < data.len() {
        let b = data[i]
        let plain = (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 42 || b == 45 || b == 46 || b == 95
        if plain {
            out = out + s.slice(i, i + 1)
        } else if b == 32 {
            out = out + "+"
        } else {
            out = out + "%" + hex(b / 16) + hex(b % 16)
        }
        i = i + 1
    }
    return out
}

/// Encodes a map as a query string or form body.
pub fn query(params: Map<String, String>) -> String {
    var parts: List<String> = []
    for k in params.keys() {
        parts.push(encode(k) + "=" + encode(params[k]))
    }
    return strings.join(parts, "&")
}

/// Resolves `path` under `base`.
fn joined(base: String, path: String) -> String {
    if path.starts_with("http://") || path.starts_with("https://") || base == "" { return path }
    var head = base
    while head.ends_with("/") { head = head.slice(0, head.len() - 1) }
    if path.starts_with("/") { return head + path }
    return head + "/" + path
}

/// Settings that every call shares.
pub class HttpClient {
    base_url: String
    headers: List<String>
    seconds: Int
    redirects: Int
    limit: Int

    /// A client with the default settings.
    pub fn new() -> HttpClient {
        let none: List<String> = []
        return HttpClient { base_url: "", headers: none, seconds: 30, redirects: 10, limit: 67108864 }
    }

    fn rebuilt(self, base_url: String, headers: List<String>) -> HttpClient {
        return HttpClient { base_url: base_url, headers: headers, seconds: self.seconds, redirects: self.redirects, limit: self.limit }
    }

    /// Paths given to the call methods go under `url`.
    pub fn base(self, url: String) -> HttpClient { return self.rebuilt(url, self.headers) }

    /// Sends a header with every call, replacing one of the same name.
    pub fn header(self, name: String, value: String) -> HttpClient {
        return self.rebuilt(self.base_url, with_header(self.headers, name, value))
    }

    /// Sends `authorization: Bearer token`.
    pub fn bearer(self, token: String) -> HttpClient { return self.header("authorization", "Bearer " + token) }

    /// Gives up each call after `seconds` in total (30 by default).
    pub fn timeout(self, seconds: Int) -> HttpClient {
        return HttpClient { base_url: self.base_url, headers: self.headers, seconds: seconds, redirects: self.redirects, limit: self.limit }
    }

    /// Follows at most `n` redirects (10 by default).
    pub fn max_redirects(self, n: Int) -> HttpClient {
        return HttpClient { base_url: self.base_url, headers: self.headers, seconds: self.seconds, redirects: n, limit: self.limit }
    }

    /// Reads at most `bytes` of response body (64 MiB by default).
    pub fn max_body(self, bytes: Int) -> HttpClient {
        return HttpClient { base_url: self.base_url, headers: self.headers, seconds: self.seconds, redirects: self.redirects, limit: bytes }
    }

    /// A request for `method` and `path` with this client's settings, to adjust and then `send()`.
    pub fn request(self, method: String, path: String) -> ClientRequest {
        var out = request(method, joined(self.base_url, path)).timeout(self.seconds).max_redirects(self.redirects).max_body(self.limit)
        var i = 0
        while i < self.headers.len() {
            let name: String = self.headers.get(i)
            let value: String = self.headers.get(i + 1)
            out = out.header(name, value)
            i = i + 2
        }
        return out
    }

    pub fn get(self, path: String) -> Result<Response, Error> { return self.request("GET", path).send() }

    pub fn head(self, path: String) -> Result<Response, Error> { return self.request("HEAD", path).send() }

    pub fn delete(self, path: String) -> Result<Response, Error> { return self.request("DELETE", path).send() }

    pub fn post(self, path: String, body: Bytes) -> Result<Response, Error> { return self.request("POST", path).body(body).send() }

    pub fn put(self, path: String, body: Bytes) -> Result<Response, Error> { return self.request("PUT", path).body(body).send() }

    pub fn patch(self, path: String, body: Bytes) -> Result<Response, Error> { return self.request("PATCH", path).body(body).send() }

    /// POST `value` as JSON.
    pub fn post_json(self, path: String, value: Json) -> Result<Response, Error> { return self.request("POST", path).json(value).send() }

    /// POST `fields` as a form.
    pub fn post_form(self, path: String, fields: Map<String, String>) -> Result<Response, Error> { return self.request("POST", path).form(fields).send() }
}

pub fn get(url: String) -> Result<Response, Error> { return HttpClient().get(url) }

/// Posts `value` as JSON.
pub fn post_json<B: JsonCodec>(url: String, value: B) -> Result<Response, Error> { return HttpClient().post_json(url, jsonlib.encode(value)) }

/// Sets `value` as the JSON body of `req`.
pub fn with_json<B: JsonCodec>(req: ClientRequest, value: B) -> ClientRequest { return req.json(jsonlib.encode(value)) }

/// Reads the JSON body of `resp` as an `R`.
pub fn json_as<R: JsonCodec>(resp: Response) -> Result<R, Error> {
    let j = resp.json()?
    return jsonlib.decode(j)
}
