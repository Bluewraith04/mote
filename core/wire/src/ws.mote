/// Sends and receives WebSocket messages over an upgraded connection.

import std.http_server as std_server
import { Stream } from std.stream
import { open_package, bind } from std.libtools
import .answers

/// One message from the peer.
pub enum Message {
    Text(String)
    Binary(Bytes)
    Close(Int, String)
}

let limit = "16777216"

fn call(op: Int, id: Int, input: Bytes, room: Int) -> Result<Bytes, Error> {
    let lib = open_package("wire", "mote_http")?
    let run = bind<(Int, Int, Bytes, Int, Bytes, Int) -> Int>(lib, "mote_ws")?
    var out = Bytes(room)
    var n = run(op, id, input, input.len(), out, room)
    if n < 0 { return Err(answers.fail(out, n)) }
    if n > room {
        out = Bytes(n)
        n = run(op, id, input, input.len(), out, n)
        if n < 0 { return Err(answers.fail(out, n)) }
    }
    return Ok(out.slice(0, n))
}

/// The `Sec-WebSocket-Accept` value for a client's `Sec-WebSocket-Key`.
pub fn accept_key(key: String) -> Result<String, Error> {
    let out = call(0, 0, key.bytes(), 64)?
    return Ok(answers.text_of(out))
}

/// Starts the framing for an upgraded connection.
pub fn open(up: std_server.Upgraded, early: Bytes) -> Result<Socket, Error> {
    let lib = open_package("wire", "mote_http")?
    let run = bind<(Int, Int, Bytes, Int, Bytes, Int) -> Int>(lib, "mote_ws")?
    let out = Bytes(256)
    let id = run(1, 0, limit.bytes(), limit.len(), out, out.len())
    if id < 0 { return Err(answers.fail(out, id)) }
    let ws = Socket { id: id, link: up }
    if early.len() > 0 { call(2, id, early, 0)? }
    return Ok(ws)
}

/// A WebSocket connection.
pub class Socket {
    /// Names this connection.
    pub id: Int
    link: std_server.Upgraded

    /// The messages as a stream.
    pub fn messages(self) -> Stream<Result<Message, Error>> {
        while true {
            match self.recv() {
                Ok(got) => {
                    match got {
                        Some(m) => { yield Ok(m) }
                        None => { return }
                    }
                }
                Err(e) => {
                    yield Err(e)
                    return
                }
            }
        }
    }

    fn flush(self) -> Result<Null, Error> {
        let out = call(4, self.id, Bytes(), 4096)?
        if out.len() > 0 { self.link.write(out)? }
        return Ok(null)
    }

    /// The next message, or `None` once the connection is finished.
    pub fn recv(self) -> Result<Message?, Error> {
        while true {
            match call(3, self.id, Bytes(), 4096) {
                Err(e) => {
                    let sent = self.flush()
                    return Err(e)
                }
                Ok(got) => {
                    if got.len() == 0 {
                        self.flush()?
                        let data = self.link.read(65536)?
                        if data.len() == 0 { return Ok(None) }
                        call(2, self.id, data, 0)?
                    } else {
                        self.flush()?
                        let kind = got[0]
                        let payload = got.slice(1, got.len())
                        if kind == 88 { return Ok(None) }
                        if kind == 84 {
                            match payload.decode() {
                                Some(text) => { return Ok(Some(Message.Text(text))) }
                                None => { return Err(Error.new(ErrorKind.InvalidData, "a text message is not UTF-8")) }
                            }
                        }
                        if kind == 66 { return Ok(Some(Message.Binary(payload))) }
                        let code = payload[0] * 256 + payload[1]
                        let reason = answers.text_of(payload.slice(2, payload.len()))
                        return Ok(Some(Message.Close(code, reason)))
                    }
                }
            }
        }
        return Ok(None)
    }

    /// Sends a text message.
    pub fn send_text(self, text: String) -> Result<Null, Error> {
        call(5, self.id, text.bytes(), 0)?
        return self.flush()
    }

    /// Sends a binary message.
    pub fn send_binary(self, data: Bytes) -> Result<Null, Error> {
        call(6, self.id, data, 0)?
        return self.flush()
    }

    /// Starts the closing handshake with a status code and a reason.
    pub fn close(self, code: Int, reason: String) -> Result<Null, Error> {
        let input = Bytes()
        input.push(code / 256)
        input.push(code % 256)
        input.extend(reason.bytes())
        call(7, self.id, input, 0)?
        return self.flush()
    }

    /// Frees the framing state and closes the connection.
    pub fn end(self) {
        let freed = call(8, self.id, Bytes(), 0)
        let closed = self.link.close()
    }
}
