import ..src.lib as wire

type Req = wire.Request<Null>
type Reply = Result<wire.Reply, Error>

fn who(req: Req) -> Reply {
    let auth = req.header("authorization").unwrap_or("none")
    let key = req.header("x-key").unwrap_or("none")
    return Ok(wire.Reply.text(200, "${auth}|${key}"))
}

fn serve<S>(app: wire.Server<S>) -> wire.Running {
    return app.start("127.0.0.1", 0).unwrap()
}

fn halt(r: wire.Running) {
    r.stop()
    let ended = r.wait()
}

fn base(r: wire.Running) -> String {
    return "http://127.0.0.1:${r.port()}"
}

test "a client sends its base, bearer and header with every call" {
    var app = wire.Server(null)
    app.get("/who", who)
    let r = serve(app)
    let api = wire.HttpClient().base(base(r)).bearer("tok").header("x-key", "7")
    assert_eq(api.get("/who").unwrap().text().unwrap(), "Bearer tok|7")
    assert_eq(api.get("who").unwrap().text().unwrap(), "Bearer tok|7")
    let plain = wire.get("${base(r)}/who").unwrap()
    assert_eq(plain.text().unwrap(), "none|none")
    let absolute = api.get("${base(r)}/who").unwrap()
    assert_eq(absolute.text().unwrap(), "Bearer tok|7")
    halt(r)
}

test "a request from a client takes its settings and can be adjusted" {
    var app = wire.Server(null)
    app.get("/who", who)
    let r = serve(app)
    let api = wire.HttpClient().base(base(r)).header("x-key", "1")
    let got = api.request("GET", "/who").header("x-key", "2").send().unwrap()
    assert_eq(got.text().unwrap(), "none|2")
    halt(r)
}

test "a refused connection is an error" {
    var app = wire.Server(null)
    app.get("/who", who)
    let r = serve(app)
    let gone = base(r)
    halt(r)
    assert(wire.HttpClient().timeout(5).get("${gone}/who").is_err())
}

test "the test client builds its request like the client does" {
    var app = wire.Server(null)
    app.get("/who", who)
    let got = app.test().get("/who").header("authorization", "Bearer x").header("x-key", "9").send().unwrap()
    assert_eq(got.text().unwrap(), "Bearer x|9")
}
