import std.json as json
import { JsonCodec } from std.json
import ..src.lib as wire

type Req = wire.Request<Null>
type Reply = Result<wire.Reply, Error>

struct Item: (JsonCodec) {
    name: String
    qty: Int
}

class Tally: (JsonCodec) {
    total: Int
    names: List<String>
    tags: Map<String, Int>
    note: String?
}

fn health(req: Req) -> Result<Item, Error> {
    return Ok(Item { name: "ok", qty: 0 })
}

fn create(req: Req, item: Item) -> Result<Item, Error> {
    if item.qty < 0 {
        return Err(Error.new(ErrorKind.InvalidData, "qty must not be negative").with_code("negative_qty"))
    }
    return Ok(item)
}

fn many(req: Req) -> Result<List<Item>, Error> {
    return Ok([Item { name: "a", qty: 1 }, Item { name: "b", qty: 2 }])
}

fn count(req: Req, items: List<Item>) -> Result<Int, Error> {
    var total = 0
    for item in items { total = total + item.qty }
    return Ok(total)
}

fn tally(req: Req, t: Tally) -> Result<Tally, Error> {
    return Ok(Tally { total: t.total + 1, names: t.names, tags: t.tags, note: t.note })
}

fn nothing(req: Req) -> Result<Null, Error> {
    return Ok(null)
}

fn fail(kind: ErrorKind) -> Result<Item, Error> {
    return Err(Error.new(kind, "no"))
}

fn e_invalid(req: Req) -> Result<Item, Error> { return fail(ErrorKind.InvalidData) }

fn e_missing(req: Req) -> Result<Item, Error> { return fail(ErrorKind.NotFound) }

fn e_denied(req: Req) -> Result<Item, Error> { return fail(ErrorKind.PermissionDenied) }

fn e_unauthenticated(req: Req) -> Result<Item, Error> { return fail(ErrorKind.Unauthenticated) }

fn e_conflict(req: Req) -> Result<Item, Error> { return fail(ErrorKind.Conflict) }

fn e_limited(req: Req) -> Result<Item, Error> { return fail(ErrorKind.RateLimited) }

fn e_unavailable(req: Req) -> Result<Item, Error> { return fail(ErrorKind.Unavailable) }

fn e_other(req: Req) -> Result<Item, Error> { return fail(ErrorKind.Other) }

fn raw_item(req: Req) -> Reply {
    return Ok(wire.json_reply(Item { name: "raw", qty: 9 }))
}

fn raw_created(req: Req) -> Reply {
    return Ok(wire.json_reply(Item { name: "raw", qty: 9 }, status = 201))
}

fn raw_missing(req: Req) -> Reply {
    return Err(Error.new(ErrorKind.InvalidData, "bad input"))
}

fn house(status: Int, e: Error) -> wire.Reply {
    return wire.Reply.text(status, "E:${e.message}")
}

fn typed_app() -> wire.Server<Null> {
    var app = wire.Server(null)
    app.get("/health", wire.typed(health))
    app.post("/items", wire.typed_body(create, status = 201))
    app.get("/items", wire.typed(many))
    app.post("/count", wire.typed_body(count))
    app.post("/tally", wire.typed_body(tally))
    app.get("/nothing", wire.typed(nothing))
    app.get("/raw", raw_item)
    app.get("/raw/created", raw_created)
    app.get("/raw/missing", raw_missing)
    app.get("/e/invalid", wire.typed(e_invalid))
    app.get("/e/missing", wire.typed(e_missing))
    app.get("/e/denied", wire.typed(e_denied))
    app.get("/e/unauthenticated", wire.typed(e_unauthenticated))
    app.get("/e/conflict", wire.typed(e_conflict))
    app.get("/e/limited", wire.typed(e_limited))
    app.get("/e/unavailable", wire.typed(e_unavailable))
    app.get("/e/other", wire.typed(e_other))
    return app
}

fn shown(r: Result<wire.Response, Error>) -> String {
    let got = r.unwrap()
    return "${got.status} ${got.text().unwrap()}"
}

fn post(app: wire.Server<Null>, path: String, body: String) -> String {
    return shown(app.test().post(path).text(body).send())
}

fn get(app: wire.Server<Null>, path: String) -> String {
    return shown(app.test().get(path).send())
}

test "a typed handler answers its value as JSON" {
    let app = typed_app()
    let r = app.test().get("/health").send().unwrap()
    assert_eq(r.status, 200)
    assert_eq(r.header("content-type").unwrap(), "application/json")
    assert_eq(r.text().unwrap(), "{\"name\":\"ok\",\"qty\":0}")
    assert_eq(get(app, "/items"), "200 [{\"name\":\"a\",\"qty\":1},{\"name\":\"b\",\"qty\":2}]")
}

test "a typed body is read as its type and the status is the one asked for" {
    let app = typed_app()
    assert_eq(post(app, "/items", "{\"name\":\"bolt\",\"qty\":3}"), "201 {\"name\":\"bolt\",\"qty\":3}")
}

test "a body that is not JSON is a 400 and one that does not fit is a 422 that names the field" {
    let app = typed_app()
    assert_eq(post(app, "/items", "not json"), "400 {\"detail\":\"body is not JSON\"}")
    assert_eq(post(app, "/items", "{\"name\":\"bolt\"}"), "422 {\"detail\":\"missing field \\\"qty\\\"\"}")
    assert_eq(post(app, "/items", "{\"name\":\"bolt\",\"qty\":\"x\"}"), "422 {\"detail\":\"qty: expected an int, found a string\"}")
    assert_eq(post(app, "/items", "[1]").slice(0, 3), "422")
}

test "a list, a number and nested types are bodies too" {
    let app = typed_app()
    assert_eq(post(app, "/count", "[{\"name\":\"a\",\"qty\":4},{\"name\":\"b\",\"qty\":5}]"), "200 9")
    assert_eq(post(app, "/count", "[{\"name\":\"a\",\"qty\":4},{\"name\":\"b\"}]"), "422 {\"detail\":\"[1]: missing field \\\"qty\\\"\"}")
    let t = "{\"total\":1,\"names\":[\"x\"],\"tags\":{\"a\":2},\"note\":null}"
    assert_eq(post(app, "/tally", t), "200 {\"total\":2,\"names\":[\"x\"],\"tags\":{\"a\":2},\"note\":null}")
}

test "a handler error is written as JSON with the status of its kind and its code" {
    let app = typed_app()
    assert_eq(post(app, "/items", "{\"name\":\"bolt\",\"qty\":-1}"), "422 {\"detail\":\"qty must not be negative\",\"code\":\"negative_qty\"}")
    assert_eq(get(app, "/e/invalid"), "422 {\"detail\":\"no\"}")
    assert_eq(get(app, "/e/missing"), "404 {\"detail\":\"no\"}")
    assert_eq(get(app, "/e/denied"), "403 {\"detail\":\"no\"}")
    assert_eq(get(app, "/e/unauthenticated"), "401 {\"detail\":\"no\"}")
    assert_eq(get(app, "/e/conflict"), "409 {\"detail\":\"no\"}")
    assert_eq(get(app, "/e/limited"), "429 {\"detail\":\"no\"}")
    assert_eq(get(app, "/e/unavailable"), "503 {\"detail\":\"no\"}")
    assert_eq(get(app, "/e/other"), "500 {\"detail\":\"no\"}")
}

test "a null result is a 204 with no body" {
    let app = typed_app()
    let r = app.test().get("/nothing").send().unwrap()
    assert_eq(r.status, 204)
    assert_eq(r.body.len(), 0)
}

test "a raw handler can answer a value as JSON and keeps its plain errors" {
    let app = typed_app()
    assert_eq(get(app, "/raw"), "200 {\"name\":\"raw\",\"qty\":9}")
    assert_eq(get(app, "/raw/created"), "201 {\"name\":\"raw\",\"qty\":9}")
    assert_eq(get(app, "/raw/missing"), "400 bad input")
}

test "error_reply sets the house style of every typed error" {
    var app = typed_app()
    app.error_reply(house)
    assert_eq(post(app, "/items", "not json"), "400 E:body is not JSON")
    assert_eq(get(app, "/e/conflict"), "409 E:no")
    assert_eq(get(app, "/health").slice(0, 3), "200")
}

test "a body over max_json is a 413" {
    var app = typed_app()
    app.max_json(20)
    assert_eq(post(app, "/items", "{\"name\":\"bolt\",\"qty\":3,\"more\":\"padding\"}"), "413 {\"detail\":\"body is too large\"}")
    assert_eq(post(app, "/items", "{\"name\":\"b\",\"qty\":3}"), "201 {\"name\":\"b\",\"qty\":3}")
}

test "typed routes serve over HTTP" {
    let app = typed_app()
    let r = app.start("127.0.0.1", 0).unwrap()
    let base = "http://127.0.0.1:${r.port()}"
    let made = wire.request("POST", "${base}/items").body("{\"name\":\"bolt\",\"qty\":3}".bytes()).send().unwrap()
    assert_eq(made.status, 201)
    assert_eq(made.header("content-type").unwrap(), "application/json")
    assert_eq(made.text().unwrap(), "{\"name\":\"bolt\",\"qty\":3}")
    let bad = wire.request("POST", "${base}/items").body("{}".bytes()).send().unwrap()
    assert_eq(bad.status, 422)
    r.stop()
    assert_eq(r.wait().is_ok(), true)
}

test "a typed client sends a value and reads one back" {
    let app = typed_app()
    let r = app.start("127.0.0.1", 0).unwrap()
    let base = "http://127.0.0.1:${r.port()}"
    let made = wire.post_json("${base}/items", Item { name: "bolt", qty: 3 }).unwrap()
    assert_eq(made.status, 201)
    let parsed: Result<Item, Error> = wire.json_as(made)
    let item = parsed.unwrap()
    assert_eq(item.name, "bolt")
    assert_eq(item.qty, 3)
    let api = wire.HttpClient().base(base)
    let counted = wire.with_json(api.request("POST", "/count"), [Item { name: "a", qty: 4 }, Item { name: "b", qty: 5 }]).send().unwrap()
    let total: Result<Int, Error> = wire.json_as(counted)
    assert_eq(total.unwrap(), 9)
    let listed = api.get("/items").unwrap()
    let all: Result<List<Item>, Error> = wire.json_as(listed)
    let items = all.unwrap()
    assert_eq(items.len(), 2)
    assert_eq(items.get(1).name, "b")
    r.stop()
    assert_eq(r.wait().is_ok(), true)
}

test "a typed response that does not fit is an Err naming the field" {
    let app = typed_app()
    let r = app.start("127.0.0.1", 0).unwrap()
    let got = wire.get("http://127.0.0.1:${r.port()}/health").unwrap()
    let wrong: Result<Tally, Error> = wire.json_as(got)
    match wrong {
        Ok(t) => { assert(false) }
        Err(e) => { assert_eq(e.message, "missing field \"total\"") }
    }
    r.stop()
    assert_eq(r.wait().is_ok(), true)
}

test "the test client sends a typed value" {
    let app = typed_app()
    let r = wire.test_json(app.test().post("/items"), Item { name: "bolt", qty: 3 }).send().unwrap()
    assert_eq(r.status, 201)
    let parsed: Result<Item, Error> = wire.json_as(r)
    assert_eq(parsed.unwrap().qty, 3)
    let none = wire.test_json(app.test().post("/items"), Item { name: "bolt", qty: -2 }).send().unwrap()
    assert_eq(none.status, 422)
}
