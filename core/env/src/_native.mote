// The functions of the native library `env`.

@link("env")
pub native fn env_get(name: String, buffer: [UInt8]) -> Int

@link("env")
pub native fn env_set(name: String, value: String) -> Int

@link("env")
pub native fn env_remove(name: String) -> Int

@link("env")
pub native fn env_list(buffer: [UInt8]) -> Int

@link("env")
pub native fn env_cwd(buffer: [UInt8]) -> Int

@link("env")
pub native fn env_chdir(path: String) -> Int

