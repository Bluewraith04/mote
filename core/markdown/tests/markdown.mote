import { assert, assert_eq } from std.test
import { Doc, NodeKind } from doc
import { commonmark, github, parse, parse_with, render, render_with, to_markdown, Extensions } from markdown

test "text is read to a tree of elements" {
    let doc = parse("# Title\n\nSome *text* with a [link](/to \"hint\") and `code`.\n\n- one\n- two\n")!
    let root = doc.root()
    assert_eq(root.child_count(), 3)
    assert_eq(root.find("h1")!.text_content(), "Title")
    let link = root.find("a")!
    assert_eq(link.attr("href")!, "/to")
    assert_eq(link.attr("title")!, "hint")
    assert_eq(link.text_content(), "link")
    assert_eq(root.find("em")!.text_content(), "text")
    assert_eq(root.find("code")!.text_content(), "code")
    assert_eq(root.find_all("li").len(), 2)
    assert_eq(root.to_html(), "<h1>Title</h1><p>Some <em>text</em> with a <a href=\"/to\" title=\"hint\">link</a> and <code>code</code>.</p><ul><li>one</li><li>two</li></ul>")
    doc.close()!
}

test "images, code blocks and raw HTML have their own shapes" {
    let doc = parse("![a *b* c](/i.png \"t\")\n\n```mote x\nlet a = 1 < 2\n```\n\n<div>\nraw\n</div>\n\ninline <b>html</b> here\n")!
    let root = doc.root()
    let image = root.find("img")!
    assert_eq(image.attr("src")!, "/i.png")
    assert_eq(image.attr("alt")!, "a b c")
    assert_eq(image.attr("title")!, "t")
    assert_eq(image.child_count(), 0)
    let code = root.find("pre")!.find("code")!
    assert_eq(code.attr("class")!, "language-mote")
    assert_eq(code.text_content(), "let a = 1 < 2\n")
    var raws = 0
    for node in root.descendants() {
        if node.kind() == NodeKind.Raw { raws = raws + 1 }
    }
    assert_eq(raws, 3)
    assert(root.to_html().contains("<div>\nraw\n</div>\n"), "block html is kept whole")
    assert(root.to_html().contains("<p>inline <b>html</b> here</p>"), "inline html is kept")
}

test "a link target is percent-encoded and its text is escaped by the writer" {
    assert_eq(render("[a](</my url> \"q&a\") <x@y.org> & <http://h/?a=1&b=2>")!, "<p><a href=\"/my%20url\" title=\"q&amp;a\">a</a> <a href=\"mailto:x@y.org\">x@y.org</a> &amp; <a href=\"http://h/?a=1&amp;b=2\">http://h/?a=1&amp;b=2</a></p>")
}

test "tables, strikethrough and task lists are read only when they are on" {
    let text = "| a | b |\n|:-|-:|\n| 1 | 2 |\n\n~~gone~~\n\n- [x] done\n- [ ] open\n"
    assert_eq(render_with(text, github())!, "<table><thead><tr><th style=\"text-align: left\">a</th><th style=\"text-align: right\">b</th></tr></thead><tbody><tr><td style=\"text-align: left\">1</td><td style=\"text-align: right\">2</td></tr></tbody></table><p><del>gone</del></p><ul><li><input disabled=\"\" type=\"checkbox\" checked=\"\" />done</li><li><input disabled=\"\" type=\"checkbox\" />open</li></ul>")
    let plain = render(text)!
    assert(!plain.contains("<table>"), "no table")
    assert(!plain.contains("<del>"), "no strikethrough")
    assert(!plain.contains("<input"), "no task list")
    assert(plain.contains("~~gone~~"), "tildes kept")
}

test "smart punctuation curls quotes and dashes" {
    let smart = Extensions { tables: false, strikethrough: false, tasklists: false, smart_punctuation: true }
    assert_eq(render_with("\"quoted\" -- it's...", smart)!, "<p>\u{201c}quoted\u{201d} \u{2013} it\u{2019}s\u{2026}</p>")
    assert_eq(render("\"quoted\" -- it's...")!, "<p>\"quoted\" -- it's...</p>")
}

test "a long document crosses the native boundary whole" {
    let text = "word ".repeat(5000) + "\n\n" + "- item\n".repeat(300)
    let doc = parse(text)!
    assert_eq(doc.root().find("p")!.text_content().len(), 24999)
    assert_eq(doc.root().find_all("li").len(), 300)
    let again = parse(to_markdown(doc.root()))!
    assert_eq(again.root().find_all("li").len(), 300)
}

test "a tree is written as Markdown" {
    let doc = parse("# Title\n\nSome *text*, **bold**, `code`, [a link](/x \"t\") and ![pic](/p.png).\n\n> quoted\n> text\n\n1. one\n2. two\n\n* a\n* b\n\n```sh\nls -l\n```\n\n---\n\nend\\\nof line\n")!
    assert_eq(to_markdown(doc.root()), "# Title\n\nSome *text*, **bold**, `code`, [a link](/x \"t\") and ![pic](/p.png).\n\n> quoted\n> text\n\n1. one\n2. two\n\n- a\n- b\n\n```sh\nls -l\n```\n\n***\n\nend\\\nof line\n")
}

test "lists keep their nesting, numbering and looseness" {
    let doc = parse("3. three\n4. four\n   - inner\n   - inner two\n\n- loose one\n\n  more\n- loose two\n")!
    assert_eq(to_markdown(doc.root()), "3. three\n4. four\n   - inner\n   - inner two\n\n- loose one\n\n  more\n\n- loose two\n")
}

test "characters that would read as syntax are escaped" {
    let doc = Doc.new()
    let p = doc.element("p")
    p.append(doc.text("1. not a list *or* emphasis_ [x] <b> # & &amp; a|b"))!
    doc.root().append(p)!
    let q = doc.element("p")
    q.append(doc.text("- not a bullet\n# nor a heading\n+ nor this\n12) nor this"))!
    doc.root().append(q)!
    let text = to_markdown(doc.root())
    assert_eq(text, "1\\. not a list \\*or\\* emphasis\\_ \\[x\\] \\<b\\> # & \\&amp; a|b\n\n\\- not a bullet\n\\# nor a heading\n\\+ nor this\n12\\) nor this\n")
    assert_eq(parse(text)!.root().text_content(), doc.root().text_content())
}

test "a tree that was built is written as Markdown, with HTML for what has no Markdown form" {
    let doc = Doc.new()
    let h = doc.element("h2")
    h.append(doc.text("Built"))!
    doc.root().append(h)!
    let span = doc.element("span")
    span.set_attr("class", "x")!
    span.append(doc.text("kept"))!
    let p = doc.element("p")
    p.append(doc.text("a "))!
    p.append(span)!
    p.append(doc.comment(" c "))!
    doc.root().append(p)!
    assert_eq(to_markdown(doc.root()), "## Built\n\na <span class=\"x\">kept</span><!-- c -->\n")
    assert_eq(to_markdown(h), "## Built\n")
    assert_eq(to_markdown(Doc.new().root()), "")
}

test "code spans and fences are long enough for their content" {
    let doc = parse("`` a ` b ``\n\n````\n```\nx\n```\n````\n")!
    let text = to_markdown(doc.root())
    assert_eq(text, "``a ` b``\n\n````\n```\nx\n```\n````\n")
}

test "tables are written with their alignments" {
    let doc = parse_with("| a | b | c | d |\n|:--|:-:|--:|---|\n| 1 | 2 | 3 | x \\| y |\n", github())!
    assert_eq(to_markdown(doc.root()), "| a | b | c | d |\n| :--- | :---: | ---: | --- |\n| 1 | 2 | 3 | x \\| y |\n")
}

test "emphasis at the edge of emphasis is written as HTML" {
    let doc = parse("foo***bar***baz and *a **b** c*\n")!
    assert_eq(to_markdown(doc.root()), "foo<em>**bar**</em>baz and *a **b** c*\n")
}
