// How serious a record is.
import { Display } from std.traits

pub enum Level: (Display) {
    Debug
    Info
    Warn
    Error

    /// 0 for Debug to 3 for Error.
    pub fn number(self) -> Int {
        return match self {
            Debug => 0
            Info => 1
            Warn => 2
            Error => 3
        }
    }

    pub fn to_string(self) -> String {
        return match self {
            Debug => "DEBUG"
            Info => "INFO"
            Warn => "WARN"
            Error => "ERROR"
        }
    }
}

