// The names and errors the other files share.
import { Signal } from .signal

pub fn signal_of(number: Int) -> Signal? {
    for each in [Signal.Hangup, Signal.Interrupt, Signal.Quit, Signal.User1, Signal.User2, Signal.Alarm, Signal.Terminate, Signal.Child, Signal.Continue, Signal.WindowChange] {
        if each.number() == number { return each }
    }
    return null
}

pub fn failure(code: Int, what: String) -> Error {
    let errno = -code
    if errno == 3 { return Error.new(ErrorKind.NotFound, "${what}: no such process") }
    if errno == 1 { return Error.new(ErrorKind.PermissionDenied, "${what}: operation not permitted") }
    if errno == 24 { return Error.new(ErrorKind.Other, "${what}: too many subscriptions") }
    return Error.new(ErrorKind.Other, "${what}: error ${errno}")
}
