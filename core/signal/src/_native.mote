// The functions of the native library `signal`.

@link("signal")
pub native fn signal_open() -> Int

@link("signal")
pub native fn signal_watch(fd: Int, number: Int) -> Int

@blocking
@link("signal")
pub native fn signal_next(fd: Int) -> Int

@link("signal")
pub native fn signal_stop(fd: Int) -> Int

@link("signal")
pub native fn signal_free(fd: Int) -> Int

@link("signal")
pub native fn signal_send(pid: Int, number: Int) -> Int

@link("signal")
pub native fn signal_pid() -> Int

