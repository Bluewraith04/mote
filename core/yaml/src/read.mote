// Reading YAML text.
import { Json, decode as decode_json, parse as parse_json } from json
import { call, invalid } from ._call
import { yaml_parse } from ._native

/// Every document of a YAML stream, in order; an `Err` says the line and column of the first mistake.
pub fn parse_all(text: String) -> Result<List<Json>, Error> {
    let bytes = text.bytes()
    let all = parse_json(call(|buffer: [UInt8]| yaml_parse(bytes, buffer))?)?
    var out: List<Json> = []
    var index = 0
    while true {
        let document = all.at(index)
        if document == null { break }
        out.push(document)
        index = index + 1
    }
    return Ok(out)
}

/// The one document of a text, or `Null` for a text with none; more than one is an `Err`.
pub fn parse(text: String) -> Result<Json, Error> {
    let documents = parse_all(text)?
    if documents.is_empty() { return Ok(Json.Null) }
    if documents.len() > 1 { return Err(invalid("yaml: more than one document")) }
    return Ok(documents.get(0))
}

/// The `T` a text holds, as `json.decode` reads a value.
pub fn load<T>(text: String) -> Result<T, Error> {
    return decode_json(parse(text)?)
}
