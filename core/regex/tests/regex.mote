import { assert, assert_eq } from std.test
import { join } from std.string
import { Match, Regex } from regex

fn texts(matches: List<Match>) -> String {
    var parts: List<String> = []
    for each in matches {
        parts.push("${each.text}@${each.start}")
    }
    return join(parts, ",")
}

test "a pattern is matched anywhere in the text" {
    let digits = Regex.new("[0-9]+")!
    assert(digits.is_match("abc 123"), "found")
    assert(!digits.is_match("abc"), "absent")
    let anchored = Regex.new("^a.*z$")!
    assert(anchored.is_match("a to z"), "anchored")
    assert(!anchored.is_match("a to zz!"), "anchored end")
    digits.close()!
    anchored.close()!
}

test "find gives the first match and its place" {
    let digits = Regex.new("[0-9]+")!
    let found = digits.find("ab 42 cd 7")!
    assert_eq(found.text, "42")
    assert_eq(found.start, 3)
    assert_eq(found.end, 5)
    assert(digits.find("none") == null, "no match")
    assert_eq(texts(digits.find_all("ab 42 cd 7 e 100")), "42@3,7@9,100@13")
}

test "offsets are in bytes of the UTF-8 text" {
    let word = Regex.new("\\w+")!
    assert_eq(texts(word.find_all("h\u{e9}llo w\u{f6}rld \u{4e16}\u{754c}")), "h\u{e9}llo@0,w\u{f6}rld@7,\u{4e16}\u{754c}@14")
    let dot = Regex.new(".")!
    assert_eq(dot.find("\u{1f600}x")!.text, "\u{1f600}")
    assert_eq(dot.find("\u{1f600}x")!.end, 4)
}

test "groups are numbered and named" {
    let date = Regex.new("(?P<year>[0-9]{4})-(?P<month>[0-9]{2})-([0-9]{2})")!
    let found = date.captures("on 2026-10-31 it")!
    assert_eq(found.len(), 4)
    assert_eq(found.get(0)!, "2026-10-31")
    assert_eq(found.get(1)!, "2026")
    assert_eq(found.named("month")!, "10")
    assert_eq(found.get(3)!, "31")
    assert(found.get(4) == null, "past the groups")
    assert(found.named("day") == null, "no such name")
    assert_eq(found.group(1)!.start, 3)
    assert_eq(join(date.group_names(), ","), ",year,month,")
}

test "a group that did not take part is null" {
    let pair = Regex.new("(a)|(b)")!
    let found = pair.captures("b")!
    assert(found.get(1) == null, "first group")
    assert_eq(found.get(2)!, "b")
}

test "matches do not overlap and empty matches are handled" {
    let stars = Regex.new("a*")!
    assert_eq(texts(stars.find_all("baaab")), "@0,aaa@1,@5")
    let boundary = Regex.new("\\b")!
    assert_eq(boundary.find_all("ab cd").len(), 4)
    let each = Regex.new("")!
    assert_eq(each.find_all("a\u{e9}").len(), 3)
}

test "flags and classes follow the syntax of the Rust regex crate" {
    assert(Regex.new("(?i)hello")!.is_match("HeLLo"), "case")
    assert(Regex.new("\\p{Greek}+")!.is_match("\u{3b1}\u{3b2}"), "unicode class")
    assert(Regex.new("(?m)^b$")!.is_match("a\nb\nc"), "multi-line")
    assert(Regex.new("a{2,3}")!.is_match("aa"), "repeat")
    assert(Regex.new("x*?y")!.is_match("xxy"), "lazy")
}

test "replace uses groups in the template" {
    let swap = Regex.new("(?P<a>\\w+) (?P<b>\\w+)")!
    assert_eq(swap.replace("one two three four", "$b $a"), "two one three four")
    assert_eq(swap.replace_all("one two three four", "\${b}-\${a}"), "two-one four-three")
    assert_eq(swap.replace_all("x y", "$2$1$$ $9 \${0} $"), "yx$  x y $")
    let digits = Regex.new("[0-9]")!
    assert_eq(digits.replace_all("a1b22", "#"), "a#b##")
    assert_eq(digits.replace("nothing", "#"), "nothing")
}

test "a text is split at the matches" {
    let comma = Regex.new("\\s*,\\s*")!
    assert_eq(join(comma.split("a , b,c ,d"), "|"), "a|b|c|d")
    assert_eq(join(comma.split("no commas"), "|"), "no commas")
    assert_eq(join(comma.split(",a,"), "|"), "|a|")
}

test "a bad pattern is an error that says where" {
    let bad = Regex.new("a(b")
    assert(bad.is_err(), "unclosed group")
    match bad {
        Ok(_) => assert(false, "compiled")
        Err(error) => assert(error.to_string().contains("regex:"), error.to_string())
    }
    assert(Regex.new("*a").is_err(), "nothing to repeat")
    assert(Regex.new("(?<=a)b").is_err(), "no look-behind")
    assert(Regex.new("(a)\\1").is_err(), "no back-references")
}

test "a pattern that would take exponential time in a backtracking engine runs in linear time" {
    let evil = Regex.new("(a*)*b")!
    let text = "a".repeat(200000)
    assert(!evil.is_match(text), "no match, and no hang")
    assert(evil.is_match(text + "b"), "match")
}

test "a long text is searched whole" {
    let text = "word ".repeat(50000)
    let word = Regex.new("[a-z]+")!
    assert_eq(word.find_all(text).len(), 50000)
    assert_eq(word.replace_all(text, "x").len(), 50000 * 2)
}

test "closing twice is an error" {
    let one = Regex.new("a")!
    one.close()!
    assert(one.close().is_err(), "twice")
}

test "many patterns can be made and closed" {
    for n in 0..200 {
        let each = Regex.new("a${n}")!
        assert(each.is_match("xa${n}y"), "match")
        each.close()!
    }
}
