/// Describes a terminal UI as a function of your state.

pub import { Element, Run, run } from .element
pub import { text, rich, vstack, hstack, spacer, frame, list, input, scroll } from .controls
pub import { Cell, Screen } from .screen
pub import { App, Running } from .app
pub import { height } from .paint

import std.term as term

/// No modifier held, for `on_key`.
pub fn no_mods() -> term.Mods { return term.no_mods() }

/// The modifiers held with a key, for `on_key`.
pub fn mods(shift: Bool, ctrl: Bool, alt: Bool) -> term.Mods { return term.mods(shift, ctrl, alt) }
