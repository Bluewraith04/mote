/// Runs the app loop over the terminal's events and timers.

import std.term as term
import std.io as io
import std.env as env
import std.time as time
import std.stream as stream
import std.string as string
import { Task } from std.task
import .ansi
import .element
import .paint
import .screen

/// A key, the modifiers held with it, and what pressing it does.
class Shortcut<S> {
    key: term.Key
    mods: term.Mods
    f: (var S) -> Null
    quit: Bool
}

/// How often a timer's handler runs, and the handler.
class Tick<S> {
    ms: Int
    f: (var S) -> Null
}

/// What the loop receives, as numbers a channel can carry.
struct Msg {
    kind: Int
    a: Int
    b: Int
    c: Int
    text: String
}

fn key_number(k: term.Key) -> Int {
    match k {
        term.Key.Char(c) => { return 0 }
        term.Key.Enter => { return 1 }
        term.Key.Escape => { return 2 }
        term.Key.Tab => { return 3 }
        term.Key.Backspace => { return 4 }
        term.Key.Delete => { return 5 }
        term.Key.Insert => { return 6 }
        term.Key.Up => { return 7 }
        term.Key.Down => { return 8 }
        term.Key.Left => { return 9 }
        term.Key.Right => { return 10 }
        term.Key.Home => { return 11 }
        term.Key.End => { return 12 }
        term.Key.PageUp => { return 13 }
        term.Key.PageDown => { return 14 }
        term.Key.F(n) => { return 100 + n }
    }
}

fn key_of(n: Int, text: String) -> term.Key {
    if n == 0 { return term.Key.Char(text) }
    if n == 1 { return term.Key.Enter }
    if n == 2 { return term.Key.Escape }
    if n == 3 { return term.Key.Tab }
    if n == 4 { return term.Key.Backspace }
    if n == 5 { return term.Key.Delete }
    if n == 6 { return term.Key.Insert }
    if n == 7 { return term.Key.Up }
    if n == 8 { return term.Key.Down }
    if n == 9 { return term.Key.Left }
    if n == 10 { return term.Key.Right }
    if n == 11 { return term.Key.Home }
    if n == 12 { return term.Key.End }
    if n == 13 { return term.Key.PageUp }
    if n == 14 { return term.Key.PageDown }
    return term.Key.F(n - 100)
}

fn mods_bits(m: term.Mods) -> Int {
    var bits = 0
    if m.shift { bits = bits | 1 }
    if m.ctrl { bits = bits | 2 }
    if m.alt { bits = bits | 4 }
    return bits
}

/// The message for an event.
fn message_of(e: term.Event) -> Msg? {
    match e {
        term.Event.Key(k, m) => {
            var text = ""
            match k {
                term.Key.Char(c) => { text = c }
                _ => { }
            }
            return Some(Msg { kind: 0, a: key_number(k), b: mods_bits(m), c: 0, text: text })
        }
        term.Event.Mouse(m, col, row) => {
            match m {
                term.Mouse.Down(b) => {
                    match b {
                        term.Button.Left => { return Some(Msg { kind: 1, a: col, b: row, c: 0, text: "" }) }
                        _ => { return None }
                    }
                }
                term.Mouse.ScrollUp => { return Some(Msg { kind: 4, a: -1, b: 0, c: 0, text: "" }) }
                term.Mouse.ScrollDown => { return Some(Msg { kind: 4, a: 1, b: 0, c: 0, text: "" }) }
                _ => { return None }
            }
        }
        term.Event.Resize(c, r) => { return Some(Msg { kind: 2, a: c, b: r, c: 0, text: "" }) }
    }
}

fn same_mods(a: term.Mods, b: term.Mods) -> Bool {
    return a.shift == b.shift && a.ctrl == b.ctrl && a.alt == b.alt
}

fn drop_last(s: String) -> String {
    var cells = term.glyphs(s)
    if cells.len() > 0 {
        let last = cells.pop()
        if last == "" && cells.len() > 0 { cells.pop() }
    }
    return string.join(cells, "")
}

/// An app made of a state and the view that draws it.
pub class App<S> {
    var own: S
    var view: (S) -> element.Element<S>
    var keys: List<Shortcut<S>>
    var ticks: List<Tick<S>>
    var mouse_on: Bool
    var stops: List<(S) -> Bool>
    var sizers: List<(var S, Int, Int) -> Null>
    var wheels: List<(var S, Int) -> Null>

    pub fn new(state: S, view: (S) -> element.Element<S>) -> App<S> {
        return App { own: state, view: view, keys: [], ticks: [], mouse_on: false, stops: [], sizers: [], wheels: [] }
    }

    fn copy(self) -> App<S> {
        return App { own: self.own, view: self.view, keys: self.keys, ticks: self.ticks, mouse_on: self.mouse_on, stops: self.stops, sizers: self.sizers, wheels: self.wheels }
    }

    /// Runs `f` with the state and the direction of each mouse wheel step.
    pub fn on_wheel(self, f: (var S, Int) -> Null) -> App<S> {
        var a = self.copy()
        var wheels: List<(var S, Int) -> Null> = []
        for g in self.wheels { wheels.push(g) }
        wheels.push(f)
        a.wheels = wheels
        return a
    }

    /// Runs `f` with the state and the terminal size on each resize.
    pub fn on_resize(self, f: (var S, Int, Int) -> Null) -> App<S> {
        var a = self.copy()
        var sizers: List<(var S, Int, Int) -> Null> = []
        for g in self.sizers { sizers.push(g) }
        sizers.push(f)
        a.sizers = sizers
        return a
    }

    /// Runs `f` on the state when `key` is pressed with the modifiers `mods`.
    pub fn on_key(self, key: term.Key, mods: term.Mods, f: (var S) -> Null) -> App<S> {
        var a = self.copy()
        var keys: List<Shortcut<S>> = []
        for k in self.keys { keys.push(k) }
        keys.push(Shortcut { key: key, mods: mods, f: f, quit: false })
        a.keys = keys
        return a
    }

    /// Ends the app when `key` is pressed with no modifiers.
    pub fn quit_on(self, key: term.Key) -> App<S> {
        var a = self.copy()
        var keys: List<Shortcut<S>> = []
        for k in self.keys { keys.push(k) }
        keys.push(Shortcut { key: key, mods: term.no_mods(), f: |var s: S| { }, quit: true })
        a.keys = keys
        return a
    }

    /// Ends the app once `done(state)` is true, checked after every event.
    pub fn quit_when(self, done: (S) -> Bool) -> App<S> {
        var a = self.copy()
        var stops: List<(S) -> Bool> = []
        for d in self.stops { stops.push(d) }
        stops.push(done)
        a.stops = stops
        return a
    }

    /// Runs `f` on the state every `ms` milliseconds, then draws again.
    pub fn every(self, ms: Int, f: (var S) -> Null) -> App<S> {
        var a = self.copy()
        var ticks: List<Tick<S>> = []
        for t in self.ticks { ticks.push(t) }
        ticks.push(Tick { ms: ms, f: f })
        a.ticks = ticks
        return a
    }

    /// Reports mouse clicks to `on_click` handlers.
    pub fn mouse(self) -> App<S> {
        var a = self.copy()
        a.mouse_on = true
        return a
    }

    fn start(self, cols: Int, rows: Int, color: Bool) -> Running<S> {
        var r = Running { data: self.own, view: self.view, keys: self.keys, ticks: self.ticks, stops: self.stops, sizers: self.sizers, wheels: self.wheels, cols: cols, rows: rows, prev: None, frame: [], out: "", over: false, color: color }
        r.sized()
        r.render()
        return r
    }

    /// Runs on an in-memory screen of `cols` by `rows` cells, for tests.
    pub fn headless(self, cols: Int, rows: Int) -> Running<S> {
        return self.start(cols, rows, true)
    }

    /// Takes the terminal over and handles its events until the app quits.
    pub fn run(self) -> Result<Null, Error> {
        let t = term.open(self.mouse_on)?
        let size = t.size()?
        var color = true
        match env.get_var("NO_COLOR") {
            Some(v) => { color = false }
            None => { }
        }
        var running = self.start(size.cols, size.rows, color)
        let out = io.stdout()
        out.write(ansi.hide_cursor() + running.take_output())
        out.flush()
        let (tx, rx) = Channel<Msg>(64)
        scope {
            var tasks: List<Task<Null>> = []
            let reader = tx.clone()
            tasks.push(spawn {
                for e in t.events() {
                    match message_of(e) {
                        Some(m) => { reader.send(m) }
                        None => { }
                    }
                }
            })
            var i = 0
            for tick in self.ticks {
                let sender = tx.clone()
                let ms = tick.ms
                let index = i
                tasks.push(spawn {
                    for n in time.ticker(time.Duration.from_millis(ms)) {
                        sender.send(Msg { kind: 3, a: index, b: 0, c: 0, text: "" })
                    }
                })
                i = i + 1
            }
            for m in rx {
                if m.kind == 0 {
                    let mods = term.mods((m.b & 1) != 0, (m.b & 2) != 0, (m.b & 4) != 0)
                    running.press(key_of(m.a, m.text), mods)
                } else if m.kind == 1 {
                    running.click(m.a, m.b)
                } else if m.kind == 2 {
                    running.resize(m.a, m.b)
                } else if m.kind == 4 {
                    running.wheel(m.a)
                } else {
                    running.fire(m.a)
                }
                out.write(running.take_output())
                out.flush()
                if running.finished() { break }
            }
            for task in tasks {
                task.cancel()
                task.join()
            }
        }
        out.write(ansi.show_cursor())
        out.flush()
        t.close()
        return Ok(null)
    }
}

/// An app on a screen.
pub class Running<S> {
    var data: S
    view: (S) -> element.Element<S>
    keys: List<Shortcut<S>>
    ticks: List<Tick<S>>
    stops: List<(S) -> Bool>
    sizers: List<(var S, Int, Int) -> Null>
    wheels: List<(var S, Int) -> Null>
    var cols: Int
    var rows: Int
    var prev: screen.Screen?
    var frame: List<paint.Canvas<S>>
    var out: String
    var over: Bool
    color: Bool

    /// The state as it is now, read-only.
    pub fn state(self) -> S { return self.data }

    /// Whether the app has ended.
    pub fn finished(self) -> Bool { return self.over }

    /// The screen as text, one string per row.
    pub fn screen(self) -> List<String> {
        if self.frame.len() == 0 { return [] }
        return self.frame.get(0).scr.lines()
    }

    /// One cell of the screen with its colours and style bits.
    pub fn cell(self, col: Int, row: Int) -> screen.Cell {
        if self.frame.len() == 0 { return screen.blank() }
        return self.frame.get(0).scr.get(col, row)
    }

    /// Whether some row of the screen holds `text`.
    pub fn shows(self, text: String) -> Bool {
        for line in self.screen() {
            if line.contains(text) { return true }
        }
        return false
    }

    /// The bytes drawn since they were last taken.
    pub fn take_output(var self) -> String {
        let out = self.out
        self.out = ""
        return out
    }

    fn sized(var self) {
        for f in self.sizers { f(self.data, self.cols, self.rows) }
    }

    /// Draws the view and keeps the bytes that turn the last frame into it.
    pub fn render(var self) {
        let draw = self.view
        let tree = draw(self.data)
        var scrolls: List<Int> = []
        if self.frame.len() > 0 { scrolls = self.frame.get(0).scrolls }
        let canvas = paint.draw_after(tree, self.cols, self.rows, scrolls)
        var bytes = canvas.scr.diff(self.prev, self.color)
        if canvas.caret_col >= 0 {
            bytes = bytes + ansi.cursor_to(canvas.caret_col, canvas.caret_row) + ansi.show_cursor()
        } else {
            bytes = bytes + ansi.hide_cursor()
        }
        self.out = self.out + bytes
        self.prev = Some(canvas.scr)
        self.frame = [canvas]
    }

    fn check(var self) {
        for done in self.stops {
            if done(self.data) { self.over = true }
        }
        self.render()
    }

    /// Handles one terminal event, then draws.
    pub fn step(var self, e: term.Event) {
        match e {
            term.Event.Key(k, m) => { self.key(k, m) }
            term.Event.Mouse(m, col, row) => {
                match m {
                    term.Mouse.Down(b) => { self.click(col, row) }
                    term.Mouse.ScrollUp => { self.wheel_by(-1) }
                    term.Mouse.ScrollDown => { self.wheel_by(1) }
                    _ => { }
                }
            }
            term.Event.Resize(c, r) => {
                self.cols = c
                self.rows = r
                self.prev = None
                self.sized()
            }
        }
        self.check()
    }

    fn key(var self, k: term.Key, m: term.Mods) {
        if self.frame.len() > 0 && self.frame.get(0).input.len() > 0 && !m.ctrl && !m.alt {
            let field = self.frame.get(0).input.get(0)
            match k {
                term.Key.Char(c) => {
                    if field.change.len() > 0 {
                        let change = field.change.get(0)
                        change(self.data, field.text + c)
                    }
                    return
                }
                term.Key.Backspace => {
                    if field.change.len() > 0 {
                        let change = field.change.get(0)
                        change(self.data, drop_last(field.text))
                    }
                    return
                }
                term.Key.Enter => {
                    if field.submit.len() > 0 {
                        let submit = field.submit.get(0)
                        submit(self.data)
                    }
                    return
                }
                _ => { }
            }
        }
        for s in self.keys {
            if s.key == k && same_mods(s.mods, m) {
                if s.quit { self.over = true }
                let f = s.f
                f(self.data)
                return
            }
        }
        match k {
            term.Key.Char(c) => {
                if m.ctrl && c == "c" { self.over = true }
            }
            _ => { }
        }
    }

    fn wheel_by(var self, dir: Int) {
        for f in self.wheels { f(self.data, dir) }
    }

    /// Runs the `on_wheel` handlers for one mouse wheel step.
    pub fn wheel(var self, dir: Int) {
        self.wheel_by(dir)
        self.check()
    }

    /// Clicks the cell at `col`, `row`.
    pub fn click(var self, col: Int, row: Int) {
        if self.frame.len() == 0 { return }
        var found = -1
        var i = 0
        for h in self.frame.get(0).hits {
            if col >= h.x && col < h.x + h.w && row >= h.y && row < h.y + h.h { found = i }
            i = i + 1
        }
        if found >= 0 {
            let f = self.frame.get(0).hits.get(found).f
            f(self.data)
        }
        self.check()
    }

    /// Presses a key with the modifiers held, then draws.
    pub fn press(var self, k: term.Key, m: term.Mods) {
        self.step(term.Event.Key(k, m))
    }

    /// Types `text` one character at a time.
    pub fn type_text(var self, text: String) {
        for c in stream.chars(text) {
            self.press(term.Key.Char(c), term.no_mods())
        }
    }

    pub fn resize(var self, cols: Int, rows: Int) {
        self.step(term.Event.Resize(cols, rows))
    }

    /// Runs timer `index` once, as if its interval had passed, then draws.
    pub fn fire(var self, index: Int) {
        let f = self.ticks.get(index).f
        f(self.data)
        self.check()
    }

    /// Runs every timer once.
    pub fn tick(var self) {
        var i = 0
        while i < self.ticks.len() {
            self.fire(i)
            i = i + 1
        }
    }
}
