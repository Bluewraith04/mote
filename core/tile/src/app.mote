// A program over one state: a view of it, handlers that change it, and the terminal that shows it.
import { Terminal } from term
import { Dyn, downcast } from std.meta
import { Element } from .element
import { Painted, render_areas } from .render
import { Input, Next, Options, run } from .run
import { Click, build } from ._build

/// Lays out an element tree on a screen of `rows` by `cols` cells.
pub fn lay_out(root: Element, rows: Int, cols: Int) -> Painted {
    return render_areas(build(root).view, rows, cols)
}

struct KeyBinding<S> {
    spec: String
    run: (var S) -> Null
}

/// A terminal program over the state: `view` makes the elements of a state, and the handlers on them change it. `App(state, view).run()` takes the terminal until a quit key is pressed.
pub class App<S> {
    state: S
    view: (S) -> Element
    keys: List<KeyBinding<S>>
    quits: List<String>
    tick_ms: Int
    ticker: ((var S) -> Null)?
    reports_mouse: Bool
    done: ((S) -> Bool)?

    /// Ends the run when `done` answers true for the state after an event.
    pub fn quit_when(self, done: (S) -> Bool) -> App<S> {
        return App { state: self.state, view: self.view, keys: self.keys, quits: self.quits, tick_ms: self.tick_ms, ticker: self.ticker, reports_mouse: self.reports_mouse, done: done }
    }

    /// An app that reports the mouse and has no timer.
    pub fn new(state: S, view: (S) -> Element) -> App<S> {
        return App { state: state, view: view, keys: [], quits: [], tick_ms: 0, ticker: null, reports_mouse: true, done: null }
    }

    /// Runs when the key is pressed; the key is written as `KeyEvent` shows it: `q`, `Enter`, `Up`, `Ctrl+c`, `F5`.
    pub fn on_key(self, key: String, run: (var S) -> Null) -> App<S> {
        var keys = self.keys
        keys.push(KeyBinding { spec: key, run: run })
        return App { state: self.state, view: self.view, keys: keys, quits: self.quits, tick_ms: self.tick_ms, ticker: self.ticker, reports_mouse: self.reports_mouse, done: self.done }
    }

    /// Ends the run when the key is pressed.
    pub fn quit_on(self, key: String) -> App<S> {
        var quits = self.quits
        quits.push(key)
        return App { state: self.state, view: self.view, keys: self.keys, quits: quits, tick_ms: self.tick_ms, ticker: self.ticker, reports_mouse: self.reports_mouse, done: self.done }
    }

    /// Runs every `ms` milliseconds.
    pub fn every(self, ms: Int, run: (var S) -> Null) -> App<S> {
        return App { state: self.state, view: self.view, keys: self.keys, quits: self.quits, tick_ms: ms, ticker: run, reports_mouse: self.reports_mouse, done: self.done }
    }

    /// Whether the terminal reports the mouse, which clicks need.
    pub fn mouse(self, on: Bool) -> App<S> {
        return App { state: self.state, view: self.view, keys: self.keys, quits: self.quits, tick_ms: self.tick_ms, ticker: self.ticker, reports_mouse: on, done: self.done }
    }

    /// Runs on the terminal of the process; gives the last state.
    pub fn run(self) -> Result<S, Error> {
        return self.run_on(Terminal.stdio())
    }

    /// Runs on a terminal, which a pseudo-terminal can be in a test.
    pub fn run_on(self, var terminal: Terminal) -> Result<S, Error> {
        let make = self.view
        return run(terminal, self.state, |current: S| build(make(current)).view, |current: S, input: Input| self.step(terminal, current, input), Options { tick_ms: self.tick_ms, mouse: self.reports_mouse })
    }

    fn step(self, terminal: Terminal, state: S, input: Input) -> Next<S> {
        var current = state
        match input {
            Key(key) => {
                let spec = key.to_string()
                for quit in self.quits {
                    if quit == spec { return Next.Quit(current) }
                }
                for binding in self.keys {
                    if binding.spec == spec {
                        let act = binding.run
                        act(current)
                    }
                }
            }
            Mouse(event) => {
                if event.kind.to_string() == "Press" && event.button == 0 {
                    let found = terminal.size()
                    if found.is_ok() {
                        let size = found.unwrap()
                        let make = self.view
                        let built = build(make(current))
                        let painted = render_areas(built.view, size.rows, size.cols)
                        let hit = click_at(painted, built.clicks, event.row, event.col)
                        if hit != null {
                            let act = hit
                            var boxed = Dyn.of(current)
                            act(boxed)
                            current = downcast<S>(boxed)!
                        }
                    }
                }
            }
            Tick => {
                if self.ticker != null {
                    let act = self.ticker!
                    act(current)
                }
            }
            _ => {}
        }
        if self.done != null {
            let over = self.done!
            if over(current) { return Next.Quit(current) }
        }
        return Next.Continue(current)
    }
}

// The handler of the view under the cell, or the nearest one around it: the last area in paint order that holds the cell and has a handler.
fn click_at(painted: Painted, clicks: List<Click>, row: Int, col: Int) -> ((var Dyn) -> Null)? {
    var found: ((var Dyn) -> Null)? = null
    for area in painted.areas {
        if row < area.row || row >= area.row + area.rows || col < area.col || col >= area.col + area.cols { continue }
        for each in clicks {
            if each.tag == area.tag { found = each.run }
        }
    }
    return found
}
