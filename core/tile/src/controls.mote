/// Builds the elements a view is made of.

import .element

/// A line of text; a newline in it starts another line.
pub fn text<S>(s: String) -> element.Element<S> {
    return element.text_element(s)
}

/// Text in several looks.
pub fn rich<S>(runs: List<element.Run>) -> element.Element<S> {
    return element.element(element.Kind.Text, "", []).with_runs(runs)
}

/// Children one under the other.
pub fn vstack<S>(kids: List<element.Element<S>>) -> element.Element<S> {
    return element.element(element.Kind.VStack, "", kids)
}

/// Children side by side.
pub fn hstack<S>(kids: List<element.Element<S>>) -> element.Element<S> {
    return element.element(element.Kind.HStack, "", kids)
}

/// Empty space that takes what the parent has left, to push siblings apart.
pub fn spacer<S>() -> element.Element<S> {
    return element.element(element.Kind.Spacer, "", []).grow()
}

/// A border with a title around one child.
pub fn frame<S>(title: String, kid: element.Element<S>) -> element.Element<S> {
    return element.element(element.Kind.Frame, title, [kid])
}

/// One row per item with row `selected` highlighted.
pub fn list<S>(items: List<String>, selected: Int, top: Int) -> element.Element<S> {
    return element.element(element.Kind.List, "", []).with_rows(items, selected, top)
}

/// A one-line field showing `value`.
pub fn input<S>(value: String, on_change: (var S, String) -> Null) -> element.Element<S> {
    return element.element(element.Kind.Input, value, []).on_change(on_change)
}

/// Children one under the other, starting `offset` rows down.
pub fn scroll<S>(offset: Int, kids: List<element.Element<S>>) -> element.Element<S> {
    return element.element(element.Kind.Scroll, "", kids).with_offset(offset)
}
