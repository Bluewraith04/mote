/// Builds the `Element` tree of a view and restyles it with modifiers.

import .screen

pub enum Kind { Text VStack HStack Spacer Frame List Input Scroll }

/// A piece of text in its own look.
pub class Run {
    pub text: String
    pub fgc: Int
    pub bgc: Int
    pub bits: Int

    /// The foreground colour.
    pub fn fg(self, color: Int) -> Run { return Run { text: self.text, fgc: color, bgc: self.bgc, bits: self.bits } }

    pub fn bg(self, color: Int) -> Run { return Run { text: self.text, fgc: self.fgc, bgc: color, bits: self.bits } }

    pub fn bold(self) -> Run { return Run { text: self.text, fgc: self.fgc, bgc: self.bgc, bits: self.bits | 1 } }

    pub fn dim(self) -> Run { return Run { text: self.text, fgc: self.fgc, bgc: self.bgc, bits: self.bits | 2 } }

    pub fn underline(self) -> Run { return Run { text: self.text, fgc: self.fgc, bgc: self.bgc, bits: self.bits | 4 } }

    pub fn reverse(self) -> Run { return Run { text: self.text, fgc: self.fgc, bgc: self.bgc, bits: self.bits | 8 } }
}

/// A run of text with no colours or style yet.
pub fn run(text: String) -> Run { return Run { text: text, fgc: -1, bgc: -1, bits: 0 } }

/// One piece of a view.
pub class Element<S> {
    pub var kind: Kind
    pub var text: String
    pub var runs: List<Run>
    pub var lines: List<List<String>>
    pub var kids: List<Element<S>>
    pub var items: List<String>
    pub var selected: Int
    pub var top: Int
    pub var fgc: Int
    pub var bgc: Int
    pub var bits: Int
    pub var w: Int
    pub var h: Int
    pub var shr: Int
    pub var padn: Int
    pub var gapn: Int
    pub var wrapped: Bool
    pub var nums: Bool
    pub var align: Int
    pub var focused: Bool
    pub var click: List<(var S) -> Null>
    pub var pick: List<(var S, Int) -> Null>
    pub var change: List<(var S, String) -> Null>
    pub var submit: List<(var S) -> Null>

    fn copy(self) -> Element<S> {
        return Element { kind: self.kind, text: self.text, runs: self.runs, lines: self.lines, kids: self.kids, items: self.items, selected: self.selected, top: self.top, fgc: self.fgc, bgc: self.bgc, bits: self.bits, w: self.w, h: self.h, shr: self.shr, padn: self.padn, gapn: self.gapn, wrapped: self.wrapped, nums: self.nums, align: self.align, focused: self.focused, click: self.click, pick: self.pick, change: self.change, submit: self.submit }
    }

    /// Shows `runs` in a text element in place of its text.
    pub fn with_runs(self, runs: List<Run>) -> Element<S> {
        var e = self.copy()
        e.runs = runs
        return e
    }

    /// Makes a list element show `items` with row `selected` marked, from row `top`.
    pub fn with_rows(self, items: List<String>, selected: Int, top: Int) -> Element<S> {
        var e = self.copy()
        e.items = items
        e.selected = selected
        e.top = top
        return e
    }

    /// Scrolls a scroll element `rows` down.
    pub fn with_offset(self, rows: Int) -> Element<S> {
        var e = self.copy()
        e.top = rows
        return e
    }

    /// The foreground colour, `0xRRGGBB`.
    pub fn fg(self, color: Int) -> Element<S> {
        var e = self.copy()
        e.fgc = color
        return e
    }

    pub fn bg(self, color: Int) -> Element<S> {
        var e = self.copy()
        e.bgc = color
        return e
    }

    pub fn bold(self) -> Element<S> {
        var e = self.copy()
        e.bits = self.bits | 1
        return e
    }

    pub fn dim(self) -> Element<S> {
        var e = self.copy()
        e.bits = self.bits | 2
        return e
    }

    pub fn underline(self) -> Element<S> {
        var e = self.copy()
        e.bits = self.bits | 4
        return e
    }

    pub fn reverse(self) -> Element<S> {
        var e = self.copy()
        e.bits = self.bits | 8
        return e
    }

    /// Cells of space inside the element on every side.
    pub fn pad(self, n: Int) -> Element<S> {
        var e = self.copy()
        e.padn = n
        return e
    }

    /// Cells between the children of a stack.
    pub fn gap(self, n: Int) -> Element<S> {
        var e = self.copy()
        e.gapn = n
        return e
    }

    /// A fixed width in cells.
    pub fn width(self, n: Int) -> Element<S> {
        var e = self.copy()
        e.w = n
        return e
    }

    pub fn height(self, n: Int) -> Element<S> {
        var e = self.copy()
        e.h = n
        return e
    }

    /// Takes a share of the space the parent has left.
    pub fn grow(self) -> Element<S> { return self.shares(1) }

    pub fn shares(self, n: Int) -> Element<S> {
        var e = self.copy()
        e.shr = n
        return e
    }

    /// Breaks text at spaces to fit the width.
    pub fn wrap(self) -> Element<S> {
        var e = self.copy()
        e.wrapped = true
        return e
    }

    /// Puts `1.`, `2.` and so on before the items of a list.
    pub fn numbered(self) -> Element<S> {
        var e = self.copy()
        e.nums = true
        return e
    }

    /// Centers the text in its width.
    pub fn center(self) -> Element<S> {
        var e = self.copy()
        e.align = 1
        return e
    }

    /// Puts the text at the right of its width.
    pub fn right(self) -> Element<S> {
        var e = self.copy()
        e.align = 2
        return e
    }

    /// Makes an input the one that takes the typed keys, and shows the cursor at its end.
    pub fn focus(self) -> Element<S> {
        var e = self.copy()
        e.focused = true
        return e
    }

    /// Runs `f` on the state when the element, or something inside it, is clicked.
    pub fn on_click(self, f: (var S) -> Null) -> Element<S> {
        var e = self.copy()
        e.click = [f]
        return e
    }

    /// Runs `f` with the state and the row index when a row of a list is clicked.
    pub fn on_pick(self, f: (var S, Int) -> Null) -> Element<S> {
        var e = self.copy()
        e.pick = [f]
        return e
    }

    /// Runs `f` with the state and the new text when a focused input's text changes.
    pub fn on_change(self, f: (var S, String) -> Null) -> Element<S> {
        var e = self.copy()
        e.change = [f]
        return e
    }

    /// Runs `f` on the state when Enter is pressed in a focused input.
    pub fn on_submit(self, f: (var S) -> Null) -> Element<S> {
        var e = self.copy()
        e.submit = [f]
        return e
    }
}

pub fn element<S>(kind: Kind, text: String, kids: List<Element<S>>) -> Element<S> {
    return Element { kind: kind, text: text, runs: [], lines: [], kids: kids, items: [], selected: -1, top: 0, fgc: -1, bgc: -1, bits: 0, w: -1, h: -1, shr: 0, padn: 0, gapn: 0, wrapped: false, nums: false, align: 0, focused: false, click: [], pick: [], change: [], submit: [] }
}

/// A text element with the glyphs of each line kept.
pub fn text_element<S>(s: String) -> Element<S> {
    var e: Element<S> = element(Kind.Text, s, [])
    var rows: List<List<String>> = []
    for line in s.split("\n") {
        rows.push(screen.glyphs(line))
    }
    e.lines = rows
    return e
}

/// The cells of an element's text in its runs' looks.
pub fn styled<S>(e: Element<S>) -> List<screen.Cell> {
    var out: List<screen.Cell> = []
    if e.runs.len() == 0 {
        for c in screen.cells(e.text, e.fgc, e.bgc, e.bits) { out.push(c) }
        return out
    }
    for r in e.runs {
        var fg = r.fgc
        if fg < 0 { fg = e.fgc }
        var bg = r.bgc
        if bg < 0 { bg = e.bgc }
        for c in screen.cells(r.text, fg, bg, r.bits | e.bits) { out.push(c) }
    }
    return out
}
