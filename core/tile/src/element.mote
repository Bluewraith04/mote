// The element of a view: what it shows, how it looks, and what a click on it does to the state.
import { Color } from term
import { Dyn, downcast } from std.meta
import { Style } from term

/// What an element is.
pub enum ElementKind {
    Text
    Row
    Column
    Spacer
    Fill
}

/// A part of a view. Every modifier answers a changed copy, so they chain: `tile.text("Done").fg(Color.Green).bold()`.
pub class Element {
    pub var kind: ElementKind
    pub var label: String
    pub var kids: List<Element>
    pub var style: Style
    pub var tag: String
    pub var wide: Int
    pub var tall: Int
    pub var weight: Int
    pub var padding: Int
    pub var spacing: Int
    pub var framed: Bool
    pub var title: String
    pub var click: ((var Dyn) -> Null)?

    // Another element of the same parts, which a modifier then changes.
    fn copy(self) -> Element {
        return Element { kind: self.kind, label: self.label, kids: self.kids, style: self.style, tag: self.tag, wide: self.wide, tall: self.tall, weight: self.weight, padding: self.padding, spacing: self.spacing, framed: self.framed, title: self.title, click: self.click }
    }

    // The element with a style changed.
    fn styled(self, style: Style) -> Element {
        var made = self.copy()
        made.style = style
        return made
    }

    /// Empty cells around the element.
    pub fn pad(self, cells: Int) -> Element {
        var made = self.copy()
        made.padding = cells
        return made
    }

    /// Empty cells between the children.
    pub fn gap(self, cells: Int) -> Element {
        var made = self.copy()
        made.spacing = cells
        return made
    }

    /// A width in cells, along a row.
    pub fn width(self, cells: Int) -> Element {
        var made = self.copy()
        made.wide = cells
        return made
    }

    /// A height in cells, along a column.
    pub fn height(self, cells: Int) -> Element {
        var made = self.copy()
        made.tall = cells
        return made
    }

    /// Takes one share of what the parent's other children leave.
    pub fn grow(self) -> Element { return self.grow_by(1) }

    /// Takes `weight` shares of what the parent's other children leave.
    pub fn grow_by(self, weight: Int) -> Element {
        var made = self.copy()
        made.weight = weight
        return made
    }

    /// A line around the element with the title in its top edge.
    pub fn border(self, title: String) -> Element {
        var made = self.copy()
        made.framed = true
        made.title = title
        return made
    }

    /// The colour of the text in the element and under it.
    pub fn fg(self, color: Color) -> Element {
        return self.styled(Style { fg: color, bg: self.style.bg, bold: self.style.bold, dim: self.style.dim, italic: self.style.italic, underline: self.style.underline, reverse: self.style.reverse })
    }

    /// The background of the text in the element and under it.
    pub fn bg(self, color: Color) -> Element {
        return self.styled(Style { fg: self.style.fg, bg: color, bold: self.style.bold, dim: self.style.dim, italic: self.style.italic, underline: self.style.underline, reverse: self.style.reverse })
    }

    /// Bold text.
    pub fn bold(self) -> Element {
        return self.styled(Style { fg: self.style.fg, bg: self.style.bg, bold: true, dim: self.style.dim, italic: self.style.italic, underline: self.style.underline, reverse: self.style.reverse })
    }

    /// Dim text.
    pub fn dim(self) -> Element {
        return self.styled(Style { fg: self.style.fg, bg: self.style.bg, bold: self.style.bold, dim: true, italic: self.style.italic, underline: self.style.underline, reverse: self.style.reverse })
    }

    /// Italic text.
    pub fn italic(self) -> Element {
        return self.styled(Style { fg: self.style.fg, bg: self.style.bg, bold: self.style.bold, dim: self.style.dim, italic: true, underline: self.style.underline, reverse: self.style.reverse })
    }

    /// Underlined text.
    pub fn underline(self) -> Element {
        return self.styled(Style { fg: self.style.fg, bg: self.style.bg, bold: self.style.bold, dim: self.style.dim, italic: self.style.italic, underline: true, reverse: self.style.reverse })
    }

    /// Text with the foreground and background swapped.
    pub fn reverse(self) -> Element {
        return self.styled(Style { fg: self.style.fg, bg: self.style.bg, bold: self.style.bold, dim: self.style.dim, italic: self.style.italic, underline: self.style.underline, reverse: true })
    }

    /// A name for the element, which its area in the layout carries.
    pub fn id(self, name: String) -> Element {
        var made = self.copy()
        made.tag = name
        return made
    }

    /// Runs when the mouse is pressed on the element, or on something in it that handles no click. The handler is a function over `var` state, or a lambda whose parameter says the type: `|var s: Counter| { s.count += 1 }`.
    pub fn on_click<S>(self, run: (var S) -> Null) -> Element {
        var made = self.copy()
        made.click = |var boxed: Dyn| {
            var state = downcast<S>(boxed)!
            run(state)
            boxed = Dyn.of(state)
        }
        return made
    }
}
