import ..src.lib as tile
import ..src.paint as paint

class State {
    var n: Int
    var picked: Int
}

type View = tile.Element<State>

fn t(s: String) -> tile.Element<State> { return tile.text(s) }

fn vs(kids: List<tile.Element<State>>) -> tile.Element<State> { return tile.vstack(kids) }

fn hs(kids: List<tile.Element<State>>) -> tile.Element<State> { return tile.hstack(kids) }

fn sp() -> tile.Element<State> { return tile.spacer() }

fn draw(root: tile.Element<State>, cols: Int, rows: Int) -> paint.Canvas<State> {
    return paint.draw(root, cols, rows)
}

fn lines(root: tile.Element<State>, cols: Int, rows: Int) -> List<String> {
    var out = draw(root, cols, rows).scr.lines()
    while out.len() > 0 && out.get(out.len() - 1) == "" {
        out.pop()
    }
    return out
}

test "text is painted at the top left and cut at the edge" {
    assert_eq(lines(t("hello world"), 5, 2), ["hello"])
}

test "a newline starts another line" {
    assert_eq(lines(t("ab\ncd"), 4, 3), ["ab", "cd"])
}

test "text wraps at spaces when it is asked to" {
    assert_eq(lines(t("the quick brown fox").wrap(), 9, 4), ["the quick", "brown fox"])
}

test "a long word breaks at the width" {
    assert_eq(lines(t("abcdefgh").wrap(), 3, 4), ["abc", "def", "gh"])
}

test "a vstack puts children one under the other" {
    assert_eq(lines(vs([t("one"), t("two")]), 5, 3), ["one", "two"])
}

test "an hstack puts children side by side, a gap between" {
    assert_eq(lines(hs([t("ab"), t("cd")]).gap(1), 6, 1), ["ab cd"])
}

test "a spacer pushes the next child to the end" {
    assert_eq(lines(hs([t("L"), sp(), t("R")]), 6, 1), ["L    R"])
}

test "children that grow share what is left" {
    assert_eq(lines(hs([t("a").grow(), t("b").grow()]), 6, 1), ["a  b"])
}

test "pad moves the content in" {
    assert_eq(lines(t("x").pad(1), 3, 3), ["", " x"])
}

test "text centers and aligns right in its width" {
    assert_eq(lines(vs([t("ab").center(), t("ab").right()]), 6, 2), ["  ab", "    ab"])
}

test "a frame draws a border and a title around its child" {
    let f = tile.frame("Box", t("hi"))
    assert_eq(lines(f, 8, 3), ["┌─ Box ┐", "│hi    │", "└──────┘"])
}

test "a list marks the selected row and starts at top" {
    let l: tile.Element<State> = tile.list(["a", "b", "c", "d"], 2, 1)
    let c = draw(l, 3, 3)
    assert_eq(c.scr.lines(), ["b", "c", "d"])
    assert_eq(c.scr.get(0, 1).bits, 8)
    assert_eq(c.scr.get(0, 0).bits, 0)
}

test "a scroll shows its children from the offset and clips them" {
    let s = tile.scroll(2, [t("a"), t("b"), t("c"), t("d")]).height(2)
    assert_eq(lines(vs([s, t("end")]), 4, 4), ["c", "d", "end"])
}

test "a scroll with a gap shows the gap rows and counts them in its height" {
    let kids = [t("a"), t("b"), t("c")]
    assert_eq(lines(tile.scroll(0, kids).gap(1), 3, 5), ["a", "", "b", "", "c"])
    assert_eq(tile.height(tile.scroll(0, kids).gap(1), 3), 5)
    assert_eq(lines(tile.scroll(2, kids).gap(1), 3, 3), ["b", "", "c"])
}

test "a scroll takes the height of a child that has one without measuring it" {
    let tall = t("one two three four").wrap().height(2)
    let s = tile.scroll(0, [tall, t("end")])
    assert_eq(tile.height(s, 5), 3)
    assert_eq(lines(vs([s.height(3)]), 5, 3), ["one", "two", "end"])
}

test "a scroll paints only the children inside it" {
    var kids: List<tile.Element<State>> = []
    var i = 0
    while i < 100 {
        kids.push(t("row ${i}").height(1))
        i = i + 1
    }
    assert_eq(lines(tile.scroll(50, kids).height(3), 8, 3), ["row 50", "row 51", "row 52"])
    assert_eq(lines(tile.scroll(97, kids).height(5), 8, 5), ["row 97", "row 98", "row 99"])
}

test "an hstack is as tall as its wrapped child at the width the child is given" {
    let item = hs([t("-").width(4), t("aaa bbb ccc").wrap().grow()])
    assert_eq(tile.height(item, 10), 3)
    assert_eq(lines(vs([item, t("end")]), 10, 4), ["-   aaa", "    bbb", "    ccc", "end"])
}

test "wide text wraps by columns and never splits a character from its second column" {
    assert_eq(lines(t("日本語の字").wrap(), 5, 4), ["日本", "語の", "字"])
    assert_eq(lines(t("日本語の字").wrap(), 6, 4), ["日本語", "の字"])
    assert_eq(tile.height(t("日本語の字").wrap(), 5), 3)
}

test "wide text mixes with narrow text and breaks at spaces" {
    assert_eq(lines(t("日本 go 語").wrap(), 7, 3), ["日本 go", "語"])
}

test "a column too narrow for a wide character still keeps it whole" {
    assert_eq(tile.height(t("日本").wrap(), 1), 2)
}

test "a wide character cut by the right edge is shown as a blank" {
    assert_eq(lines(t("ab日"), 3, 1), ["ab"])
    assert_eq(lines(t("ab日"), 4, 1), ["ab日"])
    assert_eq(lines(hs([t("日日").width(3), t("x")]), 5, 1), ["日 x"])
}

test "rich wide text keeps its looks on both columns" {
    let c = draw(tile.rich([tile.run("日").bold().fg(0xff0000), tile.run("a")]), 4, 1)
    assert_eq(c.scr.get(0, 0).bits, 1)
    assert_eq(c.scr.get(1, 0).bits, 1)
    assert_eq(c.scr.get(1, 0).fg, 0xff0000)
    assert_eq(c.scr.get(2, 0).bits, 0)
}

test "a frame is as wide as its wide title" {
    assert_eq(tile.height(tile.frame("日本", t("x")), -1), 3)
    assert_eq(lines(tile.frame("日本", t("x")), 10, 3), ["┌─ 日本 ─┐", "│x       │", "└────────┘"])
}

test "a list of wide items wraps by columns, the later rows indented" {
    let items = ["日本語の字日本語"]
    assert_eq(lines(tile.list(items, -1, 0).wrap(), 8, 3), ["日本語", "  の字日", "  本語"])
}

test "height answers the rows an element takes at a width" {
    assert_eq(tile.height(t("one two three four").wrap(), 7), 3)
    assert_eq(tile.height(t("one two three four").wrap(), -1), 1)
    assert_eq(tile.height(vs([t("a"), t("b")]).gap(1), 4), 3)
}

test "an input shows its value and the cursor at its end when focused" {
    let i = tile.input("ab", |var s: State, text| { s.n = 1 }).focus()
    let c = draw(i, 6, 1)
    assert_eq(c.scr.lines(), ["ab"])
    assert_eq(c.caret_col, 2)
    assert_eq(c.caret_row, 0)
}

test "an input longer than its width continues on the next row" {
    let i = tile.input("abcdefgh", |var s: State, text| { s.n = 1 }).focus()
    let c = draw(vs([i, t("end")]), 5, 4)
    assert_eq(lines(vs([i, t("end")]), 5, 4), ["abcde", "fgh", "end"])
    assert_eq(c.caret_col, 3)
    assert_eq(c.caret_row, 1)
}

test "an input breaks at spaces so a word is not split" {
    let i = tile.input("hello big world", |var s: State, text| { s.n = 1 }).focus()
    let c = draw(vs([i, t("end")]), 8, 5)
    assert_eq(lines(vs([i, t("end")]), 8, 5), ["hello", "big", "world", "end"])
    assert_eq(c.caret_col, 5)
    assert_eq(c.caret_row, 2)
}

test "an input that ends on a full row puts the cursor on the next row" {
    let i = tile.input("abcde", |var s: State, text| { s.n = 1 }).focus()
    let c = draw(vs([i, t("end")]), 5, 4)
    assert_eq(lines(vs([i, t("end")]), 5, 4), ["abcde", "", "end"])
    assert_eq(c.caret_col, 0)
    assert_eq(c.caret_row, 1)
}

test "a long input does not push its neighbour out of the screen" {
    let long = tile.input("abcdefghijklmnopqrstuvwxyz", |var s: State, text| { s.n = 1 })
    let left = tile.frame("in", vs([long])).grow()
    let right = tile.frame("n", t("7")).width(7)
    let c = draw(hs([left, right]), 20, 6)
    assert(c.scr.lines().get(0).ends_with("┌─ n ─┐"))
    assert(c.scr.lines().get(1).ends_with("│7    │"))
}

test "colours and bits reach the cells; text keeps the background beneath it" {
    let c = draw(vs([t("x").fg(0xff0000).bold()]).bg(0x0000ff), 2, 1)
    assert_eq(c.scr.get(0, 0).fg, 0xff0000)
    assert_eq(c.scr.get(0, 0).bg, 0x0000ff)
    assert_eq(c.scr.get(0, 0).bits, 1)
    assert_eq(c.scr.get(1, 0).bg, 0x0000ff)
}

test "rich text takes each run's look" {
    let r: tile.Element<State> = tile.rich([tile.run("a").bold(), tile.run("b").fg(0x00ff00)])
    let c = draw(r, 2, 1)
    assert_eq(c.scr.get(0, 0).bits, 1)
    assert_eq(c.scr.get(1, 0).fg, 0x00ff00)
}

test "the innermost click handler under a point is found last" {
    let outer = vs([t("in").on_click(|var s| { s.n = 2 })]).on_click(|var s| { s.n = 1 })
    let c = draw(outer, 4, 2)
    var s = State { n: 0, picked: 0 }
    var found = -1
    var i = 0
    for h in c.hits {
        if 0 >= h.x && 0 < h.x + h.w && 0 >= h.y && 0 < h.y + h.h { found = i }
        i = i + 1
    }
    c.hits.get(found).f(s)
    assert_eq(s.n, 2)
}

fn letters() -> List<String> { return ["a", "b", "c", "d", "e", "f", "g", "h"] }

test "a list scrolls to keep the selected item in view" {
    let l: tile.Element<State> = tile.list(letters(), 5, 0)
    assert_eq(draw(l, 3, 3).scr.lines(), ["d", "e", "f"])
}

test "a list stays where it was while the selection moves inside it" {
    let first: paint.Canvas<State> = paint.draw_after(tile.list(letters(), 5, 0), 3, 3, [])
    assert_eq(first.scr.lines(), ["d", "e", "f"])
    let second: paint.Canvas<State> = paint.draw_after(tile.list(letters(), 4, 0), 3, 3, first.scrolls)
    assert_eq(second.scr.lines(), ["d", "e", "f"])
    let third: paint.Canvas<State> = paint.draw_after(tile.list(letters(), 2, 0), 3, 3, second.scrolls)
    assert_eq(third.scr.lines(), ["c", "d", "e"])
}

test "a list whose top the program changed starts from that top" {
    let first: paint.Canvas<State> = paint.draw_after(tile.list(letters(), 5, 0), 3, 3, [])
    let moved: paint.Canvas<State> = paint.draw_after(tile.list(letters(), -1, 1), 3, 3, first.scrolls)
    assert_eq(moved.scr.lines(), ["b", "c", "d"])
}

test "a list the program scrolled past the selection stays there until the selection moves" {
    let first: paint.Canvas<State> = paint.draw_after(tile.list(letters(), 1, 0), 3, 3, [])
    assert_eq(first.scr.lines(), ["a", "b", "c"])
    let scrolled: paint.Canvas<State> = paint.draw_after(tile.list(letters(), 1, 4), 3, 3, first.scrolls)
    assert_eq(scrolled.scr.lines(), ["e", "f", "g"])
    let again: paint.Canvas<State> = paint.draw_after(tile.list(letters(), 1, 4), 3, 3, scrolled.scrolls)
    assert_eq(again.scr.lines(), ["e", "f", "g"])
    let moved: paint.Canvas<State> = paint.draw_after(tile.list(letters(), 2, 4), 3, 3, again.scrolls)
    assert_eq(moved.scr.lines(), ["c", "d", "e"])
}

test "a wrapped item is scrolled into view with all its rows" {
    let l: tile.Element<State> = tile.list(["one", "two", "buy ink and paper"], 2, 0).wrap().numbered()
    assert_eq(draw(l, 12, 2).scr.lines(), ["3. buy ink", "   and paper"])
    assert_eq(draw(l, 12, 3).scr.lines(), ["2. two", "3. buy ink", "   and paper"])
}

test "a numbered list wraps its items with the later rows indented under the text" {
    let l: tile.Element<State> = tile.list(["buy ink and paper", "write", "try the mouse today"], 1, 0).wrap().numbered()
    assert_eq(lines(l, 12, 8), ["1. buy ink", "   and paper", "2. write", "3. try the", "   mouse", "   today"])
}

test "every row of a selected item is highlighted" {
    let l: tile.Element<State> = tile.list(["one", "buy ink and paper", "two"], 1, 0).wrap().numbered()
    let c = draw(l, 12, 8)
    assert_eq(c.scr.get(0, 0).bits, 0)
    assert_eq(c.scr.get(0, 1).bits, 8)
    assert_eq(c.scr.get(11, 2).bits, 8)
    assert_eq(c.scr.get(0, 3).bits, 0)
}

test "a click on a later row of a wrapped item picks that item" {
    let l: tile.Element<State> = tile.list(["one", "buy ink and paper", "two"], -1, 0).wrap().numbered().on_pick(|var s, i| { s.picked = i })
    let c = draw(l, 12, 8)
    var s = State { n: 0, picked: -1 }
    var i = 0
    var found = -1
    for h in c.hits {
        if 2 >= h.y && 2 < h.y + h.h { found = i }
        i = i + 1
    }
    c.hits.get(found).f(s)
    assert_eq(s.picked, 1)
}

test "a list that wraps wants as many rows as its items take" {
    let l: tile.Element<State> = tile.list(["buy ink and paper", "write"], -1, 0).wrap().numbered()
    assert_eq(lines(vs([l, t("end")]), 12, 8), ["1. buy ink", "   and paper", "2. write", "end"])
}

test "a list row click passes its index" {
    let l: tile.Element<State> = tile.list(["a", "b", "c"], -1, 0).on_pick(|var s, i| { s.picked = i })
    let c = draw(l, 3, 3)
    var s = State { n: 0, picked: -1 }
    c.hits.get(2).f(s)
    assert_eq(s.picked, 2)
}
