import { assert, assert_eq } from std.test
import { join } from std.string
import { Pty, move_to } from term
import { sleep } from std.task
import { Input, Next, Options, Style, View, fit, fixed, flex, render, run, text_width } from tile

let ESC = "\u{1b}"

fn shown(view: View, rows: Int, cols: Int) -> String {
    return join(render(view, rows, cols).lines(), "|")
}

test "text fills the top left and the rest is blank" {
    assert_eq(shown(View.text("hi\nthere"), 3, 8), "hi      |there   |        ")
}

test "text that does not fit is cut" {
    assert_eq(shown(View.text("abcdef\n12"), 1, 4), "abcd")
    assert_eq(shown(View.text("abc"), 2, 0), "|")
}

test "a column gives fixed, fitted and shared rows" {
    let view = View.column([fixed(1, View.text("top")), flex(1, View.fill(".", Style {})), fit(View.text("a\nb"))])
    assert_eq(shown(view, 6, 3), "top|...|...|...|a  |b  ")
}

test "shares are by weight and the remainder goes to the first" {
    let view = View.row([flex(1, View.fill("a", Style {})), flex(2, View.fill("b", Style {}))])
    assert_eq(shown(view, 1, 10), "aaaabbbbbb")
    assert_eq(shown(view, 1, 7), "aaabbbb")
}

test "a row puts its children side by side" {
    let view = View.row([fixed(3, View.text("ab")), fit(View.text("xyz")), flex(1, View.text("end"))])
    assert_eq(shown(view, 1, 12), "ab xyzend   ")
}

test "a border draws a box with a title" {
    let view = View.border("Log", View.text("one\ntwo"))
    assert_eq(shown(view, 4, 9), "┌ Log ──┐|│one    │|│two    │|└───────┘")
}

test "padding leaves the edge blank" {
    assert_eq(shown(View.pad(1, View.text("x")), 3, 3), "   | x |   ")
}

test "a view bigger than the screen is cut at the screen" {
    let view = View.column([fixed(2, View.text("a")), fixed(2, View.text("b"))])
    assert_eq(shown(view, 3, 2), "a |  |b ")
}

test "wide glyphs take two columns and combining marks none" {
    assert_eq(text_width("abc"), 3)
    assert_eq(text_width("日本"), 4)
    assert_eq(text_width("e\u{301}"), 1)
    assert_eq(shown(View.text("日本x"), 1, 5), "日本x")
    assert_eq(shown(View.text("日本"), 1, 3), "日 ")
}

test "the first drawing is everything and an unchanged one is nothing" {
    let first = render(View.text("hi"), 2, 4)
    let drawn = first.diff(null)
    assert(drawn.starts_with(ESC + "[2J"), "clear")
    assert(drawn.contains("hi"), "text")
    assert_eq(render(View.text("hi"), 2, 4).diff(first), "")
}

test "a change writes only the cell that differs" {
    let before = render(View.text("hello"), 2, 8)
    let after = render(View.text("help!"), 2, 8)
    let drawn = after.diff(before)
    assert(!drawn.contains(ESC + "[2J"), "no clear")
    assert(drawn.starts_with(move_to(0, 3)), "starts at the first change")
    assert(drawn.contains("p!"), "the changed run")
    assert(!drawn.contains("hel"), "unchanged cells are not written")
}

test "a style change writes the cell again" {
    let before = render(View.text("ab"), 1, 4)
    let after = render(View.styled("ab", Style { bold: true }), 1, 4)
    let drawn = after.diff(before)
    assert(drawn.contains(ESC + "[1m"), "bold")
    assert(drawn.contains("a"), "a")
    assert(drawn.contains("b"), "b")
}

test "a new size draws everything again" {
    let small = render(View.text("x"), 1, 2)
    let bigger = render(View.text("x"), 2, 3)
    assert(bigger.diff(small).starts_with(ESC + "[2J"), "clear")
}

// The text the other end of the pseudo-terminal has been written until it is quiet.
fn written(pty: Pty) -> String {
    var all = ""
    while true {
        let more = pty.read(200)!
        if more == "" { break }
        all = all + more
    }
    return all
}

fn count_view(n: Int) -> View {
    return View.border("count", View.text("n=${n}"))
}

fn count_update(n: Int, input: Input) -> Next<Int> {
    return match input {
        Key(key) => if key.to_string() == "j" {
            Next.Continue(n + 1)
        } else if key.to_string() == "k" {
            Next.Continue(n - 1)
        } else if key.to_string() == "q" {
            Next.Quit(n)
        } else {
            Next.Continue(n)
        }
        _ => Next.Continue(n)
    }
}

test "a program draws its state, follows the keys and puts the terminal back" {
    let pty = Pty.open()!
    pty.resize(4, 20)!
    pty.send("jjkq")!
    let final = run(pty.terminal(), 0, count_view, count_update, Options {})!
    assert_eq(final, 1)
    let output = written(pty)
    assert(output.contains(ESC + "[?1049h"), "alternate screen")
    assert(output.contains("n=0"), "first state")
    assert(output.contains("count"), "title")
    assert(output.contains(ESC + "[?25l"), "cursor hidden")
    assert(output.ends_with(ESC + "[0m" + ESC + "[?25h" + ESC + "[?1049l"), "put back")
    pty.close()!
}

test "the mouse is reported only when asked for" {
    let pty = Pty.open()!
    pty.resize(4, 20)!
    pty.send("${ESC}[<0;3;2M")!
    let seen = run(pty.terminal(), "", |s: String| View.text(s), |s: String, input: Input| match input {
        Mouse(event) => Next.Quit(event.to_string())
        _ => Next.Continue(s)
    }, Options { mouse: true })!
    assert_eq(seen, "Press(0) at 1,2")
    assert(written(pty).contains(ESC + "[?1006h"), "mouse on")
    pty.close()!
}

test "ticks come at the interval and stop with the program" {
    let pty = Pty.open()!
    pty.resize(4, 20)!
    let ticks = run(pty.terminal(), 0, |n: Int| View.text("ticks ${n}"), |n: Int, input: Input| match input {
        Tick => if n >= 2 { Next.Quit(n + 1) } else { Next.Continue(n + 1) }
        _ => Next.Continue(n)
    }, Options { tick_ms: 10 })!
    assert_eq(ticks, 3)
    pty.close()!
}

test "the program is told when the terminal changes size" {
    let pty = Pty.open()!
    pty.resize(4, 20)!
    let resizer = spawn {
        sleep(80)
        return pty.resize(6, 30)
    }
    let seen = run(pty.terminal(), "", |s: String| View.text(s), |s: String, input: Input| match input {
        Resize(rows, cols) => Next.Quit("${rows}x${cols}")
        _ => Next.Continue(s)
    }, Options {})!
    assert_eq(seen, "6x30")
    resizer.await()!!
    pty.close()!
}

test "a terminal with no size uses the size in the options" {
    let pty = Pty.open()!
    pty.send("q")!
    let seen = run(pty.terminal(), 0, |n: Int| View.text("wide"), |n: Int, input: Input| Next.Quit(7), Options { rows: 3, cols: 9 })!
    assert_eq(seen, 7)
    pty.close()!
}
