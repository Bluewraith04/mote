import std.fs as fs
import std.math as math
import ..src.lib as sql

class Out {
    var lines: List<String>
}

fn say<T>(var o: Out, v: T) {
    o.lines.push(v.to_string())
}

fn count(db: sql.Database) -> Int {
    let rows = db.query("SELECT COUNT(*) AS n FROM t").unwrap()
    return rows.get(0).int("n").unwrap()
}

fn report(var o: Out, label: String, r: Result<sql.Changes, Error>) {
    match r {
        Ok(d) => { say(o, "${label}: ok") }
        Err(e) => { say(o, "${label}: ${e.message}") }
    }
}

test "every kind of cell round trips" {
    var o = Out { lines: [] }
    let db = sql.memory().unwrap()
    let made = db.execute("CREATE TABLE t (a INTEGER, b REAL, c TEXT, d BLOB, e TEXT)").unwrap()
    say(o, made.changed)
    let blob = Bytes(3)
    blob.set(0, 1)
    blob.set(1, 2)
    blob.set(2, 255)
    let put = db.execute("INSERT INTO t VALUES (?, ?, ?, ?, ?)", [-7, 2.5, "héllo", blob, None]).unwrap()
    say(o, "${put.changed} ${put.last_id}")
    let rows = db.query("SELECT * FROM t").unwrap()
    say(o, rows.len())
    let r = rows.get(0)
    say(o, r.columns().len())
    say(o, r.int("a").unwrap())
    say(o, r.float("b").unwrap())
    say(o, r.text("c").unwrap())
    say(o, r.bytes("d").unwrap().len())
    say(o, r.bytes("d").unwrap().get(2))
    say(o, r.is_null("e").unwrap())
    say(o, r.is_null("a").unwrap())
    say(o, r.float("a").unwrap())
    assert_eq(o.lines, ["0", "1 1", "1", "5", "-7", "2.5", "héllo", "3", "255", "true", "false", "-7.0"])
}

test "a prepared statement is checked once and run many times" {
    var o = Out { lines: [] }
    let db = sql.memory().unwrap()
    let made = db.execute("CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT)").unwrap()
    let add = db.prepare("INSERT INTO t (name) VALUES (?)").unwrap()
    say(o, add.param_count())
    for n in ["a", "b", "c"] {
        let done = add.execute([n]).unwrap()
        say(o, done.last_id)
    }
    let find = db.prepare("SELECT id, name FROM t WHERE id >= ? ORDER BY id").unwrap()
    say(o, find.columns().len())
    say(o, find.query([2]).unwrap().len())
    say(o, find.query([4]).unwrap().len())
    match add.execute([]) {
        Ok(d) => { say(o, "ran with no parameter") }
        Err(e) => { say(o, "too few: ${e.message}") }
    }
    match db.prepare("SELEKT 1") {
        Ok(s) => { say(o, "prepared nonsense") }
        Err(e) => { say(o, "bad sql") }
    }
    assert_eq(o.lines.get(0), "1")
    assert_eq(o.lines.get(1), "1")
    assert_eq(o.lines.get(2), "2")
    assert_eq(o.lines.get(3), "3")
    assert_eq(o.lines.get(4), "2")
    assert_eq(o.lines.get(5), "2")
    assert_eq(o.lines.get(6), "0")
    assert(o.lines.get(7).starts_with("too few: "))
    assert_eq(o.lines.get(8), "bad sql")
}

test "a transaction commits or rolls back" {
    var o = Out { lines: [] }
    let db = sql.memory().unwrap()
    let made = db.execute("CREATE TABLE t (a INTEGER)").unwrap()
    let t = db.begin().unwrap()
    let one = t.execute("INSERT INTO t VALUES (1)").unwrap()
    let seen = t.query("SELECT a FROM t").unwrap()
    say(o, seen.len())
    let ok = t.commit()
    say(o, count(db))
    let u = db.begin().unwrap()
    let two = u.execute("INSERT INTO t VALUES (2)").unwrap()
    let undone = u.rollback()
    say(o, count(db))
    with w = db.begin().unwrap() {
        let three = w.execute("INSERT INTO t VALUES (3)").unwrap()
    }
    say(o, count(db))
    with x = db.begin().unwrap() {
        let four = x.execute("INSERT INTO t VALUES (4)").unwrap()
        let kept = x.commit()
    }
    say(o, count(db))
    match t.execute("INSERT INTO t VALUES (5)") {
        Ok(d) => { say(o, "ran after commit") }
        Err(e) => { say(o, "finished: ${e.message}") }
    }
    assert_eq(o.lines, ["1", "1", "1", "1", "2", "finished: sql: the transaction is finished"])
}

test "failures say what went wrong" {
    var o = Out { lines: [] }
    let db = sql.memory().unwrap()
    let a = db.execute("CREATE TABLE p (id INTEGER PRIMARY KEY, name TEXT NOT NULL)").unwrap()
    let b = db.execute("CREATE TABLE c (pid INTEGER REFERENCES p(id))").unwrap()
    report(o, "insert", db.execute("INSERT INTO p VALUES (1, ?)", ["x"]))
    report(o, "duplicate", db.execute("INSERT INTO p VALUES (1, ?)", ["y"]))
    report(o, "null", db.execute("INSERT INTO p VALUES (2, ?)", [None]))
    report(o, "foreign", db.execute("INSERT INTO c VALUES (99)"))
    report(o, "syntax", db.execute("SELEKT"))
    report(o, "table", db.execute("DROP TABLE nope"))
    report(o, "count", db.execute("INSERT INTO p VALUES (?, ?)", [3]))
    let rows = db.query("SELECT id, name FROM p").unwrap()
    let r = rows.get(0)
    match r.int("name") {
        Ok(n) => { say(o, "name as int") }
        Err(e) => { say(o, e.message) }
    }
    match r.get("nope") {
        Ok(c) => { say(o, "found") }
        Err(e) => { say(o, e.message) }
    }
    let closed = db.close()
    report(o, "closed", db.execute("SELECT 1"))
    let got = o.lines
    assert_eq(got.get(0), "insert: ok")
    assert(got.get(1).starts_with("duplicate: ") && got.get(1).contains("UNIQUE"))
    assert(got.get(2).starts_with("null: ") && got.get(2).contains("NOT NULL"))
    assert(got.get(3).starts_with("foreign: ") && got.get(3).contains("FOREIGN KEY"))
    assert(got.get(4).starts_with("syntax: ") && got.get(4).contains("syntax error"))
    assert(got.get(5).starts_with("table: ") && got.get(5).contains("no such table"))
    assert(got.get(6).starts_with("count: "))
    assert_eq(got.get(7), "column name is not an Int")
    assert_eq(got.get(8), "no column nope")
    assert(got.get(9).starts_with("closed: ") && got.get(9).contains("closed"))
}

test "tasks share one database" {
    let db = sql.memory().unwrap()
    let made = db.execute("CREATE TABLE t (n INTEGER)").unwrap()
    scope {
        var i = 0
        while i < 50 {
            let n = i
            spawn {
                let t = db.begin().unwrap()
                let one = t.execute("INSERT INTO t VALUES (?)", [n]).unwrap()
                let two = t.execute("INSERT INTO t VALUES (?)", [n + 1000]).unwrap()
                let done = t.commit()
            }
            i = i + 1
        }
    }
    let rows = db.query("SELECT COUNT(*) AS n, SUM(n) AS total FROM t").unwrap()
    assert_eq(rows.get(0).int("n").unwrap(), 100)
    assert_eq(rows.get(0).int("total").unwrap(), 52450)
}

test "a file database keeps its rows" {
    let dir = "/tmp/mote_sqlite_test"
    fs.remove_dir_all(dir)
    fs.create_dir_all(dir).unwrap()
    let path = "${dir}/app.db"
    let db = sql.open(path).unwrap()
    let made = db.execute("CREATE TABLE t (n INTEGER)").unwrap()
    let one = db.execute("INSERT INTO t VALUES (41), (1)").unwrap()
    let closed = db.close()
    let again = sql.open(path).unwrap()
    let rows = again.query("SELECT SUM(n) AS s FROM t").unwrap()
    assert_eq(rows.get(0).int("s").unwrap(), 42)
    assert(sql.open("/no/such/dir/x.db").is_err())
    let shut = again.close()
    fs.remove_dir_all(dir)
}

test "large answers and extreme values cross intact" {
    let db = sql.memory().unwrap()
    let made = db.execute("CREATE TABLE t (id INTEGER, body TEXT)").unwrap()
    let wide = "0123456789".repeat(20)
    let t = db.begin().unwrap()
    var i = 0
    while i < 3000 {
        let done = t.execute("INSERT INTO t VALUES (?, ?)", [i, wide]).unwrap()
        i = i + 1
    }
    let kept = t.commit()
    let rows = db.query("SELECT id, body FROM t ORDER BY id").unwrap()
    assert_eq(rows.len(), 3000)
    assert_eq(rows.get(2999).int("id").unwrap(), 2999)
    assert(rows.get(2999).text("body").unwrap() == wide)
    let lo = 0 - 9223372036854775807 - 1
    let edges = db.query("SELECT ? AS lo, ? AS hi, ? AS big, ? AS up, ? AS down, ? AS empty, ? AS none", [lo, 9223372036854775807, 1.0e300, math.inf(), 0.0 - math.inf(), "", Bytes()]).unwrap()
    let e = edges.get(0)
    assert(e.int("lo").unwrap() == lo)
    assert_eq(e.int("hi").unwrap(), 9223372036854775807)
    assert(e.float("big").unwrap() == 1.0e300)
    assert(math.is_infinite(e.float("up").unwrap()))
    assert(e.float("down").unwrap() < 0.0)
    assert_eq(e.text("empty").unwrap().len(), 0)
}
