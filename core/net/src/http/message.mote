// The request a server reads and the response it writes.
import { Json, parse as parse_json } from json
import { find_header, segments_of } from ._text
import { url_decode } from .url

/// A request: the method and target as sent, the path and query split at `?`, headers as `(name, value)` pairs (names in lower case), the body and the peer's address.
pub class Request {
    pub method: String
    pub target: String
    pub path: String
    pub query: String
    pub version: String
    pub headers: [(String, String)]
    pub body: [UInt8]
    pub peer: String

    /// The value of a header, by its name in any case.
    pub fn header(self, name: String) -> String? { return find_header(self.headers, name.to_lower()) }

    /// The value of a query parameter, decoded; `a=1&b` gives "" for `b`.
    pub fn query_param(self, name: String) -> String? {
        for pair in self.query.split("&") {
            let at = pair.find("=")
            let key = if at == null { pair } else { pair.slice(0, at) }
            if url_decode(key.replace("+", " ")) == name {
                if at == null { return "" }
                return url_decode(pair.slice(at + 1, pair.len()).replace("+", " "))
            }
        }
        return null
    }

    /// The path split at `/` with each part decoded.
    pub fn segments(self) -> [String] { return segments_of(self.path) }

    /// The parts a path takes for each `:name` of the pattern, when the method and the other parts match; null otherwise.
    pub fn route(self, method: String, pattern: String) -> [String]? {
        if self.method != method { return null }
        let wanted = segments_of(pattern)
        let actual = segments_of(self.path)
        if wanted.len() != actual.len() { return null }
        var found: List<String> = []
        for k in 0..wanted.len() {
            if wanted[k].starts_with(":") {
                found.push(actual[k])
            } else if wanted[k] != actual[k] {
                return null
            }
        }
        return found.to_array()
    }

    pub fn body_text(self) -> String? { return String.from_bytes(self.body) }

    /// The body parsed as JSON.
    pub fn body_json(self) -> Result<Json, Error> {
        let text = String.from_bytes(self.body)
        if text == null { return Err(Error.new(ErrorKind.InvalidData, "the body is not text")) }
        return parse_json(text)
    }
}

/// A response: the status, headers as `(name, value)` pairs (names in lower case) and the body. The server adds `content-length` and `connection`.
pub class Response {
    pub status: Int
    pub headers: [(String, String)]
    pub body: [UInt8]
    pub upgrade: Bool

    /// A response with a content type and bytes.
    pub fn bytes(status: Int, content_type: String, body: [UInt8]) -> Response {
        return Response { status: status, headers: [("content-type", content_type)], body: body, upgrade: false }
    }

    pub fn text(status: Int, text: String) -> Response { return Response.bytes(status, "text/plain; charset=utf-8", text.bytes()) }

    pub fn html(status: Int, text: String) -> Response { return Response.bytes(status, "text/html; charset=utf-8", text.bytes()) }

    pub fn json(status: Int, value: Json) -> Response { return Response.bytes(status, "application/json", value.to_string().bytes()) }

    /// A response with no body.
    pub fn empty(status: Int) -> Response { return Response { status: status, headers: [], body: [], upgrade: false } }

    /// A 302 to `location`.
    pub fn redirect(location: String) -> Response { return Response.empty(302).with_header("location", location) }

    /// The answer that turns the connection into a WebSocket, when the request asked for one.
    pub fn upgrade_to_websocket() -> Response { return Response { status: 101, headers: [], body: [], upgrade: true } }

    /// The response with one more header.
    pub fn with_header(self, name: String, value: String) -> Response {
        var headers = self.headers.to_list()
        headers.push((name.to_lower(), value))
        return Response { status: self.status, headers: headers.to_array(), body: self.body, upgrade: self.upgrade }
    }

    pub fn header(self, name: String) -> String? { return find_header(self.headers, name.to_lower()) }

    pub fn body_text(self) -> String? { return String.from_bytes(self.body) }

    pub fn body_json(self) -> Result<Json, Error> {
        let text = String.from_bytes(self.body)
        if text == null { return Err(Error.new(ErrorKind.InvalidData, "the body is not text")) }
        return parse_json(text)
    }
}

