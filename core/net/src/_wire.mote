// A plain or TLS stream behind one set of calls, and a reader that keeps what arrived beyond the line or block asked for.
import { TcpStream } from .socket
import { TlsStream } from .tls

/// A connected stream, plain or encrypted.
pub enum Wire {
    Plain(TcpStream)
    Secure(TlsStream)

    pub fn read_into(self, buffer: [UInt8]) -> Result<Int, Error> {
        return match self {
            Plain(stream) => stream.read_into(buffer)
            Secure(stream) => stream.read_into(buffer)
        }
    }

    pub fn write(self, bytes: [UInt8]) -> Result<Null, Error> {
        return match self {
            Plain(stream) => stream.write(bytes)
            Secure(stream) => stream.write(bytes)
        }
    }

    pub fn set_timeout(self, ms: Int) {
        match self {
            Plain(stream) => stream.set_timeout(ms)
            Secure(stream) => stream.set_timeout(ms)
        }
    }

    pub fn peer_addr(self) -> String {
        let found = match self {
            Plain(stream) => stream.peer_addr()
            Secure(stream) => stream.peer_addr()
        }
        return match found {
            Ok(text) => text
            Err(_) => ""
        }
    }

    pub fn close(self) {
        match self {
            Plain(stream) => stream.close()
            Secure(stream) => stream.close()
        }
    }
}

let TOO_LARGE = ErrorKind.Unsupported

/// Reads lines and blocks of bytes from a wire, keeping the rest of each read for the next call.
pub class Reader {
    pub wire: Wire
    chunk: [UInt8]
    var start: Int
    var finish: Int

    pub fn new(wire: Wire) -> Reader { return Reader { wire: wire, chunk: [0; 16384], start: 0, finish: 0 } }

    // Makes bytes ready; false at the end of the stream.
    fn fill(var self) -> Result<Bool, Error> {
        if self.start < self.finish { return Ok(true) }
        let got = self.wire.read_into(self.chunk)?
        self.start = 0
        self.finish = got
        return Ok(got > 0)
    }

    /// A line without its line break, or null at the end of the stream before any byte; a line over `limit` bytes is an `Unsupported` error.
    pub fn line(var self, limit: Int) -> Result<String?, Error> {
        var bytes: List<UInt8> = []
        while true {
            if !self.fill()? {
                if bytes.len() == 0 { return Ok(null) }
                break
            }
            let byte = self.chunk[self.start]
            self.start += 1
            if byte == 10 { break }
            bytes.push(byte)
            if bytes.len() > limit { return Err(Error.new(TOO_LARGE, "line too long")) }
        }
        if bytes.len() > 0 && bytes.get(bytes.len() - 1) == 13 { bytes.pop() }
        let text = String.from_bytes(bytes.to_array())
        if text == null { return Err(Error.new(ErrorKind.InvalidData, "line is not text")) }
        return Ok(text)
    }

    /// Exactly `count` bytes; the stream ending first is an error.
    pub fn take(var self, count: Int) -> Result<[UInt8], Error> {
        var out: [UInt8] = [0; count]
        var at = 0
        while at < count {
            if !self.fill()? { return Err(Error.new(ErrorKind.InvalidData, "the stream ended inside a message")) }
            var n = self.finish - self.start
            if n > count - at { n = count - at }
            for k in 0..n {
                out[at + k] = self.chunk[self.start + k]
            }
            self.start += n
            at += n
        }
        return Ok(out)
    }

    /// Every byte to the end of the stream, up to `limit`.
    pub fn rest(var self, limit: Int) -> Result<[UInt8], Error> {
        var out: List<UInt8> = []
        while self.fill()? {
            for k in self.start..self.finish {
                out.push(self.chunk[k])
            }
            self.start = self.finish
            if out.len() > limit { return Err(Error.new(TOO_LARGE, "body too large")) }
        }
        return Ok(out.to_array())
    }
}
