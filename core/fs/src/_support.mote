// The error for a negated errno, and the metadata a native gave, as values.

// The error for the negated errno a native gave, naming what was asked.
pub fn failure(code: Int, what: String) -> Error {
    let errno = -code
    var kind = ErrorKind.Other
    var text = "error ${errno}"
    if errno == 1 {
        kind = ErrorKind.PermissionDenied
        text = "operation not permitted"
    } else if errno == 2 {
        kind = ErrorKind.NotFound
        text = "no such file or directory"
    } else if errno == 4 {
        kind = ErrorKind.Interrupted
        text = "interrupted"
    } else if errno == 9 {
        text = "bad file descriptor"
    } else if errno == 11 {
        kind = ErrorKind.WouldBlock
        text = "would block"
    } else if errno == 13 {
        kind = ErrorKind.PermissionDenied
        text = "permission denied"
    } else if errno == 17 {
        kind = ErrorKind.AlreadyExists
        text = "file exists"
    } else if errno == 18 {
        text = "cross-device link"
    } else if errno == 20 {
        text = "not a directory"
    } else if errno == 21 {
        text = "is a directory"
    } else if errno == 22 {
        kind = ErrorKind.InvalidData
        text = "invalid argument"
    } else if errno == 24 {
        text = "too many open files"
    } else if errno == 28 {
        text = "no space left on device"
    } else if errno == 30 {
        text = "read-only file system"
    } else if errno == 36 {
        text = "file name too long"
    } else if errno == 39 {
        text = "directory not empty"
    } else if errno == 40 {
        text = "too many levels of symbolic links"
    }
    return Error.new(kind, "${what}: ${text}")
}

/// What a path is.
pub enum FileKind {
    File
    Directory
    Symlink
    Other
}

/// What the file system knows of a path: its kind, its size in bytes, its last change in nanoseconds since 1970-01-01 and its permission bits.
pub struct Metadata {
    pub kind: FileKind
    pub size: Int
    pub modified: Int
    pub mode: Int

    pub fn is_file(self) -> Bool { return self.kind == FileKind.File }
    pub fn is_dir(self) -> Bool { return self.kind == FileKind.Directory }
    pub fn is_symlink(self) -> Bool { return self.kind == FileKind.Symlink }
}

pub fn metadata_of(fields: [Int]) -> Metadata {
    let number = fields[0]
    var kind = FileKind.Other
    if number == 1 {
        kind = FileKind.File
    } else if number == 2 {
        kind = FileKind.Directory
    } else if number == 3 {
        kind = FileKind.Symlink
    }
    return Metadata { kind: kind, size: fields[1], modified: fields[2], mode: fields[3] }
}

