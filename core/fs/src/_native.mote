// The functions of the native library `fs`.

@blocking
@link("fs")
pub native fn fs_open(path: String, flags: Int, mode: Int) -> Int

@blocking
@link("fs")
pub native fn fs_close(fd: Int) -> Int

@blocking
@link("fs")
pub native fn fs_read(fd: Int, buffer: [UInt8], count: Int) -> Int

@blocking
@link("fs")
pub native fn fs_write(fd: Int, buffer: [UInt8], count: Int) -> Int

@blocking
@link("fs")
pub native fn fs_seek(fd: Int, offset: Int, whence: Int) -> Int

@blocking
@link("fs")
pub native fn fs_truncate(fd: Int, size: Int) -> Int

@blocking
@link("fs")
pub native fn fs_mkdir(path: String, mode: Int) -> Int

@blocking
@link("fs")
pub native fn fs_rmdir(path: String) -> Int

@blocking
@link("fs")
pub native fn fs_unlink(path: String) -> Int

@blocking
@link("fs")
pub native fn fs_rename(source: String, target: String) -> Int

@blocking
@link("fs")
pub native fn fs_stat(path: String, out: [Int], follow: Int) -> Int

@blocking
@link("fs")
pub native fn fs_fstat(fd: Int, out: [Int]) -> Int

@blocking
@link("fs")
pub native fn fs_list(path: String, buffer: [UInt8]) -> Int

