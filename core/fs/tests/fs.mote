import { assert, assert_eq } from std.test
import { join } from std.string
import { File, Origin, FileKind, append_string, copy, create_dir, create_dir_all, exists, is_dir, is_file, list, metadata, read_bytes, read_string, remove_all, remove_dir, remove_file, rename, write_bytes, write_string } from fs

let root = "/tmp/mote-fs-tests"

// A clean directory of the test's own.
fn scratch(name: String) -> String {
    let dir = root + "/" + name
    remove_all(dir).is_err()
    create_dir_all(dir)!
    return dir
}

test "text is written and read back" {
    let dir = scratch("text")
    write_string(dir + "/a.txt", "hello\nworld\n")!
    assert_eq(read_string(dir + "/a.txt")!, "hello\nworld\n")
    write_string(dir + "/a.txt", "short")!
    assert_eq(read_string(dir + "/a.txt")!, "short")
}

test "bytes are written and read back" {
    let dir = scratch("bytes")
    let data: [UInt8] = [0, 1, 2, 255, 0, 7]
    write_bytes(dir + "/b.bin", data)!
    let back = read_bytes(dir + "/b.bin")!
    assert_eq(back.len(), 6)
    assert_eq(back[3] as Int, 255)
    assert_eq(back[4] as Int, 0)
}

test "append adds to the end" {
    let dir = scratch("append")
    append_string(dir + "/log", "one\n")!
    append_string(dir + "/log", "two\n")!
    assert_eq(read_string(dir + "/log")!, "one\ntwo\n")
}

test "a large file reads whole" {
    let dir = scratch("large")
    var text = "0123456789"
    for _ in 0..14 {
        text = text + text
    }
    write_string(dir + "/big", text)!
    assert_eq(read_string(dir + "/big")!.len(), 163840)
    assert_eq(metadata(dir + "/big")!.size, 163840)
}

test "a file reads in pieces and seeks" {
    let dir = scratch("pieces")
    write_string(dir + "/p", "abcdefghij")!
    let file = File.open(dir + "/p")!
    assert_eq(String.from_bytes(file.read(4)!)!, "abcd")
    assert_eq(file.seek(2, Origin.Current)!, 6)
    assert_eq(String.from_bytes(file.read(10)!)!, "ghij")
    assert_eq(file.read(5)!.len(), 0)
    assert_eq(file.seek(-3, Origin.End)!, 7)
    assert_eq(String.from_bytes(file.read(3)!)!, "hij")
    assert_eq(file.seek(0, Origin.Start)!, 0)
    assert_eq(file.metadata()!.size, 10)
    file.close()!
}

test "a created file can be truncated and written in parts" {
    let dir = scratch("parts")
    let file = File.create(dir + "/q")!
    file.write_string("abc")!
    file.write_string("def")!
    file.truncate(4)!
    file.close()!
    assert_eq(read_string(dir + "/q")!, "abcd")
}

test "a file that exists cannot be created new" {
    let dir = scratch("exclusive")
    write_string(dir + "/x", "1")!
    let again = File.create_new(dir + "/x")
    assert(again.is_err(), "exists")
    assert(File.create_new(dir + "/y").is_ok(), "new")
}

test "a missing file is NotFound and names the path" {
    let dir = scratch("missing")
    let result = read_string(dir + "/nope")
    assert(result.is_err(), "missing")
    let message = match result {
        Ok(_) => ""
        Err(error) => error.message
    }
    assert_eq(message, dir + "/nope: no such file or directory")
    let kind = match result {
        Ok(_) => ErrorKind.Other
        Err(error) => error.kind
    }
    assert(kind == ErrorKind.NotFound, "kind")
}

test "metadata tells files from directories" {
    let dir = scratch("meta")
    write_string(dir + "/f", "12345")!
    create_dir(dir + "/d")!
    assert(is_file(dir + "/f"), "file")
    assert(!is_dir(dir + "/f"), "not dir")
    assert(is_dir(dir + "/d"), "dir")
    assert(exists(dir + "/d"), "exists")
    assert(!exists(dir + "/zzz"), "absent")
    let info = metadata(dir + "/f")!
    assert_eq(info.size, 5)
    assert(info.kind == FileKind.File, "kind")
    assert(info.modified > 1000000000000000000, "modified")
    assert_eq(info.mode % 512, 420)
}

test "a directory lists its names in order" {
    let dir = scratch("list")
    write_string(dir + "/b", "")!
    write_string(dir + "/a", "")!
    create_dir(dir + "/c")!
    assert_eq(join(list(dir)!, " "), "a b c")
    assert_eq(list(dir + "/c")!.len(), 0)
    assert(list(dir + "/a").is_err(), "not a directory")
}

test "directories are made, removed and removed whole" {
    let dir = scratch("dirs")
    create_dir_all(dir + "/x/y/z")!
    create_dir_all(dir + "/x/y/z")!
    assert(is_dir(dir + "/x/y/z"), "deep")
    assert(create_dir(dir + "/x").is_err(), "exists")
    write_string(dir + "/x/y/f", "1")!
    assert(remove_dir(dir + "/x").is_err(), "not empty")
    remove_all(dir + "/x")!
    assert(!exists(dir + "/x"), "gone")
    remove_file(dir + "/nothing").is_err()
}

test "a path is renamed and copied" {
    let dir = scratch("move")
    write_string(dir + "/a", "data")!
    rename(dir + "/a", dir + "/b")!
    assert(!exists(dir + "/a"), "moved")
    assert_eq(copy(dir + "/b", dir + "/c")!, 4)
    assert_eq(read_string(dir + "/c")!, "data")
    assert(copy(dir + "/none", dir + "/d").is_err(), "no source")
}

test "a file that is not UTF-8 is an error as text and fine as bytes" {
    let dir = scratch("utf8")
    let data: [UInt8] = [255, 254]
    write_bytes(dir + "/w", data)!
    assert(read_string(dir + "/w").is_err(), "text")
    assert_eq(read_bytes(dir + "/w")!.len(), 2)
}

test "a closed file cannot be used" {
    let dir = scratch("closed")
    write_string(dir + "/c", "x")!
    let file = File.open(dir + "/c")!
    file.close()!
    assert(file.close().is_err(), "twice")
    assert(file.read(1).is_err(), "read")
}
