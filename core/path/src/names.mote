// The names inside a path: its parent, file name and extension, and one path relative to another.
import { join as join_with } from std.string
import { assemble, cancel, names } from ._names
import { is_absolute, normalize, split } from .parts

/// The path without its last name, or `null` for `/`, an empty path and a single relative name.
pub fn parent(path: String) -> String? {
    let absolute = is_absolute(path)
    let items = names(path)
    if items.len() == 0 || (items.len() == 1 && !absolute) {
        return null
    }
    return assemble(items.slice(0, items.len() - 1), absolute)
}

/// The last name, or `null` for `/`, an empty path and a path that ends in `..`.
pub fn file_name(path: String) -> String? {
    let items = names(path)
    if items.len() == 0 {
        return null
    }
    let last = items.get(items.len() - 1)
    if last == ".." {
        return null
    }
    return last
}

/// The text after the last `.` of the file name, or `null` when it has none or the name starts with the only `.`.
pub fn extension(path: String) -> String? {
    let name = file_name(path)
    if name == null {
        return null
    }
    let dot = name.rfind(".")
    if dot == null || dot == 0 || dot == name.len() - 1 {
        return null
    }
    return name.slice(dot + 1, name.len())
}

/// The path from `base` to `path` when `path` is below `base` (`.` when they are the same), else `null`; neither is read from the file system, so `..` is never written.
pub fn relative_to(path: String, base: String) -> String? {
    let absolute = is_absolute(path)
    if absolute != is_absolute(base) {
        return null
    }
    let items = cancel(names(path), absolute)
    let root = cancel(names(base), absolute)
    if root.len() > items.len() {
        return null
    }
    var at = 0
    while at < root.len() {
        if items.get(at) != root.get(at) {
            return null
        }
        at += 1
    }
    let rest = items.slice(root.len(), items.len())
    if rest.len() == 0 {
        return "."
    }
    return join_with(rest, "/")
}
