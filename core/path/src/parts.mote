// Joining, splitting and cleaning paths.
import { join as join_with } from std.string
import { assemble, cancel, names } from ._names

pub fn is_absolute(path: String) -> Bool { return path.starts_with("/") }

/// The path `b` below `a`, or `b` itself when it is absolute.
pub fn join(a: String, b: String) -> String {
    if is_absolute(b) || a == "" {
        return b
    }
    if b == "" {
        return a
    }
    if a.ends_with("/") {
        return a + b
    }
    return a + "/" + b
}

/// The parts of a path; an absolute path starts with `/`.
pub fn split(path: String) -> List<String> {
    var out: List<String> = []
    if is_absolute(path) {
        out.push("/")
    }
    for item in names(path) {
        out.push(item)
    }
    return out
}

/// The path with no empty parts, no `.`, and each `..` cancelled where it can be; an empty result is `.`.
pub fn normalize(path: String) -> String {
    let absolute = is_absolute(path)
    return assemble(cancel(names(path), absolute), absolute)
}

