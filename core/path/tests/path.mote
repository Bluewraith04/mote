import { assert, assert_eq } from std.test
import { join as glue } from std.string
import { extension, file_name, is_absolute, join, normalize, parent, relative_to, split } from path

fn spaced(items: List<String>) -> String { return glue(items, " ") }

test "a path is absolute when it starts with a slash" {
    assert(is_absolute("/a"), "root")
    assert(!is_absolute("a/b"), "relative")
    assert(!is_absolute(""), "empty")
}

test "join puts the second path below the first" {
    assert_eq(join("a", "b"), "a/b")
    assert_eq(join("a/", "b"), "a/b")
    assert_eq(join("/", "b"), "/b")
    assert_eq(join("", "b"), "b")
    assert_eq(join("a", ""), "a")
}

test "join of an absolute second path is that path" {
    assert_eq(join("a", "/b"), "/b")
}

test "split gives the root then each name" {
    assert_eq(spaced(split("/a/b")), "/ a b")
    assert_eq(spaced(split("a//b/")), "a b")
    assert_eq(spaced(split("./a/./b")), "a b")
    assert_eq(spaced(split("/")), "/")
    assert_eq(spaced(split("")), "")
}

test "normalize drops empty parts and dots" {
    assert_eq(normalize("a//b/./c/"), "a/b/c")
    assert_eq(normalize("/a/./b"), "/a/b")
}

test "normalize cancels dot-dot where it can" {
    assert_eq(normalize("a/b/../c"), "a/c")
    assert_eq(normalize("a/../.."), "..")
    assert_eq(normalize("../../a"), "../../a")
    assert_eq(normalize("/a/../.."), "/")
}

test "normalize of nothing is a dot or the root" {
    assert_eq(normalize(""), ".")
    assert_eq(normalize("./"), ".")
    assert_eq(normalize("a/.."), ".")
    assert_eq(normalize("/"), "/")
}

test "parent drops the last name" {
    assert_eq(parent("a/b/c")!, "a/b")
    assert_eq(parent("/a/b")!, "/a")
    assert_eq(parent("/a")!, "/")
    assert_eq(parent("a/b/")!, "a")
}

test "parent of a root, an empty path and a single name is null" {
    assert(parent("/") == null, "root")
    assert(parent("") == null, "empty")
    assert(parent("a") == null, "single")
}

test "file name is the last name" {
    assert_eq(file_name("a/b.txt")!, "b.txt")
    assert_eq(file_name("/a/b/")!, "b")
    assert_eq(file_name("a")!, "a")
}

test "file name of a root, an empty path and dot-dot is null" {
    assert(file_name("/") == null, "root")
    assert(file_name("") == null, "empty")
    assert(file_name("a/..") == null, "dot-dot")
}

test "extension is the text after the last dot" {
    assert_eq(extension("a/b.txt")!, "txt")
    assert_eq(extension("archive.tar.gz")!, "gz")
    assert_eq(extension("dir.d/file.rs")!, "rs")
}

test "extension is null for no dot, a leading dot or a trailing dot" {
    assert(extension("a/b") == null, "none")
    assert(extension(".bashrc") == null, "leading")
    assert(extension("a.") == null, "trailing")
    assert(extension("dir.d/file") == null, "dir only")
    assert(extension("/") == null, "root")
}

test "relative to gives the path below the base" {
    assert_eq(relative_to("/a/b/c", "/a")!, "b/c")
    assert_eq(relative_to("a/b", "a")!, "b")
    assert_eq(relative_to("/a/b", "/a/b")!, ".")
    assert_eq(relative_to("/a/./b/../c", "/a//")!, "c")
}

test "relative to is null when the path is not below the base" {
    assert(relative_to("/a", "/b") == null, "other")
    assert(relative_to("/a", "/a/b") == null, "above")
    assert(relative_to("/a", "a") == null, "mixed")
}
