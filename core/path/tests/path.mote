import ..src.lib as path

fn shown(o: Option<String>) -> String {
    match o {
        Some(v) => { return v }
        None => { return "none" }
    }
}

test "join takes an absolute right side and adds one separator" {
    assert_eq(path.join("a", "b"), "a/b")
    assert_eq(path.join("a/", "b"), "a/b")
    assert_eq(path.join("a", "/b"), "/b")
    assert_eq(path.join("", "b"), "b")
}

test "normalize resolves dots lexically" {
    assert_eq(path.normalize("a/./b/../c//d"), "a/c/d")
    assert_eq(path.normalize("../../a"), "../../a")
    assert_eq(path.normalize("/../a"), "/a")
    assert_eq(path.normalize("a/.."), ".")
    assert_eq(path.normalize("/"), "/")
}

test "parent and file_name split the last component" {
    assert_eq(shown(path.parent("a/b/c")), "a/b")
    assert_eq(shown(path.parent("/a")), "/")
    assert_eq(shown(path.parent("a")), "")
    assert_eq(shown(path.parent("/")), "none")
    assert_eq(shown(path.file_name("a/b/")), "b")
    assert_eq(shown(path.file_name("")), "none")
}

test "extension, stem and with_extension follow the last dot" {
    assert_eq(shown(path.extension("a/b.tar.gz")), "gz")
    assert_eq(shown(path.extension(".bashrc")), "none")
    assert_eq(shown(path.extension("noext")), "none")
    assert_eq(shown(path.stem("a/b.tar.gz")), "b.tar")
    assert_eq(path.with_extension("a/b.txt", "md"), "a/b.md")
    assert_eq(path.with_extension("a/b.txt", ""), "a/b")
}

test "components and is_absolute" {
    assert_eq(path.components("/a//b/"), ["/", "a", "b"])
    assert(path.is_absolute("/a"))
    assert(!path.is_absolute("a"))
}
