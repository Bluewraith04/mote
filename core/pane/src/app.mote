// A program over one state: a view of it, handlers that change it, and the window that shows it.
import { Doc } from doc
import { Dyn, downcast } from std.meta
import { Element } from .element
import { Event } from .event
import { Layout, layout } from .layout
import { Window } from .window
import { Click, build } from ._tree

/// Lays out an element tree in a window of `width` by `height` pixels.
pub fn lay_out(root: Element, width: Int, height: Int) -> Result<Layout, Error> {
    let built = build(root, Doc.new())?
    return layout(built.node, width, height)
}

struct KeyBinding<S> {
    code: Int
    run: (var S) -> Null
}

/// A window over the state: `view` makes the elements of a state, and the handlers on them change it. `App(title, state, view).run()` opens the window and keeps it shown until it closes.
pub class App<S> {
    title: String
    state: S
    view: (S) -> Element
    width: Int
    height: Int
    keys: List<KeyBinding<S>>
    quits: List<Int>
    done: ((S) -> Bool)?

    /// Ends the run when `done` answers true for the state after an event.
    pub fn quit_when(self, done: (S) -> Bool) -> App<S> {
        return App { title: self.title, state: self.state, view: self.view, width: self.width, height: self.height, keys: self.keys, quits: self.quits, done: done }
    }

    /// An app of a window 800 by 600 pixels.
    pub fn new(title: String, state: S, view: (S) -> Element) -> App<S> {
        return App { title: title, state: state, view: view, width: 800, height: 600, keys: [], quits: [], done: null }
    }

    /// The window size, in pixels.
    pub fn size(self, width: Int, height: Int) -> App<S> {
        return App { title: self.title, state: self.state, view: self.view, width: width, height: height, keys: self.keys, quits: self.quits, done: self.done }
    }

    /// Runs when the key with the raylib code is pressed.
    pub fn on_key(self, code: Int, run: (var S) -> Null) -> App<S> {
        var keys = self.keys
        keys.push(KeyBinding { code: code, run: run })
        return App { title: self.title, state: self.state, view: self.view, width: self.width, height: self.height, keys: keys, quits: self.quits, done: self.done }
    }

    /// Ends the run when the key is pressed.
    pub fn quit_on(self, code: Int) -> App<S> {
        var quits = self.quits
        quits.push(code)
        return App { title: self.title, state: self.state, view: self.view, width: self.width, height: self.height, keys: self.keys, quits: quits, done: self.done }
    }

    /// Opens the window and runs until it closes or a quit key is pressed; gives the last state.
    pub fn run(self) -> Result<S, Error> {
        var window = Window.open(self.width, self.height, self.title)?
        let done = self.run_in(window)
        window.close()
        return done
    }

    /// As `run`, in a window that is already open; a headless window ends the run when its events are used up.
    pub fn run_in(self, var window: Window) -> Result<S, Error> {
        var state = self.state
        while true {
            let make = self.view
            let built = build(make(state), Doc.new())?
            let shown = layout(built.node, window.width, window.height)?
            window.present(shown)
            let event = window.next()
            if event == null { return Ok(state) }
            match event {
                Close => { return Ok(state) }
                Click(_, x, y, _) => {
                    let hit = click_at(shown, built.clicks, x, y)
                    if hit != null {
                        let run = hit
                        var boxed = Dyn.of(state)
                        run(boxed)
                        state = downcast<S>(boxed)!
                    }
                }
                Key(code) => {
                    for quit in self.quits {
                        if quit == code { return Ok(state) }
                    }
                    for binding in self.keys {
                        if binding.code == code {
                            let run = binding.run
                            run(state)
                        }
                    }
                }
                _ => {}
            }
            if self.done != null {
                let over = self.done!
                if over(state) { return Ok(state) }
            }
        }
        return Ok(state)
    }
}

// The handler of the element under the point, or the nearest one around it: the last area in document order that holds the point and has a handler.
fn click_at(shown: Layout, clicks: List<Click>, x: Int, y: Int) -> ((var Dyn) -> Null)? {
    var found: ((var Dyn) -> Null)? = null
    for area in shown.areas {
        if x < area.x || x >= area.x + area.w || y < area.y || y >= area.y + area.h { continue }
        for each in clicks {
            if each.id == area.id { found = each.run }
        }
    }
    return found
}
