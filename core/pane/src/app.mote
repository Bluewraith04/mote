/// Draws a view on a window and redraws it after each event.

import std.task as task
import { Task } from std.task
import { Stream } from std.stream
import std.time as time
import std.gui as gui
import .element
import .theme
import .chrome

/// What the window holds for an element.
class Mounted<S> {
    node: gui.Node
    kind: gui.Kind
    key: String
    shown: String
    png: Bytes
    runs: List<gui.Run>
    kids: List<Mounted<S>>
    click: List<(var S) -> Null>
    change: List<(var S, String) -> Null>
    submit: List<(var S) -> Null>
    link: List<(var S, Int) -> Null>
    local: List<(var element.Locals) -> Null>
    act: element.Action
    reveal: Int
    memo: Int
    drag: List<(var S, element.Drag) -> Null>
    wheel: List<(var S, Float, Float) -> Null>
    aim: Int
}

fn edits_text(k: gui.Kind) -> Bool { return k == gui.Kind.Input || k == gui.Kind.TextArea }

fn has_text(k: gui.Kind) -> Bool { return k == gui.Kind.Text || k == gui.Kind.Button || edits_text(k) }

fn look_id<S>(win: gui.Window, th: theme.Theme, e: element.Element<S>) -> Result<gui.StyleId, Error> {
    var look = th.look(e.role)
    var fill = th.fill(e.role)
    if e.fill >= 0 {
        fill = e.fill
        look = look.background(fill)
    }
    for f in e.edits { look = f(look) }
    if fill < 0 {
        if e.lift >= 0 { return win.style(look.hover(win.style(look.background(e.lift))?)) }
        return win.style(look)
    }
    let hover = win.style(look.background(th.hover_of(e.role, fill)))?
    let held = win.style(look.background(th.press_of(e.role, fill)))?
    return win.style(look.hover(hover).pressed(held))
}

fn update<S>(win: gui.Window, th: theme.Theme, locals: element.Locals, m: Mounted<S>, e: element.Element<S>) -> Result<Mounted<S>, Error> {
    win.set_style(m.node, look_id(win, th, e)?)?
    let runs = th.tint_links(e.runs)
    if runs.len() > 0 {
        if runs != m.runs { win.set_runs(m.node, runs)? }
    } else if has_text(e.kind) && (!edits_text(e.kind) || e.text != m.shown) {
        win.set_text(m.node, e.text)?
    }
    if e.kind == gui.Kind.Image && e.png != m.png { win.set_image(m.node, e.png)? }
    let kids = sync(win, th, locals, m.node, e.kids, m.kids)?
    return Ok(Mounted { node: m.node, kind: e.kind, key: e.id, shown: e.text, png: e.png, runs: runs, kids: kids, click: e.click, change: e.change, submit: e.submit, link: e.link, local: e.local, act: e.act, reveal: e.wanted, memo: e.memo, drag: e.drag, wheel: e.wheel, aim: e.aim })
}

fn build<S>(win: gui.Window, th: theme.Theme, locals: element.Locals, parent: gui.Node, e: element.Element<S>) -> Result<Mounted<S>, Error> {
    let node = win.add(parent, e.kind)?
    return update(win, th, locals, Mounted { node: node, kind: e.kind, key: e.id, shown: "", png: Bytes(0), runs: [], kids: [], click: [], change: [], submit: [], link: [], local: [], act: element.Action.Nothing, reveal: 0, memo: 0, drag: [], wheel: [], aim: 0 }, e)
}

/// The index of the old child a new one continues.
fn match_old<S>(k: element.Element<S>, at: Int, old: List<Mounted<S>>, keyed: Map<String, Int>, used: List<Bool>) -> Int {
    if k.id != "" {
        let j = keyed.get_or(k.id, -1)
        if j >= 0 && !used.get(j) && old.get(j).kind == k.kind { return j }
        return -1
    }
    if at < old.len() && old.get(at).key == "" && !used.get(at) && old.get(at).kind == k.kind { return at }
    return -1
}

/// The index of the old child that a `memo` element keeps as drawn.
fn kept<S>(k: element.Element<S>, at: Int, old: List<Mounted<S>>, keyed: Map<String, Int>, used: List<Bool>) -> Int {
    if k.memo == 0 { return -1 }
    var j = -1
    if k.id != "" {
        j = keyed.get_or(k.id, -1)
    } else if at < old.len() && old.get(at).key == "" {
        j = at
    }
    if j >= 0 && !used.get(j) && old.get(j).memo == k.memo { return j }
    return -1
}

fn same_order(a: List<Int>, b: List<Int>) -> Bool {
    var i = 0
    while i < a.len() {
        if a.get(i) != b.get(i) { return false }
        i = i + 1
    }
    return true
}

fn sync<S>(win: gui.Window, th: theme.Theme, locals: element.Locals, parent: gui.Node, shown: List<element.Element<S>>, old: List<Mounted<S>>) -> Result<List<Mounted<S>>, Error> {
    var keyed: Map<String, Int> = {}
    var used: List<Bool> = []
    var i = 0
    while i < old.len() {
        if old.get(i).key != "" { keyed.set(old.get(i).key, i) }
        used.push(false)
        i = i + 1
    }
    var kids: List<element.Element<S>> = []
    var pick: List<Int> = []
    var keep: List<Bool> = []
    i = 0
    while i < shown.len() {
        var k = shown.get(i)
        var j = kept(k, i, old, keyed, used)
        keep.push(j >= 0)
        if j < 0 {
            if k.memo != 0 && k.build.len() > 0 { k = element.expand_memo(k, locals) }
            j = match_old(k, i, old, keyed, used)
        }
        if j >= 0 { used.set(j, true) }
        kids.push(k)
        pick.push(j)
        i = i + 1
    }
    var current: List<Int> = []
    i = 0
    while i < old.len() {
        if used.get(i) { current.push(old.get(i).node.id) } else { win.remove(old.get(i).node)? }
        i = i + 1
    }
    var out: List<Mounted<S>> = []
    var order: List<Int> = []
    i = 0
    while i < kids.len() {
        let j = pick.get(i)
        if keep.get(i) {
            out.push(old.get(j))
        } else if j >= 0 {
            out.push(update(win, th, locals, old.get(j), kids.get(i))?)
        } else {
            out.push(build(win, th, locals, parent, kids.get(i))?)
            current.push(out.get(i).node.id)
        }
        order.push(out.get(i).node.id)
        i = i + 1
    }
    if !same_order(current, order) {
        i = out.len() - 1
        while i >= 0 {
            if i == out.len() - 1 { win.move_before(out.get(i).node, None)? } else { win.move_before(out.get(i).node, Some(out.get(i + 1).node))? }
            i = i - 1
        }
    }
    return Ok(out)
}

/// The first text-bearing node whose text is `want`, searching depth first.
fn find_text<S>(win: gui.Window, ms: List<Mounted<S>>, want: String) -> Option<gui.Node> {
    for m in ms {
        if has_text(m.kind) && win.text(m.node).unwrap_or("") == want { return Some(m.node) }
        match find_text(win, m.kids, want) {
            Some(n) => { return Some(n) }
            None => { }
        }
    }
    return None
}

/// Scrolls each scroll node so the elements with a new reveal token sit at its top.
fn reveal_pending<S>(win: gui.Window, ms: List<Mounted<S>>, scroller: gui.Node?, var done: Map<Int, Int>) -> Result<Bool, Error> {
    var moved = false
    for m in ms {
        if m.reveal != 0 && done.get_or(m.node.id, 0) != m.reveal {
            done.set(m.node.id, m.reveal)
            match scroller {
                Some(s) => {
                    let at = win.rect(m.node)?
                    let box = win.rect(s)?
                    if win.scroll(s, 0.0, at.get(1) - box.get(1))? { moved = true }
                }
                None => { }
            }
        }
        var inner = scroller
        if m.kind == gui.Kind.Scroll { inner = Some(m.node) }
        if reveal_pending(win, m.kids, inner, done)? { moved = true }
    }
    return Ok(moved)
}

/// Gives the focus to the element with a new focus token.
fn focus_pending<S>(win: gui.Window, ms: List<Mounted<S>>, var done: Map<Int, Int>) -> Result<Bool, Error> {
    var moved = false
    for m in ms {
        if m.aim != 0 && done.get_or(m.node.id, 0) != m.aim {
            done.set(m.node.id, m.aim)
            win.focus_on(m.node)?
            moved = true
        }
        if focus_pending(win, m.kids, done)? { moved = true }
    }
    return Ok(moved)
}

/// The mounted elements from a root down to the node `id`, or none.
fn chain<S>(ms: List<Mounted<S>>, id: Int) -> List<Mounted<S>> {
    for m in ms {
        if m.node.id == id { return [m] }
        let inner = chain(m.kids, id)
        if inner.len() > 0 {
            var out = [m]
            for x in inner { out.push(x) }
            return out
        }
    }
    return []
}

/// The user event a `Handle` posts to redraw the window.
fn wake_tag() -> Int { return 7001 }

/// How often a timer's handler runs, and the handler.
class Tick<S> {
    ms: Int
    f: (var S) -> Bool
}

/// Whether a timer's last tick is still waiting to be handled.
class Pending {
    var on: Bool
}

/// A key and the modifiers held with it, and the handler an `on_key` runs.
class Shortcut<S> {
    key: gui.Key
    mods: gui.Mods
    f: (var S) -> Null
}

/// The drag in progress.
class Grip<S> {
    f: (var S, element.Drag) -> Null
    from_x: Float
    from_y: Float
    box: List<Float>
}

/// What other tasks hold to change an app's state.
pub class Handle<S> {
    cell: Shared<S>
    slot: Shared<List<gui.Window>>

    /// The current state, read-only.
    pub fn get(self) -> S { return self.cell.get() }

    pub fn update(self, f: (var S) -> Null) {
        var c = self.cell.clone()
        c.update(|v| { f(v) })
        for w in self.slot.get() { w.post(wake_tag()) }
    }
}

/// An app made of a title, a state and the view that draws it.
pub class App<S> {
    var title: String
    var own: S
    var view: (S) -> element.Element<S>
    var th: theme.Theme
    var ch: chrome.Chrome
    var width: Int
    var height: Int
    var fill: Int
    var ticks: List<Tick<S>>
    var keys: List<Shortcut<S>>
    var cell: List<Shared<S>>
    var slot: List<Shared<List<gui.Window>>>
    var th_by: List<(S) -> theme.Theme>
    var ch_by: List<(S) -> chrome.Chrome>

    /// An app in the `light` theme with the system frame and a 480 by 640 window.
    pub fn new(title: String, state: S, view: (S) -> element.Element<S>) -> App<S> {
        return App { title: title, own: state, view: view, th: theme.light(), ch: chrome.system(), width: 480, height: 640, fill: 0, ticks: [], keys: [], cell: [], slot: [], th_by: [], ch_by: [] }
    }

    fn copy(self) -> App<S> {
        return App { title: self.title, own: self.own, view: self.view, th: self.th, ch: self.ch, width: self.width, height: self.height, fill: self.fill, ticks: self.ticks, keys: self.keys, cell: self.cell, slot: self.slot, th_by: self.th_by, ch_by: self.ch_by }
    }

    /// The theme as a function of the state.
    pub fn theme_by(self, f: (S) -> theme.Theme) -> App<S> {
        var a = self.copy()
        a.th_by = [f]
        return a
    }

    /// The frame as a function of the state, read at every draw.
    pub fn chrome_by(self, f: (S) -> chrome.Chrome) -> App<S> {
        var a = self.copy()
        a.ch_by = [f]
        return a
    }

    /// The colors and shapes the elements take.
    pub fn theme(self, th: theme.Theme) -> App<S> {
        var a = self.copy()
        a.th = th
        return a
    }

    /// The frame: the system's own, or a title bar pane draws.
    pub fn chrome(self, ch: chrome.Chrome) -> App<S> {
        var a = self.copy()
        a.ch = ch
        return a
    }

    /// The window's size in pixels when `run` opens it.
    pub fn size(self, width: Int, height: Int) -> App<S> {
        var a = self.copy()
        a.width = width
        a.height = height
        return a
    }

    /// Opens the window maximized: it fills the screen's work area and keeps its frame.
    pub fn maximized(self) -> App<S> {
        var a = self.copy()
        a.fill = 1
        return a
    }

    /// Opens the window fullscreen.
    pub fn fullscreen(self) -> App<S> {
        var a = self.copy()
        a.fill = 2
        return a
    }

    /// Runs `f` on the state every `ms` milliseconds while the window is open, then redraws.
    pub fn every(self, ms: Int, f: (var S) -> Null) -> App<S> {
        return self.watch(ms, |var s| {
            f(s)
            return true
        })
    }

    /// Runs `f` on the state every `ms` milliseconds and redraws when it answers `true`.
    pub fn watch(self, ms: Int, f: (var S) -> Bool) -> App<S> {
        var a = self.copy()
        var ticks: List<Tick<S>> = []
        for t in self.ticks { ticks.push(t) }
        ticks.push(Tick { ms: ms, f: f })
        a.ticks = ticks
        return a
    }

    /// Runs `f` on the state when `key` is pressed with the modifiers `mods`.
    pub fn on_key(self, key: gui.Key, mods: gui.Mods, f: (var S) -> Null) -> App<S> {
        var a = self.copy()
        var keys: List<Shortcut<S>> = []
        for k in self.keys { keys.push(k) }
        keys.push(Shortcut { key: key, mods: mods, f: f })
        a.keys = keys
        return a
    }

    /// A handle other tasks use to change the state.
    pub fn state(var self) -> Handle<S> {
        if self.cell.len() == 0 {
            var none: List<gui.Window> = []
            self.cell = [Shared(self.own)]
            self.slot = [Shared(none)]
        }
        return Handle { cell: self.cell.get(0), slot: self.slot.get(0) }
    }

    /// Draws the app on a window you made; drive it with `step` or `run`.
    pub fn mount(self, win: gui.Window) -> Result<Running<S>, Error> {
        return self.start(win, None)
    }

    fn start(self, win: gui.Window, events: Stream<gui.UiEvent>?) -> Result<Running<S>, Error> {
        if self.slot.len() > 0 {
            var s = self.slot.get(0)
            s.update(|v| { v.push(win) })
        }
        var running = Running { win: win, app: self, roots: [], locals: element.locals(), revealed: {}, aimed: {}, events: events, waiting: [], framed: false, grip: [] }
        running.render()?
        return Ok(running)
    }

    /// Draws the app on a window with no screen, for tests.
    pub fn headless(self, width: Int, height: Int) -> Result<Running<S>, Error> {
        let win = gui.headless(width, height)?
        return self.start(win, Some(win.events()))
    }

    /// Opens the window and handles events until it closes.
    pub fn run(self) -> Result<Null, Error> {
        task.pin()
        let win = gui.open(self.title, self.width, self.height)?
        if self.fill == 1 { win.set_maximized(true)? }
        if self.fill == 2 { win.set_fullscreen(true)? }
        var running = self.mount(win)?
        return running.run()
    }
}

/// An app drawn on a window: the tree it last showed, and the events it has handled.
pub class Running<S> {
    win: gui.Window
    var app: App<S>
    var roots: List<Mounted<S>>
    var locals: element.Locals
    var revealed: Map<Int, Int>
    var aimed: Map<Int, Int>
    /// Whether pane's own frame is on.
    var framed: Bool
    /// The drag that a press began, until its release.
    var grip: List<Grip<S>>
    events: Stream<gui.UiEvent>?
    /// Each timer's pending flag while `run` goes.
    var waiting: List<Shared<Pending>>

    /// The window the app draws in, for `std.gui` calls such as `png` and `input`.
    pub fn window(self) -> gui.Window { return self.win }

    /// The first node showing exactly `want` as its text (headless tests).
    pub fn find(self, want: String) -> Option<gui.Node> {
        return find_text(self.win, self.roots, want)
    }

    /// Whether some node shows exactly `want`.
    pub fn shows(self, want: String) -> Bool {
        match self.find(want) {
            Some(n) => { return true }
            None => { return false }
        }
    }

    /// Clicks the centre of the node showing `want` and handles the events it raises.
    pub fn click_text(var self, want: String) -> Result<Null, Error> {
        let n = self.need(want)?
        let r = self.win.rect(n)?
        self.point(r.get(0) + r.get(2) / 2.0, r.get(1) + r.get(3) / 2.0)?
        return self.settle()
    }

    /// Clicks the point `x`, `y` of the window and handles the events it raises.
    pub fn click_at(var self, x: Float, y: Float) -> Result<Null, Error> {
        self.point(x, y)?
        return self.settle()
    }

    /// Presses at `x0`, `y0`, moves the pointer to `x1`, `y1` and releases there.
    pub fn drag(var self, x0: Float, y0: Float, x1: Float, y1: Float) -> Result<Null, Error> {
        self.win.input(gui.Input.PointerMove(x0, y0))?
        self.win.input(gui.Input.PointerDown(x0, y0))?
        self.settle()?
        self.win.input(gui.Input.PointerMove(x1, y1))?
        self.settle()?
        self.win.input(gui.Input.PointerUp(x1, y1))?
        return self.settle()
    }

    /// Turns the wheel by `dx`, `dy` pixels with the pointer at `x`, `y`.
    pub fn wheel(var self, x: Float, y: Float, dx: Float, dy: Float) -> Result<Null, Error> {
        self.win.input(gui.Input.Wheel(x, y, dx, dy))?
        return self.settle()
    }

    /// Focuses the input showing `current` and types `text` into it.
    pub fn type_into(var self, current: String, text: String) -> Result<Null, Error> {
        let n = self.need(current)?
        let r = self.win.rect(n)?
        self.point(r.get(0) + r.get(2) / 2.0, r.get(1) + r.get(3) / 2.0)?
        self.win.input(gui.Input.Text(text))?
        return self.settle()
    }

    /// Presses and releases a key and handles the events it raises.
    pub fn press(var self, key: gui.Key, mods: gui.Mods) -> Result<Null, Error> {
        self.win.input(gui.Input.Key(key, mods, true))?
        self.win.input(gui.Input.Key(key, mods, false))?
        return self.settle()
    }

    fn need(self, want: String) -> Result<gui.Node, Error> {
        match self.find(want) {
            Some(n) => { return Ok(n) }
            None => { return Err(Error(ErrorKind.NotFound, "no node shows \"${want}\"")) }
        }
    }

    fn point(self, x: Float, y: Float) -> Result<Null, Error> {
        self.win.input(gui.Input.PointerMove(x, y))?
        self.win.input(gui.Input.PointerDown(x, y))?
        self.win.input(gui.Input.PointerUp(x, y))?
        return Ok(null)
    }

    /// Steps the app through every event queued so far.
    fn settle(var self) -> Result<Null, Error> {
        match self.events {
            None => { return Err(Error(ErrorKind.Unsupported, "only an app made by `headless` handles its own events")) }
            Some(events) => {
                let marker = wake_tag() + 5000
                self.win.post(marker)?
                for e in events {
                    match e {
                        gui.UiEvent.User(n) => {
                            if n == marker { return Ok(null) }
                            self.step(e)?
                        }
                        _ => { self.step(e)? }
                    }
                }
                return Ok(null)
            }
        }
    }

    /// Draws the view of the current state.
    pub fn render(var self) -> Result<Null, Error> {
        let draw = self.app.view
        var now = self.app.own
        if self.app.cell.len() > 0 { now = self.app.cell.get(0).get() }
        var th = self.app.th
        if self.app.th_by.len() > 0 { th = self.app.th_by.get(0)(now) }
        var ch = self.app.ch
        if self.app.ch_by.len() > 0 { ch = self.app.ch_by.get(0)(now) }
        if ch.drawn() != self.framed {
            self.win.set_frame(!ch.drawn())?
            self.framed = ch.drawn()
        }
        if ch.drawn() {
            self.win.set_style(self.win.root(), self.win.style(th.framed_root())?)?
        } else {
            self.win.set_style(self.win.root(), self.win.style(th.root())?)?
        }
        let root = chrome.frame(ch, th, self.app.title, element.expand(draw(now), self.locals))
        self.roots = sync(self.win, th, self.locals, self.win.root(), root, self.roots)?
        self.win.present()?
        var moved = reveal_pending(self.win, self.roots, None, self.revealed)?
        if focus_pending(self.win, self.roots, self.aimed)? { moved = true }
        if moved { self.win.present()? }
        return Ok(null)
    }

    /// Runs a timer's handler; answers whether the window must be drawn again.
    fn tick(var self, f: (var S) -> Bool) -> Bool {
        if self.app.cell.len() > 0 {
            var c = self.app.cell.get(0)
            c.update(|v| { let drawn = f(v) })
            return true
        }
        return f(self.app.own)
    }

    fn handle(var self, h: (var S) -> Null) {
        if self.app.cell.len() > 0 {
            var c = self.app.cell.get(0)
            c.update(|v| { h(v) })
        } else {
            h(self.app.own)
        }
    }

    /// Handles one window event and redraws; answers `false` once the window closes.
    pub fn step(var self, e: gui.UiEvent) -> Result<Bool, Error> {
        match e {
            gui.UiEvent.Click(n) => {
                let up = chain(self.roots, n.id)
                var i = up.len() - 1
                var ran = false
                while i >= 0 {
                    let hs = up.get(i).click
                    let ls = up.get(i).local
                    if hs.len() > 0 || ls.len() > 0 {
                        for h in hs { self.handle(h) }
                        for h in ls { h(self.locals) }
                        ran = true
                        break
                    }
                    match up.get(i).act {
                        element.Action.Minimize => {
                            self.win.minimize()?
                            break
                        }
                        element.Action.Maximize => {
                            self.win.toggle_maximize()?
                            break
                        }
                        element.Action.Close => {
                            self.win.close()?
                            return Ok(false)
                        }
                        _ => { }
                    }
                    i = i - 1
                }
                if !ran { return Ok(true) }
            }
            gui.UiEvent.PointerDown(n, x, y) => {
                let up = chain(self.roots, n.id)
                var i = up.len() - 1
                var gripped = false
                while i >= 0 {
                    if up.get(i).drag.len() > 0 {
                        let box = self.win.rect(up.get(i).node)?
                        let g = Grip { f: up.get(i).drag.get(0), from_x: x, from_y: y, box: box }
                        self.grip = [g]
                        self.handle(|var s| { g.f(s, drag_of(g, element.Phase.Start, x, y)) })
                        gripped = true
                        break
                    }
                    match up.get(i).act {
                        element.Action.Move => {
                            self.win.drag()?
                            break
                        }
                        element.Action.Resize(edge) => {
                            self.win.drag_resize(edge_of(edge))?
                            break
                        }
                        _ => { }
                    }
                    i = i - 1
                }
                if !gripped { return Ok(true) }
            }
            gui.UiEvent.PointerUp(n, x, y) => {
                if self.grip.len() == 0 { return Ok(true) }
                let g = self.grip.get(0)
                self.grip = []
                self.handle(|var s| { g.f(s, drag_of(g, element.Phase.End, x, y)) })
            }
            gui.UiEvent.PointerMove(n, x, y) => {
                if self.grip.len() == 0 { return Ok(true) }
                let g = self.grip.get(0)
                self.handle(|var s| { g.f(s, drag_of(g, element.Phase.Move, x, y)) })
            }
            gui.UiEvent.Enter(n) => { return Ok(true) }
            gui.UiEvent.Leave(n) => { return Ok(true) }
            gui.UiEvent.Wheel(n, dx, dy) => {
                let up = chain(self.roots, n.id)
                var i = up.len() - 1
                var ran = false
                while i >= 0 {
                    let hs = up.get(i).wheel
                    if hs.len() > 0 {
                        for h in hs { self.handle(|var s| { h(s, dx, dy) }) }
                        ran = true
                        break
                    }
                    i = i - 1
                }
                if !ran { return Ok(true) }
            }
            gui.UiEvent.Changed(n) => {
                let typed = self.win.text(n)?
                let up = chain(self.roots, n.id)
                if up.len() > 0 {
                    for h in up.get(up.len() - 1).change { self.handle(|var s| { h(s, typed) }) }
                }
            }
            gui.UiEvent.Submit(n) => {
                let up = chain(self.roots, n.id)
                if up.len() > 0 {
                    for h in up.get(up.len() - 1).submit { self.handle(h) }
                }
            }
            gui.UiEvent.Link(n, id) => {
                let up = chain(self.roots, n.id)
                if up.len() > 0 {
                    for h in up.get(up.len() - 1).link { self.handle(|var s| { h(s, id) }) }
                }
            }
            gui.UiEvent.Key(key, mods, down) => {
                var ran = false
                if down {
                    for s in self.app.keys {
                        if s.key == key && s.mods == mods {
                            self.handle(s.f)
                            ran = true
                        }
                    }
                }
                if !ran { return Ok(true) }
            }
            gui.UiEvent.User(tag) => {
                let first = wake_tag() + 1
                if tag >= first && tag < first + self.app.ticks.len() {
                    let i = tag - first
                    if i < self.waiting.len() {
                        var p = self.waiting.get(i)
                        p.update(|f| { f.on = false })
                    }
                    if !self.tick(self.app.ticks.get(i).f) { return Ok(true) }
                }
            }
            gui.UiEvent.Close => {
                self.win.close()?
                return Ok(false)
            }
            _ => { }
        }
        self.render()?
        return Ok(true)
    }

    /// Handles events until the window closes.
    pub fn run(var self) -> Result<Null, Error> {
        let win = self.win
        var failure: Error? = None
        var flags: List<Shared<Pending>> = []
        for t in self.app.ticks { flags.push(Shared(Pending { on: false })) }
        self.waiting = flags
        scope {
            var tickers: List<Task<Null>> = []
            var i = 0
            for t in self.app.ticks {
                let tag = wake_tag() + 1 + i
                let ms = t.ms
                var busy = flags.get(i)
                tickers.push(spawn {
                    for n in time.ticker(time.Duration.from_millis(ms)) {
                        if !busy.get().on {
                            busy.update(|p| { p.on = true })
                            if win.post(tag).is_err() { break }
                        }
                    }
                })
                i = i + 1
            }
            for e in win.events() {
                match self.step(e) {
                    Ok(open) => {
                        if !open { break }
                    }
                    Err(err) => {
                        failure = Some(err)
                        break
                    }
                }
            }
            for t in tickers {
                t.cancel()
                t.join()
            }
        }
        match failure {
            Some(err) => { return Err(err) }
            None => { return Ok(null) }
        }
    }
}

fn drag_of<S>(g: Grip<S>, phase: element.Phase, x: Float, y: Float) -> element.Drag {
    return element.drag_step(phase, x, y, g.from_x, g.from_y, g.box)
}

fn edge_of(code: Int) -> gui.Edge {
    match code {
        0 => { return gui.Edge.North }
        1 => { return gui.Edge.South }
        2 => { return gui.Edge.East }
        3 => { return gui.Edge.West }
        4 => { return gui.Edge.NorthEast }
        5 => { return gui.Edge.NorthWest }
        6 => { return gui.Edge.SouthEast }
        _ => { return gui.Edge.SouthWest }
    }
}

