/// Builds the `Element` tree of a view and restyles it with modifiers.

import std.gui as gui
import { fmin, fmax } from std.math
import .theme

/// What an element does to the window itself.
pub enum Action {
    Nothing
    Move
    Minimize
    Maximize
    Close
    Resize(Int)
}

/// Where a pointer drag is.
pub enum Phase {
    Start
    Move
    End
}

/// One step of a drag that started on an element.
pub class Drag {
    pub phase: Phase
    pub x: Float
    pub y: Float
    pub from_x: Float
    pub from_y: Float
    pub left: Float
    pub top: Float
    pub width: Float
    pub height: Float

    /// How far the pointer is across the pressed element, from 0.0 to 1.0.
    pub fn across(self) -> Float {
        if self.width <= 0.0 { return 0.0 }
        return fmax(0.0, fmin(1.0, (self.x - self.left) / self.width))
    }

    /// How far the pointer is down the pressed element, from 0.0 to 1.0.
    pub fn down(self) -> Float {
        if self.height <= 0.0 { return 0.0 }
        return fmax(0.0, fmin(1.0, (self.y - self.top) / self.height))
    }

    /// How far the pointer has moved right since the press, in pixels.
    pub fn dx(self) -> Float { return self.x - self.from_x }

    /// How far the pointer has moved down since the press, in pixels.
    pub fn dy(self) -> Float { return self.y - self.from_y }
}

/// A `Drag` step for `phase` with the pointer at `x`, `y`.
pub fn drag_step(phase: Phase, x: Float, y: Float, from_x: Float, from_y: Float, box: List<Float>) -> Drag {
    return Drag { phase: phase, x: x, y: y, from_x: from_x, from_y: from_y, left: box.get(0), top: box.get(1), width: box.get(2), height: box.get(3) }
}

/// What the app keeps for components beside the state.
pub class Locals {
    var values: Map<String, Int>

    /// The number kept under `id`; 0 until it is set.
    pub fn get(self, id: String) -> Int { return self.values.get_or(id, 0) }

    pub fn set(var self, id: String, value: Int) { self.values.set(id, value) }
}

pub fn locals() -> Locals { return Locals { values: {} } }

/// One piece of a view.
pub class Element<S> {
    pub var kind: gui.Kind
    pub var role: theme.Role
    pub var text: String
    pub var edits: List<(gui.Style) -> gui.Style>
    pub var fill: Int
    pub var lift: Int
    pub var id: String
    pub var png: Bytes
    pub var runs: List<gui.Run>
    pub var act: Action
    pub var kids: List<Element<S>>
    pub var click: List<(var S) -> Null>
    pub var change: List<(var S, String) -> Null>
    pub var submit: List<(var S) -> Null>
    pub var wanted: Int
    pub var link: List<(var S, Int) -> Null>
    pub var local: List<(var Locals) -> Null>
    pub var build: List<(Locals) -> Element<S>>
    pub var memo: Int
    pub var drag: List<(var S, Drag) -> Null>
    pub var wheel: List<(var S, Float, Float) -> Null>
    pub var aim: Int

    fn copy(self) -> Element<S> {
        return Element { kind: self.kind, role: self.role, text: self.text, edits: self.edits, fill: self.fill, lift: self.lift, id: self.id, png: self.png, runs: self.runs, wanted: self.wanted, act: self.act, kids: self.kids, click: self.click, change: self.change, submit: self.submit, link: self.link, local: self.local, build: self.build, memo: self.memo, drag: self.drag, wheel: self.wheel, aim: self.aim }
    }

    /// Runs `f` with the state and a `Drag` as the pointer presses, moves and releases.
    pub fn on_drag(self, f: (var S, Drag) -> Null) -> Element<S> {
        var e = self.copy()
        e.drag = [f]
        return e
    }

    /// Runs `f` with the state and the wheel turn in pixels.
    pub fn on_wheel(self, f: (var S, Float, Float) -> Null) -> Element<S> {
        var e = self.copy()
        e.wheel = [f]
        return e
    }

    /// Gives the element the keyboard focus when its `token` changes.
    pub fn focus(self, token: Int) -> Element<S> {
        var e = self.copy()
        e.aim = token
        return e
    }

    /// Shows `runs` in a text or button element in place of its text.
    pub fn with_runs(self, runs: List<gui.Run>) -> Element<S> {
        var e = self.copy()
        var joined = ""
        for r in runs { joined = joined + r.text }
        e.text = joined
        e.runs = runs
        return e
    }

    /// Runs `f` with the state and the link id when a link run of a rich text element is clicked.
    pub fn on_link(self, f: (var S, Int) -> Null) -> Element<S> {
        var e = self.copy()
        e.link = [f]
        return e
    }

    /// Scrolls the nearest `scroll` so the element is at its top when its `token` changes.
    pub fn reveal(self, token: Int) -> Element<S> {
        var e = self.copy()
        e.wanted = token
        return e
    }

    /// Runs `f` on the app's `Locals` when the element is clicked, beside any `on_click`.
    pub fn on_local(self, f: (var Locals) -> Null) -> Element<S> {
        var e = self.copy()
        e.local = [f]
        return e
    }

    /// Runs `f` on the state when the element is clicked.
    pub fn on_click(self, f: (var S) -> Null) -> Element<S> {
        var e = self.copy()
        e.click = [f]
        return e
    }

    /// Runs `f` with the state and the new text when an input's text changes.
    pub fn on_change(self, f: (var S, String) -> Null) -> Element<S> {
        var e = self.copy()
        e.change = [f]
        return e
    }

    /// Runs `f` on the state when Enter is pressed in an input.
    pub fn on_submit(self, f: (var S) -> Null) -> Element<S> {
        var e = self.copy()
        e.submit = [f]
        return e
    }

    /// Names the element among its siblings so a redraw keeps its node.
    pub fn key(self, id: String) -> Element<S> {
        var e = self.copy()
        e.id = id
        return e
    }

    /// Makes pressing the element act on the window.
    pub fn action(self, a: Action) -> Element<S> {
        var e = self.copy()
        e.act = a
        return e
    }

    /// Shows a PNG in an image element.
    pub fn source(self, png: Bytes) -> Element<S> {
        var e = self.copy()
        e.png = png
        return e
    }

    /// Changes the look with any `std.gui` style method.
    pub fn style(self, f: (gui.Style) -> gui.Style) -> Element<S> {
        var e = self.copy()
        var edits: List<(gui.Style) -> gui.Style> = []
        for x in self.edits { edits.push(x) }
        edits.push(f)
        e.edits = edits
        return e
    }

    /// The same padding on every side, in pixels.
    pub fn pad(self, px: Float) -> Element<S> { return self.style(|s| s.padding(px)) }

    /// The space between children, in pixels.
    pub fn gap(self, px: Float) -> Element<S> { return self.style(|s| s.gap(px)) }

    /// The same margin on every side, in pixels.
    pub fn margin(self, px: Float) -> Element<S> { return self.style(|s| s.margin(px)) }

    /// The background, as `0xRRGGBBAA`.
    pub fn bg(self, color: Int) -> Element<S> {
        if self.is_pressable() {
            var e = self.copy()
            e.fill = color
            return e
        }
        return self.style(|s| s.background(color))
    }

    /// The text color, as `0xRRGGBBAA`.
    pub fn color(self, color: Int) -> Element<S> { return self.style(|s| s.color(color)) }

    /// The font size, in pixels.
    pub fn size(self, px: Float) -> Element<S> { return self.style(|s| s.font_size(px)) }

    pub fn bold(self) -> Element<S> { return self.style(|s| s.font_weight(700)) }

    pub fn radius(self, px: Float) -> Element<S> { return self.style(|s| s.radius(px)) }

    /// A border of `px` pixels in `color`, as `0xRRGGBBAA`.
    pub fn border(self, px: Float, color: Int) -> Element<S> { return self.style(|s| s.border(px, color)) }

    /// The background under the pointer, as `0xRRGGBBAA`, for an element that is not a button.
    pub fn hover_bg(self, color: Int) -> Element<S> {
        var e = self.copy()
        e.lift = color
        return e
    }

    /// Faded and deaf: it keeps its place but runs no handler.
    pub fn disabled(self) -> Element<S> {
        var e = self.style(|s| s.opacity(0.5))
        e.click = []
        e.change = []
        e.submit = []
        e.link = []
        e.local = []
        e.drag = []
        e.wheel = []
        return e
    }

    /// A width in pixels.
    pub fn width(self, px: Float) -> Element<S> { return self.style(|s| s.width(gui.Size.Px(px))) }

    /// A height in pixels.
    pub fn height(self, px: Float) -> Element<S> { return self.style(|s| s.height(gui.Size.Px(px))) }

    /// Takes the free space left in the parent, shared with other growing siblings.
    pub fn grow(self) -> Element<S> { return self.style(|s| s.grow(1.0)) }

    /// Centers the children, buttons included, or the text of a button.
    pub fn center(self) -> Element<S> {
        var e = self.style(|s| s.align_items(gui.Align.Center).justify(gui.Align.Center).text_align(gui.TextAlign.Center))
        var kids: List<Element<S>> = []
        for k in self.kids {
            if k.kind == gui.Kind.Button { kids.push(k.style(|s| s.align_self(gui.Align.Center))) } else { kids.push(k) }
        }
        e.kids = kids
        return e
    }

    fn is_pressable(self) -> Bool {
        match self.role {
            theme.Role.Button => { return true }
            theme.Role.Chosen => { return true }
            theme.Role.Item => { return true }
            theme.Role.Caption => { return true }
            theme.Role.CaptionClose(_) => { return true }
            theme.Role.Dot(_) => { return true }
            _ => { return false }
        }
    }
}

/// An element of `kind` and `role` with no handlers.
pub fn element<S>(kind: gui.Kind, role: theme.Role, text: String, kids: List<Element<S>>) -> Element<S> {
    return Element { kind: kind, role: role, text: text, edits: [], fill: -1, lift: -1, id: "", png: Bytes(0), runs: [], wanted: 0, act: Action.Nothing, kids: kids, click: [], change: [], submit: [], link: [], local: [], build: [], memo: 0, drag: [], wheel: [], aim: 0 }
}

/// An element that `build` makes from the app's `Locals` at each draw.
pub fn with_locals<S>(build: (Locals) -> Element<S>) -> Element<S> {
    var e: Element<S> = element(gui.Kind.Box, theme.Role.Plain, "", [])
    e.build = [build]
    return e
}

/// An element that `build` makes only when `token` changes.
pub fn memo<S>(token: Int, build: () -> Element<S>) -> Element<S> {
    var e: Element<S> = element(gui.Kind.Box, theme.Role.Plain, "", [])
    e.memo = token
    e.build = [|l| { return build() }]
    return e
}

/// What a `memo` element builds, with the token and key it was given.
pub fn expand_memo<S>(e: Element<S>, locals: Locals) -> Element<S> {
    var out = expand(e.build.get(0)(locals), locals).copy()
    out.memo = e.memo
    if e.id != "" { out.id = e.id }
    return out
}

/// The tree with every `with_locals` element replaced by what it builds.
pub fn expand<S>(e: Element<S>, locals: Locals) -> Element<S> {
    if e.build.len() > 0 {
        if e.memo != 0 { return e }
        let make = e.build.get(0)
        return expand(make(locals), locals)
    }
    var kids: List<Element<S>> = []
    var changed = false
    for k in e.kids {
        let x = expand(k, locals)
        if x != k { changed = true }
        kids.push(x)
    }
    if !changed { return e }
    var out = e.copy()
    out.kids = kids
    return out
}
