/// Holds the colors and shapes every element takes its look from.

import std.gui as gui
import { min, round, to_float } from std.math

/// What an element is for; the theme gives each role its look.
pub enum Role {
    Plain
    Text
    Heading(Float)
    Button
    Input
    Area
    Item
    Chosen
    Check
    Checked
    Bar
    Caption
    CaptionClose(Int)
    Dot(Int)
    Code
    Rule
    Cell
    Rail
    Fill
}

/// A color a theme holds, or a fixed one.
pub enum Tone {
    Ink
    Page
    Surface
    Quiet
    Border
    Accent
    AccentInk
    Rgba(Int)
}

/// Space in steps of 4 pixels.
pub fn space(step: Int) -> Float { return 4.0 * to_float(step) }

/// Text sizes in pixels, scaled by 1.25 per step.
pub fn type_size(step: Int) -> Float {
    var px = 16.0
    var i = 0
    while i < step {
        px = px * 1.25
        i = i + 1
    }
    while i > step {
        px = px / 1.25
        i = i - 1
    }
    return round(px)
}

fn tint(c: Int, pct: Int) -> Int {
    let r = min(255, ((c >> 24) & 0xff) * pct / 100)
    let g = min(255, ((c >> 16) & 0xff) * pct / 100)
    let b = min(255, ((c >> 8) & 0xff) * pct / 100)
    return (r << 24) | (g << 16) | (b << 8) | (c & 0xff)
}

/// The colors and corner radius of a window.
pub class Theme {
    var fg: Int
    var back: Int
    var panel: Int
    var soft: Int
    var line: Int
    var brand: Int
    var on_brand: Int
    var round: Float
    var size: Float
    var unit: Float
    pub var hover: Int
    pub var press: Int

    fn copy(self) -> Theme {
        return Theme { fg: self.fg, back: self.back, panel: self.panel, soft: self.soft, line: self.line, brand: self.brand, on_brand: self.on_brand, round: self.round, size: self.size, unit: self.unit, hover: self.hover, press: self.press }
    }

    /// The text color.
    pub fn ink(self, c: Int) -> Theme {
        var t = self.copy()
        t.fg = c
        return t
    }

    /// The window's background.
    pub fn page(self, c: Int) -> Theme {
        var t = self.copy()
        t.back = c
        return t
    }

    /// The fill of inputs and checkboxes.
    pub fn surface(self, c: Int) -> Theme {
        var t = self.copy()
        t.panel = c
        return t
    }

    /// The fill of choices that are not selected.
    pub fn quiet(self, c: Int) -> Theme {
        var t = self.copy()
        t.soft = c
        return t
    }

    /// The border of inputs and checkboxes.
    pub fn border(self, c: Int) -> Theme {
        var t = self.copy()
        t.line = c
        return t
    }

    /// The color of buttons and of the selected choice.
    pub fn accent(self, c: Int) -> Theme {
        var t = self.copy()
        t.brand = c
        return t
    }

    /// The text color on the accent.
    pub fn accent_ink(self, c: Int) -> Theme {
        var t = self.copy()
        t.on_brand = c
        return t
    }

    /// The corner radius of buttons, inputs and choices, in pixels.
    pub fn radius(self, px: Float) -> Theme {
        var t = self.copy()
        t.round = px
        return t
    }

    /// The size of ordinary text in pixels.
    pub fn text_size(self, px: Float) -> Theme {
        var t = self.copy()
        t.size = px
        return t
    }

    /// The unit that padding is counted in, in pixels.
    pub fn spacing(self, px: Float) -> Theme {
        var t = self.copy()
        t.unit = px
        return t
    }

    /// How much a pressable color is scaled under the pointer and when pressed.
    pub fn shading(self, hover_pct: Int, press_pct: Int) -> Theme {
        var t = self.copy()
        t.hover = hover_pct
        t.press = press_pct
        return t
    }

    /// The color a pressable role is filled with, or -1 for a role that is not pressable.
    pub fn fill(self, role: Role) -> Int {
        match role {
            Role.Button => { return self.brand }
            Role.Chosen => { return self.brand }
            Role.Item => { return self.soft }
            Role.Caption => { return self.soft }
            Role.CaptionClose(_) => { return self.soft }
            Role.Dot(c) => { return c }
            _ => { return -1 }
        }
    }

    /// The color a pressable role takes under the pointer.
    pub fn hover_of(self, role: Role, fill: Int) -> Int {
        match role {
            Role.CaptionClose(c) => { return c }
            _ => { return tint(fill, self.hover) }
        }
    }

    /// The color a pressable role takes when pressed.
    pub fn press_of(self, role: Role, fill: Int) -> Int {
        match role {
            Role.CaptionClose(c) => { return tint(c, self.press) }
            _ => { return tint(fill, self.press) }
        }
    }

    /// The color a tone names in this theme.
    pub fn color(self, t: Tone) -> Int {
        match t {
            Tone.Ink => { return self.fg }
            Tone.Page => { return self.back }
            Tone.Surface => { return self.panel }
            Tone.Quiet => { return self.soft }
            Tone.Border => { return self.line }
            Tone.Accent => { return self.brand }
            Tone.AccentInk => { return self.on_brand }
            Tone.Rgba(c) => { return c }
        }
    }

    /// The style of a role before an element's own modifiers.
    pub fn look(self, role: Role) -> gui.Style {
        let base = gui.style().color(self.fg).shrink(0.0).font_size(self.size)
        let u = self.unit
        match role {
            Role.Plain => { return gui.style().shrink(0.0) }
            Role.Text => { return base }
            Role.Heading(px) => { return base.font_size(px).font_weight(700) }
            Role.Button => {
                return base.color(self.on_brand).background(self.brand).radius(self.round).padding_sides(2.0 * u, 4.0 * u, 2.0 * u, 4.0 * u).align_self(gui.Align.Start)
            }
            Role.Input => {
                return base.width(gui.Size.Pct(100.0)).height(gui.Size.Px(self.size + 5.5 * u)).padding(2.0 * u).border(1.0, self.line).radius(self.round).background(self.panel)
            }
            Role.Area => {
                return base.width(gui.Size.Pct(100.0)).min_height(gui.Size.Px(19.0 * u)).padding(2.0 * u).border(1.0, self.line).radius(self.round).background(self.panel)
            }
            Role.Item => {
                return base.background(self.soft).radius(self.round).padding_sides(2.0 * u, 3.0 * u, 2.0 * u, 3.0 * u).align_self(gui.Align.Stretch)
            }
            Role.Chosen => {
                return base.color(self.on_brand).background(self.brand).radius(self.round).padding_sides(2.0 * u, 3.0 * u, 2.0 * u, 3.0 * u).align_self(gui.Align.Stretch)
            }
            Role.Check => {
                return base.width(gui.Size.Px(20.0)).height(gui.Size.Px(20.0)).border(2.0, self.line).radius(self.round / 2.0).background(self.panel)
            }
            Role.Checked => {
                return base.width(gui.Size.Px(20.0)).height(gui.Size.Px(20.0)).border(2.0, self.brand).radius(self.round / 2.0).background(self.brand)
            }
            Role.Bar => {
                return base.direction(gui.Direction.Row).align_items(gui.Align.Center).height(gui.Size.Px(36.0)).background(self.soft)
            }
            Role.Caption => {
                return base.width(gui.Size.Px(46.0)).height(gui.Size.Px(36.0)).background(self.soft).align_items(gui.Align.Center).justify(gui.Align.Center).text_align(gui.TextAlign.Center)
            }
            Role.CaptionClose(_) => {
                return base.width(gui.Size.Px(46.0)).height(gui.Size.Px(36.0)).background(self.soft).align_items(gui.Align.Center).justify(gui.Align.Center).text_align(gui.TextAlign.Center)
            }
            Role.Dot(c) => {
                return base.width(gui.Size.Px(13.0)).height(gui.Size.Px(13.0)).radius(7.0).background(c)
            }
            Role.Code => {
                return base.font_size(self.size - 2.0).background(self.soft).radius(self.round).padding(2.5 * u)
            }
            Role.Rule => {
                return gui.style().shrink(0.0).width(gui.Size.Pct(100.0)).height(gui.Size.Px(1.0)).background(self.line)
            }
            Role.Cell => {
                return base.border(1.0, self.line).padding(1.5 * u)
            }
            Role.Rail => {
                return gui.style().shrink(0.0).width(gui.Size.Pct(100.0)).height(gui.Size.Px(8.0)).radius(4.0).background(self.line)
            }
            Role.Fill => {
                return gui.style().shrink(0.0).height(gui.Size.Px(8.0)).radius(4.0).background(self.brand)
            }
        }
    }

    /// The runs of a rich text element with its links colored in the accent.
    pub fn tint_links(self, runs: List<gui.Run>) -> List<gui.Run> {
        var out: List<gui.Run> = []
        for r in runs { out.push(r.tint_link(self.brand)) }
        return out
    }

    /// The style of the window's root: a padded column on the page color.
    pub fn root(self) -> gui.Style {
        return gui.style().direction(gui.Direction.Column).width(gui.Size.Pct(100.0)).height(gui.Size.Pct(100.0)).padding(4.0 * self.unit).background(self.back)
    }

    /// The style of the window's root when pane draws the title bar.
    pub fn framed_root(self) -> gui.Style {
        return gui.style().direction(gui.Direction.Column).width(gui.Size.Pct(100.0)).height(gui.Size.Pct(100.0)).background(self.back)
    }
}

/// Dark text on a light page, a blue accent; the default.
pub fn light() -> Theme {
    return Theme { fg: 0x1f2937ff, back: 0xf4f5f7ff, panel: 0xffffffff, soft: 0xe5e7ebff, line: 0xc4c9d0ff, brand: 0x2563ebff, on_brand: 0xffffffff, round: 6.0, size: 16.0, unit: 4.0, hover: 90, press: 78 }
}

/// Light text on a dark page, a lighter blue accent.
pub fn dark() -> Theme {
    return Theme { fg: 0xe5e7ebff, back: 0x111827ff, panel: 0x1f2937ff, soft: 0x374151ff, line: 0x4b5563ff, brand: 0x3b82f6ff, on_brand: 0xffffffff, round: 6.0, size: 16.0, unit: 4.0, hover: 115, press: 135 }
}

/// White on black with a yellow accent and square corners, for legibility.
pub fn contrast() -> Theme {
    return Theme { fg: 0xffffffff, back: 0x000000ff, panel: 0x000000ff, soft: 0x262626ff, line: 0xffffffff, brand: 0xffd60aff, on_brand: 0x000000ff, round: 2.0, size: 16.0, unit: 4.0, hover: 85, press: 70 }
}
