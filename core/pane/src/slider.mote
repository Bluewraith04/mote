/// Draws a rail with a filled part that follows the pointer.

import std.gui as gui
import { fmin, fmax } from std.math
import .element
import .theme

/// A rail filled up to `value` between `lo` and `hi`.
pub fn slider<S>(value: Float, lo: Float, hi: Float, on_change: (var S, Float) -> Null) -> element.Element<S> {
    var share = 0.0
    if hi > lo { share = fmax(0.0, fmin(1.0, (value - lo) / (hi - lo))) }
    let fill: element.Element<S> = element.element(gui.Kind.Box, theme.Role.Fill, "", []).style(|s| s.width(gui.Size.Pct(100.0 * share)))
    let rail: element.Element<S> = element.element(gui.Kind.Box, theme.Role.Rail, "", [fill])
    let track: element.Element<S> = element.element(gui.Kind.Box, theme.Role.Plain, "", [rail])
    return track.style(|s| s.width(gui.Size.Pct(100.0)).shrink(1.0).height(gui.Size.Px(24.0)).align_items(gui.Align.Center)).on_drag(|var s, d| { on_change(s, lo + d.across() * (hi - lo)) })
}
