// Pipelines: steps that change the state from text, channels and screens.
import { parse_float, parse_int } from std.string
import { Dyn, Kind, Shape, Type, build_dyn, describe, downcast, duplicate } from std.meta
import { Receiver, Sender } from std.sync
import { Next } from .event

/// One step of a pipeline: set a field of the state from text, show a screen (set the field `screen`), send text to a channel, wait for a reply into a field, or end the run.
pub enum Step {
    Set(String, String)
    Show(String)
    Send(Sender<String>, String)
    Await(Receiver<String>, String)
    Quit
}

// A field of the state from text: a `Bool`, `Int`, `Float` or `String`, or the unit variant of an enum that has that name.
fn text_value(ty: Type, text: String, field: String) -> Result<Dyn, Error> {
    let kind = ty.kind()
    if kind == Kind.Bool {
        if text == "true" { return Ok(Dyn.of(true)) }
        if text == "false" { return Ok(Dyn.of(false)) }
        return Err(Error.new(ErrorKind.InvalidData, "pane: ${field} wants true or false, not ${text}"))
    }
    if kind == Kind.Int && ty.name() == "Int" {
        let n = parse_int(text)
        if n.is_err() { return Err(Error.new(ErrorKind.InvalidData, "pane: ${field} wants an integer, not ${text}")) }
        return Ok(Dyn.of(n.unwrap()))
    }
    if kind == Kind.Float && ty.name() == "Float" {
        let x = parse_float(text)
        if x.is_err() { return Err(Error.new(ErrorKind.InvalidData, "pane: ${field} wants a number, not ${text}")) }
        return Ok(Dyn.of(x.unwrap()))
    }
    if kind == Kind.String { return Ok(Dyn.of(text)) }
    if kind == Kind.Enum {
        let variants = ty.variants()
        for tag in 0..variants.len() {
            if variants[tag].name == text && variants[tag].shape == Shape.Unit { return Ok(build_dyn(ty, tag, [])) }
        }
        return Err(Error.new(ErrorKind.InvalidData, "pane: ${field} has no variant ${text}"))
    }
    return Err(Error.new(ErrorKind.Unsupported, "pane: ${field} is a ${ty.name()}, which text cannot set"))
}

// The state with one field replaced by the value of the text; the given state is left as it was.
fn set_field<S>(state: S, name: String, text: String) -> Result<S, Error> {
    let ty = describe<S>()
    if ty.kind() != Kind.Struct && ty.kind() != Kind.Class {
        return Err(Error.new(ErrorKind.InvalidData, "pane: ${ty.name()} is not a struct or class"))
    }
    let fields = ty.fields()
    for at in 0..fields.len() {
        if fields[at].name == name {
            let part = text_value(fields[at].ty, text, name)?
            let whole = Dyn.of(duplicate(state))
            whole.set(at, part)
            let made = downcast<S>(whole)
            if made == null { return Err(Error.new(ErrorKind.Other, "pane: ${name} could not be set")) }
            return Ok(made)
        }
    }
    return Err(Error.new(ErrorKind.InvalidData, "pane: ${ty.name()} has no field ${name}"))
}

/// Runs the steps in order on the state and gives the new state: `Continue` after the last step, `Quit` at a `Quit` step. A step that fails, or a channel that closes before it replies, is an `Err`.
pub fn run_steps<S>(state: S, steps: List<Step>) -> Result<Next<S>, Error> {
    var current = state
    for step in steps {
        match step {
            Set(field, text) => { current = set_field<S>(current, field, text)? }
            Show(screen) => { current = set_field<S>(current, "screen", screen)? }
            Send(to, text) => { to.send(text) }
            Await(source, field) => {
                let reply = source.recv()
                if reply == null { return Err(Error.new(ErrorKind.Other, "pane: the channel for ${field} closed")) }
                current = set_field<S>(current, field, reply)?
            }
            Quit => { return Ok(Next.Quit(current)) }
        }
    }
    return Ok(Next.Continue(current))
}
