// The constructors of elements: text, buttons and the boxes that hold them.
import { Attr, Element, ElementKind } from .element
import { ACCENT, WHITE } from .theme

fn make(kind: ElementKind, label: String, kids: List<Element>) -> Element {
    return Element { kind: kind, label: label, kids: kids, attrs: [], grows: false, outer: 0, click: null }
}

/// A line of text, 16 pixels high.
pub fn text(label: String) -> Element { return make(ElementKind.Text, label, []) }

/// Text 28 pixels high.
pub fn h1(label: String) -> Element { return text(label).size(28) }

/// Text 24 pixels high.
pub fn h2(label: String) -> Element { return text(label).size(24) }

/// Text 20 pixels high.
pub fn h3(label: String) -> Element { return text(label).size(20) }

/// Text 18 pixels high.
pub fn h4(label: String) -> Element { return text(label).size(18) }

/// A button in the accent colour that shows a label.
pub fn button(label: String) -> Element {
    return make(ElementKind.Box, "", [text(label)]).pad_xy(16, 8).bg(ACCENT).color(WHITE).radius(6).center()
}

/// Children one under the other, 8 pixels apart.
pub fn vstack(kids: List<Element>) -> Element { return make(ElementKind.Column, "", kids).gap(8) }

/// Children side by side, 8 pixels apart and centred across.
pub fn hstack(kids: List<Element>) -> Element { return make(ElementKind.Row, "", kids).gap(8).middle() }

/// A plain box that lays its children out in a row.
pub fn box(kids: List<Element>) -> Element { return make(ElementKind.Box, "", kids) }

/// Empty space that takes what the parent leaves, to push its siblings apart.
pub fn spacer() -> Element { return make(ElementKind.Spacer, "", []) }
