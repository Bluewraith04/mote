import std.gui as gui
import { Stream } from std.stream
import std.time as time
import ..src.lib as pane
import ..src.theme as theme
import ..src.chrome as chrome
import ..src.layout as layout
import ..src.controls as c

class State {
    var count: Int
}

class Shown {
    var text: String
}

fn view(s: State) -> pane.Element<State> {
    return pane.vstack([
        pane.text("count ${s.count}"),
        pane.button("+").on_click(|var s| { s.count += 1 }),
    ])
}

test "a handle updated by another task redraws and takes the handlers" {
    let win = gui.headless(300, 300).unwrap()
    var base = pane.App("Shared", State { count: 0 }, view)
    let counter = base.state()
    var app = base.mount(win).unwrap()
    let events = win.events()
    scope {
        spawn {
            counter.update(|var s| { s.count = 40 })
        }
    }
    for e in events {
        match e {
            gui.UiEvent.User(n) => {
                app.step(e).unwrap()
                break
            }
            _ => { app.step(e).unwrap() }
        }
    }
    assert_eq(win.text(win.hit(20.0, 26.0).unwrap().unwrap()).unwrap(), "count 40")
    win.input(gui.Input.PointerMove(20.0, 60.0)).unwrap()
    win.input(gui.Input.PointerDown(20.0, 60.0)).unwrap()
    win.input(gui.Input.PointerUp(20.0, 60.0)).unwrap()
    win.post(8).unwrap()
    for e in events {
        match e {
            gui.UiEvent.User(n) => { break }
            _ => { app.step(e).unwrap() }
        }
    }
    assert_eq(counter.get().count, 41)
    assert_eq(win.text(win.hit(20.0, 26.0).unwrap().unwrap()).unwrap(), "count 41")
}

fn count_view(s: State) -> pane.Element<State> {
    return pane.text("count ${s.count}")
}

test "every runs its handler on an interval and stops with the window" {
    let win = gui.headless(200, 100).unwrap()
    let state = State { count: 0 }
    var app = pane.App("Every", state, count_view).every(10, |var s| { s.count += 1 }).every(60000, |var s| { s.count += 1000 }).mount(win).unwrap()
    let started = time.now()
    scope {
        spawn {
            time.sleep(time.Duration.from_millis(200))
            win.input(gui.Input.Close).unwrap()
        }
        match app.run() {
            Err(e) => { assert(false) }
            _ => { }
        }
    }
    assert(state.count >= 3)
    assert(state.count < 1000)
    assert(time.now().duration_since(started).as_millis() < 5000)
}

test "watch redraws only when its handler answers true" {
    let win = gui.headless(200, 100).unwrap()
    let state = State { count: 0 }
    var app = pane.App("Watch", state, count_view).watch(10, |var s| {
        s.count += 1
        return false
    }).mount(win).unwrap()
    var shown = Shared(Shown { text: "" })
    let label = app.find("count 0").unwrap()
    scope {
        spawn {
            time.sleep(time.Duration.from_millis(200))
            let text = win.text(label).unwrap()
            var mine = shown.clone()
            mine.update(|s| { s.text = text })
            win.input(gui.Input.Close).unwrap()
        }
        app.run().unwrap()
    }
    assert(state.count >= 3)
    assert_eq(shown.get().text, "count 0")
}

test "a close is not kept waiting behind ticks that come faster than they are handled" {
    let win = gui.headless(200, 100).unwrap()
    let state = State { count: 0 }
    var app = pane.App("Slow", state, count_view).every(1, |var s| {
        time.sleep(time.Duration.from_millis(50))
        s.count += 1
    }).mount(win).unwrap()
    let started = time.now()
    scope {
        spawn {
            time.sleep(time.Duration.from_millis(300))
            win.input(gui.Input.Close).unwrap()
        }
        app.run().unwrap()
    }
    assert(state.count >= 3)
    assert(time.now().duration_since(started).as_millis() < 1500)
}

test "hovering, an unused wheel turn and a click nobody handles do not redraw" {
    let win = gui.headless(200, 100).unwrap()
    let state = State { count: 0 }
    var app = pane.App("Quiet", state, count_view).mount(win).unwrap()
    let label = app.find("count 0").unwrap()
    state.count = 7
    app.step(gui.UiEvent.Enter(label)).unwrap()
    app.step(gui.UiEvent.Leave(label)).unwrap()
    app.step(gui.UiEvent.Wheel(label, 0.0, 10.0)).unwrap()
    app.step(gui.UiEvent.Click(label)).unwrap()
    assert_eq(win.text(label).unwrap(), "count 0")
    app.step(gui.UiEvent.User(7001)).unwrap()
    assert_eq(win.text(label).unwrap(), "count 7")
}

test "a key runs its handler only with its modifiers" {
    let win = gui.headless(200, 100).unwrap()
    let state = State { count: 0 }
    var app = pane.App("Keys", state, count_view).on_key(gui.Key.Char(115), gui.mods(false, true, false, false), |var s| { s.count += 5 }).on_key(gui.Key.Escape, gui.no_mods(), |var s| { s.count = 0 }).mount(win).unwrap()
    let events = win.events()
    win.input(gui.Input.Key(gui.Key.Char(115), gui.no_mods(), true)).unwrap()
    win.input(gui.Input.Key(gui.Key.Char(115), gui.mods(false, true, false, false), true)).unwrap()
    win.input(gui.Input.Key(gui.Key.Char(115), gui.mods(false, true, false, false), false)).unwrap()
    win.post(1).unwrap()
    for e in events {
        match e {
            gui.UiEvent.User(n) => { break }
            _ => { app.step(e).unwrap() }
        }
    }
    assert_eq(state.count, 5)
    win.input(gui.Input.Key(gui.Key.Escape, gui.no_mods(), true)).unwrap()
    win.post(2).unwrap()
    for e in events {
        match e {
            gui.UiEvent.User(n) => { break }
            _ => { app.step(e).unwrap() }
        }
    }
    assert_eq(state.count, 0)
}

fn style_view(s: State) -> pane.Element<State> {
    return pane.hstack([
        pane.button("on").on_click(|var s| { s.count += 1 }),
        pane.button("off").on_click(|var s| { s.count += 10 }).disabled(),
        pane.spacer(),
        pane.text("end").border(1.0, 0xff0000ff).hover_bg(0x00ff00ff),
    ])
}

test "a disabled button is deaf, a spacer pushes apart and the scales step" {
    let state = State { count: 0 }
    var app = pane.App("Style", state, style_view).headless(300, 100).unwrap()
    app.click_text("on").unwrap()
    app.click_text("off").unwrap()
    assert_eq(state.count, 1)
    let end = app.find("end").unwrap()
    assert(app.window().rect(end).unwrap().get(0) > 200.0)
    assert_eq(pane.space(3), 12.0)
    assert_eq(pane.type_size(0), 16.0)
    assert_eq(pane.type_size(2), 25.0)
    assert_eq(pane.type_size(-1), 13.0)
}

class Form {
    var count: Int
    var name: String
}

fn form_view(s: Form) -> pane.Element<Form> {
    return pane.vstack([
        pane.button("+").on_click(|var s| { s.count += 1 }),
        pane.input(s.name, |var s, t| { s.name = t }),
        pane.text("count ${s.count} name ${s.name}"),
    ])
}

test "the headless helpers click, type and press by the text shown" {
    let state = Form { count: 0, name: "" }
    var app = pane.App("Helpers", state, form_view).on_key(gui.Key.Escape, gui.no_mods(), |var s| { s.count = 0 }).headless(200, 200).unwrap()
    app.click_text("+").unwrap()
    app.click_text("+").unwrap()
    assert(app.shows("count 2 name "))
    app.type_into("", "ab").unwrap()
    assert(app.shows("count 2 name ab"))
    app.press(gui.Key.Escape, gui.no_mods()).unwrap()
    assert(app.shows("count 0 name ab"))
    assert(app.click_text("missing").is_err())
}

fn drain(var app: pane.Running<State>, win: gui.Window, events: Stream<gui.UiEvent>) -> Bool {
    win.post(1).unwrap()
    for e in events {
        match e {
            gui.UiEvent.User(n) => { return true }
            _ => {
                let open = app.step(e).unwrap()
                if !open { return false }
            }
        }
    }
    return false
}

fn press(win: gui.Window, x: Float, y: Float) {
    win.input(gui.Input.PointerMove(x, y)).unwrap()
    win.input(gui.Input.PointerDown(x, y)).unwrap()
    win.input(gui.Input.PointerUp(x, y)).unwrap()
}

fn plus_view(s: State) -> pane.Element<State> {
    return pane.vstack([pane.button("+").on_click(|var s| { s.count += 1 })])
}

test "a title bar drawn by pane has working caption buttons and leaves the content below it" {
    let win = gui.headless(420, 200).unwrap()
    let state = State { count: 0 }
    var app = pane.App("Demo", state, plus_view).chrome(chrome.banner()).mount(win).unwrap()
    let events = win.events()
    assert_eq(win.pixel(200, 10).unwrap(), 0x2563ebff)
    assert_eq(win.pixel(200, 100).unwrap(), 0xf4f5f7ff)
    press(win, 200.0, 18.0)
    assert(drain(app, win, events))
    press(win, 30.0, 70.0)
    assert(drain(app, win, events))
    assert_eq(state.count, 1)
    press(win, 2.0, 100.0)
    assert(drain(app, win, events))
    press(win, 342.0, 20.0)
    assert(drain(app, win, events))
    press(win, 394.0, 20.0)
    assert(!drain(app, win, events))
    assert(win.present().is_err())
}

test "the presets draw their buttons where their style puts them" {
    let a = gui.headless(420, 200).unwrap()
    pane.App("Demo", State { count: 0 }, count_view).chrome(chrome.slate().buttons(chrome.Buttons.Dots).buttons_left(true)).mount(a).unwrap()
    assert_eq(a.pixel(18, 17).unwrap(), 0xe5484dff)
    let b = gui.headless(420, 200).unwrap()
    pane.App("Demo", State { count: 0 }, count_view).chrome(chrome.system()).mount(b).unwrap()
    assert_eq(b.pixel(20, 18).unwrap(), 0xf4f5f7ff)
    let d = gui.headless(420, 200).unwrap()
    pane.App("Demo", State { count: 0 }, count_view).theme(theme.dark()).chrome(chrome.banner()).mount(d).unwrap()
    assert_eq(d.pixel(5, 5).unwrap(), 0x3b82f6ff)
    let e = gui.headless(420, 200).unwrap()
    pane.App("Demo", State { count: 0 }, count_view).chrome(chrome.slate()).mount(e).unwrap()
    assert_eq(e.pixel(5, 5).unwrap(), 0xf4f5f7ff)
    assert_eq(e.pixel(100, 34).unwrap(), 0xc4c9d0ff)
    assert_eq(e.pixel(303, 8).unwrap(), 0xe5e7ebff)
}

fn go_view(s: State) -> pane.Element<State> {
    return pane.button("go")
}

test "a chrome is built from tones and the theme sets text size and spacing" {
    let a = gui.headless(420, 200).unwrap()
    let tall = chrome.slate().height(50.0).bar_color(theme.Tone.Rgba(0x102030ff)).rule(false)
    pane.App("Demo", State { count: 0 }, go_view).chrome(tall).mount(a).unwrap()
    assert_eq(a.pixel(5, 45).unwrap(), 0x102030ff)
    assert_eq(a.pixel(5, 55).unwrap(), 0xf4f5f7ff)
    let b = gui.headless(420, 200).unwrap()
    pane.App("Demo", State { count: 0 }, go_view).theme(theme.light().accent(0x00aa00ff).spacing(8.0)).mount(b).unwrap()
    assert_eq(b.pixel(20, 20).unwrap(), 0xf4f5f7ff)
    assert_eq(b.pixel(40, 40).unwrap(), 0x00aa00ff)
}

fn module_view(s: State) -> pane.Element<State> {
    return layout.vstack([c.text("n = ${s.count}"), pane.button("go").on_click(|var s| { s.count += 1 })])
}

test "a module of the package imports by name beside the whole package" {
    let win = gui.headless(200, 100).unwrap()
    let app = pane.App("Modules", State { count: 4 }, module_view).mount(win).unwrap()
    assert_eq(win.text(win.hit(20.0, 30.0).unwrap().unwrap()).unwrap(), "n = 4")
}

class Seen {
    var seen: Int
}

fn rich_view(s: Seen) -> pane.Element<Seen> {
    return pane.vstack([
        pane.rich([gui.run("aaaa "), gui.run("a link in the middle of the line").link(3), gui.run(" bbbb")]).on_link(|var s, id| { s.seen = id }),
        pane.text("seen ${s.seen}"),
    ])
}

test "rich text shows its runs joined and a clicked link reaches its handler" {
    let state = Seen { seen: 0 }
    var app = pane.App("Rich", state, rich_view).headless(400, 100).unwrap()
    assert(app.shows("aaaa a link in the middle of the line bbbb"))
    app.click_text("aaaa a link in the middle of the line bbbb").unwrap()
    assert_eq(state.seen, 3)
    assert(app.shows("seen 3"))
}

fn tint_view(s: Seen) -> pane.Element<Seen> {
    return pane.rich([gui.run("MMMMMMMMMM").link(1)])
}

test "a link run without a color takes the theme's accent" {
    let win = gui.headless(200, 60).unwrap()
    var app = pane.App("Tint", Seen { seen: 0 }, tint_view).mount(win).unwrap()
    var blue = 0
    var x = 16
    while x < 120 {
        let p = win.pixel(x, 24).unwrap()
        let r = (p >> 24) & 0xff
        let b = (p >> 8) & 0xff
        if r < 120 && b > 150 { blue = blue + 1 }
        x = x + 1
    }
    assert(blue > 5)
}

class Note {
    var note: String
    var sent: Int
}

fn note_view(s: Note) -> pane.Element<Note> {
    return pane.vstack([
        pane.input_multi(s.note, |var s, t| { s.note = t }).on_submit(|var s| { s.sent += 1 }).height(80.0),
        pane.text("sent ${s.sent}"),
    ])
}

test "input_multi keeps its line breaks through redraws, submits on control enter and undoes" {
    let state = Note { note: "", sent: 0 }
    var app = pane.App("Notes", state, note_view).headless(300, 300).unwrap()
    app.type_into("", "one").unwrap()
    app.press(gui.Key.Enter, gui.no_mods()).unwrap()
    app.type_into("one\n", "two").unwrap()
    assert_eq(state.note, "one\ntwo")
    assert(app.shows("sent 0"))
    app.press(gui.Key.Enter, gui.mods(false, true, false, false)).unwrap()
    assert(app.shows("sent 1"))
    assert_eq(state.note, "one\ntwo")
    app.press(gui.Key.Char(122), gui.mods(false, true, false, false)).unwrap()
    assert_eq(state.note, "one\n")
}

test "maximized and fullscreen apps and windows do nothing without a screen" {
    var a = pane.App("A", State { count: 1 }, count_view).maximized().headless(200, 100).unwrap()
    var b = pane.App("B", State { count: 2 }, count_view).fullscreen().headless(200, 100).unwrap()
    assert(a.shows("count 1"))
    assert(b.shows("count 2"))
    let win = b.window()
    win.set_maximized(true).unwrap()
    win.set_fullscreen(true).unwrap()
    assert(!win.maximized().unwrap())
    assert(!win.fullscreen().unwrap())
}

class Reveal {
    var token: Int
    var target: Int
}

class Memoed {
    var label: String
    var token: Int
}

fn memo_view(s: Memoed) -> pane.Element<Memoed> {
    let label = s.label
    return pane.vstack([pane.memo(s.token, || { return pane.text(label) }), pane.text("token ${s.token}")])
}

test "a memo element is built again only when its token changes" {
    let state = Memoed { label: "one", token: 1 }
    var app = pane.App("Memo", state, memo_view).headless(300, 200).unwrap()
    assert(app.shows("one"))
    state.label = "two"
    app.render().unwrap()
    assert(app.shows("one"))
    assert(!app.shows("two"))
    state.token = 2
    app.render().unwrap()
    assert(app.shows("two"))
    assert(!app.shows("one"))
}

class Rows {
    var names: List<String>
    var vers: List<Int>
}

fn rows_view(s: Rows) -> pane.Element<Rows> {
    var kids: List<pane.Element<Rows>> = []
    var i = 0
    while i < s.names.len() {
        let name = s.names.get(i)
        kids.push(pane.memo(s.vers.get(i), || { return pane.text(name) }).key("r${s.vers.get(i)}"))
        i = i + 1
    }
    return pane.vstack(kids)
}

test "keyed memo elements keep their nodes when a sibling is inserted before them" {
    let state = Rows { names: ["a", "b"], vers: [1, 2] }
    var app = pane.App("Rows", state, rows_view).headless(300, 200).unwrap()
    let node = app.find("b").unwrap()
    state.names = ["x", "a", "ZZ"]
    state.vers = [3, 1, 2]
    app.render().unwrap()
    assert(app.shows("x"))
    assert(app.shows("a"))
    assert(app.shows("b"))
    assert(!app.shows("ZZ"))
    assert_eq(app.find("b").unwrap().id, node.id)
    let top = app.window().rect(app.find("x").unwrap()).unwrap().get(1)
    let mid = app.window().rect(app.find("a").unwrap()).unwrap().get(1)
    let low = app.window().rect(app.find("b").unwrap()).unwrap().get(1)
    assert(top < mid && mid < low)
}

fn reveal_view(s: Reveal) -> pane.Element<Reveal> {
    var rows: List<pane.Element<Reveal>> = []
    var i = 0
    while i < 30 {
        var row: pane.Element<Reveal> = pane.text("row ${i}")
        if i == s.target { row = row.reveal(s.token) }
        rows.push(row)
        i = i + 1
    }
    return pane.vstack([
        pane.button("go").on_click(|var s| { s.target = 20
            s.token += 1 }),
        pane.button("again").on_click(|var s| { s.token += 1 }),
        pane.scroll(rows).height(100.0),
    ])
}

test "reveal scrolls the scroll around an element to its top once per token" {
    let state = Reveal { token: 0, target: 0 }
    var app = pane.App("Reveal", state, reveal_view).headless(300, 300).unwrap()
    let box = app.window().rect(app.find("row 0").unwrap()).unwrap()
    app.click_text("go").unwrap()
    let row = app.window().rect(app.find("row 20").unwrap()).unwrap()
    assert(row.get(1) >= box.get(1) - 1.0 && row.get(1) < box.get(1) + 40.0)
    app.window().scroll(app.find("row 20").unwrap(), 0.0, 0.0).unwrap()
    app.click_text("again").unwrap()
    let after = app.window().rect(app.find("row 20").unwrap()).unwrap()
    assert(after.get(1) < box.get(1) + 40.0)
}
