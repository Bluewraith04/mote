import std.gui as gui
import { Stream } from std.stream
import ..src.lib as pane
import { nav } from ..src.nav
import { tabs } from ..src.tabs
import { pages } from ..src.pages
import { checkbox } from ..src.checkbox
import { select } from ..src.select
import { image } from ..src.image

class State {
    var count: Int
    var name: String
    var done: Bool
}

fn fresh() -> State {
    return State { count: 0, name: "", done: false }
}

fn at(win: gui.Window, x: Float, y: Float) -> gui.Node {
    return win.hit(x, y).unwrap().unwrap()
}

fn click(win: gui.Window, x: Float, y: Float) {
    win.input(gui.Input.PointerMove(x, y)).unwrap()
    win.input(gui.Input.PointerDown(x, y)).unwrap()
    win.input(gui.Input.PointerUp(x, y)).unwrap()
}

/// Steps the app through every event queued so far, stopping at the marker `User(1)`.
fn settle(var app: pane.Running<State>, win: gui.Window, events: Stream<gui.UiEvent>) {
    win.post(1).unwrap()
    for e in events {
        match e {
            gui.UiEvent.User(n) => { return }
            _ => { app.step(e).unwrap() }
        }
    }
}

/// The x of the first button or text showing `want` on the row at `y`, or -1.
fn find(win: gui.Window, y: Float, want: String) -> Float {
    var x = 0.0
    while x < 300.0 {
        match win.hit(x, y).unwrap() {
            Some(n) => { if win.text(n).unwrap() == want { return x } }
            None => { }
        }
        x = x + 2.0
    }
    return -1.0
}

fn nav_view(s: State) -> pane.Element<State> {
    var page: pane.Element<State> = pane.text("welcome")
    if s.count == 1 { page = pane.vstack([pane.h2("Performance"), pane.text("busy")]) }
    return pane.hstack([
        nav(["Processes", "Performance", "History"], s.count, |var s, i| { s.count = i }).style(|st| st.width(gui.Size.Px(150.0))),
        page,
    ]).style(|st| st.align_items(gui.Align.Start)).grow()
}

test "a nav picks one page and the view shows that page" {
    let win = gui.headless(300, 300).unwrap()
    let state = fresh()
    var app = pane.App("Test", state, nav_view).mount(win).unwrap()
    let events = win.events()
    assert_eq(win.pixel(20, 20).unwrap(), 0x2563ebff)
    click(win, 40.0, 70.0)
    settle(app, win, events)
    assert_eq(state.count, 1)
    win.input(gui.Input.PointerMove(290.0, 290.0)).unwrap()
    win.present().unwrap()
    assert(win.pixel(20, 20).unwrap() != 0x2563ebff)
    assert_eq(win.pixel(20, 70).unwrap(), 0x2563ebff)
    assert(find(win, 60.0, "busy") > 0.0)
    assert(find(win, 26.0, "welcome") < 0.0)
}

fn tabs_view(s: State) -> pane.Element<State> {
    return pane.vstack([
        tabs(["One", "Two", "Three"], s.count, |var s, i| { s.count = i }),
        pages(10, s.count, |var s, i| { s.count = i }),
    ])
}

test "tabs and pages report the one picked" {
    let win = gui.headless(300, 300).unwrap()
    let state = fresh()
    var app = pane.App("Test", state, tabs_view).mount(win).unwrap()
    let events = win.events()
    click(win, find(win, 26.0, "Three") + 2.0, 26.0)
    settle(app, win, events)
    assert_eq(state.count, 2)
    click(win, find(win, 70.0, ">") + 2.0, 70.0)
    settle(app, win, events)
    assert_eq(state.count, 3)
    click(win, find(win, 70.0, "2") + 2.0, 70.0)
    settle(app, win, events)
    assert_eq(state.count, 1)
    click(win, find(win, 70.0, "<") + 2.0, 70.0)
    settle(app, win, events)
    assert_eq(state.count, 0)
    assert(find(win, 70.0, "10") < 0.0)
}

fn checkbox_view(s: State) -> pane.Element<State> {
    return pane.vstack([checkbox("Enabled", s.done, |var s, on| { s.done = on })])
}

test "a checkbox flips from its box or its label" {
    let win = gui.headless(300, 300).unwrap()
    let state = fresh()
    var app = pane.App("Test", state, checkbox_view).mount(win).unwrap()
    let events = win.events()
    assert(win.pixel(26, 26).unwrap() != 0x2563ebff)
    click(win, 60.0, 26.0)
    settle(app, win, events)
    assert(state.done)
    assert_eq(win.pixel(26, 26).unwrap(), 0x2563ebff)
    click(win, 26.0, 26.0)
    settle(app, win, events)
    assert(!state.done)
}

fn select_view(s: State) -> pane.Element<State> {
    return pane.vstack([
        select("color", ["red", "green", "blue"], s.count, |var s, i| { s.count = i }),
        pane.text("below"),
    ])
}

test "a select opens in place and closes on a pick" {
    let win = gui.headless(300, 300).unwrap()
    let state = fresh()
    var app = pane.App("Test", state, select_view).mount(win).unwrap()
    let events = win.events()
    assert(win.text(at(win, 30.0, 150.0)).unwrap() != "blue")
    click(win, 30.0, 26.0)
    settle(app, win, events)
    assert_eq(win.text(at(win, 30.0, 150.0)).unwrap(), "blue")
    click(win, 30.0, 150.0)
    settle(app, win, events)
    assert_eq(state.count, 2)
    assert(win.text(at(win, 30.0, 150.0)).unwrap() != "blue")
}

test "an image shows its png scaled to its box" {
    let src = gui.headless(4, 4).unwrap()
    src.set_style(src.root(), src.style(gui.style().width(gui.Size.Pct(100.0)).height(gui.Size.Pct(100.0)).background(0xff0000ff)).unwrap()).unwrap()
    src.present().unwrap()
    let png = src.png().unwrap()
    let win = gui.headless(100, 100).unwrap()
    pane.App("Image", fresh(), |s| { return pane.vstack([image(png).width(20.0).height(20.0)]) }).mount(win).unwrap()
    assert_eq(win.pixel(26, 26).unwrap(), 0xff0000ff)
    assert_eq(win.pixel(60, 60).unwrap(), 0xf4f5f7ff)
}
