import std.gui as gui
import ..src.lib as pane
import { slider } from ..src.slider
import { light, dark } from ..src.theme

class State {
    var level: Float
    var drags: List<String>
    var wheeled: Float
    var token: Int
    var dark: Bool
    var typed: String
}

fn fresh() -> State {
    return State { level: 0.5, drags: [], wheeled: 0.0, token: 0, dark: false, typed: "" }
}

fn view(s: State) -> pane.Element<State> {
    return pane.vstack([
        slider(s.level, 0.0, 10.0, |var s, v| { s.level = v }).width(200.0),
        pane.box([]).width(100.0).height(60.0).on_drag(|var s, d| {
            if d.phase == pane.Phase.Start { s.drags.push("start") }
            if d.phase == pane.Phase.Move { s.drags.push("move ${d.dx()} ${d.dy()}") }
            if d.phase == pane.Phase.End { s.drags.push("end") }
        }).on_wheel(|var s, dx, dy| { s.wheeled = s.wheeled + dy }),
        pane.input(s.typed, |var s, t| { s.typed = t }).focus(s.token),
    ])
}

fn pick_theme(s: State) -> pane.Theme {
    if s.dark { return dark() }
    return light()
}

test "a slider takes the value under the pointer on a press and while it is dragged" {
    let state = fresh()
    var app = pane.App("T", state, view).headless(300, 300).unwrap()
    app.click_at(108.0, 20.0).unwrap()
    assert_eq(state.level > 4.0 && state.level < 6.0, true)
    app.drag(20.0, 20.0, 200.0, 20.0).unwrap()
    assert_eq(state.level > 8.5, true)
    app.drag(100.0, 20.0, 2.0, 20.0).unwrap()
    assert_eq(state.level, 0.0)
}

test "a drag reports the start, each move and the end, even when the pointer leaves the element" {
    let state = fresh()
    var app = pane.App("T", state, view).headless(300, 300).unwrap()
    app.drag(20.0, 70.0, 250.0, 200.0).unwrap()
    assert_eq(state.drags, ["start", "move 230.0 130.0", "end"])
}

test "a wheel turn over an element with a wheel handler reaches it" {
    let state = fresh()
    var app = pane.App("T", state, view).headless(300, 300).unwrap()
    app.wheel(20.0, 70.0, 0.0, 30.0).unwrap()
    app.wheel(20.0, 70.0, 0.0, 12.0).unwrap()
    assert_eq(state.wheeled, 42.0)
}

test "a new focus token gives the element the keyboard focus once" {
    let state = fresh()
    var app = pane.App("T", state, view).headless(300, 300).unwrap()
    state.token = 1
    app.render().unwrap()
    app.window().input(gui.Input.Text("ab")).unwrap()
    app.press(gui.Key.Escape, gui.no_mods()).unwrap()
    assert_eq(state.typed, "ab")
}

test "the theme follows the state" {
    let state = fresh()
    var app = pane.App("T", state, view).theme_by(pick_theme).headless(300, 300).unwrap()
    let win = app.window()
    assert_eq(win.pixel(290, 290).unwrap(), 0xf4f5f7ff)
    state.dark = true
    app.render().unwrap()
    assert_eq(win.pixel(290, 290).unwrap(), 0x111827ff)
}
