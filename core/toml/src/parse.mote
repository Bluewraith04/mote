// Reading TOML text.
import { parse as parse_json } from json
import { Toml, from_tagged } from ._value
import { call } from ._call
import { toml_parse } from ._native

/// TOML text as a table; an `Err` says the line and column of the first mistake.
pub fn parse(text: String) -> Result<Toml, Error> {
    let bytes = text.bytes()
    let tagged = call(|buffer: [UInt8]| toml_parse(bytes, buffer))?
    return from_tagged(parse_json(tagged)?)
}
