// A value tree as JSON, and the encoding and decoding of Mote values through it.
import { Json, decode as decode_json, encode as encode_json } from json
import { Toml } from ._value
import { invalid } from ._call

// The JSON a value reads as: a table is an object and a date-time is text.
fn json_table(members: List<(String, Toml)>) -> Json {
    var out: List<(String, Json)> = []
    for (name, inner) in members {
        out.push((name, to_json(inner)))
    }
    return Json.Object(out)
}

fn json_array(items: List<Toml>) -> Json {
    var out: List<Json> = []
    for inner in items {
        out.push(to_json(inner))
    }
    return Json.Array(out)
}

fn to_json(value: Toml) -> Json {
    return match value {
        Toml.Table(members) => json_table(members)
        Toml.Array(items) => json_array(items)
        Toml.Text(text) => Json.Text(text)
        Toml.Integer(number) => Json.Integer(number)
        Toml.Real(number) => Json.Real(number)
        Toml.Boolean(flag) => Json.Boolean(flag)
        Toml.Datetime(text) => Json.Text(text)
    }
}

fn table_from_json(members: List<(String, Json)>, path: String) -> Result<Toml, Error> {
    var out: List<(String, Toml)> = []
    for (name, inner) in members {
        if !inner.is_null() { out.push((name, from_json(inner, path + "." + name)?)) }
    }
    return Ok(Toml.Table(out))
}

fn array_from_json(items: List<Json>, path: String) -> Result<Toml, Error> {
    var out: List<Toml> = []
    var index = 0
    for inner in items {
        out.push(from_json(inner, path + "[" + index.to_string() + "]")?)
        index = index + 1
    }
    return Ok(Toml.Array(out))
}

// The value a JSON tree is; a member that is null is left out, as TOML has no null.
fn from_json(json: Json, path: String) -> Result<Toml, Error> {
    return match json {
        Json.Object(members) => table_from_json(members, path)
        Json.Array(items) => array_from_json(items, path)
        Json.Text(text) => Ok(Toml.Text(text))
        Json.Integer(number) => Ok(Toml.Integer(number))
        Json.Real(number) => Ok(Toml.Real(number))
        Json.Boolean(flag) => Ok(Toml.Boolean(flag))
        Json.Null => Err(invalid("toml: null at ${path} cannot be written"))
    }
}

/// The value of a `T`, as `json.encode` reads it: a record is a table of its fields, an optional field that is null is left out, and a null anywhere else is an `Err`.
pub fn encode<T>(value: T) -> Result<Toml, Error> {
    return from_json(encode_json(value)?, "$")
}

/// `to_toml()` on any type that lists it.
pub trait ToToml {
    fn to_toml(self) -> Result<Toml, Error> { return encode(self) }
}

/// The `T` a table holds, as `json.decode` reads it; a date-time is read as text.
pub fn decode<T>(value: Toml) -> Result<T, Error> {
    return decode_json(to_json(value))
}

/// `T.from_toml(value)` on any type that lists it.
pub trait FromToml {
    fn from_toml(value: Toml) -> Result<Self, Error> { return decode(value) }
}
