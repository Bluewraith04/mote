import { Dyn, build, downcast } from std.meta

struct Point {
    x: Int
    y: Int
}

class Counter {
    var count: Int
    var label: String
}

enum Shape {
    Empty
    Circle(Float)
    Rect { width: Float, height: Float }
}

fn main() {
    let p: Point = build(0, [Dyn.of(5), Dyn.of(6)])
    println("${p.x} ${p.y}")
    let c: Counter = build(0, [Dyn.of(2), Dyn.of("two")])
    println("${c.count} ${c.label}")
    let t: (Int, String) = build(0, [Dyn.of(1), Dyn.of("x")])
    println("${t.0} ${t.1}")
    let empty: Shape = build(0, [])
    println(Dyn.of(empty).tag())
    let circle: Shape = build(1, [Dyn.of(2.5)])
    println(downcast<Float>(Dyn.of(circle).get(0)) ?? 0.0)
    let rect: Shape = build(2, [Dyn.of(1.0), Dyn.of(2.0)])
    println(Dyn.of(rect).tag())
    let d = Dyn.of(Point { x: 8, y: 9 })
    let again: Point = build(d.tag(), [d.get(0), d.get(1)])
    println("${again.x} ${again.y}")
}
