import { Dyn, downcast, Kind } from std.meta

struct Point {
    x: Int
    y: Int
}

class Counter {
    var count: Int
    var label: String
}

enum Shape {
    Empty
    Circle(Float)
    Rect { width: Float, height: Float }
}

fn main() {
    let d = Dyn.of(41)
    println(downcast<Int>(d) ?? 0)
    println(downcast<String>(d) == null)
    println(d.ty().kind() == Kind.Int)
    println(d.len())
    let point = Dyn.of(Point { x: 3, y: 4 })
    println(point.len())
    println(downcast<Int>(point.get(0)) ?? 0)
    println(downcast<Int>(point.get(1)) ?? 0)
    println(point.get(1).ty().name())
    let counter = Dyn.of(Counter { count: 2, label: "two" })
    println(counter.len())
    println(downcast<String>(counter.get(1)) ?? "")
    let pair = Dyn.of((1, "two"))
    println(pair.len())
    println(downcast<String>(pair.get(1)) ?? "")
    let xs = Dyn.of([10, 20, 30])
    println(xs.len())
    println(downcast<Int>(xs.get(2)) ?? 0)
    let present: Int? = 5
    let absent: Int? = null
    println(Dyn.of(present).len())
    println(downcast<Int>(Dyn.of(present).get(0)) ?? 0)
    println(Dyn.of(absent).len())
    println(Dyn.of(Shape.Empty).tag())
    let circle = Dyn.of(Shape.Circle(1.5))
    println(circle.tag())
    println(circle.len())
    println(downcast<Float>(circle.get(0)) ?? 0.0)
    let rect = Dyn.of(Shape.Rect { width: 2.0, height: 3.0 })
    println(rect.tag())
    println(downcast<Float>(rect.get(1)) ?? 0.0)
    println(downcast<Point>(point) != null)
    println(downcast<Shape>(rect) != null)
}
