import { Kind, Shape } from std.reflect

/// A point on the plane.
struct Point {
    pub var x: Int
    y: Int = 0
}

enum Shapely {
    Empty
    Circle(Float)
    Rect { width: Float, height: Float }
}

struct Pair<A, B> {
    first: A
    second: B
}

class Node {
    var value: Int
    var next: Node?
}

fn name_of<T>() -> String {
    return @type_name(T)
}

fn main() {
    println(@type_name(Int))
    println(@type_name(List<Int>))
    println(@type_info(Int?).kind == Kind.Optional)
    println(@type_info((Int, String)).kind == Kind.Tuple)
    println(@type_info(Int | String).kind == Kind.Union)
    println(@type_name(@TypeArg(List<String>, 0)))
    const point = @type_info(Point)
    println(point.name)
    println(point.doc)
    comptime for field in @fields(Point) {
        println("${field.name} ${field.type_name} ${field.is_var} ${field.is_pub} ${field.has_default}")
    }
    comptime for variant in @variants(Shapely) {
        println("${variant.name} ${variant.field_count} ${variant.shape == Shape.Named}")
    }
    println(@type_name(Pair<Int, String>))
    println(@type_name(@TypeArg(Pair<Int, String>, 1)))
    println(name_of<Point>())
    println(name_of<List<String>>())
    println(@type_info(@TypeArg(@FieldType(Node, "next"), 0)).field_count)
    println(@type_info(List<Int>).kind == Kind.List)
}
