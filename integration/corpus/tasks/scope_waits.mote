fn main() {
    println("before")
    scope {
        spawn {
            println("inside")
        }
    }
    println("after")
    var round = 0
    while round < 3 {
        round += 1
        scope {
            spawn { println("round") }
            if round == 2 {
                break
            }
        }
    }
    println(round)
}
