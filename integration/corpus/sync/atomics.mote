fn main() {
    let a = AtomicInt(10)
    println(a.load())
    a.store(3)
    println(a.swap(4))
    println(a.fetch_add(6))
    println(a.fetch_sub(1))
    println(a.compare_exchange(9, 20))
    println(a.compare_exchange(9, 30))
    println(a.load())
    let low = AtomicInt(-9223372036854775807)
    println(low.fetch_sub(1))
    println(low.load())
    let f = AtomicBool(false)
    println(f.load())
    f.store(true)
    println(f.swap(false))
    println(f.compare_exchange(false, true))
    println(f.compare_exchange(false, true))
    println(f.load())
    let sum = AtomicInt(0)
    scope {
        for i in 0..4 {
            spawn { sum.fetch_add(i + 1) }
        }
    }
    println(sum.load())
}
