fn main() {
    let hi: Int8 = 127
    let lo: Int8 = -128
    let (a, a_over) = hi.overflowing_add(1)
    println(a)
    println(a_over)
    let (b, b_over) = lo.overflowing_sub(1)
    println(b)
    println(b_over)
    let (c, c_over) = hi.overflowing_mul(2)
    println(c)
    println(c_over)
    let (d, d_over) = lo.overflowing_neg()
    println(d)
    println(d_over)
    let (e, e_over) = hi.overflowing_neg()
    println(e)
    println(e_over)
    let (f, f_over) = hi.overflowing_shl(1)
    println(f)
    println(f_over)
    let (g, g_over) = hi.overflowing_shl(8)
    println(g)
    println(g_over)
    let (h, h_over) = lo.overflowing_shr(2)
    println(h)
    println(h_over)
    let (i, i_over) = lo.overflowing_shr(-1)
    println(i)
    println(i_over)
    let top: UInt32 = 4294967295
    let (j, j_over) = top.overflowing_add(1)
    println(j)
    println(j_over)
    let (k, k_over) = top.overflowing_mul(top)
    println(k)
    println(k_over)
    let (l, l_over) = top.overflowing_neg()
    println(l)
    println(l_over)
    let big: Int = 9223372036854775807
    let (m, m_over) = big.overflowing_add(1)
    println(m)
    println(m_over)
    let (n, n_over) = big.overflowing_mul(big)
    println(n)
    println(n_over)
    let ubig: UInt64 = 18446744073709551615
    let (o, o_over) = ubig.overflowing_sub(ubig)
    println(o)
    println(o_over)
    let (p, p_over) = ubig.overflowing_shr(64)
    println(p)
    println(p_over)
}
