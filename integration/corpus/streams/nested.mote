fn count(n: Int) -> Stream<Int> {
    var i = 0
    while i < n {
        yield i
        i += 1
    }
}

fn evens(limit: Int) -> Stream<Int> {
    for x in count(limit) {
        if x % 2 == 0 {
            yield x
        }
    }
}

fn squares(limit: Int) -> Stream<Int> {
    for x in evens(limit) {
        yield x * x
    }
}

fn rows(n: Int) -> Stream<Stream<Int>> {
    for i in 0..n {
        yield count(i)
    }
}

fn forever() -> Stream<Int> {
    var i = 0
    while true {
        yield i
        i += 1
    }
}

fn early() -> Stream<Int> {
    yield 1
    yield 2
    return
}

fn main() {
    println(squares(10).collect())
    for row in rows(4) {
        var r = row
        println(r.collect())
    }
    for x in forever() {
        if x == 3 {
            break
        }
        println(x)
    }
    println(early().collect())
    var done = count(1)
    println(done.next())
    println(done.next())
    println(done.next())
}
