import { Stream } from std.collections

fn stepping(start: Int, step: Int) -> Stream<Int> {
    var at = start
    let bump = || at += step
    for _ in 0..4 {
        yield at
        bump()
    }
}

fn labelled(prefix: String, n: Int) -> Stream<String> {
    var count = 0
    let next = || {
        count += 1
        return count
    }
    while count < n {
        let k = next()
        yield "${prefix}${k}"
    }
}

fn main() {
    for x in stepping(10, 5) {
        println(x)
    }
    for s in labelled("n", 3) {
        println(s)
    }
    var a = stepping(1, 1)
    var b = stepping(100, 100)
    println(a.next()!)
    println(b.next()!)
    println(a.next()!)
    println(b.next()!)
}
