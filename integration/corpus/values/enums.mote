enum Shape {
    Circle(Int)
    Rect(Int, Int)
    Tagged { id: Int8, weight: Float }
    Empty
}

enum Light {
    Red
    Green
    Yellow

    pub fn next(self) -> Light {
        return match self {
            Red => Green
            Green => Yellow
            Yellow => Red
        }
    }
}

fn area(s: Shape) -> Int {
    return match s {
        Circle(r) => 3 * r * r
        Rect(w, h) => w * h
        Tagged { id, .. } => id as Int
        Empty => 0
    }
}

fn weight(s: Shape) -> Float {
    return match s {
        Tagged { weight, .. } => weight
        _ => 0.0
    }
}

fn code(l: Light) -> Int {
    return match l {
        Red => 1
        Green => 2
        Yellow => 3
    }
}

fn main() {
    println(area(Shape.Circle(2)))
    println(area(Shape.Rect(3, 4)))
    println(area(Shape.Tagged { id: 7, weight: 2.5 }))
    println(area(Shape.Empty))
    println(weight(Shape.Tagged { id: 1, weight: 2.5 }))
    println(weight(Shape.Empty))
    var l = Light.Red
    var i = 0
    while i < 4 {
        println(code(l))
        l = l.next()
        i += 1
    }
}
