fn main() {
    let r = 2..7
    println(r.start)
    println(r.end)
    println(r.inclusive)
    let q = 1..=3
    println(q.inclusive)
    var total = 0
    for i in 0..10 {
        total += i
    }
    println(total)
    for i in 1..=4 {
        total += i * 100
    }
    println(total)
    let n: Int8 = 5
    let small = 0..n
    println(small.end)
}
