import { sleep } from std.task

struct Res {
    var id: Int

    fn close(self) {
        sleep(5)
        println("closed ${self.id}")
    }
}

fn main() {
    let h = spawn {
        with r = Res { id: 1 } {
            sleep(1000)
            println("never")
        }
        return 1
    }
    sleep(100)
    h.cancel()
    println(h.await().is_err())
    println("end")
}
