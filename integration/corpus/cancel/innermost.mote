import { sleep } from std.task

struct Res {
    var id: Int

    fn close(self) {
        println("closed ${self.id}")
    }
}

fn main() {
    let h = spawn {
        with a = Res { id: 1 } {
            with b = Res { id: 2 } {
                with c = Res { id: 3 } {
                    sleep(1000)
                }
            }
        }
        return 1
    }
    sleep(100)
    h.cancel()
    println(h.await().is_err())
    println("end")
}
