// feed 0 10 1,1
// feed 1 20 2,2,2
// feed 0 30 1
// close 0 40
// close 1 50
import { Port, PortMode } from std.port

fn main() {
    let (first, a) = Port.open(PortMode.Queue(4))
    let (second, b) = Port.open(PortMode.Latest)
    var left = 0
    for message in a { left += message.len() as Int }
    var right = 0
    for message in b { right += message.len() as Int }
    println(left)
    println(right)
}
