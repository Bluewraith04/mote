; Object Test Program
; Allocates objects, tests field mutations, and traverses a linked object chain

.type @Vector3 id=101 fields=x,y,z
.type @Node id=102 fields=val,next

.func @main regs=24 params=0
    ; 1. Allocate Vector3 (x=10, y=20, z=30)
    NEWOBJ r0, @Vector3
    LOADI r1, 10
    LOADI r2, 20
    LOADI r3, 30
    SETFIELD r0, 0, r1    ; v.x = 10
    SETFIELD r0, 1, r2    ; v.y = 20
    SETFIELD r0, 2, r3    ; v.z = 30

    ; Read fields and compute dot / sum
    GETFIELD r4, r0, 0    ; 10
    GETFIELD r5, r0, 1    ; 20
    GETFIELD r6, r0, 2    ; 30
    ADD r7, r4, r5        ; 30
    ADD r8, r7, r6        ; 60 (r8 = 60)
    TYPEOF r9, r0         ; 101 (r9 = 101)

    ; 2. Allocate 3 linked nodes: node1(100) -> node2(200) -> node3(300)
    NEWOBJ r10, @Node     ; node1
    NEWOBJ r11, @Node     ; node2
    NEWOBJ r12, @Node     ; node3

    LOADI r13, 100
    LOADI r14, 200
    LOADI r15, 300

    SETFIELD r10, 0, r13  ; node1.val = 100
    SETFIELD r10, 1, r11  ; node1.next = node2

    SETFIELD r11, 0, r14  ; node2.val = 200
    SETFIELD r11, 1, r12  ; node2.next = node3

    SETFIELD r12, 0, r15  ; node3.val = 300
    ; node3.next is Null by default

    ; Traverse the list and accumulate sum into r16
    LOADI r16, 0          ; list_sum = 0
    MOVE r17, r10         ; curr = node1

traverse_loop:
    ; check if curr is null/empty
    TYPEOF r18, r17
    LOADI r19, -4         ; typeof gives -4 for Null
    EQ r20, r18, r19
    JMPIF r20, traverse_done

    ; accumulate val
    GETFIELD r21, r17, 0  ; val
    ADD r16, r16, r21     ; sum += val
    GETFIELD r17, r17, 1  ; curr = curr.next
    JMP traverse_loop

traverse_done:
    ; r16 should be 100 + 200 + 300 = 600
    HALT
.end
