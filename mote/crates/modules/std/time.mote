/// std.time: durations, monotonic instants and an injectable clock. Explicit import.
/// `Duration` and `Instant` are value structs with methods instead of operators. An `Instant` carries no clock; measure an interval with `Clock.since`.
/// `sleep` parks the calling task; other tasks keep running.

import { * } from std.prelude

pub struct Duration {
    var nanos: Int

    pub fn from_nanos(n: Int) -> Duration { return Duration { nanos: n } }
    pub fn from_millis(n: Int) -> Duration { return Duration { nanos: n * 1000000 } }
    pub fn from_secs(n: Int) -> Duration { return Duration { nanos: n * 1000000000 } }

    pub fn as_nanos(self) -> Int { return self.nanos }
    pub fn as_millis(self) -> Int { return self.nanos / 1000000 }
    pub fn as_secs(self) -> Int { return self.nanos / 1000000000 }

    pub fn plus(self, other: Duration) -> Duration {
        return Duration { nanos: self.nanos + other.nanos }
    }
    pub fn minus(self, other: Duration) -> Duration {
        return Duration { nanos: self.nanos - other.nanos }
    }

    /// -1, 0 or 1.
    pub fn compare(self, other: Duration) -> Int {
        if self.nanos < other.nanos { return -1 }
        if self.nanos > other.nanos { return 1 }
        return 0
    }
}

pub struct Instant {
    var nanos: Int

    pub fn duration_since(self, earlier: Instant) -> Duration {
        return Duration { nanos: self.nanos - earlier.nanos }
    }

    pub fn compare(self, other: Instant) -> Int {
        if self.nanos < other.nanos { return -1 }
        if self.nanos > other.nanos { return 1 }
        return 0
    }
}

pub class Clock {
    is_fake: Bool
    var fake_nanos: Int

    pub fn system() -> Clock { return Clock { is_fake: false, fake_nanos: 0 } }

    /// A deterministic clock starting at `start_nanos`; it only moves when
    /// `advance` is called.
    pub fn fake(start_nanos: Int) -> Clock {
        return Clock { is_fake: true, fake_nanos: start_nanos }
    }

    pub fn now(self) -> Instant {
        if self.is_fake {
            return Instant { nanos: self.fake_nanos }
        }
        return Instant { nanos: __time_now_nanos() }
    }

    pub fn since(self, earlier: Instant) -> Duration {
        return self.now().duration_since(earlier)
    }

    /// Move a fake clock forward. A system clock cannot be advanced — a no-op.
    pub fn advance(var self, d: Duration) {
        if self.is_fake {
            self.fake_nanos = self.fake_nanos + d.nanos
        }
    }
}

/// The system monotonic clock.
pub fn now() -> Instant { return Instant { nanos: __time_now_nanos() } }

/// Wall-clock milliseconds since the Unix epoch.
pub fn unix_millis() -> Int { return __time_unix_millis() }

pub fn sleep(d: Duration) { __time_sleep_nanos(d.nanos) }

/// A `Receiver` that receives 1, 2, 3,... once per `period`; the timer runs until the program ends.
pub fn ticker(period: Duration) -> Receiver<Int> { return __time_ticker(period.nanos) }
