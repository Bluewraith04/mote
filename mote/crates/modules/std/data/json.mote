/// std.data.json — JSON as a value tree. Explicit import, not in the prelude.
///
/// Reading and printing are free functions: `json.get(v, "k")`, `json.to_text(v)`. `Array` holds a
/// `List` of `Json`; `Object` holds a `List` of `Member`, in input order, duplicates kept.
/// `@derive(Json)` writes `to_json` and `from_json` for a type; it calls the `__` functions.

import { * } from std.prelude
import { is_finite, to_float } from std.math
import { join, parse_int, parse_float } from std.string

pub enum Json {
    Null
    Bool(Bool)
    Int(Int)
    Float(Float)
    Str(String)
    Array(List<Json>)
    Object(List<Member>)
}

/// One `"key": value` pair of an object.
pub class Member {
    pub key: String
    pub value: Json
}

pub fn member(key: String, value: Json) -> Member {
    return Member { key: key, value: value }
}

pub fn is_null(j: Json) -> Bool {
    match j {
        Json.Null => { return true }
        _ => { return false }
    }
}

pub fn as_bool(j: Json) -> Option<Bool> {
    match j {
        Json.Bool(b) => { return Some(b) }
        _ => { return None }
    }
}

pub fn as_int(j: Json) -> Option<Int> {
    match j {
        Json.Int(n) => { return Some(n) }
        _ => { return None }
    }
}

/// A `Float`, or an `Int` read as one.
pub fn as_float(j: Json) -> Option<Float> {
    match j {
        Json.Float(f) => { return Some(f) }
        Json.Int(n) => { return Some(to_float(n)) }
        _ => { return None }
    }
}

pub fn as_str(j: Json) -> Option<String> {
    match j {
        Json.Str(s) => { return Some(s) }
        _ => { return None }
    }
}

/// The elements of an array, as a `List` of `Json`.
pub fn as_array(j: Json) -> Option<List<Json>> {
    match j {
        Json.Array(items) => { return Some(items) }
        _ => { return None }
    }
}

/// The members of an object, as a `List` of `Member`.
pub fn as_object(j: Json) -> Option<List<Member>> {
    match j {
        Json.Object(members) => { return Some(members) }
        _ => { return None }
    }
}

/// The value of the last member named `key`; `None` if `j` is not an object or has no such member.
pub fn get(j: Json, key: String) -> Option<Json> {
    match j {
        Json.Object(members) => {
            let ms = members
            var i = ms.len() - 1
            while i >= 0 {
                let m: Member = ms.get(i)
                if m.key == key { return Some(m.value) }
                i = i - 1
            }
            return None
        }
        _ => { return None }
    }
}

/// Element `index` of an array; `None` if `j` is not an array or the index is out of range.
pub fn at(j: Json, index: Int) -> Option<Json> {
    match j {
        Json.Array(items) => {
            let xs = items
            if index < 0 || index >= xs.len() { return None }
            return Some(xs.get(index))
        }
        _ => { return None }
    }
}

fn kind_of(j: Json) -> String {
    match j {
        Json.Null => { return "null" }
        Json.Bool(b) => { return "a bool" }
        Json.Int(n) => { return "an int" }
        Json.Float(f) => { return "a float" }
        Json.Str(s) => { return "a string" }
        Json.Array(xs) => { return "an array" }
        Json.Object(ms) => { return "an object" }
    }
}

fn invalid(message: String) -> Error {
    return Error.new(ErrorKind.InvalidData, message)
}

pub fn __wrong(want: String, j: Json) -> Error {
    return invalid("expected ${want}, found ${kind_of(j)}")
}

pub fn __bool(j: Json) -> Result<Bool, Error> {
    match j {
        Json.Bool(b) => { return Ok(b) }
        _ => { return Err(__wrong("a bool", j)) }
    }
}

pub fn __int(j: Json) -> Result<Int, Error> {
    match j {
        Json.Int(n) => { return Ok(n) }
        _ => { return Err(__wrong("an int", j)) }
    }
}

pub fn __float(j: Json) -> Result<Float, Error> {
    match j {
        Json.Float(f) => { return Ok(f) }
        Json.Int(n) => { return Ok(to_float(n)) }
        _ => { return Err(__wrong("a float", j)) }
    }
}

pub fn __str(j: Json) -> Result<String, Error> {
    match j {
        Json.Str(s) => { return Ok(s) }
        _ => { return Err(__wrong("a string", j)) }
    }
}

/// The value of `key` in an object; an error if `j` is not an object or has no such key.
pub fn __field(j: Json, key: String) -> Result<Json, Error> {
    match get(j, key) {
        Some(v) => { return Ok(v) }
        None => {
            if as_object(j).is_none() { return Err(__wrong("an object", j)) }
            return Err(invalid("missing field \"${key}\""))
        }
    }
}

/// The value of `key`, or `null` when the key is missing; an error if `j` is not an object.
pub fn __field_or_null(j: Json, key: String) -> Result<Json, Error> {
    match get(j, key) {
        Some(v) => { return Ok(v) }
        None => {
            if as_object(j).is_none() { return Err(__wrong("an object", j)) }
            return Ok(Json.Null)
        }
    }
}

/// Puts `key` in front of the path an error already carries (`zip:...` becomes `home.zip:...`).
pub fn __in<T>(key: String, r: Result<T, Error>) -> Result<T, Error> {
    match r {
        Ok(v) => { return Ok(v) }
        Err(e) => {
            if !e.message.contains(": ") { return Err(Error.new(e.kind, "${key}: ${e.message}")) }
            if e.message.starts_with("[") { return Err(Error.new(e.kind, "${key}${e.message}")) }
            return Err(Error.new(e.kind, "${key}.${e.message}"))
        }
    }
}

pub fn __list<T>(j: Json, f: (Json) -> Result<T, Error>) -> Result<List<T>, Error> {
    match j {
        Json.Array(items) => {
            var out: List<T> = []
            var i = 0
            for x in items {
                out.push(__in("[${i}]", f(x))?)
                i = i + 1
            }
            return Ok(out)
        }
        _ => { return Err(__wrong("an array", j)) }
    }
}

pub fn __set<T>(j: Json, f: (Json) -> Result<T, Error>) -> Result<Set<T>, Error> {
    var out: Set<T> = Set()
    let items = __list(j, f)?
    for x in items { out.add(x) }
    return Ok(out)
}

pub fn __map<T>(j: Json, f: (Json) -> Result<T, Error>) -> Result<Map<String, T>, Error> {
    match j {
        Json.Object(members) => {
            var out: Map<String, T> = {}
            for m in members {
                out.set(m.key, __in(m.key, f(m.value))?)
            }
            return Ok(out)
        }
        _ => { return Err(__wrong("an object", j)) }
    }
}

pub fn __nullable<T>(j: Json, f: (Json) -> Result<T, Error>) -> Result<T?, Error> {
    match j {
        Json.Null => { return Ok(null) }
        _ => { return Ok(f(j)?) }
    }
}

/// The items of an array of exactly `n` elements.
pub fn __elements(j: Json, n: Int) -> Result<List<Json>, Error> {
    match j {
        Json.Array(xs) => {
            if xs.len() != n { return Err(invalid("expected an array of ${n}, found ${xs.len()}")) }
            return Ok(xs)
        }
        _ => { return Err(__wrong("an array", j)) }
    }
}

/// The one member of an object that names an enum variant.
pub fn __variant(j: Json) -> Result<Member, Error> {
    match j {
        Json.Object(ms) => {
            if ms.len() != 1 { return Err(invalid("expected an object with one key, found ${ms.len()}")) }
            return Ok(ms.get(0))
        }
        _ => { return Err(__wrong("a string or an object", j)) }
    }
}

pub fn __unknown_variant(name: String, owner: String) -> Error {
    return invalid("unknown variant \"${name}\" of ${owner}")
}

pub fn __to_list<T>(xs: List<T>, f: (T) -> Json) -> Json {
    var out: List<Json> = []
    for x in xs { out.push(f(x)) }
    return Json.Array(out)
}

pub fn __to_map<T>(m: Map<String, T>, f: (T) -> Json) -> Json {
    var out: List<Member> = []
    for k in m.keys() { out.push(member(k, f(m.get(k)))) }
    return Json.Object(out)
}

pub fn __to_nullable<T>(x: T?, f: (T) -> Json) -> Json {
    match x {
        Some(v) => { return f(v) }
        None => { return Json.Null }
    }
}

fn hex_digit(n: Int) -> String {
    return "0123456789abcdef".slice(n, n + 1)
}

fn escape(c: Int) -> String {
    if c == 34 { return "\\\"" }
    if c == 92 { return "\\\\" }
    if c == 8 { return "\\b" }
    if c == 9 { return "\\t" }
    if c == 10 { return "\\n" }
    if c == 12 { return "\\f" }
    if c == 13 { return "\\r" }
    return "\\u00" + hex_digit(c / 16) + hex_digit(c % 16)
}

fn quote(s: String) -> String {
    let b = s.bytes()
    var out = "\""
    var start = 0
    var i = 0
    while i < b.len() {
        let c = b.get(i)
        if c == 34 || c == 92 || c < 32 {
            out = out + s.slice(start, i) + escape(c)
            start = i + 1
        }
        i = i + 1
    }
    return out + s.slice(start, b.len()) + "\""
}

fn float_text(f: Float) -> String {
    let text = f.to_string()
    if text.contains(".") || text.contains("e") || text.contains("E") { return text }
    return text + ".0"
}

fn emit(j: Json, indent: Int, level: Int, var out: List<String>) -> Bool {
    match j {
        Json.Null => { out.push("null") }
        Json.Bool(b) => { out.push(b.to_string()) }
        Json.Int(n) => { out.push(n.to_string()) }
        Json.Float(f) => {
            if !is_finite(f) { return false }
            out.push(float_text(f))
        }
        Json.Str(s) => { out.push(quote(s)) }
        Json.Array(items) => {
            let xs = items
            if xs.len() == 0 {
                out.push("[]")
                return true
            }
            out.push("[")
            var i = 0
            while i < xs.len() {
                if i > 0 { out.push(",") }
                if indent >= 0 { out.push("\n" + " ".repeat(indent * (level + 1))) }
                let e: Json = xs.get(i)
                if !emit(e, indent, level + 1, out) { return false }
                i = i + 1
            }
            if indent >= 0 { out.push("\n" + " ".repeat(indent * level)) }
            out.push("]")
        }
        Json.Object(members) => {
            let ms = members
            if ms.len() == 0 {
                out.push("{}")
                return true
            }
            out.push("{")
            var i = 0
            while i < ms.len() {
                if i > 0 { out.push(",") }
                if indent >= 0 { out.push("\n" + " ".repeat(indent * (level + 1))) }
                let m: Member = ms.get(i)
                out.push(quote(m.key))
                if indent >= 0 { out.push(": ") } else { out.push(":") }
                if !emit(m.value, indent, level + 1, out) { return false }
                i = i + 1
            }
            if indent >= 0 { out.push("\n" + " ".repeat(indent * level)) }
            out.push("}")
        }
    }
    return true
}

fn render(j: Json, indent: Int) -> Result<String, Error> {
    var out: List<String> = []
    if !emit(j, indent, 0, out) {
        return Err(Error.new(ErrorKind.InvalidData, "NaN and infinity have no JSON form"))
    }
    return Ok(join(out, ""))
}

/// Compact JSON text; `Err` if a `Float` is `NaN` or infinite.
pub fn to_text(j: Json) -> Result<String, Error> {
    return render(j, -1)
}

/// JSON text with each element on its own line, `indent` spaces per level.
pub fn pretty(j: Json, indent: Int) -> Result<String, Error> {
    return render(j, indent)
}

class Parser {
    text: String
    bytes: Bytes
    var pos: Int
    var depth: Int
    var error: String
}

fn fail(var p: Parser, message: String) -> Json {
    if p.error != "" { return Json.Null }
    var line = 1
    var col = 1
    var i = 0
    while i < p.pos && i < p.bytes.len() {
        if p.bytes.get(i) == 10 {
            line = line + 1
            col = 1
        } else {
            col = col + 1
        }
        i = i + 1
    }
    p.error = message + " at line " + line.to_string() + " column " + col.to_string()
    return Json.Null
}

fn skip_ws(var p: Parser) {
    while p.pos < p.bytes.len() {
        let c = p.bytes.get(p.pos)
        if c != 32 && c != 9 && c != 10 && c != 13 { return }
        p.pos = p.pos + 1
    }
}

fn is_digit(c: Int) -> Bool {
    return c >= 48 && c <= 57
}

fn hex_value(c: Int) -> Int {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }
    if c >= 65 && c <= 70 { return c - 55 }
    return -1
}

fn hex4(var p: Parser) -> Int {
    var n = 0
    var i = 0
    while i < 4 {
        if p.pos >= p.bytes.len() {
            fail(p, "unfinished \\u escape")
            return -1
        }
        let h = hex_value(p.bytes.get(p.pos))
        if h < 0 {
            fail(p, "bad hex digit in \\u escape")
            return -1
        }
        n = n * 16 + h
        p.pos = p.pos + 1
        i = i + 1
    }
    return n
}

fn code_point_text(cp: Int) -> String {
    let b = Bytes()
    if cp < 128 {
        b.push(cp)
    } else if cp < 2048 {
        b.push(192 + cp / 64)
        b.push(128 + cp % 64)
    } else if cp < 65536 {
        b.push(224 + cp / 4096)
        b.push(128 + (cp / 64) % 64)
        b.push(128 + cp % 64)
    } else {
        b.push(240 + cp / 262144)
        b.push(128 + (cp / 4096) % 64)
        b.push(128 + (cp / 64) % 64)
        b.push(128 + cp % 64)
    }
    return b.decode().unwrap()
}

fn unicode_escape(var p: Parser) -> Int {
    let first = hex4(p)
    if first < 0 { return -1 }
    if first >= 56320 && first <= 57343 {
        fail(p, "lone low surrogate")
        return -1
    }
    if first < 55296 || first > 56319 { return first }
    if p.pos + 1 >= p.bytes.len() || p.bytes.get(p.pos) != 92 || p.bytes.get(p.pos + 1) != 117 {
        fail(p, "lone high surrogate")
        return -1
    }
    p.pos = p.pos + 2
    let second = hex4(p)
    if second < 0 { return -1 }
    if second < 56320 || second > 57343 {
        fail(p, "high surrogate not followed by a low surrogate")
        return -1
    }
    return 65536 + (first - 55296) * 1024 + (second - 56320)
}

fn parse_string_body(var p: Parser) -> String {
    let pieces: List<String> = []
    var start = p.pos
    while true {
        if p.pos >= p.bytes.len() {
            fail(p, "unterminated string")
            return ""
        }
        let c = p.bytes.get(p.pos)
        if c == 34 {
            pieces.push(p.text.slice(start, p.pos))
            p.pos = p.pos + 1
            return join(pieces, "")
        }
        if c < 32 {
            fail(p, "control character in string")
            return ""
        }
        if c != 92 {
            p.pos = p.pos + 1
            continue
        }
        pieces.push(p.text.slice(start, p.pos))
        p.pos = p.pos + 1
        if p.pos >= p.bytes.len() {
            fail(p, "unterminated string")
            return ""
        }
        let e = p.bytes.get(p.pos)
        p.pos = p.pos + 1
        if e == 34 { pieces.push("\"") }
        else if e == 92 { pieces.push("\\") }
        else if e == 47 { pieces.push("/") }
        else if e == 98 { pieces.push(code_point_text(8)) }
        else if e == 102 { pieces.push(code_point_text(12)) }
        else if e == 110 { pieces.push("\n") }
        else if e == 114 { pieces.push("\r") }
        else if e == 116 { pieces.push("\t") }
        else if e == 117 {
            let cp = unicode_escape(p)
            if cp < 0 { return "" }
            pieces.push(code_point_text(cp))
        } else {
            p.pos = p.pos - 1
            fail(p, "bad escape")
            return ""
        }
        start = p.pos
    }
    return ""
}

fn parse_number(var p: Parser) -> Json {
    let start = p.pos
    if p.bytes.get(p.pos) == 45 { p.pos = p.pos + 1 }
    if p.pos >= p.bytes.len() || !is_digit(p.bytes.get(p.pos)) { return fail(p, "a number needs a digit") }
    if p.bytes.get(p.pos) == 48 {
        p.pos = p.pos + 1
        if p.pos < p.bytes.len() && is_digit(p.bytes.get(p.pos)) { return fail(p, "a number has a leading zero") }
    } else {
        while p.pos < p.bytes.len() && is_digit(p.bytes.get(p.pos)) { p.pos = p.pos + 1 }
    }
    var whole = true
    if p.pos < p.bytes.len() && p.bytes.get(p.pos) == 46 {
        whole = false
        p.pos = p.pos + 1
        if p.pos >= p.bytes.len() || !is_digit(p.bytes.get(p.pos)) { return fail(p, "a fraction needs a digit") }
        while p.pos < p.bytes.len() && is_digit(p.bytes.get(p.pos)) { p.pos = p.pos + 1 }
    }
    if p.pos < p.bytes.len() && (p.bytes.get(p.pos) == 101 || p.bytes.get(p.pos) == 69) {
        whole = false
        p.pos = p.pos + 1
        if p.pos < p.bytes.len() && (p.bytes.get(p.pos) == 43 || p.bytes.get(p.pos) == 45) { p.pos = p.pos + 1 }
        if p.pos >= p.bytes.len() || !is_digit(p.bytes.get(p.pos)) { return fail(p, "an exponent needs a digit") }
        while p.pos < p.bytes.len() && is_digit(p.bytes.get(p.pos)) { p.pos = p.pos + 1 }
    }
    let text = p.text.slice(start, p.pos)
    if whole {
        match parse_int(text) {
            Ok(n) => { return Json.Int(n) }
            Err(e) => {}
        }
    }
    match parse_float(text) {
        Ok(f) => { return Json.Float(f) }
        Err(e) => {
            p.pos = start
            return fail(p, "number out of range")
        }
    }
}

fn parse_literal(var p: Parser, word: String, value: Json) -> Json {
    if p.pos + word.len() > p.bytes.len() || p.text.slice(p.pos, p.pos + word.len()) != word {
        return fail(p, "unexpected character")
    }
    p.pos = p.pos + word.len()
    return value
}

fn parse_array(var p: Parser) -> Json {
    p.pos = p.pos + 1
    p.depth = p.depth + 1
    if p.depth > 256 { return fail(p, "nesting is too deep") }
    let items: List<Json> = []
    skip_ws(p)
    if p.pos < p.bytes.len() && p.bytes.get(p.pos) == 93 {
        p.pos = p.pos + 1
        p.depth = p.depth - 1
        return Json.Array(items)
    }
    while true {
        items.push(parse_value(p))
        if p.error != "" { return Json.Null }
        skip_ws(p)
        if p.pos >= p.bytes.len() { return fail(p, "unterminated array") }
        let c = p.bytes.get(p.pos)
        p.pos = p.pos + 1
        if c == 93 { break }
        if c != 44 {
            p.pos = p.pos - 1
            return fail(p, "expected ',' or ']'")
        }
    }
    p.depth = p.depth - 1
    return Json.Array(items)
}

fn parse_object(var p: Parser) -> Json {
    p.pos = p.pos + 1
    p.depth = p.depth + 1
    if p.depth > 256 { return fail(p, "nesting is too deep") }
    let members: List<Member> = []
    skip_ws(p)
    if p.pos < p.bytes.len() && p.bytes.get(p.pos) == 125 {
        p.pos = p.pos + 1
        p.depth = p.depth - 1
        return Json.Object(members)
    }
    while true {
        skip_ws(p)
        if p.pos >= p.bytes.len() { return fail(p, "unterminated object") }
        if p.bytes.get(p.pos) != 34 { return fail(p, "expected a string key") }
        p.pos = p.pos + 1
        let key = parse_string_body(p)
        if p.error != "" { return Json.Null }
        skip_ws(p)
        if p.pos >= p.bytes.len() || p.bytes.get(p.pos) != 58 { return fail(p, "expected ':'") }
        p.pos = p.pos + 1
        let value = parse_value(p)
        if p.error != "" { return Json.Null }
        members.push(Member { key: key, value: value })
        skip_ws(p)
        if p.pos >= p.bytes.len() { return fail(p, "unterminated object") }
        let c = p.bytes.get(p.pos)
        p.pos = p.pos + 1
        if c == 125 { break }
        if c != 44 {
            p.pos = p.pos - 1
            return fail(p, "expected ',' or '}'")
        }
    }
    p.depth = p.depth - 1
    return Json.Object(members)
}

fn parse_value(var p: Parser) -> Json {
    skip_ws(p)
    if p.pos >= p.bytes.len() { return fail(p, "unexpected end of text") }
    let c = p.bytes.get(p.pos)
    if c == 123 { return parse_object(p) }
    if c == 91 { return parse_array(p) }
    if c == 34 {
        p.pos = p.pos + 1
        let s = parse_string_body(p)
        if p.error != "" { return Json.Null }
        return Json.Str(s)
    }
    if c == 116 { return parse_literal(p, "true", Json.Bool(true)) }
    if c == 102 { return parse_literal(p, "false", Json.Bool(false)) }
    if c == 110 { return parse_literal(p, "null", Json.Null) }
    if c == 45 || is_digit(c) { return parse_number(p) }
    return fail(p, "unexpected character")
}

/// Parses one JSON document; whitespace around it is fine, anything else after it is an `Err` naming the line and column.
pub fn parse(text: String) -> Result<Json, Error> {
    var p = Parser { text: text, bytes: text.bytes(), pos: 0, depth: 0, error: "" }
    let value = parse_value(p)
    if p.error == "" {
        skip_ws(p)
        if p.pos < p.bytes.len() { fail(p, "unexpected text after the document") }
    }
    if p.error != "" { return Err(Error.new(ErrorKind.InvalidData, p.error)) }
    return Ok(value)
}
