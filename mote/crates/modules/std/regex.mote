/// std.regex: regular expressions over Unicode code points.

import { * } from std.prelude
import { join } from std.string

/// One match with byte offsets into the matched text.
pub class Match {
    pub start: Int
    pub end: Int
    pub text: String
}

fn make_match(text: String, start: Int, end: Int) -> Match {
    return Match { start: start, end: end, text: text.slice(start, end) }
}

/// A successful match's capture groups.
pub class Captures {
    groups: List<Match?>
    names: List<String>

    pub fn get(self, i: Int) -> Option<Match> {
        if i < 0 || i >= self.groups.len() { return None }
        return self.groups.get(i)
    }

    /// The group named `name`, or `None` if there is none.
    pub fn get_named(self, name: String) -> Option<Match> {
        var i = 1
        while i < self.names.len() {
            if self.names.get(i) == name { return self.groups.get(i) }
            i = i + 1
        }
        return None
    }

    pub fn len(self) -> Int {
        return self.groups.len()
    }
}

fn make_captures(names: List<String>, text: String, flat: List<Int>) -> Captures {
    let groups: List<Match?> = []
    var i = 0
    while i < flat.len() {
        let s = flat.get(i)
        let e = flat.get(i + 1)
        if s >= 0 && e >= 0 {
            groups.push(Some(make_match(text, s, e)))
        } else {
            groups.push(None)
        }
        i = i + 2
    }
    return Captures { groups: groups, names: names }
}

/// A compiled pattern.
pub class Regex {
    pattern: String
    names: List<String>

    /// Compiles `pattern`.
    pub fn compile(pattern: String) -> Result<Regex, Error> {
        let names = __regex_compile(pattern)?
        return Ok(Regex { pattern: pattern, names: names })
    }

    pub fn is_match(self, text: String) -> Bool {
        return __regex_is_match(self.pattern, text)
    }

    /// The leftmost match, if any.
    pub fn find(self, text: String) -> Option<Match> {
        return self.find_from(text, 0)
    }

    /// The leftmost match that starts at byte offset `start` or later.
    pub fn find_from(self, text: String, start: Int) -> Option<Match> {
        let flat = __regex_find_at(self.pattern, text, start)
        if flat.is_empty() { return None }
        return Some(make_match(text, flat.get(0), flat.get(1)))
    }

    /// The leftmost match's capture groups, if any.
    pub fn captures(self, text: String) -> Option<Captures> {
        let flat = __regex_captures_at(self.pattern, text, 0)
        if flat.is_empty() { return None }
        return Some(make_captures(self.names, text, flat))
    }

    /// Every non-overlapping match, left to right.
    pub fn find_all(self, text: String) -> List<Match> {
        let flat = __regex_find_all(self.pattern, text)
        let out: List<Match> = []
        var i = 0
        while i < flat.len() {
            out.push(make_match(text, flat.get(i), flat.get(i + 1)))
            i = i + 2
        }
        return out
    }

    /// `text` cut around every match.
    pub fn split(self, text: String) -> List<String> {
        let flat = __regex_find_all(self.pattern, text)
        let parts: List<String> = []
        var last = 0
        var i = 0
        while i < flat.len() {
            parts.push(text.slice(last, flat.get(i)))
            last = flat.get(i + 1)
            i = i + 2
        }
        parts.push(text.slice(last, text.len()))
        return parts
    }

    /// Every match replaced with the literal `replacement`.
    pub fn replace_all(self, text: String, replacement: String) -> String {
        return join(self.split(text), replacement)
    }
}
