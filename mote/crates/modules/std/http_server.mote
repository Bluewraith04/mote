/// std.http_server: an HTTP/1.1 server over platform sockets.

import { * } from std.prelude
import std.json as jsonlib
import { Json } from std.json
import { Identity } from std.tls
import { Stream } from std.stream

class Socket {
    id: Int
}

fn owned_socket(id: Int) -> Socket {
    let s = Socket { id: id }
    __release_on_collect(s, 2)
    return s
}

fn with_header(items: List<String>, name: String, value: String) -> List<String> {
    let lower = name.to_lower()
    var out: List<String> = []
    var i = 0
    while i < items.len() {
        let have: String = items.get(i)
        if have != lower {
            out.push(have)
            let kept: String = items.get(i + 1)
            out.push(kept)
        }
        i = i + 2
    }
    out.push(lower)
    out.push(value)
    return out
}

fn is_token(s: String) -> Bool {
    let b = s.bytes()
    if b.len() == 0 { return false }
    var i = 0
    while i < b.len() {
        let c: Int = b.get(i)
        let ok = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || "!#$%&'*+-.^_`|~".bytes().contains(c)
        if !ok { return false }
        i = i + 1
    }
    return true
}

/// A reply to send with `Request.respond`.
pub class Response {
    pub status: Int
    headers: List<String>
    pub body: Bytes
    failure: String
    chunks: Stream<Bytes>?

    /// A reply whose body is the pieces of `chunks`, pulled as they are sent.
    pub fn stream(status: Int, chunks: Stream<Bytes>) -> Response {
        let none: List<String> = []
        return Response { status: status, headers: none, body: Bytes(), failure: "", chunks: Some(chunks) }
    }

    /// A reply with a status and a body.
    pub fn new(status: Int, body: Bytes) -> Response {
        let none: List<String> = []
        return Response { status: status, headers: none, body: body, failure: "", chunks: None }
    }

    /// A reply with no body.
    pub fn empty(status: Int) -> Response {
        let none: List<String> = []
        return Response { status: status, headers: none, body: Bytes(), failure: "", chunks: None }
    }

    /// A UTF-8 text body with a `text/plain` content type.
    pub fn text(status: Int, content: String) -> Response {
        let none: List<String> = []
        return Response { status: status, headers: with_header(none, "content-type", "text/plain; charset=utf-8"), body: content.bytes(), failure: "", chunks: None }
    }

    /// A JSON body with a JSON content type.
    pub fn json(status: Int, value: Json) -> Response {
        let none: List<String> = []
        match jsonlib.to_text(value) {
            Ok(t) => { return Response { status: status, headers: with_header(none, "content-type", "application/json"), body: t.bytes(), failure: "", chunks: None } }
            Err(e) => { return Response { status: status, headers: none, body: Bytes(), failure: e.message, chunks: None } }
        }
    }

    /// Sets a header, replacing one of the same name.
    pub fn header(self, name: String, value: String) -> Response {
        return Response { status: self.status, headers: with_header(self.headers, name, value), body: self.body, failure: self.failure, chunks: self.chunks }
    }

    /// The headers set so far as a flat list of names and values.
    pub fn header_list(self) -> List<String> {
        return self.headers
    }

    /// The whole body of the reply, reading a stream to its end.
    pub fn collect(self) -> Result<Bytes, Error> {
        if self.failure != "" { return Err(Error.new(ErrorKind.InvalidData, self.failure)) }
        match self.chunks {
            Some(chunks) => {
                let out = Bytes()
                while true {
                    match chunks.next() {
                        Some(piece) => {
                            let b: Bytes = piece
                            out.extend(b)
                        }
                        None => { break }
                    }
                }
                return Ok(out)
            }
            None => { return Ok(self.body) }
        }
    }
}

/// A connection after `Request.upgrade`, carrying raw bytes both ways.
pub class Upgraded {
    sock: Socket

    /// Waits for data and answers up to `max` bytes.
    pub fn read(self, max: Int) -> Result<Bytes, Error> {
        return __net_read(self.sock.id, max)
    }

    /// Writes all of `b`.
    pub fn write(self, b: Bytes) -> Result<Null, Error> {
        return __net_write(self.sock.id, b)
    }

    /// Closes the connection.
    pub fn close(self) -> Result<Null, Error> {
        return __net_close(self.sock.id)
    }
}

/// A request whose head and whole body have arrived.
pub class Request {
    pub method: String
    /// The target as sent.
    pub target: String
    /// The target's path, percent-decoded.
    pub path: String
    pub body: Bytes
    headers: List<String>
    sock: Socket
    keep_alive: Bool
    lead: Bytes
    length: Int
    taken: Shared<Int>
    idle_millis: Int
    rest: Bytes
    answered: Shared<Bool>

    /// A request that came from no connection, for tests.
    pub fn detached(method: String, target: String, headers: List<String>, body: Bytes) -> Request {
        var raw = target
        match raw.find("?") {
            Some(q) => { raw = raw.slice(0, q) }
            None => {}
        }
        var lowered: List<String> = []
        var i = 0
        while i + 1 < headers.len() {
            let name: String = headers.get(i)
            let value: String = headers.get(i + 1)
            lowered.push(name.to_lower())
            lowered.push(value)
            i = i + 2
        }
        return Request {
            method: method, target: target, path: __percent_decode(raw), body: body, headers: lowered, sock: Socket { id: -1 }, keep_alive: true,
            lead: body, length: body.len(), taken: Shared(0), idle_millis: 0, rest: Bytes(), answered: Shared(false),
        }
    }

    /// Answers 101 with `headers` and hands the raw connection over.
    pub fn upgrade(self, headers: List<String>) -> Result<(Upgraded, Bytes), Error> {
        if self.answered.get() { return Err(Error.new(ErrorKind.InvalidData, "the request was already answered")) }
        var head = "HTTP/1.1 101 Switching Protocols\r\n"
        var i = 0
        while i + 1 < headers.len() {
            let name: String = headers.get(i)
            let value: String = headers.get(i + 1)
            if !is_token(name) || value.contains("\r") || value.contains("\n") {
                return Err(Error.new(ErrorKind.InvalidData, "bad header ${name}"))
            }
            head = head + name + ": " + value + "\r\n"
            i = i + 2
        }
        self.answered.set(true)
        __net_write(self.sock.id, (head + "\r\n").bytes())?
        return Ok((Upgraded { sock: self.sock }, self.rest))
    }

    /// The next piece of the body, at most `max` bytes.
    pub fn read_body(self, max: Int) -> Result<Bytes, Error> {
        let done = self.taken.get()
        if done >= self.length { return Ok(Bytes()) }
        var piece = Bytes()
        if done < self.lead.len() {
            var upto = done + max
            if upto > self.lead.len() { upto = self.lead.len() }
            piece = self.lead.slice(done, upto)
        } else {
            var want = self.length - done
            if want > max { want = max }
            let got = __net_read_for(self.sock.id, want, self.idle_millis)?
            piece = got
            if piece.len() == 0 { return Err(Error.new(ErrorKind.InvalidData, "the connection closed in the middle of the body")) }
        }
        self.taken.update(|v| { v += piece.len() })
        return Ok(piece)
    }

    /// The body as pieces of at most 64 KiB.
    pub fn body_stream(self) -> Stream<Result<Bytes, Error>> {
        while true {
            match self.read_body(65536) {
                Ok(piece) => {
                    let p: Bytes = piece
                    if p.len() == 0 { return }
                    yield Ok(p)
                }
                Err(e) => {
                    yield Err(e)
                    return
                }
            }
        }
    }

    /// The first header called `name`, if there is one.
    pub fn header(self, name: String) -> Option<String> {
        let want = name.to_lower()
        var i = 0
        while i < self.headers.len() {
            let have: String = self.headers.get(i)
            if have == want {
                let value: String = self.headers.get(i + 1)
                return Some(value)
            }
            i = i + 2
        }
        return None
    }

    /// Every header by lowercase name.
    pub fn header_map(self) -> Map<String, String> {
        var out: Map<String, String> = Map()
        var i = 0
        while i < self.headers.len() {
            let name: String = self.headers.get(i)
            let value: String = self.headers.get(i + 1)
            if out.contains_key(name) {
                let before: String = out[name]
                out[name] = before + ", " + value
            } else {
                out[name] = value
            }
            i = i + 2
        }
        return out
    }

    /// The query parameters, percent-decoded.
    pub fn query(self) -> Map<String, String> {
        match self.target.find("?") {
            Some(i) => { return pairs(self.target.slice(i + 1, self.target.len())) }
            None => { return Map() }
        }
    }

    /// The body as text.
    pub fn text(self) -> Result<String, Error> {
        match self.body.decode() {
            Some(t) => { return Ok(t) }
            None => { return Err(Error.new(ErrorKind.InvalidData, "the request body is not UTF-8")) }
        }
    }

    /// The body parsed as JSON.
    pub fn json(self) -> Result<Json, Error> {
        let t = self.text()?
        return jsonlib.parse(t)
    }

    /// The body read as a form.
    pub fn form(self) -> Result<Map<String, String>, Error> {
        let t = self.text()?
        return Ok(pairs(t))
    }

    /// Sends the reply, then closes the connection unless it stays open.
    pub fn respond(self, reply: Response) -> Result<Null, Error> {
        if self.answered.get() { return Err(Error.new(ErrorKind.InvalidData, "the request was already answered")) }
        if reply.failure != "" { return Err(Error.new(ErrorKind.InvalidData, reply.failure)) }
        if reply.status < 100 || reply.status > 999 {
            return Err(Error.new(ErrorKind.InvalidData, "bad status ${reply.status}"))
        }
        var head = "HTTP/1.1 ${reply.status} ${__http_reason(reply.status)}\r\n"
        var dated = false
        var declared = ""
        var i = 0
        while i < reply.headers.len() {
            let name: String = reply.headers.get(i)
            let value: String = reply.headers.get(i + 1)
            if !is_token(name) || value.contains("\r") || value.contains("\n") {
                return Err(Error.new(ErrorKind.InvalidData, "bad header ${name}"))
            }
            if name == "date" { dated = true }
            if name == "content-length" { declared = value }
            if name != "content-length" && name != "transfer-encoding" && name != "connection" {
                head = head + name + ": " + value + "\r\n"
            }
            i = i + 2
        }
        if !dated { head = head + "date: " + __http_date() + "\r\n" }
        let bodiless = reply.status < 200 || reply.status == 204 || reply.status == 304
        self.answered.set(true)
        match reply.chunks {
            Some(chunks) => { return self.respond_stream(head, bodiless, chunks, declared) }
            None => { }
        }
        if !bodiless { head = head + "content-length: ${reply.body.len()}\r\n" }
        if !self.keep_alive { head = head + "connection: close\r\n" }
        let out = (head + "\r\n").bytes()
        if !bodiless && self.method != "HEAD" { out.extend(reply.body) }
        let wrote = __net_write(self.sock.id, out)
        if !self.keep_alive {
            let closed = __net_close(self.sock.id)
        }
        return wrote
    }

    fn respond_stream(self, head: String, bodiless: Bool, chunks: Stream<Bytes>, declared: String) -> Result<Null, Error> {
        var out = head
        let sized = declared != ""
        if sized {
            match __str_parse_int(declared) {
                Ok(n) => { }
                Err(e) => {
                    self.answered.set(false)
                    return Err(Error.new(ErrorKind.InvalidData, "bad content-length"))
                }
            }
        }
        let body = !bodiless && self.method != "HEAD"
        if !bodiless {
            if sized {
                out = out + "content-length: ${declared}\r\n"
            } else if body {
                out = out + "transfer-encoding: chunked\r\n"
            }
        }
        if !self.keep_alive { out = out + "connection: close\r\n" }
        var failure: Error? = None
        match __net_write(self.sock.id, (out + "\r\n").bytes()) {
            Ok(sent) => { }
            Err(e) => { failure = Some(e) }
        }
        if body && failure.is_none() {
            while true {
                match chunks.next() {
                    None => { break }
                    Some(piece) => {
                        let b: Bytes = piece
                        if b.len() > 0 {
                            match __net_write(self.sock.id, framed(b, sized)) {
                                Ok(sent) => { }
                                Err(e) => {
                                    failure = Some(e)
                                    break
                                }
                            }
                        }
                    }
                }
            }
            if failure.is_none() && !sized {
                match __net_write(self.sock.id, "0\r\n\r\n".bytes()) {
                    Ok(sent) => { }
                    Err(e) => { failure = Some(e) }
                }
            }
        }
        if !self.keep_alive || failure.is_some() {
            let closed = __net_close(self.sock.id)
        }
        match failure {
            Some(e) => { return Err(e) }
            None => { return Ok(null) }
        }
    }
}

/// A piece as it is written.
fn framed(piece: Bytes, sized: Bool) -> Bytes {
    if sized { return piece }
    let out = "${hex_of(piece.len())}\r\n".bytes()
    out.extend(piece)
    out.extend("\r\n".bytes())
    return out
}

fn hex_of(n: Int) -> String {
    let digits = "0123456789abcdef"
    if n == 0 { return "0" }
    var out = ""
    var rest = n
    while rest > 0 {
        let d = rest % 16
        out = digits.slice(d, d + 1) + out
        rest = rest / 16
    }
    return out
}

fn pairs(text: String) -> Map<String, String> {
    var out: Map<String, String> = Map()
    let flat = __form_decode(text)
    var i = 0
    while i + 1 < flat.len() {
        out[flat.get(i)] = flat.get(i + 1)
        i = i + 2
    }
    return out
}

/// One client's connection, safe to hand to a task.
pub class Connection {
    sock: Socket
    header_limit: Int
    body_limit: Int
    idle_millis: Int
    stream_over: Int

    /// The peer as `host:port`.
    pub fn peer_addr(self) -> Result<String, Error> {
        return __net_peer_addr(self.sock.id)
    }

    /// Closes the connection now.
    pub fn close(self) -> Result<Null, Error> {
        return __net_close(self.sock.id)
    }

    /// Answers with `status` and a text body, then closes.
    pub fn reject(self, status: Int, message: String) -> Result<Null, Error> {
        let reply = "HTTP/1.1 ${status} ${__http_reason(status)}\r\ndate: ${__http_date()}\r\ncontent-type: text/plain; charset=utf-8\r\ncontent-length: ${message.bytes().len()}\r\nconnection: close\r\n\r\n${message}"
        let sent = __net_write(self.sock.id, reply.bytes())
        let closed = __net_close(self.sock.id)
        return sent
    }

    /// The reader of this connection's requests.
    pub fn requests(self) -> Requests {
        return Requests { sock: self.sock, buf: Bytes(), done: false, header_limit: self.header_limit, body_limit: self.body_limit, idle_millis: self.idle_millis, stream_over: self.stream_over }
    }
}

/// Reads the requests on one connection in order.
pub class Requests {
    sock: Socket
    var buf: Bytes
    var done: Bool
    header_limit: Int
    body_limit: Int
    idle_millis: Int
    stream_over: Int

    fn shut(var self) {
        self.done = true
        let closed = __net_close(self.sock.id)
    }

    fn refuse(var self, status: Int, message: String) -> Error {
        let reply = "HTTP/1.1 ${status} ${__http_reason(status)}\r\ndate: ${__http_date()}\r\ncontent-type: text/plain; charset=utf-8\r\ncontent-length: ${message.len()}\r\nconnection: close\r\n\r\n${message}"
        let sent = __net_write(self.sock.id, reply.bytes())
        self.shut()
        if status == 408 { return Error.new(ErrorKind.TimedOut, message) }
        return Error.new(ErrorKind.InvalidData, message)
    }

    fn more(var self, size: Int, started: Bool) -> Result<Bool, Error> {
        match __net_read_for(self.sock.id, size, self.idle_millis) {
            Ok(chunk) => {
                let c: Bytes = chunk
                if c.len() == 0 {
                    self.shut()
                    if started { return Err(Error.new(ErrorKind.InvalidData, "the connection closed in the middle of a request")) }
                    return Ok(false)
                }
                self.buf.extend(c)
                return Ok(true)
            }
            Err(e) => {
                if e.kind == ErrorKind.TimedOut {
                    if started { return Err(self.refuse(408, "the request timed out")) }
                    self.shut()
                    return Ok(false)
                }
                self.shut()
                return Err(e)
            }
        }
    }

    fn take(var self, n: Int) -> Bytes {
        let front = self.buf.slice(0, n)
        self.buf = self.buf.slice(n, self.buf.len())
        return front
    }

    /// Waits for the next request, or `None` once the client is done.
    pub fn next(var self) -> Result<Request?, Error> {
        if self.done { return Ok(None) }
        while true {
            if self.buf.len() > 0 {
                match __http_parse_request(self.buf) {
                    Err(e) => { return Err(self.refuse(400, "malformed request: ${e.message}")) }
                    Ok(r) => {
                        let n: Int = r.get(0)
                        if n > self.header_limit { return Err(self.refuse(431, "the request header is too large")) }
                        if n > 0 {
                            let method: String = r.get(1)
                            let target: String = r.get(2)
                            let minor: Int = r.get(3)
                            var flat: List<String> = []
                            var k = 4
                            while k < r.len() {
                                let item: String = r.get(k)
                                flat.push(item)
                                k = k + 1
                            }
                            return self.finish(method, target, minor, flat, n)
                        }
                    }
                }
                if self.buf.len() > self.header_limit { return Err(self.refuse(431, "the request header is too large")) }
            }
            match self.more(16384, self.buf.len() > 0) {
                Ok(got) => { if !got { return Ok(None) } }
                Err(e) => { return Err(e) }
            }
        }
        return Ok(None)
    }

    fn finish(var self, method: String, target: String, minor: Int, headers: List<String>, n: Int) -> Result<Request?, Error> {
        var length = -1
        var chunked = false
        var other_coding = false
        var closing = minor == 0
        var expect = false
        var upgrading = false
        var i = 0
        while i < headers.len() {
            let name: String = headers.get(i)
            let value: String = headers.get(i + 1)
            if name == "content-length" {
                match __str_parse_int(value) {
                    Ok(v) => {
                        let got: Int = v
                        if got < 0 || (length >= 0 && got != length) { return Err(self.refuse(400, "bad content-length")) }
                        length = got
                    }
                    Err(e) => { return Err(self.refuse(400, "bad content-length")) }
                }
            }
            if name == "transfer-encoding" {
                if value.to_lower().trim() == "chunked" { chunked = true } else { other_coding = true }
            }
            if name == "connection" {
                for token in value.to_lower().split(",") {
                    if token.trim() == "close" { closing = true }
                    if token.trim() == "keep-alive" && minor == 0 { closing = false }
                }
            }
            if name == "expect" && value.to_lower().trim() == "100-continue" { expect = true }
            if name == "upgrade" { upgrading = true }
            i = i + 2
        }
        if other_coding { return Err(self.refuse(501, "that transfer-encoding is not supported")) }
        if chunked && length >= 0 { return Err(self.refuse(400, "both content-length and transfer-encoding")) }
        let streaming = self.stream_over > 0 && !chunked && length > self.stream_over
        if !streaming && length > self.body_limit { return Err(self.refuse(413, "the request body is too large")) }
        self.buf = self.buf.slice(n, self.buf.len())
        if expect && (chunked || length > self.buf.len()) {
            let sent = __net_write(self.sock.id, "HTTP/1.1 100 Continue\r\n\r\n".bytes())
        }
        var body = Bytes()
        var lead = Bytes()
        var total = 0
        if streaming {
            var held = length
            if held > self.buf.len() { held = self.buf.len() }
            lead = self.take(held)
            total = length
            closing = true
        } else if chunked {
            while true {
                let d = __http_decode_chunked(self.buf, self.body_limit)
                match d {
                    Err(e) => { return Err(self.refuse(400, "malformed chunked body: ${e.message}")) }
                    Ok(parts) => {
                        let used: Int = parts.get(0)
                        if used < 0 { return Err(self.refuse(413, "the request body is too large")) }
                        if used > 0 {
                            let decoded: Bytes = parts.get(1)
                            body = decoded
                            let rest = self.take(used)
                            break
                        }
                    }
                }
                if self.buf.len() > self.body_limit + self.header_limit { return Err(self.refuse(413, "the request body is too large")) }
                match self.more(1048576, true) {
                    Ok(got) => {}
                    Err(e) => { return Err(e) }
                }
            }
        } else if length > 0 {
            while self.buf.len() < length {
                match self.more(1048576, true) {
                    Ok(got) => {}
                    Err(e) => { return Err(e) }
                }
            }
            body = self.take(length)
        }
        if closing { self.done = true }
        var raw = target
        match raw.find("?") {
            Some(q) => { raw = raw.slice(0, q) }
            None => {}
        }
        if raw.starts_with("http://") || raw.starts_with("https://") {
            let tail = raw.slice(raw.find("://").unwrap() + 3, raw.len())
            match tail.find("/") {
                Some(slash) => { raw = tail.slice(slash, tail.len()) }
                None => { raw = "/" }
            }
        }
        if !streaming {
            lead = body
            total = body.len()
        }
        var rest = Bytes()
        if upgrading { rest = self.buf.slice(0, self.buf.len()) }
        return Ok(Some(Request {
            method: method, target: target, path: __percent_decode(raw), body: body, headers: headers, sock: self.sock, keep_alive: !closing,
            lead: lead, length: total, taken: Shared(0), idle_millis: self.idle_millis, rest: rest, answered: Shared(false),
        }))
    }
}

/// Stops a `Server` from another task.
pub class Closer {
    id: Int

    /// Stops listening.
    pub fn close(self) -> Result<Null, Error> {
        return __net_close(self.id)
    }
}

/// A listening server.
pub class Server {
    id: Int
    var header_limit: Int
    var body_limit: Int
    var idle_millis: Int
    var stream_over: Int

    /// Waits for the next client.
    pub fn accept(self) -> Result<Connection, Error> {
        let sid = __net_tcp_accept(self.id)?
        return Ok(Connection {
            sock: owned_socket(sid),
            header_limit: self.header_limit, body_limit: self.body_limit, idle_millis: self.idle_millis,
            stream_over: self.stream_over,
        })
    }

    /// The bound port.
    pub fn local_port(self) -> Result<Int, Error> {
        return __net_local_port(self.id)
    }

    /// Stops listening.
    pub fn close(self) -> Result<Null, Error> {
        return __net_close(self.id)
    }

    /// A handle that stops this server from another task.
    pub fn closer(self) -> Closer {
        return Closer { id: self.id }
    }

    /// The most bytes of request head.
    pub fn set_max_header(var self, bytes: Int) {
        self.header_limit = bytes
    }

    /// The most bytes of request body.
    pub fn set_max_body(var self, bytes: Int) {
        self.body_limit = bytes
    }

    /// How long a read waits for data.
    pub fn set_idle_timeout(var self, seconds: Int) {
        self.idle_millis = seconds * 1000
    }

    /// Leaves bodies longer than `bytes` on the connection for `Request.read_body`.
    pub fn set_stream_over(var self, bytes: Int) {
        self.stream_over = bytes
    }
}

fn serving(id: Int) -> Server {
    let server = Server { id: id, header_limit: 65536, body_limit: 67108864, idle_millis: 10000, stream_over: 0 }
    __release_on_collect(server, 2)
    return server
}

/// Listens on `host:port` and serves plain HTTP.
pub fn listen(host: String, port: Int) -> Result<Server, Error> {
    let id = __net_tcp_listen(host, port)?
    return Ok(serving(id))
}

/// Listens like `listen`, but serves HTTPS with `identity`.
pub fn listen_tls(host: String, port: Int, identity: Identity) -> Result<Server, Error> {
    let id = __net_tcp_listen_tls(host, port, identity.cert_pem(), identity.key_pem())?
    return Ok(serving(id))
}
