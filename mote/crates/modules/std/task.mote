/// std.task: join-combinators over live `Task<T>` handles and main-thread pinning.

import { * } from std.prelude
import std.time as time

/// Every task's result, in list order, stopping at the first `Err`.
pub fn all<T>(tasks: List<Task<T>>) -> Result<List<T>, String> {
    var out: List<T> = []
    var at = 0
    for t in tasks {
        at = at + 1
        match t.join() {
            Ok(v) => out.push(v)
            Err(e) => {
                var rest = at
                while rest < tasks.len() {
                    tasks.get(rest).cancel()
                    rest = rest + 1
                }
                rest = at
                while rest < tasks.len() {
                    tasks.get(rest).join()
                    rest = rest + 1
                }
                return Err(e)
            }
        }
    }
    return Ok(out)
}

/// Whichever task resolves first, success or failure.
pub fn any<T>(tasks: List<Task<T>>) -> Result<T, String> {
    let winner: Task<T> = __task_any(tasks)
    return winner.join()
}

/// `f`'s value, or `Err` of kind `TimedOut` when `d` passes first.
pub fn timeout<T>(d: time.Duration, f: Send () -> T) -> Result<T, Error> {
    let work: Task<T?> = spawn {
        let v: T = f()
        return Some(v)
    }
    let timer: Task<T?> = spawn {
        time.sleep(d)
        return None
    }
    match any([work, timer]) {
        Ok(got) => {
            match got {
                Some(v) => { return Ok(v) }
                None => { return Err(Error.new(ErrorKind.TimedOut, "timed out")) }
            }
        }
        Err(msg) => { return Err(Error.new(ErrorKind.Other, msg)) }
    }
}

/// `f` over `items` with at most `n` calls running at once.
pub fn par_map<T, U>(items: List<T>, n: Int, f: Send (T) -> U) -> Result<List<U>, String> {
    let total = items.len()
    let src = Shared(items)
    var next = Shared(0)
    var workers = n
    if workers > total { workers = total }
    if workers < 1 { workers = 1 }
    var parts: List<(List<Int>, List<U>)> = []
    var failure = ""
    scope {
        var handles: List<Task<(List<Int>, List<U>)>> = []
        var w = 0
        while w < workers && total > 0 {
            handles.push(spawn {
                var idx: List<Int> = []
                var vals: List<U> = []
                while true {
                    var i = 0
                    next.update(|k| {
                        i = k
                        k += 1
                    })
                    if i >= total { break }
                    idx.push(i)
                    vals.push(f(src.get().get(i)))
                }
                return (idx, vals)
            })
            w = w + 1
        }
        for h in handles {
            match h.join() {
                Ok(part) => { parts.push(part) }
                Err(msg) => {
                    if failure == "" || failure == "task was cancelled" { failure = msg }
                }
            }
        }
    }
    if failure != "" { return Err(failure) }
    var slots: Map<Int, U> = Map()
    for part in parts {
        var k = 0
        while k < part.0.len() {
            slots.set(part.0.get(k), part.1.get(k))
            k = k + 1
        }
    }
    var out: List<U> = []
    var i = 0
    while i < total {
        match slots.get(i) {
            Some(v) => { out.push(v) }
            None => { }
        }
        i = i + 1
    }
    return Ok(out)
}

/// A count of permits that tasks take and give back.
pub class Semaphore {
    permits: Shared<Int>

    /// A semaphore with `permits` free.
    pub fn new(permits: Int) -> Semaphore {
        return Semaphore { permits: Shared(permits) }
    }

    /// Takes a permit, waiting while none is free.
    pub fn acquire(self) {
        __sem_acquire(self.permits)
    }

    /// Gives back a permit this task took.
    pub fn release(self) {
        __sem_release(self.permits)
    }

    /// The permits free right now.
    pub fn available(self) -> Int {
        return self.permits.get()
    }

    /// Runs `f` holding a permit.
    pub fn with_permit<T>(self, f: () -> T) -> T {
        self.acquire()
        let out = f()
        self.release()
        return out
    }
}

/// Moves the calling task to the program's main thread.
pub fn pin() {
    __task_pin(1)
}

/// Returns the calling task to the worker pool.
pub fn unpin() {
    __task_pin(0)
}

/// Whether the calling task runs on the main thread.
pub fn is_pinned() -> Bool {
    return __task_pin(2)
}
