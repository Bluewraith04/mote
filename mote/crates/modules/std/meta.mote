/// std.meta: what a compile-time modifier reads and answers.

import { * } from std.prelude
import { Json, member, to_text, parse, __field, __str, __bool, __list, __nullable, __in, __int } from std.json
import { join } from std.string

@stable
pub enum DeclKind {
    Struct
    Class
    Enum
}

/// The shape of a type as written.
@stable
pub enum TypeKind {
    Named
    Optional
    Generic
    Tuple
    Function
    Array
    Union
    SelfType
    Var
}

/// A type as written, names unresolved.
@stable
pub class TypeRef {
    pub kind: TypeKind
    /// The type's name.
    pub name: String
    pub args: List<TypeRef>

    pub fn new(kind: TypeKind, name: String = "", args: List<TypeRef> = []) -> TypeRef {
        return TypeRef { kind: kind, name: name, args: args }
    }
}

/// An attribute with its arguments and pairs.
@stable
pub class Attr {
    pub name: String
    pub args: List<String>
    pub values: List<(String, String)>

    pub fn new(name: String, args: List<String> = [], values: List<(String, String)> = []) -> Attr {
        return Attr { name: name, args: args, values: values }
    }
}

/// A field with its type, doc and default.
@stable
pub class Field {
    pub name: String
    pub ty: TypeRef
    pub is_pub: Bool
    pub is_var: Bool
    pub doc: String
    pub default: String

    pub fn new(name: String, ty: TypeRef, is_pub: Bool = false, is_var: Bool = false, doc: String = "", default: String = "") -> Field {
        return Field { name: name, ty: ty, is_pub: is_pub, is_var: is_var, doc: doc, default: default }
    }
}

@stable
pub enum Shape {
    Unit
    Tuple
    Struct
}

/// An enum variant with its payload.
@stable
pub class Variant {
    pub name: String
    pub shape: Shape
    pub types: List<TypeRef>
    pub fields: List<Field>
    pub discriminant: Int?
    pub doc: String
    pub attrs: List<Attr>

    pub fn new(name: String, shape: Shape = Shape.Unit, types: List<TypeRef> = [], fields: List<Field> = [], discriminant: Int? = null, attrs: List<Attr> = [], doc: String = "") -> Variant {
        return Variant { name: name, shape: shape, types: types, fields: fields, discriminant: discriminant, doc: doc, attrs: attrs }
    }
}

@stable
pub class Param {
    pub name: String
    pub ty: TypeRef?

    pub fn new(name: String, ty: TypeRef? = null) -> Param {
        return Param { name: name, ty: ty }
    }
}

/// A method already on the declaration.
@stable
pub class Method {
    pub name: String
    pub is_pub: Bool
    pub has_self: Bool
    pub params: List<Param>
    pub returns: TypeRef?

    pub fn new(name: String, is_pub: Bool = false, has_self: Bool = true, params: List<Param> = [], returns: TypeRef? = null) -> Method {
        return Method { name: name, is_pub: is_pub, has_self: has_self, params: params, returns: returns }
    }
}

@stable
pub class GenericParam {
    pub name: String
    pub bounds: List<TypeRef>

    pub fn new(name: String, bounds: List<TypeRef> = []) -> GenericParam {
        return GenericParam { name: name, bounds: bounds }
    }
}

/// One `struct`, `class` or `enum` as written.
@stable
pub class Decl {
    pub kind: DeclKind
    pub name: String
    pub is_pub: Bool
    pub doc: String
    pub generics: List<GenericParam>
    pub traits: List<TypeRef>
    pub fields: List<Field>
    pub variants: List<Variant>
    pub methods: List<Method>
    pub attrs: List<Attr>

    pub fn new(kind: DeclKind, name: String, is_pub: Bool = true, generics: List<GenericParam> = [], traits: List<TypeRef> = [], fields: List<Field> = [], variants: List<Variant> = [], methods: List<Method> = [], attrs: List<Attr> = [], doc: String = "") -> Decl {
        return Decl { kind: kind, name: name, is_pub: is_pub, doc: doc, generics: generics, traits: traits, fields: fields, variants: variants, methods: methods, attrs: attrs }
    }
}

/// `fn` sources that become methods of the declaration.
@stable
pub class Additions {
    pub public: String
    pub private: String

    pub fn new(public: String, private: String = "") -> Additions {
        return Additions { public: public, private: private }
    }
}

@stable
pub class Diagnostic {
    pub message: String

    pub fn new(message: String) -> Diagnostic {
        return Diagnostic { message: message }
    }
}

/// `t` written back as source.
@stable
pub fn render(t: TypeRef) -> String {
    match t.kind {
        TypeKind.Named => { return t.name }
        TypeKind.SelfType => { return "Self" }
        TypeKind.Optional => {
            let inner = t.args.get(0)
            match inner.kind {
                TypeKind.Union => { return "(" + render(inner) + ")?" }
                _ => { return render(inner) + "?" }
            }
        }
        TypeKind.Generic => { return t.name + "<" + join(render_all(t.args), ", ") + ">" }
        TypeKind.Tuple => { return "(" + join(render_all(t.args), ", ") + ")" }
        TypeKind.Array => { return "[" + render(t.args.get(0)) + "]" }
        TypeKind.Var => { return "var " + render(t.args.get(0)) }
        TypeKind.Union => {
            var parts: List<String> = []
            for a in t.args {
                match a.kind {
                    TypeKind.Function => { parts.push("(" + render(a) + ")") }
                    _ => { parts.push(render(a)) }
                }
            }
            return join(parts, " | ")
        }
        TypeKind.Function => {
            let last = t.args.len() - 1
            var params: List<String> = []
            var i = 0
            for a in t.args {
                if i < last { params.push(render(a)) }
                i = i + 1
            }
            var send = ""
            if t.name == "Send" { send = "Send " }
            return send + "(" + join(params, ", ") + ") -> " + render(t.args.get(last))
        }
    }
}

fn render_all(ts: List<TypeRef>) -> List<String> {
    var out: List<String> = []
    for t in ts { out.push(render(t)) }
    return out
}

fn invalid(message: String) -> Error {
    return Error.new(ErrorKind.InvalidData, message)
}

fn text_of(j: Json, key: String) -> Result<String, Error> {
    let v = __field(j, key)?
    return __in(key, __str(v))
}

fn flag_of(j: Json, key: String) -> Result<Bool, Error> {
    let v = __field(j, key)?
    return __in(key, __bool(v))
}

fn list_of<T>(j: Json, key: String, f: (Json) -> Result<T, Error>) -> Result<List<T>, Error> {
    let v = __field(j, key)?
    return __in(key, __list(v, f))
}

fn pair(j: Json) -> Result<(String, String), Error> {
    let items = __list(j, __str)?
    if items.len() != 2 { return Err(invalid("expected a pair of text")) }
    return Ok((items.get(0), items.get(1)))
}

fn type_kind(name: String) -> Result<TypeKind, Error> {
    if name == "name" { return Ok(TypeKind.Named) }
    if name == "optional" { return Ok(TypeKind.Optional) }
    if name == "generic" { return Ok(TypeKind.Generic) }
    if name == "tuple" { return Ok(TypeKind.Tuple) }
    if name == "function" { return Ok(TypeKind.Function) }
    if name == "array" { return Ok(TypeKind.Array) }
    if name == "union" { return Ok(TypeKind.Union) }
    if name == "self" { return Ok(TypeKind.SelfType) }
    if name == "var" { return Ok(TypeKind.Var) }
    return Err(invalid("unknown type kind `${name}`"))
}

fn type_ref(j: Json) -> Result<TypeRef, Error> {
    let kind = type_kind(text_of(j, "kind")?)?
    let name = text_of(j, "name")?
    let args = list_of(j, "args", type_ref)?
    return Ok(TypeRef { kind: kind, name: name, args: args })
}

fn attr(j: Json) -> Result<Attr, Error> {
    let name = text_of(j, "name")?
    let args = list_of(j, "args", __str)?
    let values = list_of(j, "values", pair)?
    return Ok(Attr { name: name, args: args, values: values })
}

fn field(j: Json) -> Result<Field, Error> {
    let name = text_of(j, "name")?
    let ty_json = __field(j, "type")?
    let ty = __in("type", type_ref(ty_json))?
    let is_pub = flag_of(j, "pub")?
    let is_var = flag_of(j, "var")?
    let doc = text_of(j, "doc")?
    let default = text_of(j, "default")?
    return Ok(Field { name: name, ty: ty, is_pub: is_pub, is_var: is_var, doc: doc, default: default })
}

fn shape(name: String) -> Result<Shape, Error> {
    if name == "unit" { return Ok(Shape.Unit) }
    if name == "tuple" { return Ok(Shape.Tuple) }
    if name == "struct" { return Ok(Shape.Struct) }
    return Err(invalid("unknown variant shape `${name}`"))
}

fn variant(j: Json) -> Result<Variant, Error> {
    let name = text_of(j, "name")?
    let sh = shape(text_of(j, "shape")?)?
    let types = list_of(j, "types", type_ref)?
    let fields = list_of(j, "fields", field)?
    let disc_json = __field(j, "discriminant")?
    let discriminant = __in("discriminant", __nullable(disc_json, __int))?
    let doc = text_of(j, "doc")?
    let attrs = list_of(j, "attrs", attr)?
    return Ok(Variant { name: name, shape: sh, types: types, fields: fields, discriminant: discriminant, doc: doc, attrs: attrs })
}

fn param(j: Json) -> Result<Param, Error> {
    let name = text_of(j, "name")?
    let ty_json = __field(j, "type")?
    let ty = __in("type", __nullable(ty_json, type_ref))?
    return Ok(Param { name: name, ty: ty })
}

fn method(j: Json) -> Result<Method, Error> {
    let name = text_of(j, "name")?
    let is_pub = flag_of(j, "pub")?
    let has_self = flag_of(j, "self")?
    let params = list_of(j, "params", param)?
    let ret_json = __field(j, "returns")?
    let returns = __in("returns", __nullable(ret_json, type_ref))?
    return Ok(Method { name: name, is_pub: is_pub, has_self: has_self, params: params, returns: returns })
}

fn generic_param(j: Json) -> Result<GenericParam, Error> {
    let name = text_of(j, "name")?
    let bounds = list_of(j, "bounds", type_ref)?
    return Ok(GenericParam { name: name, bounds: bounds })
}

fn decl_kind(name: String) -> Result<DeclKind, Error> {
    if name == "struct" { return Ok(DeclKind.Struct) }
    if name == "class" { return Ok(DeclKind.Class) }
    if name == "enum" { return Ok(DeclKind.Enum) }
    return Err(invalid("unknown declaration kind `${name}`"))
}

/// The `Decl` a compiler wrote as JSON text.
pub fn parse_decl(text: String) -> Result<Decl, Error> {
    let j = parse(text)?
    let kind = decl_kind(text_of(j, "kind")?)?
    let name = text_of(j, "name")?
    let is_pub = flag_of(j, "pub")?
    let doc = text_of(j, "doc")?
    let generics = list_of(j, "generics", generic_param)?
    let traits = list_of(j, "traits", type_ref)?
    let fields = list_of(j, "fields", field)?
    let variants = list_of(j, "variants", variant)?
    let methods = list_of(j, "methods", method)?
    let attrs = list_of(j, "attrs", attr)?
    return Ok(Decl { kind: kind, name: name, is_pub: is_pub, doc: doc, generics: generics, traits: traits, fields: fields, variants: variants, methods: methods, attrs: attrs })
}

fn answer(key: String, value: Json) -> String {
    match to_text(Json.Object([member(key, value)])) {
        Ok(s) => { return s }
        Err(e) => { return "{\"err\":\"${e.message}\"}" }
    }
}

/// Runs `f` on the `Decl` in `input` and answers as JSON text.
pub fn respond(input: String, f: (Decl) -> Result<Additions, Diagnostic>) -> String {
    match parse_decl(input) {
        Err(e) => { return answer("err", Json.Str("bad modifier input: " + e.message)) }
        Ok(decl) => {
            match f(decl) {
                Ok(a) => { return answer("ok", Json.Object([member("public", Json.Str(a.public)), member("private", Json.Str(a.private))])) }
                Err(d) => { return answer("err", Json.Str(d.message)) }
            }
        }
    }
}
