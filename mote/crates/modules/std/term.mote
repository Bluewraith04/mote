/// std.term: raw mode, the terminal size and key, mouse and resize events.

import { * } from std.prelude
import { Stream } from std.stream

pub class Mods {
    pub shift: Bool
    pub ctrl: Bool
    pub alt: Bool
}

pub fn mods(shift: Bool, ctrl: Bool, alt: Bool) -> Mods { return Mods { shift: shift, ctrl: ctrl, alt: alt } }

pub fn no_mods() -> Mods { return Mods { shift: false, ctrl: false, alt: false } }

pub enum Key {
    Char(String)
    Enter
    Escape
    Tab
    Backspace
    Delete
    Insert
    Up
    Down
    Left
    Right
    Home
    End
    PageUp
    PageDown
    F(Int)
}

pub enum Button { Left Middle Right }

pub enum Mouse {
    Down(Button)
    Up(Button)
    Drag(Button)
    Move
    ScrollUp
    ScrollDown
}

/// A key, mouse or resize event.
pub enum Event {
    Key(Key, Mods)
    Mouse(Mouse, Int, Int)
    Resize(Int, Int)
}

pub class Size {
    pub cols: Int
    pub rows: Int
}

/// An open terminal in raw mode on the alternate screen.
pub class Term {
    pub mouse: Bool

    pub fn size(self) -> Result<Size, Error> {
        let packed = __term_size()?
        return Ok(Size { cols: packed / 65536, rows: packed % 65536 })
    }

    /// Keys, mouse and resizes in order.
    pub fn events(self) -> Stream<Event> { return decode(__term_events()) }

    /// Leaves raw mode and the alternate screen.
    pub fn close(self) { __term_close() }
}

/// The columns `text` takes on a terminal, one entry each.
pub fn glyphs(text: String) -> List<String> { return __term_glyphs(text) }

/// How many columns `text` takes on a terminal.
pub fn width(text: String) -> Int { return __term_width(text) }

/// Opens the terminal, or `Err` when stdin or stdout is not one.
pub fn open(mouse: Bool) -> Result<Term, Error> {
    var flag = 0
    if mouse { flag = 1 }
    __term_open(flag)?
    return Ok(Term { mouse: mouse })
}

fn decode(inbox: Receiver<List<Int>>) -> Stream<Event> {
    for raw in inbox {
        yield decode_event(raw)
    }
}

fn decode_event(raw: List<Int>) -> Event {
    let kind = raw.get(0)
    if kind == 0 {
        let bits = raw.get(2)
        let mods = Mods { shift: (bits & 1) != 0, ctrl: (bits & 2) != 0, alt: (bits & 4) != 0 }
        return Event.Key(key_of(raw.get(1)), mods)
    }
    if kind == 1 {
        return Event.Mouse(mouse_of(raw.get(1), raw.get(2)), raw.get(3), raw.get(4))
    }
    return Event.Resize(raw.get(1), raw.get(2))
}

fn key_of(code: Int) -> Key {
    if code >= 0 { return Key.Char(utf8(code)) }
    if code == -1 { return Key.Enter }
    if code == -2 { return Key.Escape }
    if code == -3 { return Key.Tab }
    if code == -4 { return Key.Backspace }
    if code == -5 { return Key.Delete }
    if code == -6 { return Key.Insert }
    if code == -7 { return Key.Up }
    if code == -8 { return Key.Down }
    if code == -9 { return Key.Left }
    if code == -10 { return Key.Right }
    if code == -11 { return Key.Home }
    if code == -12 { return Key.End }
    if code == -13 { return Key.PageUp }
    if code == -14 { return Key.PageDown }
    return Key.F(-100 - code)
}

fn button_of(code: Int) -> Button {
    if code == 0 { return Button.Left }
    if code == 1 { return Button.Middle }
    return Button.Right
}

fn mouse_of(kind: Int, button: Int) -> Mouse {
    if kind == 0 { return Mouse.Down(button_of(button)) }
    if kind == 1 { return Mouse.Up(button_of(button)) }
    if kind == 2 { return Mouse.Drag(button_of(button)) }
    if kind == 3 { return Mouse.Move }
    if kind == 4 { return Mouse.ScrollUp }
    return Mouse.ScrollDown
}

fn utf8(cp: Int) -> String {
    var b = Bytes()
    if cp < 128 {
        b.push(cp)
    } else if cp < 2048 {
        b.push(192 + cp / 64)
        b.push(128 + cp % 64)
    } else if cp < 65536 {
        b.push(224 + cp / 4096)
        b.push(128 + (cp / 64) % 64)
        b.push(128 + cp % 64)
    } else {
        b.push(240 + cp / 262144)
        b.push(128 + (cp / 4096) % 64)
        b.push(128 + (cp / 64) % 64)
        b.push(128 + cp % 64)
    }
    return b.decode().unwrap_or("?")
}
