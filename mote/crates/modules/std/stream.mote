/// std.stream: lazy `Stream` sources and adapters. Consume with `for` or `.next()`.
/// A fallible source is a stream of `Result`: a read failure arrives as a final `Err` item, then the stream ends.

import { * } from std.prelude
import std.sys.io as io

/// `f` applied to every element, pulled lazily.
pub fn map<T, U>(s: Stream<T>, f: (T) -> U) -> Stream<U> {
    for x in s {
        yield f(x)
    }
}

/// The elements for which `pred` is true, pulled lazily.
pub fn filter<T>(s: Stream<T>, pred: (T) -> Bool) -> Stream<T> {
    for x in s {
        if pred(x) {
            yield x
        }
    }
}

/// The first `n` elements, pulled lazily — the source is never asked for more
/// than `n` items.
pub fn take<T>(s: Stream<T>, n: Int) -> Stream<T> {
    var i = 0
    for x in s {
        if i >= n {
            return
        }
        yield x
        i = i + 1
    }
}

/// One `String` per UTF-8 code point of `s` (there is no `Char` conversion yet).
pub fn chars(s: String) -> Stream<String> {
    let b = s.bytes()
    let n = b.len()
    var i = 0
    while i < n {
        let lead = b.get(i)
        var width = 1
        if lead >= 240 { width = 4 }
        if lead >= 224 && lead < 240 { width = 3 }
        if lead >= 192 && lead < 224 { width = 2 }
        var end = i + width
        if end > n { end = n }
        yield s.slice(i, end)
        i = end
    }
}

/// The lines of `s` split on `\n`, without the empty piece after a final newline.
pub fn lines(s: String) -> Stream<String> {
    let parts = s.split("\n")
    let last = parts.len() - 1
    var i = 0
    for part in parts {
        if i < last || !part.is_empty() { yield part }
        i = i + 1
    }
}

/// Each line of stdin as `Ok(line)`; a read failure is one `Err`, then the end.
pub fn stdin_lines() -> Stream<Result<String, Error>> {
    let sin = io.stdin()
    while true {
        match sin.read_line() {
            Ok(got) => {
                match got {
                    Some(line) => { yield Ok(line) }
                    None => { return }
                }
            }
            Err(e) => {
                yield Err(e)
                return
            }
        }
    }
}

/// Each line of the file at `path` as `Ok(line)`; an unreadable file is one `Err`.
pub fn file_lines(path: String) -> Stream<Result<String, Error>> {
    match io.read_file(path) {
        Ok(text) => {
            for line in lines(text) { yield Ok(line) }
        }
        Err(e) => { yield Err(e) }
    }
}
