/// std.error: the `Error` and `ErrorKind` types every fallible std operation returns.

import { Result } from std.result

@stable
pub enum ErrorKind {
    NotFound
    PermissionDenied
    InvalidData
    Interrupted
    AlreadyExists
    WouldBlock
    TimedOut
    Unsupported
    Other
    Unauthenticated
    Conflict
    RateLimited
    Unavailable
}

@stable
pub class Error {
    pub kind: ErrorKind
    pub message: String
    pub code: String

    pub fn new(kind: ErrorKind, message: String) -> Error { return Error { kind: kind, message: message, code: "" } }

    /// The same error with a machine-readable `code`.
    pub fn with_code(self, code: String) -> Error { return Error { kind: self.kind, message: self.message, code: code } }

    /// The same kind and code with `what` in front of the message.
    pub fn context(self, what: String) -> Error { return Error { kind: self.kind, message: what + ": " + self.message, code: self.code } }
}

/// A type that `?` turns into an `Error`.
@stable
pub trait Failure {
    fn into_error(self) -> Error
}

/// `r` with `what` put in front of the message of its `Err`.
pub fn context<T>(r: Result<T, Error>, what: String) -> Result<T, Error> {
    match r {
        Ok(v) => { return Ok(v) }
        Err(e) => { return Err(e.context(what)) }
    }
}

pub fn error_kind_from_code(code: Int) -> ErrorKind {
    if code == 0 { return ErrorKind.NotFound }
    if code == 1 { return ErrorKind.PermissionDenied }
    if code == 2 { return ErrorKind.InvalidData }
    if code == 3 { return ErrorKind.Interrupted }
    if code == 4 { return ErrorKind.AlreadyExists }
    if code == 5 { return ErrorKind.WouldBlock }
    if code == 6 { return ErrorKind.TimedOut }
    if code == 7 { return ErrorKind.Unsupported }
    return ErrorKind.Other
}

/// The `Error` a fallible native's recoverable failure becomes.
pub fn __native_error(code: Int, message: String) -> Error {
    return Error.new(error_kind_from_code(code), message)
}

/// A domain-relevant view of an I/O failure.
@stable
pub enum IoError {
    NotFound
    PermissionDenied
    AlreadyExists
    Interrupted
    WouldBlock
    TimedOut
    Other
}

@stable
pub fn io_error_of(e: Error) -> IoError {
    match e.kind {
        NotFound => { return IoError.NotFound }
        PermissionDenied => { return IoError.PermissionDenied }
        AlreadyExists => { return IoError.AlreadyExists }
        Interrupted => { return IoError.Interrupted }
        WouldBlock => { return IoError.WouldBlock }
        TimedOut => { return IoError.TimedOut }
        _ => { return IoError.Other }
    }
}

/// A domain-relevant view of a parse failure.
@stable
pub enum ParseError {
    InvalidSyntax
    Other
}

@stable
pub fn parse_error_of(e: Error) -> ParseError {
    match e.kind {
        InvalidData => { return ParseError.InvalidSyntax }
        _ => { return ParseError.Other }
    }
}
