/// std.env: program arguments and environment variables.

import { * } from std.prelude

pub fn args() -> List<String> {
    return __env_args()
}

/// The value of environment variable `name`, or `None` if it is unset.
pub fn get_var(name: String) -> Option<String> {
    let v = __env_var_raw(name)
    if v == null {
        return None
    }
    return Some(v)
}

pub fn vars() -> Map<String, String> {
    return __env_vars()
}

/// Ends the process now with `code`.
pub fn exit(code: Int) { __process_exit(code) }
