/// std.derive.args: the modifier behind `Args`.

import { * } from std.prelude
import std.meta as meta
import std.string as str

enum Scalar {
    Int
    Float
    Str
}

/// How a field is read.
enum Kind {
    Flag
    Value(Scalar, Bool)
    Many(Scalar)
    Command(String, Bool)
}

class Member {
    name: String
    long: String
    short: String
    help: String
    has_default: Bool
    default: String
    positional: Bool
    kind: Kind
}

/// One `x = field` pair of an `@arg` tag.
class Short {
    letter: String
    field: String
}

/// One line of a help table.
class Row {
    indent: Int
    left: String
    help: String
}

fn row(indent: Int, left: String, help: String) -> Row {
    return Row { indent: indent, left: left, help: help }
}

fn is_letter(c: String) -> Bool {
    return "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ".contains(c)
}

fn is_upper(c: String) -> Bool {
    return "ABCDEFGHIJKLMNOPQRSTUVWXYZ".contains(c)
}

fn is_lower_or_digit(c: String) -> Bool {
    return "abcdefghijklmnopqrstuvwxyz0123456789".contains(c)
}

/// The help text of a doc comment.
fn help_of(doc: String) -> String {
    var parts: List<String> = []
    for line in str.lines(doc) {
        let t = line.trim()
        if !t.is_empty() { parts.push(t) }
    }
    return str.join(parts, " ")
}

/// What replaces a key that `@arg` used to take.
fn gone(key: String) -> String {
    if key == "help" { return "`help` is gone: write the help as a `///` comment before the item" }
    if key == "short" { return "`short` is gone: write `@arg(x = field)` before the struct, class or variant" }
    if key == "default" { return "`default` is gone: write `= value` after the field's type" }
    if key == "positional" { return "`positional` is gone: a field with no default is a positional" }
    return ""
}

/// The `x = field` pairs of the `@arg` tags in `attrs`.
fn read_shorts(attrs: List<meta.Attr>) -> Result<List<Short>, String> {
    var out: List<Short> = []
    for a in attrs {
        if a.name != "arg" { continue }
        if !a.args.is_empty() {
            let bare = a.args[0]
            let old = gone(bare)
            if !old.is_empty() { return Err(old) }
            return Err("`@arg` takes `x = field` pairs, not `" + bare + "`")
        }
        for pair in a.values {
            let key = pair.0
            let old = gone(key)
            if !old.is_empty() { return Err(old) }
            if key.len() != 1 || !is_letter(key) { return Err("`" + key + "` is not a short: a short is one letter") }
            out.push(Short { letter: key, field: pair.1 })
        }
    }
    return Ok(out)
}

/// Fails on a short that is invalid.
fn check_shorts(shorts: List<Short>, fields: List<meta.Field>) -> Result<Null, String> {
    var seen: List<String> = []
    for s in shorts {
        if s.letter == "h" { return Err("short -h is reserved") }
        for l in seen {
            if l == s.letter { return Err("short -" + s.letter + " is used twice") }
        }
        seen.push(s.letter)
        var found = false
        for f in fields {
            if f.name == s.field { found = true }
        }
        if !found { return Err("no field named " + s.field) }
    }
    return Ok(null)
}

fn scalar_of(t: meta.TypeRef) -> Option<Scalar> {
    match t.kind {
        meta.TypeKind.Named => {
            if t.name == "Int" { return Some(Scalar.Int) }
            if t.name == "Float" { return Some(Scalar.Float) }
            if t.name == "String" { return Some(Scalar.Str) }
            return None
        }
        _ => { return None }
    }
}

fn is_primitive(name: String) -> Bool {
    return name == "Int" || name == "Float" || name == "String" || name == "Bool" || name == "Char" || name == "Null"
}

fn classify(f: meta.Field) -> Result<Kind, String> {
    let bad = "field `" + f.name + "` has type `" + meta.render(f.ty) + "`, which a command line cannot hold"
    let ty = f.ty
    match ty.kind {
        meta.TypeKind.Optional => {
            let inner = ty.args.get(0)
            match scalar_of(inner) {
                Some(sc) => { return Ok(Kind.Value(sc, true)) }
                None => {}
            }
            match inner.kind {
                meta.TypeKind.Named => {
                    if !is_primitive(inner.name) { return Ok(Kind.Command(inner.name, true)) }
                    return Err(bad)
                }
                _ => { return Err(bad) }
            }
        }
        meta.TypeKind.Generic => {
            if ty.name == "List" && ty.args.len() == 1 {
                match scalar_of(ty.args.get(0)) {
                    Some(sc) => { return Ok(Kind.Many(sc)) }
                    None => { return Err(bad) }
                }
            }
            return Err(bad)
        }
        meta.TypeKind.Named => {
            if ty.name == "Bool" { return Ok(Kind.Flag) }
            match scalar_of(ty) {
                Some(sc) => { return Ok(Kind.Value(sc, false)) }
                None => {}
            }
            if !is_primitive(ty.name) { return Ok(Kind.Command(ty.name, false)) }
            return Err(bad)
        }
        _ => { return Err(bad) }
    }
}

/// A name in kebab case.
fn kebab(name: String) -> String {
    let n = name.len()
    var out = ""
    var i = 0
    while i < n {
        let c = name.slice(i, i + 1)
        if c == "_" {
            out = out + "-"
        } else if is_upper(c) {
            var after_word = false
            var acronym_end = false
            if i > 0 {
                let prev = name.slice(i - 1, i)
                after_word = is_lower_or_digit(prev)
                if i + 1 < n {
                    acronym_end = is_upper(prev) && !is_upper(name.slice(i + 1, i + 2)) && is_letter(name.slice(i + 1, i + 2))
                }
            }
            if after_word || acronym_end { out = out + "-" }
            out = out + c.to_lower()
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out
}

fn is_command(m: Member) -> Bool {
    match m.kind {
        Kind.Command(_, _) => { return true }
        _ => { return false }
    }
}

fn is_many(m: Member) -> Bool {
    match m.kind {
        Kind.Many(_) => { return true }
        _ => { return false }
    }
}

fn is_flag(m: Member) -> Bool {
    match m.kind {
        Kind.Flag => { return true }
        _ => { return false }
    }
}

/// The members of `fields`, each read by its type and default.
fn members(fields: List<meta.Field>, in_variant: Bool, shorts: List<Short>) -> Result<List<Member>, String> {
    check_shorts(shorts, fields)?
    var out: List<Member> = []
    for f in fields {
        let kind = classify(f)?
        let long = kebab(f.name)
        let text = f.default
        var positional = false
        var has_default = false
        match kind {
            Kind.Flag => {
                if text == "true" { return Err("a flag cannot default to true") }
                if !text.is_empty() && text != "false" { return Err("`" + f.name + "` is a flag, so its default is `false`") }
            }
            Kind.Command(_, _) => {
                if !text.is_empty() { return Err("`" + f.name + "` is a subcommand, so it has no default") }
                if in_variant { return Err("`" + f.name + "`: a subcommand cannot hold a subcommand") }
            }
            Kind.Value(_, optional) => {
                if text.is_empty() {
                    positional = true
                } else if optional {
                    if text != "null" { return Err("`" + f.name + "` is optional, so its default is `null`") }
                } else {
                    has_default = true
                }
            }
            Kind.Many(_) => {
                if text.is_empty() {
                    positional = true
                } else if text != "[]" {
                    return Err("`" + f.name + "` is a list, so its default is `[]`")
                }
            }
        }
        var short = ""
        for s in shorts {
            if s.field == f.name {
                if !short.is_empty() { return Err("`" + f.name + "` has two shorts, -" + short + " and -" + s.letter) }
                short = s.letter
            }
        }
        if !short.is_empty() && (positional || is_command_kind(kind)) { return Err("a positional has no short") }
        if !positional && !is_command_kind(kind) {
            if f.name == "help" { return Err("`help` is reserved for `--help`") }
            for o in out {
                if !o.positional && o.long == long { return Err("two fields are the option `--" + long + "`") }
            }
        }
        out.push(Member { name: f.name, long: long, short: short, help: help_of(f.doc), has_default: has_default, default: text, positional: positional, kind: kind })
    }
    var positionals: List<Member> = []
    var commands = 0
    for m in out {
        if m.positional { positionals.push(m) }
        if is_command(m) { commands = commands + 1 }
    }
    var i = 0
    for p in positionals {
        if is_many(p) && i + 1 != positionals.len() {
            return Err("a `List` positional takes every argument left, so it must be the last positional")
        }
        i = i + 1
    }
    if commands > 1 { return Err("a command line has one subcommand field") }
    if commands == 1 && positionals.len() > 0 { return Err("a type with a subcommand has no positional arguments") }
    return Ok(out)
}

fn is_command_kind(k: Kind) -> Bool {
    match k {
        Kind.Command(_, _) => { return true }
        _ => { return false }
    }
}

/// `s` as a Mote string literal.
fn lit(s: String) -> String {
    return "\"" + s.replace("\\", "\\\\").replace("\"", "\\\"").replace("$", "\\$").replace("\n", "\\n") + "\""
}

fn conv(sc: Scalar) -> String {
    match sc {
        Scalar.Int => { return "|__l, __t| __modifier.__int(__l, __t)" }
        Scalar.Float => { return "|__l, __t| __modifier.__float(__l, __t)" }
        Scalar.Str => { return "|__l, __t| __modifier.__str(__l, __t)" }
    }
}

fn label(m: Member) -> String {
    return m.long.to_upper()
}

/// The statements that read each member out of the scan.
fn reads(ms: List<Member>) -> (String, String, String) {
    var stmts = ""
    var pre = ""
    var inits: List<String> = []
    var next_pos = 0
    for m in ms {
        let n = m.name
        let v = "__v_" + n
        let long = m.long
        var line = ""
        if m.positional {
            let lab = lit("<" + label(m) + ">")
            match m.kind {
                Kind.Value(sc, optional) => {
                    var fetch = "__pos"
                    if optional { fetch = "__pos_maybe" }
                    line = "let " + v + " = __modifier." + fetch + "(__s, ${next_pos}, " + lab + ", " + conv(sc) + ")?"
                    next_pos = next_pos + 1
                }
                Kind.Many(sc) => { line = "let " + v + " = __modifier.__pos_many(__s, ${next_pos}, " + lab + ", " + conv(sc) + ")?" }
                _ => {}
            }
        } else {
            match m.kind {
                Kind.Flag => { line = "let " + v + " = __modifier.__flag(__s, \"" + long + "\")" }
                Kind.Value(sc, optional) => {
                    if optional {
                        line = "let " + v + " = __modifier.__maybe(__s, \"" + long + "\", " + conv(sc) + ")?"
                    } else {
                        line = "let " + v + " = __modifier.__with(__s, \"" + long + "\", " + m.default + ", " + conv(sc) + ")?"
                    }
                }
                Kind.Many(sc) => { line = "let " + v + " = __modifier.__many(__s, \"" + long + "\", " + conv(sc) + ")?" }
                Kind.Command(ty, optional) => {
                    if optional {
                        pre = pre + "var " + v + ": " + ty + "? = null\n"
                        line = "if __s.stop < argv.len() { " + v + " = " + ty + ".__args_from(argv, __s.stop)? }"
                    } else {
                        line = "let " + v + " = " + ty + ".__args_from(argv, __s.stop)?"
                    }
                }
            }
        }
        stmts = stmts + line + "\n"
        inits.push(n + ": " + v)
    }
    var open_ended = false
    for m in ms {
        if (is_many(m) && m.positional) || is_command(m) { open_ended = true }
    }
    if !open_ended { stmts = stmts + "__modifier.__no_extra(__s, ${next_pos})?\n" }
    return (pre, stmts, str.join(inits, ", "))
}

fn options_of(ms: List<Member>) -> List<Member> {
    var out: List<Member> = []
    for m in ms {
        if !m.positional && !is_command(m) { out.push(m) }
    }
    return out
}

fn opt_table(ms: List<Member>) -> String {
    var opts: List<String> = []
    for m in options_of(ms) {
        let takes = !is_flag(m)
        opts.push("__modifier.__opt(\"" + m.long + "\", \"" + m.short + "\", ${takes})")
    }
    return "[" + str.join(opts, ", ") + "]"
}

fn has_command(ms: List<Member>) -> Bool {
    for m in ms {
        if is_command(m) { return true }
    }
    return false
}

fn table(rows: List<Row>) -> String {
    var width = 0
    for r in rows {
        if r.indent + r.left.len() > width { width = r.indent + r.left.len() }
    }
    width = width + 2
    var lines: List<String> = []
    for r in rows {
        let text = " ".repeat(r.indent) + r.left
        if r.help.is_empty() {
            lines.push(text)
        } else {
            lines.push(text + " ".repeat(width - text.len()) + r.help)
        }
    }
    return str.join(lines, "\n")
}

fn option_left(m: Member) -> String {
    var name = "    --" + m.long
    if m.short != "" { name = "-" + m.short + ", --" + m.long }
    if is_flag(m) { return name }
    return name + " <" + label(m) + ">"
}

/// A default as the help shows it.
fn shown(text: String) -> String {
    if text.len() >= 2 && text.starts_with("\"") && text.ends_with("\"") { return text.slice(1, text.len() - 1) }
    return text
}

fn help_text(m: Member) -> String {
    if m.has_default {
        if m.help.is_empty() { return "[default: " + shown(m.default) + "]" }
        return m.help + " [default: " + shown(m.default) + "]"
    }
    return m.help
}

fn positional_left(m: Member) -> String {
    match m.kind {
        Kind.Value(_, optional) => {
            if optional { return "[" + label(m) + "]" }
            return "<" + label(m) + ">"
        }
        _ => { return "[" + label(m) + "]..." }
    }
}

fn synopsis(ms: List<Member>) -> String {
    var s = " [OPTIONS]"
    for m in ms {
        if m.positional {
            s = s + " " + positional_left(m)
        } else {
            match m.kind {
                Kind.Command(_, optional) => {
                    if optional { s = s + " [COMMAND]" } else { s = s + " <COMMAND>" }
                }
                _ => {}
            }
        }
    }
    return s
}

/// The methods every `Args` type has.
fn common(owner: String, rest_of_line: String) -> String {
    return "fn parse(argv: List<String>) -> Result<" + owner + ", Error> { return " + owner + ".__args_from(argv, 1) }
fn parse_or_exit(argv: List<String>) -> " + owner + " {
let __p = __modifier.__program(argv)
if __modifier.__wants_help(argv) { __modifier.__print_help(" + owner + ".usage(__p)) }
match " + owner + ".parse(argv) {
Ok(__v) => { return __v }
Err(__e) => { __modifier.__fail(" + owner + ".__args_line(__p), __e) }
}
return " + owner + ".parse(argv).unwrap()
}
fn __args_line(program: String) -> String { return \"Usage: \" + program + " + lit(rest_of_line) + " }
"
}

fn struct_source(owner: String, fields: List<meta.Field>, desc: String, shorts: List<Short>) -> Result<String, String> {
    var parts: List<String> = []
    if !desc.is_empty() { parts.push(desc) }
    var args: List<Row> = []
    var opts: List<Row> = []
    let ms = members(fields, false, shorts)?
    let options = options_of(ms)
    for m in ms {
        if m.positional { args.push(row(2, positional_left(m), m.help)) }
    }
    if args.len() > 0 { parts.push("Arguments:\n" + table(args)) }
    for m in options {
        opts.push(row(2, option_left(m), help_text(m)))
    }
    opts.push(row(2, "-h, --help", "print this help"))
    parts.push("Options:\n" + table(opts))
    var usage = owner + ".__args_line(program) + " + lit("\n\n" + str.join(parts, "\n\n"))
    for m in ms {
        match m.kind {
            Kind.Command(ty, _) => { usage = usage + " + \"\\n\\n\" + " + ty + ".__args_cmds()" }
            _ => {}
        }
    }
    usage = usage + " + \"\\n\""
    let r = reads(ms)
    let scan = "let __s = __modifier.__scan(argv, start, " + opt_table(ms) + ", ${has_command(ms)})?"
    return Ok(common(owner, synopsis(ms)) + "fn usage(program: String) -> String { return " + usage + " }
fn __args_from(argv: List<String>, start: Int) -> Result<" + owner + ", Error> {
" + r.0 + scan + "
" + r.1 + "return Ok(" + owner + " { " + r.2 + " })
}")
}

fn enum_source(owner: String, variants: List<meta.Variant>, desc: String) -> Result<String, String> {
    var names: List<String> = []
    var rows: List<Row> = []
    var arms = ""
    for v in variants {
        var fields: List<meta.Field> = []
        match v.shape {
            meta.Shape.Unit => {}
            meta.Shape.Struct => { fields = v.fields }
            meta.Shape.Tuple => { return Err("variant `" + v.name + "` has unnamed fields, so it cannot be a subcommand") }
        }
        let cmd = kebab(v.name)
        for n in names {
            if n == cmd { return Err("two variants are the command `" + cmd + "`") }
        }
        let shorts = read_shorts(v.attrs)?
        let help = help_of(v.doc)
        let ms = members(fields, true, shorts)?
        let options = options_of(ms)
        rows.push(row(2, cmd, help))
        for m in ms {
            if m.positional { rows.push(row(6, positional_left(m), m.help)) }
        }
        for m in options {
            rows.push(row(6, option_left(m).trim(), help_text(m)))
        }
        let r = reads(ms)
        var value = owner + "." + v.name
        if fields.len() > 0 { value = owner + "." + v.name + " { " + r.2 + " }" }
        arms = arms + "if __name == \"" + cmd + "\" {\nlet __s = __modifier.__scan(argv, start + 1, " + opt_table(ms) + ", false)?\n" + r.1 + "return Ok(" + value + ")\n}\n"
        names.push(cmd)
    }
    var quoted: List<String> = []
    for n in names { quoted.push(lit(n)) }
    let list = "[" + str.join(quoted, ", ") + "]"
    let cmds = "Commands:\n" + table(rows)
    var head = ""
    if !desc.is_empty() { head = desc + "\n\n" }
    return Ok(common(owner, " <COMMAND>") + "fn usage(program: String) -> String { return " + owner + ".__args_line(program) + " + lit("\n\n" + head) + " + " + owner + ".__args_cmds() + \"\\n\" }
fn __args_cmds() -> String { return " + lit(cmds) + " }
fn __args_from(argv: List<String>, start: Int) -> Result<" + owner + ", Error> {
if start >= argv.len() { return Err(__modifier.__no_command(" + list + ")) }
let __name = argv[start]
" + arms + "return Err(__modifier.__bad_command(__name, " + list + "))
}")
}

@stable
@modifier(reads = "arg")
pub fn args_modifier(d: meta.Decl) -> Result<meta.Additions, meta.Diagnostic> {
    if d.generics.len() > 0 {
        return Err(meta.Diagnostic.new("a generic type is not supported"))
    }
    match source_of(d) {
        Ok(text) => { return Ok(meta.Additions.new(text)) }
        Err(message) => { return Err(meta.Diagnostic.new(message)) }
    }
}

fn source_of(d: meta.Decl) -> Result<String, String> {
    let shorts = read_shorts(d.attrs)?
    let desc = help_of(d.doc)
    match d.kind {
        meta.DeclKind.Enum => {
            if !shorts.is_empty() { return Err("an enum has no options of its own: write `@arg` before a variant") }
            return enum_source(d.name, d.variants, desc)
        }
        _ => { return struct_source(d.name, d.fields, desc, shorts) }
    }
}
