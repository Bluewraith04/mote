/// std.collections: set algebra and constructors over `Map` and `Set`.
/// The primitives (`.get`, `.set`, `.add`, `.remove`, `.contains`, `.keys`, `.items`) are methods.

import { * } from std.prelude

/// A `Set` holding every element of `xs` (duplicates collapsed).
pub fn set_from<T>(xs: List<T>) -> Set<T> {
    var s: Set<T> = Set()
    for x in xs {
        s.add(x)
    }
    return s
}

/// Elements in either `a` or `b`.
pub fn union<T>(a: Set<T>, b: Set<T>) -> Set<T> {
    var s: Set<T> = Set()
    for x in a.items() {
        s.add(x)
    }
    for x in b.items() {
        s.add(x)
    }
    return s
}

/// Elements in both `a` and `b`.
pub fn intersection<T>(a: Set<T>, b: Set<T>) -> Set<T> {
    var s: Set<T> = Set()
    for x in a.items() {
        if b.contains(x) {
            s.add(x)
        }
    }
    return s
}

/// Elements in `a` but not `b`.
pub fn difference<T>(a: Set<T>, b: Set<T>) -> Set<T> {
    var s: Set<T> = Set()
    for x in a.items() {
        if b.contains(x) == false {
            s.add(x)
        }
    }
    return s
}

/// A `Map` from a `List` of `(key, value)` tuples.
pub fn map_from<K, V>(pairs: List<(K, V)>) -> Map<K, V> {
    var m: Map<K, V> = Map()
    for p in pairs {
        m.set(p.0, p.1)
    }
    return m
}

/// Every entry of `a` and `b`; on a shared key, `b`'s value wins.
pub fn merge<K, V>(a: Map<K, V>, b: Map<K, V>) -> Map<K, V> {
    var m: Map<K, V> = Map()
    for k in a.keys() {
        m.set(k, a.get(k))
    }
    for k in b.keys() {
        m.set(k, b.get(k))
    }
    return m
}

/// A new `Map` with every value passed through `f`; keys are unchanged.
pub fn map_values<K, V, W>(m: Map<K, V>, f: (V) -> W) -> Map<K, W> {
    var out: Map<K, W> = Map()
    for k in m.keys() {
        out.set(k, f(m.get(k)))
    }
    return out
}

/// The entries of `m` whose key satisfies `pred`.
pub fn filter_keys<K, V>(m: Map<K, V>, pred: (K) -> Bool) -> Map<K, V> {
    var out: Map<K, V> = Map()
    for k in m.keys() {
        if pred(k) {
            out.set(k, m.get(k))
        }
    }
    return out
}
