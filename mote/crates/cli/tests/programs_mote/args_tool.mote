/// A small tool whose command line is a type: global flag, subcommands, positionals and defaults.
import std.env
import std.args

enum Command: (Args) {
    /// add up the numbers
    Sum {
        /// the numbers
        numbers: List<Int>
    }
    /// repeat a word
    @arg(n = times)
    Say {
        /// the word
        word: String
        /// how many times
        times: Int = 1
        /// end with this
        end: String? = null
    }
}

/// Small tools
@arg(q = quiet)
class Tool: (Args) {
    /// print only the result
    quiet: Bool
    command: Command
}

fn run(c: Command, quiet: Bool) {
    match c {
        Sum { numbers } => {
            var total = 0
            for n in numbers { total = total + n }
            if quiet { println(total) } else { println("sum of ${numbers.len()} numbers: ${total}") }
        }
        Say { word, times, end } => {
            var i = 0
            while i < times {
                println(word)
                i = i + 1
            }
            if end != null { println(end) }
        }
    }
}

fn main() {
    let tool = Tool.parse_or_exit(env.args())
    run(tool.command, tool.quiet)
}
